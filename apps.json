{
  "id": "arcade.shovey-player",
  "title": "Shovey",
  "apps": [
    {
      "manifest": "src/catalog.json",
      "shared_records": [
        "local.campaign",
        "campaign"
      ],
      "library_entries": [
        "json_scan:ArrayPositions",
        "json_scan:ElementAt",
        "json_scan:ReadStringValue",
        "levels:ShoveyLevelSolution"
      ],
      "cover": {
        "portrait": "assets/shovey/title-portrait.png",
        "landscape": "assets/shovey/title-landscape.png",
        "logo": "assets/shovey/logo.png",
        "action": "play"
      }
    },
    {
      "manifest": "packaging/island.json",
      "external": true,
      "cover": {
        "portrait": "assets/island-marketing/portrait.png",
        "landscape": "assets/island-marketing/landscape.png",
        "logo": "assets/island-marketing/logo.png",
        "action": "open"
      }
    },
    {
      "manifest": "src/editor/catalog.json",
      "shared_code": true,
      "cover": {
        "portrait": "assets/shovey/editor-portrait.png",
        "landscape": "assets/shovey/editor-landscape.png",
        "logo": "assets/covers/shovey-editor-logo.png",
        "action": "open"
      },
      "requires": [
        "arcade.shovey"
      ]
    }
  ]
}
