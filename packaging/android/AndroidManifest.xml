<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Shovey"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".ShoveyActivity"
            android:launchMode="${nativeLaunchMode}"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">

            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />
        </activity>
        <!-- Installs from Arcade's build launch this name; keeping it keeps
             their home screen icons. -->
        <activity-alias
            android:name="xyz.waozi.arcade.ArcadeActivity"
            android:targetActivity=".ShoveyActivity"
            android:exported="true">

            <meta-data
                android:name="android.app.lib_name"
                android:value="main" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
