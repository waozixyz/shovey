#import "kryon/geometry"
Layout :: #import, file "world_map_layout.zi";

// Detached secret rooms sit beside their anchor boards on the v5 continuous map.
WorldMapArtSecretPosition :: (room: s32, landscape: bool = false) -> Vector2 {
    anchor := Layout.WorldMapLevelPosition(ifx room == 1003 then 29 else 175, 390.0, landscape)
    if room < 1001 || room > 1003 { return Vector2.{-1.0, -1.0} }
    scale: float32 = Layout.WorldMapWorldZoom
    if room == 1003 {
        return Vector2.{anchor.x + (ifx landscape then -80.0 else -220.0) * scale,
            anchor.y + (ifx landscape then -230.0 else 60.0) * scale}
    }
    if landscape {
        return Vector2.{anchor.x + (ifx room == 1001 then -150.0 else -545.0) * scale,
            anchor.y + (ifx room == 1001 then -198.0 else 166.0) * scale}
    }
    // Portrait 159-S1 floats in the cove west of the last beach, a full
    // 56px circle clear of every board even on a 320px-wide window.
    return Vector2.{anchor.x + (ifx room == 1001 then -380.0 else 140.0) * scale,
        anchor.y + (ifx room == 1001 then 35.0 else 290.0) * scale}
}
