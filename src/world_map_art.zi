#scope_export

WorldMapArtPanelAt :: (index: s32) -> WorldMapArtPanel {
    if index < 0 || index >= WorldMapArtPanelCount { return .{} }
    at := index * 4
    size_at := index * 2
    size := Vector2.{world_map_art_sizes[size_at], world_map_art_sizes[size_at + 1]}
    return WorldMapArtPanel.{.available = true, .asset_path = world_map_art_paths[index],
        .world_bounds = Rectangle.{world_map_art_bounds[at], world_map_art_bounds[at + 1],
            world_map_art_bounds[at + 2], world_map_art_bounds[at + 3]},
        .source = Rectangle.{0.0, 0.0, size.x, size.y}, .full_size = size,
        .secret_room = world_map_art_rooms[index]}
}

WorldMapArtLevelPosition :: (level: s32) -> Vector2 {
    if level < 1 || level > 175 { return Vector2.{-1.0, -1.0} }
    return Vector2.{world_map_art_x[level - 1], world_map_art_y[level - 1]}
}

WorldMapArtSecretPosition :: (room: s32) -> Vector2 {
    if room == 1003 { return Vector2.{.x = 3152.376463, .y = 45041.205829} }
    if room == 1001 { return Vector2.{.x = 2135.564268, .y = 1831.491713} }
    if room == 1002 { return Vector2.{.x = 4251.617010, .y = 1631.359466} }
    return Vector2.{-1.0, -1.0}
}

// Borrowed immutable centerlines exclude both graph endpoints; no inferred edges.
