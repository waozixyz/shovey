// Shared shop composition for game pages and native/browser covers.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/text_props"
#import "kryon/text_widget"
#import "kryon/text_align"
#import "kryon/button_props"
#import "kryon/control_props"
#import "kryon/button_widget"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/scroll_props"
#import "kryon/scroll_widget"
#import "kryon/tree"
#import "kryon/widget_palette"
#import "kryon/app_context"
#import "std/number_text"
#import "std/text_buffer"
#import "std/c_string"
#import "std/vec"
#import "std/json_scan"
#import "entity/dew_model"
Products :: #import "entity/game_shop";
#import, file "shop_state.zi";
#import, file "daily_chest.zi";
#import, file "controls.zi";
#import, file "shovey_theme.zi";
#if #defined(SHOVEY_WEB) {
    Locale :: #import, file "web/host.zi";
    Localized :: (key: string) -> string { return Locale.AppLocaleHost(key) }
} else {
    host_api :: #system_library "host_api";
    AppLocaleHost :: (key: string) -> string #foreign host_api;
    Localized :: (key: string) -> string { return AppLocaleHost(key) }
}
Copy :: (key: string) -> string {
    // Literal keys keep fallback labels alive even if a host echoes a key.
    locale_key := "shovey_shop_shop"
    if key == "shop" { locale_key = "shovey_shop_shop" }
    if key == "chest" { locale_key = "shovey_shop_chest" }
    if key == "skins" { locale_key = "shovey_shop_skins" }
    if key == "coins" { locale_key = "shovey_shop_coins" }
    if key == "dew" { locale_key = "shovey_shop_dew" }
    if key == "back" { locale_key = "shovey_shop_back" }
    if key == "profile" { locale_key = "shovey_shop_profile" }
    if key == "leaderboard" { locale_key = "shovey_shop_leaderboard" }
    if key == "confirm" { locale_key = "shovey_shop_confirm" }
    if key == "cancel" { locale_key = "shovey_shop_cancel" }
    if key == "free" { locale_key = "shovey_shop_free" }
    if key == "owned" { locale_key = "shovey_shop_owned" }
    if key == "wear" { locale_key = "shovey_shop_wear" }
    if key == "wearing" { locale_key = "shovey_shop_wearing" }
    if key == "buy" { locale_key = "shovey_shop_buy" }
    if key == "buy_dew" { locale_key = "shovey_shop_buy_dew" }
    if key == "claim" { locale_key = "shovey_shop_claim" }
    if key == "claimed" { locale_key = "shovey_shop_claimed" }
    if key == "today" { locale_key = "shovey_shop_today" }
    if key == "locked" { locale_key = "shovey_shop_locked" }
    if key == "chest_wait" { locale_key = "shovey_shop_chest_wait" }
    if key == "purchase_pending" { locale_key = "shovey_shop_purchase_pending" }
    if key == "purchase_failed" { locale_key = "shovey_shop_purchase_failed" }
    if key == "chest_rule" { locale_key = "shovey_shop_chest_rule" }
    if key == "skin_default" { locale_key = "shovey_shop_skin_default" }
    if key == "skin_ember" { locale_key = "shovey_shop_skin_ember" }
    if key == "skin_frost" { locale_key = "shovey_shop_skin_frost" }
    if key == "skin_berry" { locale_key = "shovey_shop_skin_berry" }
    if key == "skin_night" { locale_key = "shovey_shop_skin_night" }
    if key == "skin_crystal" { locale_key = "shovey_shop_skin_crystal" }
    if key == "skin_stone" { locale_key = "shovey_shop_skin_stone" }
    if key == "skin_gold" { locale_key = "shovey_shop_skin_gold" }
    return Localized(locale_key)
}
page: s32;
tab: s32;
scroll: s32;
confirm: s32; // Skin id + 1; coin pack id + 100.
notice: string;
dew_balance: [32]u8;
host_route: bool;

// Another instance of the game may have claimed or spent coins while its
// cover wallet was hidden. Rebind from the durable records on return.
#program_export
RefreshWallet :: () {
    shop_storage_ok = false
    shop_poll_at = 0.0
    daily_chest_loaded = false
}

// Read through the account service each frame; never keep a previous owner's
// balance while the service changes accounts or waits for a node reply.
DewText :: () -> string {
    dew_balance = .{}
    reply := AppService("entity.dew", "balance")
    units := ReadNumber(reply, FieldAt(reply, 0, "units"))
    if !units.valid || units.value < 0.0 || units.value > 9000000000000000.0 ||
        !DewFormat(cast(s64)units.value, DewUnits, dew_balance[:]) { unused CopyCString("…", dew_balance[:]) }
    return TextUntilNul(dew_balance[:])
}

#program_export
Open :: (next: s32) {
    if next != 1 && next != 2 { return }
    page = next; confirm = 0; scroll = 0; notice = ""; host_route = false
}
#program_export
Skin :: () -> s32 { return ShopSkin() }
SkinPath :: () -> string { return ShopProfilePath(ShopSkin()) }
#program_export
IsOpen :: () -> bool { return page != 0 }
#program_export
Back :: () -> bool {
    if page == 0 { return false }
    if confirm != 0 { confirm = 0; notice = "" }
    else {
        page = 0
        if host_route {
            host_route = false
            unused AppService("arcade.navigation", "back")
        }
    }
    return true
}
// A cover request is navigation only. Consume it before opening, so resuming
// an unfinished board does not repeat the route or trigger any purchase.
#program_export
Request :: () {
    route := PathRecord("shop.request")
    next: s32 = ifx route == "shop" then 1 else ifx route == "chest" then 2 else 0
    if next != 0 && PathSaveRecord("shop.request", "") { Open(next); host_route = true }
}
#program_export
Pump :: (now: float64, today: s64) {
    DailyChestPump(today)
    ShopPump(now)
    ShopSetEarnedCoins(DailyChestCoins())
}
Label :: (session: Session, key: u64, bounds: Rectangle, text: string, size: s32 = 16, centre: bool = false) {
    unused Text(session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = size,
        .align = ifx centre then TextAlign.TextAlignCenter else TextAlign.TextAlignStart,
        .vertical_align = TextAlign.TextAlignCenter, .wrap = TextWrap.TextWrapAuto})
}
Picture :: (session: Session, key: u64, bounds: Rectangle, path: string, alt: string) {
    unused Image(session, ImageProps.{.key = key, .bounds = bounds, .asset_path = path,
        .fit = ImageFit.ImageFitContain, .smooth = true, .alt_text = alt})
}
Action :: (session: Session, key: u64, bounds: Rectangle, label: string, disabled: bool = false, selected: bool = false) -> bool {
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key, .bounds = bounds, .label = Copy(label),
        .disabled = disabled, .selected = selected, .fit_content = true,
        .tone = ifx selected then ButtonTone.ButtonToneAccent else ButtonTone.ButtonToneNeutral,
        .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0
}
IconAction :: (session: Session, key: u64, bounds: Rectangle, path: string, label: string) -> bool {
    Picture(session, key + 1, bounds, path, Copy(label))
    return Button(session, ButtonProps.{.key = key, .id = cast(s32)key, .bounds = bounds,
        .label = Copy(label), .invisible = true}) != 0
}
#program_export
TitleActions :: (session: Session, bounds: Rectangle) {
    size := bounds.height
    if size > 44.0 { size = 44.0 }
    if IconAction(session, 61000, Rectangle.{bounds.x, bounds.y, size, size}, "assets/shovey/shop/stall.png", "shop") { Open(1) }
    if IconAction(session, 61002, Rectangle.{bounds.x + size + 4.0, bounds.y, size, size}, "assets/shovey/shop/chest-closed.png", "chest") { Open(2) }
}
#program_export
CoverActions :: (session: Session, bounds: Rectangle) {
    if IconAction(session, 61000, Rectangle.{bounds.x, bounds.y, 44.0, 44.0}, "assets/shovey/shop/stall.png", "shop") { Open(1) }
    if IconAction(session, 61002, Rectangle.{bounds.x, bounds.y + 60.0, 44.0, 44.0}, "assets/shovey/shop/chest-closed.png", "chest") { Open(2) }
    digits: [24]u8
    Amount(session, 61004, Rectangle.{bounds.x + 48.0, bounds.y, bounds.width - 48.0, 28.0}, false,
        FormatInteger(cast(s64)ShopCoins(), digits[:]))
    Amount(session, 61006, Rectangle.{bounds.x + 48.0, bounds.y + 30.0, bounds.width - 48.0, 28.0}, true, DewText())
}
Amount :: (session: Session, key: u64, bounds: Rectangle, dew: bool, value: string) {
    Picture(session, key, Rectangle.{bounds.x, bounds.y + 2.0, 26.0, 26.0},
        ifx dew then "assets/shovey/shop/dew.png" else "assets/shovey/shop/coins.png", Copy(ifx dew then "dew" else "coins"))
    Label(session, key + 1, Rectangle.{bounds.x + 30.0, bounds.y, bounds.width - 30.0, bounds.height}, value)
}
Price :: (session: Session, key: u64, bounds: Rectangle, coins: s32, dew: s64) {
    digits: [32]u8
    if coins > 0 { Amount(session, key, bounds, false, FormatInteger(cast(s64)coins, digits[:])) }
    else if dew > 0 && DewFormat(dew, DewUnits, digits[:]) { Amount(session, key, bounds, true, TextUntilNul(digits[:])) }
    else { Label(session, key, bounds, Copy("free"), 15, true) }
}
SkinName :: (id: s32) -> string {
    keys: [8]string = .["skin_default", "skin_ember", "skin_frost", "skin_berry", "skin_night", "skin_crystal", "skin_stone", "skin_gold"]
    return Copy(keys[id])
}
Card :: (session: Session, key: u64, bounds: Rectangle, selected: bool = false) {
    unused Box(session, BoxProps.{.key = key, .bounds = bounds, .radius = 16.0,
        .fill = Color.{59, 64, 63, 255}, .border = ifx selected then Color.{52, 185, 48, 255} else Color.{93, 98, 97, 255}})
}
Confirmation :: (session: Session, bounds: Rectangle) {
    pack := confirm >= 100
    id := ifx pack then confirm - 100 else confirm - 1
    Picture(session, 61601, Rectangle.{bounds.x + (bounds.width - 104.0) / 2.0, bounds.y + 8.0, 104.0, 104.0},
        ifx pack then "assets/shovey/shop/coins.png" else ShopSkinPath(id), Copy("confirm"))
    digits: [24]u8
    Label(session, 61602, Rectangle.{bounds.x, bounds.y + 116.0, bounds.width, 32.0},
        ifx pack then FormatInteger(cast(s64)Products.ShoveyCoinPackCoins(id), digits[:]) else SkinName(id), 22, true)
    price := Rectangle.{bounds.x + (bounds.width - 100.0) / 2.0, bounds.y + 156.0, 100.0, 30.0}
    Price(session, 61603, price, ifx pack then 0 else ShopSkinCoins(id), ifx pack then Products.ShoveyCoinPackPrice(id) else ShopSkinDew(id))
    if Action(session, 61610, Rectangle.{bounds.x, bounds.y + 202.0, bounds.width, 44.0}, "confirm",
        !pack && ShopSkinCoins(id) > ShopCoins()) {
        accepted := ifx pack then ShopBuyCoins(id) else ShopBuy(id)
        if accepted {
            if !pack && ShopAvailable(id) { unused ShopSelect(id) }
            confirm = 0
            notice = ifx !pack && ShopAvailable(id) then "wearing" else "purchase_pending"
        } else { notice = "purchase_failed" }
    }
    if Action(session, 61611, Rectangle.{bounds.x, bounds.y + 256.0, bounds.width, 44.0}, "cancel") { confirm = 0; notice = "" }
}
Skins :: (session: Session, area: Rectangle, columns: s32) {
    width := (area.width - cast(float32)(columns - 1) * 10.0) / cast(float32)columns
    for id: cast(s32)0..SHOP_SKIN_COUNT - 1 {
        x := area.x + cast(float32)(id % columns) * (width + 10.0)
        y := area.y + cast(float32)(id / columns) * 216.0
        key := cast(u64)(62000 + id * 20)
        wearing := ShopSkin() == id
        owned := ShopAvailable(id)
        Card(session, key, Rectangle.{x, y, width, 204.0}, wearing)
        Picture(session, key + 1, Rectangle.{x + (width - 76.0) / 2.0, y + 8.0, 76.0, 76.0}, ShopSkinPath(id), SkinName(id))
        Label(session, key + 2, Rectangle.{x + 4.0, y + 86.0, width - 8.0, 28.0}, SkinName(id), 17, true)
        price := Rectangle.{x + 12.0, y + 120.0, width - 24.0, 28.0}
        if owned { Label(session, key + 3, price, Copy(ifx id == 0 then "free" else "owned"), 14, true) }
        else { Price(session, key + 3, price, ShopSkinCoins(id), ShopSkinDew(id)) }
        if Action(session, key + 6, Rectangle.{x + 8.0, y + 156.0, width - 16.0, 40.0},
            ifx wearing then "wearing" else ifx owned then "wear" else "buy", wearing, wearing) {
            notice = ""
            if owned { if !ShopSelect(id) { notice = "purchase_failed" } }
            else { confirm = id + 1; scroll = 0 }
        }
    }
}
CoinPacks :: (session: Session, area: Rectangle) {
    for pack: cast(s32)1..3 {
        key := cast(u64)(62400 + pack * 20)
        y := area.y + cast(float32)(pack - 1) * 138.0
        Card(session, key, Rectangle.{area.x, y, area.width, 126.0})
        digits: [24]u8
        Amount(session, key + 1, Rectangle.{area.x + 12.0, y + 10.0, area.width / 2.0 - 12.0, 32.0}, false,
            FormatInteger(cast(s64)Products.ShoveyCoinPackCoins(pack), digits[:]))
        Price(session, key + 3, Rectangle.{area.x + area.width / 2.0, y + 10.0, area.width / 2.0 - 12.0, 32.0}, 0, Products.ShoveyCoinPackPrice(pack))
        if Action(session, key + 6, Rectangle.{area.x + 12.0, y + 66.0, area.width - 24.0, 44.0}, "buy") { confirm = pack + 100; scroll = 0; notice = "" }
    }
}
Chest :: (session: Session, area: Rectangle, today: s64, columns: s32) {
    ready := DailyChestReady(today)
    claimed := DailyChestWeekClaimed(today)
    day := DailyChestDay(today)
    Picture(session, 63000, Rectangle.{area.x + (area.width - 130.0) / 2.0, area.y, 130.0, 112.0},
        ifx ready then "assets/shovey/shop/chest-open.png" else "assets/shovey/shop/chest-closed.png", Copy("chest"))
    Label(session, 63001, Rectangle.{area.x, area.y + 118.0, area.width, 72.0}, Copy("chest_rule"), 14, true)
    if Action(session, 63002, Rectangle.{area.x, area.y + 202.0, area.width, 44.0}, ifx ready then "claim" else "chest_wait", !ready, ready) {
        if DailyChestClaim(today) { ShopSetEarnedCoins(DailyChestCoins()); notice = "claimed" }
        else { notice = "purchase_failed" }
    }
    width := (area.width - cast(float32)(columns - 1) * 8.0) / cast(float32)columns
    for slot: cast(s32)1..7 {
        key := cast(u64)(63100 + slot * 10)
        x := area.x + cast(float32)((slot - 1) % columns) * (width + 8.0)
        y := area.y + 262.0 + cast(float32)((slot - 1) / columns) * 126.0
        Card(session, key, Rectangle.{x, y, width, 116.0}, day == slot)
        digits: [24]u8
        Label(session, key + 1, Rectangle.{x + 4.0, y + 4.0, width - 8.0, 24.0}, FormatInteger(cast(s64)slot, digits[:]), 16, true)
        Amount(session, key + 2, Rectangle.{x + 8.0, y + 36.0, width - 16.0, 28.0}, false,
            FormatInteger(cast(s64)DailyChestPlanCoins(slot), digits[:]))
        Label(session, key + 4, Rectangle.{x + 4.0, y + 76.0, width - 8.0, 28.0},
            Copy(ifx slot <= claimed then "claimed" else ifx slot == day then "today" else "locked"), 12, true)
    }
}
#program_export
Frame :: (session: Session, bounds: Rectangle, now: float64, today: s64) -> bool {
    if page == 0 { return false }
    Pump(now, today)
    unused WidgetPaletteUse(session, ShoveyPalette())
    unused Box(session, BoxProps.{.key = cast(u64)61100, .bounds = bounds, .fill = Color.{42, 46, 45, 255}})
    if Action(session, 61101, Rectangle.{bounds.x + 10.0, bounds.y + 8.0, 76.0, 44.0}, "back") { unused Back(); return true }
    Label(session, 61102, Rectangle.{bounds.x + 94.0, bounds.y + 8.0, bounds.width - 196.0, 44.0}, Copy(ifx page == 1 then "shop" else "chest"), 17)
    if IconAction(session, 61104, Rectangle.{bounds.x + bounds.width - 96.0, bounds.y + 10.0, 40.0, 40.0}, "assets/shovey/shop/profile.png", "profile") { unused AppService("entity.profile", "open") }
    if IconAction(session, 61106, Rectangle.{bounds.x + bounds.width - 50.0, bounds.y + 10.0, 40.0, 40.0}, "assets/shovey/shop/trophy.png", "leaderboard") { unused AppService("entity.profile", "leaderboard") }
    width := bounds.width - 24.0
    if width > 900.0 { width = 900.0 }
    x := bounds.x + (bounds.width - width) / 2.0
    Picture(session, 61200, Rectangle.{x, bounds.y + 62.0, 64.0, 64.0}, "assets/shovey/shop/stall.png", Copy("shop"))
    digits: [24]u8
    Amount(session, 61202, Rectangle.{x + 72.0, bounds.y + 62.0, width - 72.0, 28.0}, false, FormatInteger(cast(s64)ShopCoins(), digits[:]))
    Amount(session, 61204, Rectangle.{x + 72.0, bounds.y + 96.0, width - 72.0, 28.0}, true, DewText())
    top := bounds.y + 138.0
    if page == 1 {
        tabs: [3]string = .["skins", "coins", "dew"]
        for at: cast(s32)0..2 {
            w := (width - 16.0) / 3.0
            if Action(session, cast(u64)(61300 + at), Rectangle.{x + cast(float32)at * (w + 8.0), top, w, 40.0}, tabs[at], false, tab == at) {
                tab = at; confirm = 0; scroll = 0; notice = ""
            }
        }
        top += 50.0
    }
    if notice != "" { Label(session, 61400, Rectangle.{x, top, width, 44.0}, Copy(notice), 14, true); top += 48.0 }
    grid_width := width - 16.0 // Allow for the host scrollbar.
    columns: s32 = ifx grid_width >= 740.0 then 4 else ifx grid_width >= 490.0 then 3 else 2
    height := ((SHOP_SKIN_COUNT + columns - 1) / columns) * 216
    if confirm != 0 { height = 320 }
    else if page == 2 {
        columns = ifx grid_width >= 700.0 then 7 else ifx grid_width >= 420.0 then 4 else 2
        height = 262 + ((7 + columns - 1) / columns) * 126
    } else if tab == 1 { height = 414 }
    else if tab == 2 { height = 270 }
    viewport_height := bounds.y + bounds.height - top - 8.0
    if viewport_height < 1.0 { return true }
    panel := Scroll(session, ScrollProps.{.key = cast(u64)61500, .bounds = Rectangle.{x, top, width, viewport_height},
        .content_height = height, .scroll_offset = scroll})
    scroll = panel.scroll_offset
    if panel.opened {
        area := panel.content
        if confirm != 0 { Confirmation(session, area) }
        else if page == 2 { Chest(session, area, today, columns) }
        else if tab == 0 { Skins(session, area, columns) }
        else if tab == 1 { CoinPacks(session, area) }
        else {
            Picture(session, 62500, Rectangle.{area.x + (area.width - 108.0) / 2.0, area.y + 4.0, 108.0, 108.0}, "assets/shovey/shop/dew.png", Copy("dew"))
            Label(session, 62501, Rectangle.{area.x, area.y + 118.0, area.width, 36.0}, TextUntilNul(dew_balance[:]), 24, true)
            if Action(session, 62502, Rectangle.{area.x, area.y + 178.0, area.width, 44.0}, "buy_dew") { unused AppService("entity.profile", "dew") }
        }
        End(session)
    }
    return true
}
