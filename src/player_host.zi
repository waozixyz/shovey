// Local game payloads stay beside the small collection, so the shared host
// accounts for one game copy while retaining normal verified add-on navigation.
collection_bundle_root: string = "games";
collection_bundle_root_owned: bool;
collection_classic_bytes: string;
collection_editor_bytes: string;
collection_shop_request: string;
collection_shop_locator: AppLocator;
collection_island: IslandUnlock;
collection_island_page: bool;
collection_island_poll: float64;
collection_island_opening: bool;
collection_island_package: IslandPackage;
collection_island_blocked: bool;
collection_island_account: [65]u8;
// The Editor's Island levels: Island opened in editor mode from the Editor.
// The Editor asks (ISLAND_EDITOR_ASKED), the collection opens Island
// (ISLAND_EDITOR_OPENING) and it runs (ISLAND_EDITOR_OPEN); leaving it reopens
// the Editor. A locked Island shows its unlock page first.
ISLAND_EDITOR_NONE :: 0
ISLAND_EDITOR_ASKED :: 1
ISLAND_EDITOR_OPENING :: 2
ISLAND_EDITOR_OPEN :: 3
SHOVEY_EDITOR_APP :: "arcade.shovey-editor"
collection_island_editor: s32;
collection_island_unlock_for_editor: bool;

using HostValueKind;

CollectionRecords :: struct {
    id: string
    root: string
    files: AppFiles
    text: string
    next: *CollectionRecords
}

CollectionImage :: struct {
    packed: string
    absolute: string
    next: *CollectionImage
}

collection_host: AppHost;
collection_records: *CollectionRecords;
collection_directory: string;
collection_resources: AppFiles;
collection_resource_root: string;
collection_images: *CollectionImage;
collection_frame_paths: Vec(string);
collection_widget_node: *AppNode;
collection_wallet_record: string;
collection_person_codec: Codec.WidgetAppPersonCodec;
collection_shared_codec: Codec.WidgetAppSharedCodec;
collection_item_codec: Codec.WidgetAppSharedItemCodec;
collection_invitation_codec: Codec.WidgetAppInvitationCodec;
collection_ready: bool;
collection_loading: CollectionLoading;
collection_pictures_missing: bool;
collection_leave_to_library: bool;
// Whether games download new levels when they come out: asked once on the
// covers and passed to the games as arcade.updates. -1 unread, 0 off, 1 on,
// 2 not answered yet.
collection_updates: s32 = -1;

CollectionTouchFirst :: () -> bool {
    #if #defined(PLATFORM_DESKTOP) {
        return false
    }
    return true
}

CollectionRecordsFor :: (id: string) -> *CollectionRecords {
    saved := collection_records
    while saved != null {
        if saved.id == id { return saved }
        saved = saved.next
    }
    saved = New(CollectionRecords)
    if saved == null { return null }
    id_bytes: Vec(u8)
    BuilderPrint(*id_bytes, "%", id)
    saved.id = BuilderFinish(id_bytes)
    games := Join(collection_directory, "games")
    game := Join(games, id)
    saved.root = Join(game, "records")
    AppFileFree(games)
    AppFileFree(game)
    opened := AppFilesOpen(*saved.files, saved.root)
    if !opened {
        AppFileFree(saved.root)
        AppFileFree(saved.id)
        CollectionFree(cast(*void)saved)
        return null
    }
    saved.next = collection_records
    collection_records = saved
    return saved
}

// The cover wallet uses the game's existing state and exact record namespace.
// These native bindings never read the collection's records as game money.
#program_export
AppRecordHost :: (name: string) -> string {
    saved := CollectionRecordsFor("arcade.shovey")
    if saved == null || !AppFileNameValid(name) { return "" }
    AppFileFree(collection_wallet_record)
    collection_wallet_record = AppFileRead(*saved.files, name)
    return collection_wallet_record
}
#program_export
SaveAppRecordHost :: (name: string, text: string) -> bool {
    saved := CollectionRecordsFor("arcade.shovey")
    return saved != null && AppFileNameValid(name) && AppFileWrite(*saved.files, name, text)
}
#program_export
AppServiceHost :: (name: string, request: string) -> string {
    if name == "entity.records" { return EntityRecordsAnswer(request) }
    if name == "leaderboard" {
        saved := EntityLeaderboardReport("arcade", "Arcade", "arcade.shovey", "Shovey", request)
        return ifx saved then "{\"status\":\"saved\"}" else "{\"status\":\"rejected\"}"
    }
    if name == "entity.dew" { return CollectionDewAnswer(request) }
    if name == "entity.game-shop" { return CollectionShopAnswer(request) }
    if name == "arcade.progress-storage" {
        saved := CollectionRecordsFor("arcade.shovey")
        return PlayerProgressStorage(ifx saved == null then null else *saved.files, request)
    }
    return ""
}
#program_export
AppSupportsHost :: (name: string) -> bool { return false }
#program_export
AppLocaleHost :: (key: string) -> string { return CollectionLocaleText(key) }

CollectionAllows :: (context: *void, node: *AppNode, name: string) -> bool {
    if name == "kryon.notification.schedule" {
        return ChestReminderSlotAllowed(AppTreeNode(*collection_host.tree, AppHandle.{0, 1}),
            AppTreeNode(*collection_host.tree, collection_host.tree.active), node)
    }
    if name == "shovey.island.owned" { return collection_island.owned }
    return name == "shovey.standalone" || name == "AppRecordHost" || name == "SaveAppRecordHost" ||
    name == "AppFriendHost" || name == "AppSharedHost" || name == "AppSharedItemHost" ||
    name == "AppInvitationHost" || name == "RefreshAppSharedHost" || name == "SendAppSharedHost" ||
    name == "SmoothFramesHost" || name == "AppLocaleHost" || name == "AppSoundHost" ||
    name == "tile_map.sampling" || name == "arcade.controls" || name == "arcade.sound" || name == "arcade.navigation" ||
    name == "arcade.updates" || name == "arcade.progress-storage" ||
    name == PUBLICATIONS_READ_SERVICE || name == ENTITY_RECORDS_SERVICE || name == ENTITY_DEW_SERVICE ||
    name == "entity.game-shop" || name == "entity.profile" || name == "leaderboard"
}

CollectionFocused :: (context: *void, node: *AppNode) -> bool {
    unused context
    foreground := false
    #if !#defined(PLATFORM_WEB) {
        #if #defined(ANDROID_BUILD) || #defined(_WIN32) {
            foreground = ReminderWindow.RaylibFocused()
        } else {
            foreground = ReminderWindow.WindowFocusedHost()
        }
    }
    return ChestReminderSlotFocused(AppTreeNode(*collection_host.tree, AppHandle.{0, 1}),
        AppTreeNode(*collection_host.tree, collection_host.tree.active), node,
        foreground, entity_visible, collection_island_page)
}

CollectionCall :: (context: *void, node: *AppNode, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    name := TextFromCString(function)
    if name == "AppRecordHost" && count == 1 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        record := AppArgumentText(arguments[0])
        saved := CollectionRecordsFor(TextUntilNul(node.identity.id[:]))
        if saved == null || !AppFileNameValid(record) || record.count >= 256 { return 0 }
        AppFileFree(saved.text)
        saved.text = AppFileRead(*saved.files, record)
        if saved.files.status == -1 || saved.text.count >= 65536 { return 0 }
        result.* = AppHostText(saved.text)
        return 1
    }
    if name == "SaveAppRecordHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostString) {
        record := AppArgumentText(arguments[0])
        text := AppArgumentText(arguments[1])
        saved := CollectionRecordsFor(TextUntilNul(node.identity.id[:]))
        ok := saved != null && AppFileNameValid(record) && record.count < 256 &&
        text.count < 65536 && AppFileWrite(*saved.files, record, text)
        result.* = HostScalar("bool", ifx ok then 1 else 0)
        return 1
    }
    // A game plays only its own verified packed sounds.
    if name == "AppSoundHost" && count == 1 && HostScalarValid(arguments[0], "string", cast(s32)HostString) {
        asset := AppHostAsset(node, AppArgumentText(arguments[0]))
        result.* = HostScalar("bool", ifx asset.found && SoundPlay(asset.data) then 1 else 0)
        return 1
    }
    if name == "SmoothFramesHost" && count == 1 {
        result.* = HostScalar("bool", 1)
        return 1
    }
    if name == "AppServiceHost" && count == 2 &&
    HostScalarValid(arguments[0], "string", cast(s32)HostString) &&
    HostScalarValid(arguments[1], "string", cast(s32)HostString) {
        service := AppArgumentText(arguments[0])
        request := AppArgumentText(arguments[1])
        if service == "arcade.progress-storage" {
            saved := CollectionRecordsFor(TextUntilNul(node.identity.id[:]))
            result.* = AppHostText(PlayerProgressStorage(ifx saved == null then null else *saved.files, request))
            return 1
        }
        if service == "leaderboard" {
            saved := EntityLeaderboardReport("arcade", "Arcade", TextUntilNul(node.identity.id[:]),
                TextUntilNul(node.entry.title[:]), request)
            result.* = AppHostText(ifx saved then "{\"status\":\"saved\"}" else "{\"status\":\"rejected\"}")
            return 1
        }
        // Public level collections, such as a game's live campaign.
        if service == PUBLICATIONS_READ_SERVICE {
            result.* = AppHostText(PublicationsReadAnswer(request))
            return 1
        }
        // The account's own records, such as level drafts, kept and synced
        // by the outer native app's Entity host.
        if service == ENTITY_RECORDS_SERVICE {
            result.* = AppHostText(EntityRecordsAnswer(request))
            return 1
        }
        // The account's Dew to show and rewards a game claims from the node.
        if service == ENTITY_DEW_SERVICE {
            result.* = AppHostText(CollectionDewAnswer(request))
            return 1
        }
        if service == "entity.game-shop" {
            result.* = AppHostText(CollectionShopAnswer(request))
            return 1
        }
        if service == "entity.profile" {
            result.* = AppHostText(ifx EntityShowPage(request) then "queued" else "unavailable")
            return 1
        }
        // A game leaves for the cover that opened it after its frame.
        if service == "arcade.navigation" && request == "island-caption" {
            caption: [128]u8
            result.* = AppHostText(IslandUnlockCaption(*collection_island, caption[:]))
            return 1
        }
        // The title's Island action carries the price; its caption keeps the offer.
        if service == "arcade.navigation" && request == "island-unlock" {
            label: [128]u8
            result.* = AppHostText(ifx collection_island.owned then "" else IslandUnlockLabel(*collection_island, label[:]))
            return 1
        }
        // A locked Island is not the title's add-on, so the host shows its
        // unlock page directly; buying still needs the node's quote.
        if service == "arcade.navigation" && request == "island" {
            if collection_island.owned {
                collection_island_opening = true
                result.* = AppHostText("queued")
                return 1
            }
            CollectionIslandShow()
            result.* = AppHostText("queued")
            return 1
        }
        // The Editor's Island levels open after this frame, or the unlock page
        // first while Island is locked.
        if service == "arcade.navigation" && request == "island-editor" {
            if CollectionIslandEntry() == null || TextUntilNul(node.identity.id[:]) != SHOVEY_EDITOR_APP {
                result.* = AppHostText("unavailable")
                return 1
            }
            if !collection_island.owned {
                CollectionIslandShow()
                collection_island_unlock_for_editor = true
            } else { collection_island_editor = ISLAND_EDITOR_ASKED }
            result.* = AppHostText("queued")
            return 1
        }
        // The Editor's start asks once whether a locked Island is unlocked
        // now, as opening the unlock page does: the ledger is read again.
        if service == "arcade.navigation" && request == "island-refresh" {
            if !collection_island.owned && !collection_island_page { IslandUnlockOpen(*collection_island) }
            result.* = AppHostText("queued")
            return 1
        }
        // The Editor's Levels count an owner's own Island levels, which
        // Island's editor keeps in its index record, one line per level.
        if service == "arcade.navigation" && request == "island-levels" {
            if TextUntilNul(node.identity.id[:]) != SHOVEY_EDITOR_APP || !collection_island.owned {
                result.* = AppHostText("0")
                return 1
            }
            levels := CollectionIslandLevels()
            count: [24]u8
            text: Vec(u8)
            BuilderPrint(*text, "%", levels)
            unused CopyCString(TextView(VecSlice(text, 0, text.count)), count[:])
            VecFree(text)
            result.* = AppHostText(TextUntilNul(count[:]))
            return 1
        }
        // Island asks each frame whether it runs as the players' editor.
        if service == "arcade.navigation" && request == "island-mode" {
            editor := TextUntilNul(node.identity.id[:]) == ISLAND_UNLOCK_APP && collection_island.owned &&
                collection_island_editor >= ISLAND_EDITOR_OPENING
            result.* = AppHostText(ifx editor then "editor" else "play")
            return 1
        }
        if service == "arcade.navigation" && request == "island-offer" {
            result.* = AppHostText(ifx !collection_island.owned && IslandOffer(*collection_island) then AppLocaleHost("shovey_island_off") else "")
            return 1
        }
        if service == "arcade.navigation" && request == "back" {
            collection_leave_to_library = true
            result.* = AppHostText("queued")
            return 1
        }
        if service == "arcade.sound" {
            saved := CollectionRecordsFor("arcade.shovey-player")
            if saved == null { return 0 }
            if request == "get" {
                AppFileFree(saved.text)
                saved.text = AppFileRead(*saved.files, "sound")
                muted := saved.text == "muted"
                SoundSetMuted(muted)
                result.* = AppHostText(ifx muted then "muted" else "on")
                return 1
            }
            value := ifx request == "mute" then "muted" else ifx request == "unmute" then "on" else ""
            if value == "" || !AppFileWrite(*saved.files, "sound", value) { return 0 }
            SoundSetMuted(value == "muted")
            result.* = AppHostText(value)
            return 1
        }
        if service == "arcade.updates" {
            if request == "get" {
                updates := CollectionUpdates()
                result.* = AppHostText(ifx updates == 1 then "on" else ifx updates == 0 then "off" else "unset")
                return 1
            }
            if (request != "set-on" && request != "set-off") || !CollectionUpdatesSet(request == "set-on") { return 0 }
            result.* = AppHostText(request[4:])
            return 1
        }
        if service != "arcade.controls" { return 0 }
        saved := CollectionRecordsFor("arcade.shovey-player")
        if saved == null { return 0 }
        if request == "mode" {
            mode := ifx CollectionTouchFirst() then "touch" else "desktop"
            result.* = AppHostText(mode)
            return 1
        }
        if request == "get" {
            AppFileFree(saved.text)
            saved.text = AppFileRead(*saved.files, "controls")
            value := ifx saved.text == "on" || saved.text == "off" then saved.text else "auto"
            result.* = AppHostText(value)
            return 1
        }
        value := ""
        if request == "set-auto" { value = "auto" }
        if request == "set-on" { value = "on" }
        if request == "set-off" { value = "off" }
        if value == "" || !AppFileWrite(*saved.files, "controls", value) { return 0 }
        result.* = AppHostText(value)
        return 1
    }
    if name == "AppLocaleHost" && count == 1 {
        result.* = AppHostText(AppArgumentText(arguments[0]))
        return 1
    }
    if name == "AppFriendHost" && count == 1 {
        result.* = Codec.WidgetEncodeAppPerson(Node.AppPerson.{}, *collection_person_codec)
        return 1
    }
    if name == "AppSharedHost" && count == 1 {
        result.* = Codec.WidgetEncodeAppShared(Node.AppShared.{}, *collection_shared_codec)
        return 1
    }
    if name == "AppSharedItemHost" && count == 2 {
        result.* = Codec.WidgetEncodeAppSharedItem(Node.AppSharedItem.{}, *collection_item_codec)
        return 1
    }
    if name == "AppInvitationHost" && count == 1 {
        result.* = Codec.WidgetEncodeAppInvitation(Node.AppInvitation.{}, *collection_invitation_codec)
        return 1
    }
    if (name == "RefreshAppSharedHost" && count == 0) ||
    (name == "SendAppSharedHost" && count == 2) {
        result.* = HostScalar("bool", 0)
        return 1
    }
    return 0
}

CollectionAssetAllowed :: (path: string) -> bool {
    return path == "" || (collection_widget_node != null && (AppHostAsset(collection_widget_node, path).found ||
        AppHostAssetPending(collection_widget_node, path)))
}

CollectionAssetPath :: (path: string) -> string {
    if path == "" { return "" }
    if collection_widget_node == null { return "" }
    asset := AppHostAsset(collection_widget_node, path)
    if !asset.found { collection_pictures_missing = true; return "" }
    relative := Join(TextUntilNul(collection_widget_node.entry.sha256[:]), path)
    defer { AppFileFree(relative) }
    cached := collection_images
    while cached != null {
        if cached.packed == relative { break }
        cached = cached.next
    }
    if cached == null {
        cached = New(CollectionImage)
        if cached == null { return "" }
        if !AppFileWrite(*collection_resources, relative, asset.data) {
            CollectionFree(cast(*void)cached)
            return ""
        }
        copy: Vec(u8)
        BuilderPrint(*copy, "%", relative)
        cached.packed = BuilderFinish(copy)
        cached.next = collection_images
        collection_images = cached
    }
    // Own this queued path through paint, independently of mutable cache links.
    absolute := Join(collection_resources.root, relative)
    if !VecPush(collection_frame_paths, absolute) { AppFileFree(absolute); return "" }
    return absolute
}

CollectionWidgets :: (context: *void, node: *AppNode, module: *u8, function: *u8,
    arguments: *HostValue, count: s32, result: *HostValue) -> s32 {
    collection_widget_node = node
    return WidgetHostCall(context, module, function, arguments, count, result)
}

// Check the same saved install state and verified download plan as Apps.
// A cached payload or an old score alone is never installed membership.
CollectionLeaderboardInstalled :: (game: string) -> bool {
    if !collection_ready { return false }
    for slot: cast(s64)0..collection_host.tree.nodes.count - 1 {
        parent := collection_host.tree.nodes[slot].node
        if parent == null || !parent.collection { continue }
        index := AppCatalogFind(*parent.catalog, game)
        if index < 0 { continue }
        entry := AppCatalogAt(*parent.catalog, index)
        identity := AppIdentity.{.authority = parent.identity.authority, .id = entry.id}
        state: AppState
        plan: AppInstallPlan
        if CollectionState(null, "local", *identity, *state) && state.installed &&
        AppHostInstallPlan(*collection_host, parent, entry, *plan) && plan.count == 0 {
            return true
        }
    }
    return false
}

CollectionSave :: (context: *void, node: *AppNode) -> bool {
    saved := collection_records
    while saved != null {
        if saved.files.status == -1 { return false }
        saved = saved.next
    }
    return true
}

CollectionState :: (context: *void, account: string, identity: *AppIdentity, state: *AppState) -> bool {
    if account != "local" || TextUntilNul(identity.authority[:]) != "arcade.local" ||
    !Rules.AppIdValid(TextUntilNul(identity.id[:])) { return false }
    // Native control records live outside every guest's game-record root and
    // outside the digest-prefixed image cache. Bundled bytes/saves are retained.
    path := CollectionStatePath(identity)
    defer { AppFileFree(path) }
    text := AppFileRead(*collection_resources, path)
    defer { AppFileFree(text) }
    state.* = AppState.{.installed = true, .actions_known = true,
        .actions = (cast(u64)1 << APPS_OPEN) | (cast(u64)1 << APPS_INSTALL) |
        (cast(u64)1 << APPS_UNINSTALL) | (cast(u64)1 << APPS_PIN) | (cast(u64)1 << APPS_UNPIN)}
    if text == "" { return true }
    fields: [3]string = .["v", "installed", "favorite"]
    installed := ReadNumber(text, FieldAt(text, 0, "installed"))
    favorite := ReadNumber(text, FieldAt(text, 0, "favorite"))
    if !AppsObjectValid(text, 0, fields[:]) || Space(text, ValueEnd(text, 0, 0)) != text.count ||
    ReadNumber(text, FieldAt(text, 0, "v")).value != 1.0 ||
    !installed.valid || !favorite.valid ||
    (installed.value != 0.0 && installed.value != 1.0) ||
    (favorite.value != 0.0 && favorite.value != 1.0) ||
    (favorite.value == 1.0 && installed.value != 1.0) { return false }
    state.installed = installed.value == 1.0
    state.favorite = favorite.value == 1.0
    return true
}

CollectionStatePath :: (identity: *AppIdentity) -> string {
    bytes: Vec(u8)
    BuilderPrint(*bytes, "state/%.json", TextUntilNul(identity.id[:]))
    return BuilderFinish(bytes)
}

CollectionEffect :: (context: *void, account: string, locator: *AppLocator,
    operation: s32, reply: *AppsReply) -> bool {
    state: AppState
    if !CollectionState(context, account, *locator.identity, *state) { return false }
    if operation == APPS_INSTALL { state.installed = true }
    else if operation == APPS_UNINSTALL { state.installed = false; state.favorite = false }
    else if operation == APPS_PIN && state.installed { state.favorite = true }
    else if operation == APPS_UNPIN { state.favorite = false }
    else { return false }
    path := CollectionStatePath(*locator.identity)
    defer { AppFileFree(path) }
    bytes: Vec(u8)
    BuilderPrint(*bytes, "{\"v\":1,\"installed\":%,\"favorite\":%}",
        ifx state.installed then 1 else 0, ifx state.favorite then 1 else 0)
    text := BuilderFinish(bytes)
    defer { AppFileFree(text) }
    if !AppFileWrite(*collection_resources, path, text) { return false }
    reply.status = APPS_APPLIED
    return true
}

// The player needs only the collection's payload and metadata. Its stable
// identity and record folders are those Arcade's standalone Shovey used.
CollectionOpenShovey :: (directory: string, data: string) -> bool {
    if collection_ready { return false }
    CollectionBundleDirectory(directory)
    payload_path := Join(directory, "shovey.zx")
    metadata_path := Join(directory, "shovey.json")
    defer { AppFileFree(payload_path); AppFileFree(metadata_path) }
    bytes, found := ReadEntireFile(payload_path)
    metadata, metadata_found := ReadEntireFile(metadata_path)
    defer { AppFileFree(bytes); AppFileFree(metadata) }
    return found && metadata_found && CollectionOpenShoveyBytes(bytes, metadata, data)
}

CollectionBundleDirectory :: (directory: string) {
    if collection_bundle_root_owned { AppFileFree(collection_bundle_root) }
    collection_bundle_root = Join(directory, "games")
    collection_bundle_root_owned = true
}

CollectionOpenShoveyBytes :: (bytes: string, metadata: string, data: string) -> bool {
    if collection_ready { return false }
    leaderboard_installed = CollectionLeaderboardInstalled
    id: [128]u8
    digest: [65]u8
    harness: [65]u8
    if bytes.count > 67108864 || metadata.count > 65536 ||
    !AppsReadText(metadata, 0, "id", id[:]) || TextUntilNul(id[:]) != "arcade.shovey-player" ||
    !AppsReadText(metadata, 0, "sha256", digest[:]) ||
    !AppsReadText(metadata, 0, "apps_sha256", harness[:]) { return false }
    collection_directory = data
    collection_resource_root = Join(data, "resources")
    if !AppFilesOpen(*collection_resources, collection_resource_root) { return false }
    locale := EnvironmentText("LANG")
    language := ifx locale.count >= 2 then locale[:2] else "en"
    platform := AppPlatform.{.allows = CollectionAllows, .call = CollectionCall, .focused = CollectionFocused,
        .widgets = CollectionWidgets, .save = CollectionSave, .state = CollectionState,
        .effect = CollectionEffect, .open_effect = CollectionOpenEffect,
        .bundle = CollectionPackageBundle, .download = CollectionPackageDownload,
        .fetch = CollectionPackageFetch, .host_api = PLAYER_HOST_API}
    collection_island_package.service = EntityGameShopAnswer
    collection_island_package.start = HttpTransferStart
    collection_island_package.poll = HttpTransferPollLength
    collection_island_package.stop = HttpTransferCancel
    collection_island_package.files = *collection_resources
    collection_ready = AppHostStart(*collection_host, bytes, "arcade.local", "arcade.shovey-player",
        "shovey", TextUntilNul(digest[:]), "local", platform, TextUntilNul(harness[:]), language)
    if collection_ready {
        entity_locale_text = CollectionLocaleText
        EntityReferralHost.EntityHostReferralsLocale(TextUntilNul(collection_host.locale[:]))
        root := AppTreeNode(*collection_host.tree, AppHandle.{0, 1})
        collection_island_package.included = AppHostAsset(root, "assets/paid/shovey-island.zx")
        included := collection_island_package.included
        island := CollectionIslandEntry()
        if included.found && IslandPackageMatches(island, included.data) {
            // The root already accounts for these inert packaged bytes. Keep
            // the same bounded working allowance for Classic and the Editor
            // that the collection had before including Island. This grants
            // no access to Island; its entitlement gate still owns that.
            collection_host.tree.byte_limit += included.data.count
            collection_island_package.included_digest = island.sha256
        }
    }
    return collection_ready
}

// Steps back from a game to its library, as Android's Back key does. At the
// library it is unused, so the app closes.
CollectionBack :: () -> bool {
    if EntityBack() { return true }
    if collection_island_page { collection_island_page = false; collection_island_unlock_for_editor = false; return true }
    return AppHostBack(*collection_host) > 0
}

CollectionCollect :: () {
    if entity_ready { EntityPump() }
    PublicationsReadPump()
    AppHostCollect(*collection_host)
    for path: collection_frame_paths { AppFileFree(path) }
    while collection_frame_paths.count > 0 { unused VecPop(collection_frame_paths) }
    collection_widget_node = null
}

CollectionClose :: () -> bool {
    if !EntityClose() { return false }
    if collection_ready && !AppHostStop(*collection_host) { return false }
    if collection_host.retired != null { return false }
    CollectionLocalBundleFree(collection_classic_bytes)
    CollectionLocalBundleFree(collection_editor_bytes)
    collection_classic_bytes = ""
    collection_editor_bytes = ""
    if collection_bundle_root_owned { AppFileFree(collection_bundle_root) }
    collection_bundle_root = "games"
    collection_bundle_root_owned = false
    IslandPackageClose(*collection_island_package)
    collection_ready = false
    AppFileFree(collection_wallet_record)
    collection_wallet_record = ""
    collection_loading = .{}
    CollectionCollect()
    VecFree(collection_frame_paths)
    while collection_images != null {
        image := collection_images
        collection_images = image.next
        AppFileFree(image.packed)
        AppFileFree(image.absolute)
        CollectionFree(cast(*void)image)
    }
    while collection_records != null {
        saved := collection_records
        collection_records = saved.next
        AppFilesClose(*saved.files)
        AppFileFree(saved.root)
        AppFileFree(saved.text)
        AppFileFree(saved.id)
        CollectionFree(cast(*void)saved)
    }
    AppFilesClose(*collection_resources)
    AppFileFree(collection_resource_root)
    collection_resource_root = ""
    return true
}

CollectionPending :: (request: s64) -> bool {
    for index: cast(s64)0..collection_host.tree.pending.count - 1 {
        pending := collection_host.tree.pending[index]
        if pending.reply.request == request { return !pending.complete }
    }
    return false
}

CollectionOpenGame :: (id: string) -> bool {
    root := AppTreeNode(*collection_host.tree, collection_host.tree.active)
    if root == null || !root.collection { Report("Shovey: no collection is open to start "); Report(id); Report("\n"); return false }
    if id == ISLAND_UNLOCK_APP && !collection_island.owned { CollectionIslandShow(); return true }
    entry := AppCatalogAt(*root.catalog, AppCatalogFind(*root.catalog, id))
    plan: AppInstallPlan
    if entry != null && (TextUntilNul(entry.cover.action[:]) == "title" ||
        (AppHostInstallPlan(*collection_host, root, entry, *plan) && plan.count > 0)) {
        unused CopyCString(id, collection_host.platform.presentation.download_id[:])
        collection_host.platform.presentation.download_request += 1
        return true
    }
    request: AppsRequest
    request.operation = APPS_OPEN
    if !CopyCString(id, request.id[:]) { return false }
    queued := AppTreeQueue(*collection_host.tree, collection_host.tree.active, request)
    if queued.status != APPS_QUEUED {
        Report("Shovey: could not queue "); Report(id); Report(": "); Report(TextUntilNul(queued.reason[:])); Report("\n")
        return false
    }
    if !AppTreeDrain(*collection_host.tree) { Report("Shovey: the apps host stopped while starting "); Report(id); Report("\n"); return false }
    // Games that share code are verified in the background; wait for it.
    started := MonotonicMilliseconds()
    while CollectionPending(queued.request) && MonotonicMilliseconds() - started < 60000 {
        unused SleepMilliseconds(5)
        if !AppTreeDrain(*collection_host.tree) { Report("Shovey: the apps host stopped while starting "); Report(id); Report("\n"); return false }
    }
    for index: cast(s64)0..collection_host.tree.pending.count - 1 {
        reply := collection_host.tree.pending[index].reply
        if reply.request == queued.request && reply.status == APPS_REJECTED {
            Report("Shovey: could not open "); Report(id); Report(": "); Report(TextUntilNul(reply.reason[:])); Report("\n")
            return false
        }
    }
    runtime := AppHostActiveRuntime(*collection_host)
    if runtime == null || TextUntilNul(runtime.node.identity.id[:]) != id {
        Report("Shovey: "); Report(id); Report(" did not start\n")
        return false
    }
    if !AppHostRoute(*collection_host) { Report("Shovey: "); Report(id); Report(" could not be shown\n"); return false }
    return true
}

collection_typed: [1024]u8;
collection_pasted: [16384]u8;

// The answer kept with the other game settings. Shovey Classic asked in its
// first level before, and its answer counts until the covers ask.
CollectionUpdates :: () -> s32 {
    if collection_updates >= 0 { return collection_updates }
    collection_updates = 2
    ids: [2]string = .["arcade.shovey-player", "arcade.shovey"]
    for id: ids {
        saved := CollectionRecordsFor(id)
        if saved == null { continue }
        AppFileFree(saved.text)
        saved.text = AppFileRead(*saved.files, "level-updates")
        if saved.text == "on" || saved.text == "off" {
            collection_updates = ifx saved.text == "on" then 1 else 0
            break
        }
    }
    return collection_updates
}

CollectionUpdatesSet :: (on: bool) -> bool {
    saved := CollectionRecordsFor("arcade.shovey-player")
    if saved == null || !AppFileWrite(*saved.files, "level-updates", ifx on then "on" else "off") { return false }
    collection_updates = ifx on then 1 else 0
    return true
}

// Asked once over the covers, before a game opens; nothing behind it takes
// input until it is answered.
CollectionUpdatesQuestion :: (session: Session, viewport: Rectangle) {
    question := "Download new levels when they come out?"
    Box(session, BoxProps.{.key = cast(u64)49300, .bounds = viewport, .fill = Color.{0, 0, 0, 160}})
    unused Button(session, ButtonProps.{.key = cast(u64)49301, .id = 49301, .label = question,
            .bounds = viewport, .invisible = true})
    width := ifx viewport.width - 24.0 < 480.0 then viewport.width - 24.0 else 480.0
    height: float32 = 200.0
    x := viewport.x + (viewport.width - width) / 2.0
    y := viewport.y + (viewport.height - height) / 2.0
    Box(session, BoxProps.{.key = cast(u64)49302, .bounds = Rectangle.{x, y, width, height},
            .fill = Color.{59, 64, 63, 255}, .border = Color.{93, 98, 97, 255}, .radius = 18.0})
    Text(session, TextProps.{.key = cast(u64)49303, .text = question, .font = 20, .wrap = TextWrap.TextWrapAuto,
            .bounds = Rectangle.{x + 16.0, y + 16.0, width - 32.0, 60.0}})
    Text(session, TextProps.{.key = cast(u64)49304, .text = "You can change this anytime in a game's Help.", .font = 14,
            .wrap = TextWrap.TextWrapAuto, .bounds = Rectangle.{x + 16.0, y + 80.0, width - 32.0, 44.0}})
    button_width := (width - 48.0 - 12.0) / 2.0
    if Button(session, ButtonProps.{.key = cast(u64)49305, .id = 49305, .label = "Not now",
            .bounds = Rectangle.{x + 24.0, y + 136.0, button_width, 44.0},
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        unused CollectionUpdatesSet(false)
    }
    if Button(session, ButtonProps.{.key = cast(u64)49306, .id = 49306, .label = "Download",
            .bounds = Rectangle.{x + 36.0 + button_width, y + 136.0, button_width, 44.0},
            .tone = ButtonTone.ButtonToneAccent}) != 0 {
        unused CollectionUpdatesSet(true)
    }
}

// Whether the node now running is id.
CollectionActiveIs :: (id: string) -> bool {
    node := AppTreeNode(*collection_host.tree, collection_host.tree.active)
    return node != null && TextUntilNul(node.identity.id[:]) == id
}

// The Editor's Island levels. Island is the collection's own game, so the
// Editor goes home to the collection, which opens Island in editor mode as it
// does after an unlock; when Island closes, the title opens the Editor again.
CollectionIslandEditorStep :: () {
    tree := *collection_host.tree
    if collection_island_editor == ISLAND_EDITOR_NONE || tree.busy || tree.draining { return }
    if collection_island_editor == ISLAND_EDITOR_ASKED {
        collection_island_editor = ISLAND_EDITOR_NONE
        if !collection_island.owned || !CollectionActiveIs(SHOVEY_EDITOR_APP) { return }
        // Home saves the Editor and the title on the way, as Back does.
        if !AppHostHome(*collection_host) { return }
        collection_island_editor = ISLAND_EDITOR_OPENING
        if !CollectionOpenGame(ISLAND_UNLOCK_APP) { Report("Shovey: could not open the Island editor\n") }
    }
    if CollectionActiveIs(ISLAND_UNLOCK_APP) { collection_island_editor = ISLAND_EDITOR_OPEN; return }
    // Island still downloading opens in editor mode once it is there.
    if collection_island_editor == ISLAND_EDITOR_OPENING && collection_host.platform.presentation.download_id[0] != 0 { return }
    // Back from Island, or Island refused: the title, then its Editor.
    collection_island_editor = ISLAND_EDITOR_NONE
    node := AppTreeNode(tree, tree.active)
    if node != null && node.collection && !CollectionOpenGame("arcade.shovey") { return }
    if CollectionActiveIs("arcade.shovey") {
        unused AppTreeQueueAddon(tree, tree.active, SHOVEY_EDITOR_APP)
        unused AppTreeDrain(tree)
    }
}

CollectionFrame :: (session: Session, viewport: Rectangle, key: s32, modifiers: s32) -> bool {
    CollectionShopNavigate()
    CollectionIslandPump()
    CollectionIslandEditorStep()
    // A refused save cannot resume another account's already loaded package.
    if collection_island_blocked {
        Box(session, BoxProps.{.key = cast(u64)49400, .bounds = viewport,
            .fill = Color.{42, 46, 45, 255}})
        return true
    }
    if collection_island_opening {
        collection_island_opening = false
        // The cover belongs to Classic. Save it and return to its collection
        // before opening the sibling Island app, as the Editor route does.
        if AppHostHome(*collection_host) { unused CollectionOpenGame(ISLAND_UNLOCK_APP) }
    }
    if entity_visible { return EntityFrame(session, viewport, key, modifiers) }
    if collection_island_page { CollectionIslandFrame(session, viewport); return true }
    runtime := AppHostActiveRuntime(*collection_host)
    if runtime == null { Report("Shovey: no app is running\n"); return false }
    if runtime.node.collection && collection_host.platform.presentation.download_id[0] == 0 {
        // The title belongs to the game, including its carousel and wallet.
        // A retained collection still owns sibling navigation and installation.
        if !CollectionOpenGame("arcade.shovey") { return false }
        return true
    }
    opening := !runtime.node.collection && (!collection_loading.shown ||
        collection_loading.slot != collection_host.tree.active.slot ||
        collection_loading.generation != collection_host.tree.active.generation)
    if opening { key = 0 }
    nested := runtime.node.parent.generation != 0 && !runtime.node.collection
    // An app opened from its cover fills the screen with its own navigation.
    // Other apps get a bar with Back and their title; the library and that
    // bar keep Profile at the top right.
    covered := runtime.node.entry.cover.portrait[0] != 0
    // The covers ask about new levels once; the question takes every key.
    asking := !collection_host.platform.presentation.cover_grid && CollectionUpdates() == 2 &&
        (runtime.node.collection || TextUntilNul(runtime.node.identity.id[:]) == "arcade.shovey")
    // Small cover branding sits below the wallet and account actions.
    collection_host.platform.presentation.cover_logo_width = ifx viewport.width < 600.0 then viewport.width * 0.58 else 360.0
    collection_host.platform.presentation.cover_logo_top = 120.0
    if asking { key = 0 }
    top: s32 = ifx !covered && !runtime.node.collection && (entity_ready || nested) then 56 else 0
    now := cast(float64)MonotonicMilliseconds() / 1000.0
    runtime.app.session = session
    runtime.app.bounds = Rectangle.{viewport.x, viewport.y + cast(float32)top, viewport.width, viewport.height - cast(float32)top}
    runtime.app.scale = 1.0
    runtime.app.font = 16
    runtime.app.key = key
    runtime.app.modifiers = modifiers
    // A focused text field in the game edits with what was typed this frame,
    // as a native Kryon field does: text, editing keys and paste.
    typed := TypedTextTake(session, collection_typed[:])
    runtime.app.input = TextFieldInputFor(key, modifiers, typed)
    runtime.app.area_input = TextAreaInputFor(key, modifiers, typed)
    if runtime.app.input.paste {
        pasted := SystemClipboardText(collection_pasted[:])
        runtime.app.input.paste_text = pasted
        runtime.app.area_input.paste_text = pasted
    }
    if runtime.protocol == APPS_NODE_PROTOCOL {
        runtime.legacy.message = Node.AppMessage.{.locale = TextUntilNul(collection_host.locale[:]),
            .shared_status = Node.APP_SHARED_UNAVAILABLE, .time = UnixNow()}
        runtime.legacy.frame = Node.AppUiFrame.{.session = session,
            .width = cast(s32)(viewport.x + viewport.width), .height = cast(s32)(viewport.y + viewport.height),
            .top = cast(s32)viewport.y + top,
            .scale = 1.0, .font = 16, .now = now}
    }
    WidgetHostBegin(session, CollectionAssetAllowed, CollectionAssetPath)
    collection_pictures_missing = false
    drawn := AppHostRun(*collection_host, APP_FRAME)
    WidgetHostEnd()
    if !drawn {
        Report("collection frame failed\n")
        return false
    }
    if collection_leave_to_library {
        collection_leave_to_library = false
        unused AppHostBack(*collection_host)
        return true
    }
    if opening {
        pictures_ready := !collection_pictures_missing
        // Query every path, including those first requested by this frame's
        // TileMap. Android decodes them asynchronously on its render thread.
        for path: collection_frame_paths {
            if AssetWidth(path) < 0 { pictures_ready = false }
        }
        if CollectionNeedsCover(*collection_loading, collection_host.tree.active.slot,
            collection_host.tree.active.generation, pictures_ready) {
            Box(session, BoxProps.{.key = cast(u64)49400, .bounds = viewport,
                    .fill = ColorFromPacked(ShoveyPalette().background)})
            unused Button(session, ButtonProps.{.key = cast(u64)49401, .id = 49401,
                    .bounds = viewport, .invisible = true})
            LoadingIndicator(session, LoadingIndicatorProps.{.key = cast(u64)49402,
                    .bounds = viewport, .now = now, .scale = 1.5})
            return true
        }
    } else if runtime.node.collection {
        collection_loading = .{}
    }
    if asking {
        unused WidgetPaletteUse(session, ShoveyPalette())
        CollectionUpdatesQuestion(session, viewport)
        unused WidgetPaletteRestore(session)
        return true
    }
    if nested && !covered {
        title_bytes: Vec(u8)
        BuilderPrint(*title_bytes, "%", TextUntilNul(runtime.node.entry.title[:]))
        title := BuilderFinish(title_bytes)
        if !VecPush(collection_frame_paths, title) { AppFileFree(title); return false }
        Box(session, BoxProps.{.key = cast(u64)6, .bounds = Rectangle.{viewport.x, viewport.y, viewport.width, 56.0},
                .fill = Color.{128, 140, 136, 40}})
        if Button(session, ButtonProps.{.key = cast(u64)7, .id = 7, .label = "Back",
                .bounds = Rectangle.{viewport.x + 8.0, viewport.y + 6.0, 76.0, 44.0},
                .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
            unused AppHostBack(*collection_host)
        }
        Text(session, TextProps.{.key = cast(u64)8,
                .text = title, .font = 16,
                .bounds = Rectangle.{viewport.x + 112.0, viewport.y + 20.0, viewport.width - 232.0, 28.0}})
    }
    return true
}

// Download grants belong to the outer player, never a hosted game's service.
CollectionShopAnswer :: (request: string) -> string {
    if request == "shovey.island.grant" || request == "shovey.island.grant.status" { return "" }
    return EntityGameShopAnswer(request)
}
CollectionDewAnswer :: (request: string) -> string {
    if request.count >= 5 && request[:5] == "shop:" { return CollectionShopAnswer(request[5:]) }
    return EntityDewAnswer(request)
}

CollectionPackageEntry :: (parent: *AppNode, entry: *AppEntry) -> bool {
    return parent != null && TextUntilNul(parent.identity.id[:]) == "arcade.shovey-player" &&
        TextUntilNul(parent.identity.authority[:]) == "arcade.local" && IslandPackageEntryValid(entry)
}
CollectionPackageBundle :: (context: *void, parent: *AppNode, entry: *AppEntry) -> HostedAsset {
    if parent != null && TextUntilNul(parent.identity.id[:]) == "arcade.shovey-player" &&
    TextUntilNul(parent.identity.authority[:]) == "arcade.local" && entry != null && entry.protocol == APPS_NODE_PROTOCOL {
        name := TextUntilNul(entry.expected_id[:])
        if TextUntilNul(entry.id[:]) == "arcade.shovey" && name == "shovey" &&
        TextUntilNul(entry.bundle[:]) == "assets/arcade/games/shovey.zx" {
            return CollectionLocalBundle("shovey.zx", *collection_classic_bytes)
        }
        if TextUntilNul(entry.id[:]) == "arcade.shovey-editor" && name == "shovey-editor" &&
        TextUntilNul(entry.bundle[:]) == "assets/arcade/games/shovey-editor.zx" {
            return CollectionLocalBundle("shovey-editor.zx", *collection_editor_bytes)
        }
    }
    if !CollectionPackageEntry(parent, entry) { return HostedAsset.{} }
    return IslandPackageBundle(*collection_island_package, entry)
}

CollectionLocalBundle :: (name: string, cached: *string) -> HostedAsset {
    if cached.* == "" {
        path := Join(collection_bundle_root, name)
        defer { AppFileFree(path) }
        #if #defined(ANDROID_BUILD) || #defined(_WIN32) {
            cached.* = ReadAppAsset(path)
        } else {
            bytes, found := ReadEntireFile(path)
            if found { cached.* = bytes }
        }
    }
    // Like IslandPackageBundle, expose a borrowed view of retained owned bytes.
    asset: HostedAsset
    asset.found = cached.* != ""
    asset.data = TextFromBytes(BytesFromPointer(TransferBytes(cached.*), cast(u64)(cached.*).count))
    return asset
}

CollectionLocalBundleFree :: (bytes: string) {
    #if #defined(ANDROID_BUILD) || #defined(_WIN32) {
        FreeAppAsset(bytes)
    } else {
        AppFileFree(bytes)
    }
}
CollectionPackageDownload :: (context: *void, parent: *AppNode, entry: *AppEntry, download: *AppDownload) -> bool {
    if !CollectionPackageEntry(parent, entry) { return false }
    // Availability describes installed bytes, not the right to execute them.
    // The bundle callback and open effect keep enforcing paid ownership.
    if collection_island_package.included.found { return false }
    IslandPackagePump(*collection_island_package)
    if IslandPackageBundle(*collection_island_package, entry).found { return false }
    download.* = AppDownload.{.bytes = entry.bytes, .progress = -1,
        .downloading = collection_island_package.stage == 1 || collection_island_package.stage == 2,
        .failed = collection_island_package.stage == 4}
    return true
}
CollectionPackageFetch :: (context: *void, account: string, parent: *AppNode,
    entry: *AppEntry, operation: s32, reply: *AppsReply) -> bool {
    if account != "local" || !CollectionPackageEntry(parent, entry) { return false }
    if operation != APPS_INSTALL { return false }
    // Buy successfully opens the locked offer; it does not install or grant it.
    if !collection_island.owned { CollectionIslandShow(); reply.status = APPS_APPLIED; return true }
    ok := IslandPackageFetch(*collection_island_package, entry)
    reply.status = ifx !ok then APPS_REJECTED else ifx collection_island_package.stage == 3 then APPS_APPLIED else APPS_QUEUED
    return true
}

// Shovey Island's public cover, including on a source-only reproducible build.
CollectionIslandEntry :: () -> *AppEntry {
    root := AppTreeNode(*collection_host.tree, AppHandle.{0, 1})
    if root == null || !root.collection { return null }
    at := AppCatalogFind(*root.catalog, ISLAND_UNLOCK_APP)
    return ifx at < 0 then null else AppCatalogAt(*root.catalog, at)
}

// The cover stays reachable while locked; opening it shows the unlock page.
CollectionOpenEffect :: (context: *void, account: string, locator: *AppLocator,
    request: *AppsRequest, reply: *AppsReply) -> s32 {
    if TextUntilNul(locator.identity.id[:]) != ISLAND_UNLOCK_APP || collection_island.owned { return APP_OPEN_DECLARED }
    CollectionIslandShow()
    return APP_OPEN_HANDLED
}

CollectionIslandShow :: () {
    IslandUnlockOpen(*collection_island)
    collection_island_page = true
    collection_island_unlock_for_editor = false
}

// The number of levels in Island editor's own index: a header line, then one
// line per level. A missing or unreadable index counts none.
CollectionIslandLevels :: () -> s64 {
    saved := CollectionRecordsFor(ISLAND_UNLOCK_APP)
    if saved == null { return 0 }
    index := AppFileRead(*saved.files, "island-levels")
    defer { AppFileFree(index) }
    if index.count < 14 || index[:14] != "island-levels " { return 0 }
    lines: s64 = 0
    start: s64 = 0
    while start < index.count {
        end := start
        while end < index.count && index[end] != cast(u8)10 { end += 1 }
        if end > start { lines += 1 }
        start = end + 1
    }
    return ifx lines > 0 then lines - 1 else 0
}

// Reads this owner's saved answer; a missing node or file never blocks play.
CollectionIslandRecord :: () -> *CollectionRecords { return CollectionRecordsFor("arcade.shovey-player") }

// Island's owner is the signed-in Entity account; the collection's own
// account stays "local". The new epoch drops requests, preparations and
// navigation made for the previous owner. The root, the title and the Editor
// keep running under "local", so they keep their add-on navigation and return
// path; Island's nodes stay invalidated.
CollectionKeepLocalNodes :: (previous: s64) {
    tree := *collection_host.tree
    for index: cast(s64)0..tree.nodes.count - 1 {
        node := tree.nodes[index].node
        if node == null || TextUntilNul(node.account[:]) != TextUntilNul(tree.account[:]) ||
        TextUntilNul(node.identity.id[:]) == ISLAND_UNLOCK_APP { continue }
        if node.account_epoch == previous { node.account_epoch = tree.account_epoch }
        if node.return_epoch == previous && TextUntilNul(node.return_target[:]) != ISLAND_UNLOCK_APP {
            node.return_epoch = tree.account_epoch
        }
    }
}

CollectionPackageAccount :: () {
    IslandPackagePump(*collection_island_package)
    if TextUntilNul(collection_island_account[:]) != TextUntilNul(collection_island_package.owner[:]) {
        collection_island_account = collection_island_package.owner
        // Invalidate work prepared under the previous account before any frame.
        AppHostCancelChild(*collection_host)
        AppHostCancelLocator(*collection_host)
        collection_host.tree.account_epoch += 1
        CollectionKeepLocalNodes(collection_host.tree.account_epoch - 1)
        runtime := AppHostActiveRuntime(*collection_host)
        if runtime != null && TextUntilNul(runtime.node.identity.id[:]) == ISLAND_UNLOCK_APP {
            collection_island_blocked = true
        }
        collection_island = .{}
        collection_island_poll = 0.0
    }
    if collection_island_blocked {
        runtime := AppHostActiveRuntime(*collection_host)
        if runtime != null && TextUntilNul(runtime.node.identity.id[:]) == ISLAND_UNLOCK_APP {
            // Queue the host's Back directly; a guest's Back handler cannot
            // consume it and keep the old account's package running.
            unused AppTreeQueue(*collection_host.tree, collection_host.tree.active, AppsRequest.{.operation = APPS_BACK})
            unused AppTreeDrain(*collection_host.tree)
            runtime = AppHostActiveRuntime(*collection_host)
        }
        collection_island_blocked = runtime != null && TextUntilNul(runtime.node.identity.id[:]) == ISLAND_UNLOCK_APP
    }
}

CollectionIslandPump :: () {
    entry := CollectionIslandEntry()
    if entry == null { return }
    CollectionPackageAccount()
    if entity_ready {
        now := cast(float64)MonotonicMilliseconds() / 1000.0
        request := IslandUnlockNext(*collection_island, now)
        waiting := collection_island.stage != ISLAND_IDLE && collection_island.stage != ISLAND_READY
        if request != "" || waiting || collection_island_page || now >= collection_island_poll {
            collection_island_poll = now + 5.0
            changed := IslandUnlockAnswer(*collection_island,
                EntityGameShopAnswer(ifx request != "" then request else "status"), now)
            saved := CollectionIslandRecord()
            name: [96]u8
            record_name := IslandUnlockRecordName(*collection_island, name[:])
            if changed && saved != null && record_name != "" {
                AppFileFree(saved.text)
                saved.text = AppFileRead(*saved.files, record_name)
                IslandUnlockRestore(*collection_island, saved.text)
            }
            if collection_island.owned && !collection_island.saved && saved != null && record_name != "" {
                text: [192]u8
                collection_island.saved = AppFileWrite(*saved.files, record_name, IslandUnlockRecord(*collection_island, text[:]))
            }
        }
    }
    // Included content and its action share the trusted entitlement. A local
    // unlock record may not change either the loader or the Buy/Play label.
    if collection_island_package.included.found { collection_island.owned = collection_island_package.authorized }
    caption: [128]u8
    unused CopyCString(IslandUnlockCaption(*collection_island, caption[:]), entry.cover.caption[:])
    unused CopyCString(ifx collection_island.owned then "play" else "buy", entry.cover.action[:])
    if collection_island_page && collection_island.owned {
        collection_island_page = false
        // Unlocked from the Editor's Island levels: open them, not the islands.
        if collection_island_unlock_for_editor { collection_island_editor = ISLAND_EDITOR_ASKED }
        else { collection_island_opening = true }
        collection_island_unlock_for_editor = false
    }
}

CollectionIslandFrame :: (session: Session, viewport: Rectangle) {
    entry := CollectionIslandEntry()
    if entry == null { collection_island_page = false; return }
    collection_widget_node = AppTreeNode(*collection_host.tree, AppHandle.{0, 1})
    landscape := viewport.width > viewport.height && entry.cover.landscape[0] != 0
    background := CollectionAssetPath(ifx landscape then TextUntilNul(entry.cover.landscape[:]) else TextUntilNul(entry.cover.portrait[:]))
    logo := CollectionAssetPath(TextUntilNul(entry.cover.logo[:]))
    unused WidgetPaletteUse(session, ShoveyPalette())
    action := IslandUnlockPage(session, viewport, *collection_island, background, logo)
    unused WidgetPaletteRestore(session)
    if action == ISLAND_ACTION_BACK { collection_island_page = false; collection_island_unlock_for_editor = false }
    if action == ISLAND_ACTION_SIGN_IN { unused EntityShowPage("open") }
    if action == ISLAND_ACTION_BUY_DEW { unused EntityShowPage("dew") }
}

// Navigation records select a page in the verified game, never an item to buy.
CollectionShopQueue :: (page: string) -> bool {
    if page != "shop" && page != "chest" && page != "book" { return false }
    if collection_shop_request != "" { return false }
    root := AppTreeNode(*collection_host.tree, collection_host.tree.active)
    if root == null || !root.collection { return false }
    entry := AppCatalogAt(*root.catalog, AppCatalogFind(*root.catalog, "arcade.shovey"))
    if entry == null || !AppTreeLocate(*collection_host.tree, collection_host.tree.active, *collection_shop_locator) { return false }
    location := AppLocation.{.id = entry.id, .sha256 = entry.sha256}
    if !VecPush(collection_shop_locator.chain, location) { AppLocatorClear(*collection_shop_locator); return false }
    collection_shop_locator.identity.id = entry.id
    collection_shop_request = page
    return true
}

CollectionShopNavigate :: () {
    if collection_shop_request == "" { return }
    ready := AppHostOpenLocator(*collection_host, *collection_shop_locator)
    if ready == 0 { return }
    defer { collection_shop_request = ""; AppLocatorClear(*collection_shop_locator) }
    if ready != 1 || !AppHostRoute(*collection_host) { return }
    runtime := AppHostActiveRuntime(*collection_host)
    if runtime == null || TextUntilNul(runtime.node.identity.id[:]) != "arcade.shovey" { return }
    saved := CollectionRecordsFor("arcade.shovey")
    if saved == null || !AppFileWrite(*saved.files, "shop.request", collection_shop_request) {
        unused AppHostBack(*collection_host)
    }
}

// Cover labels are single lines from the game's existing locale sections.
CollectionLocaleLabel :: (text: string, key: string) -> string {
    start: s64 = 0
    while start < text.count {
        end := start
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        line := text[start:end]
        if line.count == key.count + 2 && line[0] == cast(u8)91 && line[line.count - 1] == cast(u8)93 && line[1:line.count - 1] == key {
            first := end + 1
            last := first
            while last < text.count && text[last] != cast(u8)10 { last += 1 }
            return text[first:last]
        }
        start = end + 1
    }
    return ""
}

CollectionLocaleText :: (key: string) -> string {
    if key.count > 9 && key[:9] == "referral." { return ReferralLocale.ReferralLabel(TextUntilNul(collection_host.locale[:]), key) }
    root := AppTreeNode(*collection_host.tree, AppHandle.{0, 1})
    if root == null { return key }
    path: Vec(u8)
    BuilderPrint(*path, "assets/shovey/locales/%.txt", TextUntilNul(collection_host.locale[:]))
    name := BuilderFinish(path)
    defer { AppFileFree(name) }
    resource := AppHostAsset(root, name)
    value := CollectionLocaleLabel(resource.data, key)
    if value == "" { value = CollectionLocaleLabel(AppHostAsset(root, "assets/shovey/locales/en.txt").data, key) }
    return ifx value == "" then key else value
}


c :: #system_library "c";
CollectionFree :: (memory: *void) #foreign c "free";
