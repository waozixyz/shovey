// Campaign progress is separate from a board: visiting a puzzle is not a win.
#import "text_buffer"
#import, file "engine.zi";
#import, file "levels.zi";

// Levels a campaign can track; SHOVEY_LIVE_MAX keeps the closing board within.
SHOVEY_PROGRESS_LEVELS :: 1000

ShoveyProgress :: struct {
    unlocked: s32
    completed: [SHOVEY_PROGRESS_LEVELS]bool
}

ShoveyProgressNew :: () -> ShoveyProgress { return ShoveyProgress.{.unlocked = 1} }

// A testing build (SHOVEY_UNLOCK_ALL) opens every level; saves keep counting
// as usual.
#if #defined(SHOVEY_UNLOCK_ALL) {
    ShoveyLevelUnlocked :: (progress: *ShoveyProgress, level: s32) -> bool {
        unused progress
        return level >= 1 && level <= ShoveyLevelCount()
    }
} else {
    ShoveyLevelUnlocked :: (progress: *ShoveyProgress, level: s32) -> bool {
        return level >= 1 && level <= ShoveyLevelCount() && level <= progress.unlocked
    }
}

ShoveyRecordWin :: (progress: *ShoveyProgress, game: *ShoveyGame) {
    if !game.won || game.level < 1 || game.level >= ShoveyFinaleLevel() || !ShoveyLevelUnlocked(progress, game.level) { return }
    progress.completed[game.level - 1] = true
    if game.level == progress.unlocked { progress.unlocked = game.level + 1 }
}

// Selecting a level always starts its first board. Continuing a game
// preserves an unfinished position, or moves past a completed puzzle.
ShoveySelectLevel :: (progress: *ShoveyProgress, game: *ShoveyGame, level: s32) -> bool {
    if !ShoveyLevelUnlocked(progress, level) { return false }
    return ShoveyLoad(game, level)
}

// Opening the game goes straight to the newest unlocked puzzle. An unfinished
// position on that puzzle is kept; anything else starts it from the beginning.
ShoveyOpenLatest :: (progress: *ShoveyProgress, game: *ShoveyGame) -> bool {
    ShoveyRecordWin(progress, game)
    latest := ifx progress.unlocked > ShoveyLevelCount() then ShoveyLevelCount() else progress.unlocked
    if game.level == latest && !game.won && !game.lost { return false }
    return ShoveySelectLevel(progress, game, latest)
}

ShoveyContinue :: (progress: *ShoveyProgress, game: *ShoveyGame) -> bool {
    ShoveyRecordWin(progress, game)
    if !game.won || game.level >= ShoveyLevelCount() { return false }
    return ShoveySelectLevel(progress, game, game.level + 1)
}

// An earlier version saved only a board. Preserve access to that existing
// position without inventing completed marks for puzzles it never recorded.
ShoveyMigrateProgress :: (game: *ShoveyGame) -> ShoveyProgress {
    progress := ShoveyProgress.{.unlocked = game.level}
    ShoveyRecordWin(*progress, game)
    return progress
}

// C2 adds a fingerprint of the level's starting board after the C1 layout.
SHOVEY_CAMPAIGN_C1 :: 1651
// C5 tracks campaigns past 175 levels: the unlocked level in four hex digits
// and a mark for each of SHOVEY_PROGRESS_LEVELS, then C4's position and
// fingerprint. Smaller campaigns keep saving the older layouts.
SHOVEY_CAMPAIGN_C5 :: 6 + SHOVEY_PROGRESS_LEVELS
campaign_bytes: [SHOVEY_CAMPAIGN_C5 + 2432 + 8]u8;

// FNV-1a over a level's starting board. A saved position is kept only while
// its level still starts from that board, so a game saved before levels were
// renumbered or edited restarts its level instead of showing another board.
ShoveyBoardMark :: (level: s32) -> u64 {
    data := ShoveyLevelBoard(level)
    mark: u64 = 2166136261
    for at: cast(s64)0..data.count - 1 {
        mark = ((mark ^ cast(u64)data[at]) * 16777619) & 4294967295
    }
    return mark
}

ShoveyCampaignSave :: (progress: *ShoveyProgress, game: *ShoveyGame) -> string {
    alphabet := "0123456789abcdef"
    wide := progress.unlocked > 175
    for index: cast(s32)175..SHOVEY_PROGRESS_LEVELS - 1 {
        if progress.completed[index] { wide = true }
    }
    header: s32 = ifx wide then 6 else 4
    marks: s32 = ifx wide then SHOVEY_PROGRESS_LEVELS else 175
    campaign_bytes[0] = #char "C"
    campaign_bytes[1] = ifx wide then #char "5" else #char "2"
    for digit: cast(s32)0..header - 3 {
        campaign_bytes[2 + digit] = alphabet[(progress.unlocked >> ((header - 3 - digit) * 4)) & 15]
    }
    for index: cast(s32)0..marks - 1 {
        campaign_bytes[header + index] = ifx progress.completed[index] then #char "1" else #char "0"
    }
    position := ShoveySave(game)
    start := header + marks
    for index: cast(s32)0..cast(s32)position.count - 1 { campaign_bytes[start + index] = position[index] }
    end := start + cast(s32)position.count
    if !wide && position.count > 1472 { campaign_bytes[1] = #char "3" }
    if !wide && position.count > 1952 { campaign_bytes[1] = #char "4" }
    mark := ShoveyBoardMark(game.level)
    for digit: cast(s32)0..7 {
        campaign_bytes[end + digit] = alphabet[cast(s32)((mark >> cast(u64)((7 - digit) * 4)) & 15)]
    }
    return TextView(campaign_bytes[:end + 8])
}

ShoveyCampaignRestore :: (progress: *ShoveyProgress, game: *ShoveyGame, text: string) -> bool {
    wide := text.count > SHOVEY_CAMPAIGN_C5 && text[:2] == "C5"
    header: s32 = ifx wide then 6 else 4
    marks: s32 = ifx wide then SHOVEY_PROGRESS_LEVELS else 175
    start := header + marks
    positions := cast(s32)text.count - start - 8
    decorated := (wide && positions == 2432) || (text.count == SHOVEY_CAMPAIGN_C1 + 968 && text[:2] == "C4")
    layered := decorated || (wide && positions == 1952) || (text.count == SHOVEY_CAMPAIGN_C1 + 488 && text[:2] == "C3")
    end := start + (ifx decorated then 2432 else ifx layered then 1952 else 1472)
    marked := layered || (wide && positions == 1472) || (text.count == SHOVEY_CAMPAIGN_C1 + 8 && text[:2] == "C2")
    if wide && !marked { return false }
    if !marked && (text.count != SHOVEY_CAMPAIGN_C1 || text[:2] != "C1") { return false }
    restored: ShoveyProgress
    restored.unlocked = 0
    for digit: cast(s32)2..header - 1 {
        value := ShoveyDigit(text[digit])
        if value < 0 { return false }
        restored.unlocked = restored.unlocked * 16 + value
    }
    if restored.unlocked < 1 || restored.unlocked > ShoveyLevelLimit() { return false }
    for index: cast(s32)0..marks - 1 {
        byte := text[header + index]
        if byte != #char "0" && byte != #char "1" { return false }
        restored.completed[index] = byte == #char "1"
        if restored.completed[index] && index + 1 >= restored.unlocked { return false }
    }
    position: ShoveyGame
    if !ShoveyRestore(*position, text[start:end]) || position.level > restored.unlocked { return false }
    // Older releases exposed unfinished levels. Keep all earned progress,
    // but reopen an approved board instead of discarding the campaign.
    if position.level > ShoveyLevelCount() {
        if !ShoveyLoad(*position, ShoveyLevelCount()) { return false }
        progress.* = restored
        game.* = position
        return true
    }
    mark: u64 = 0
    if marked {
        for digit: cast(s32)0..7 {
            value := ShoveyDigit(text[end + digit])
            if value < 0 { marked = false; break }
            mark = mark * 16 + cast(u64)value
        }
    }
    // Keep the progress, but start a level whose board has changed afresh.
    if !marked || mark != ShoveyBoardMark(position.level) {
        if !ShoveyLoad(*position, position.level) { return false }
    }
    progress.* = restored
    game.* = position
    return true
}
