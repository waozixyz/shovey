// Shovey Island's unlock: the node's exact quote, the one press that buys at
// the price its control showed, and the owner's verified entitlement. The
// ledger decides ownership; the local record only keeps that answer for an
// offline restart of the same owner.
#import "std/json_scan"
#import "std/text_buffer"
#import "std/c_string"
#import "std/vec"
#import "entity/dew_model"

host_api :: #system_library "host_api";
AppLocaleHost :: (key: string) -> string #foreign host_api;

ISLAND_UNLOCK_APP :: "arcade.shovey-island";
// Shown only until a signed-in device has the node's quote. Buying always
// needs that quote, so these values can never set what is charged.
ISLAND_LAUNCH_UNITS: s64 = 51000000;
ISLAND_REGULAR_UNITS: s64 = 85000000;
ISLAND_LAUNCH_PERCENT: s32 = 40;

ISLAND_IDLE :: 0;
ISLAND_SYNCING :: 1;
ISLAND_QUOTE_NEEDED :: 2;
ISLAND_QUOTING :: 3;
ISLAND_READY :: 4;
ISLAND_CONFIRM_NEEDED :: 5;
ISLAND_CONFIRMING :: 6;

ISLAND_ACTION_NONE :: 0;
ISLAND_ACTION_SIGN_IN :: 2;
ISLAND_ACTION_BUY_DEW :: 3;

// A press on Play while the node still checks a remembered unlock: Island
// opens once verified, and nothing is ever bought.
ISLAND_WANTED_OPEN: s64 = -1;

ISLAND_RETRY_SIGNED_OUT: float64 = 5.0;
ISLAND_RETRY_OFFLINE: float64 = 30.0;
ISLAND_NOTICE_SECONDS: float64 = 5.0;

IslandUnlock :: struct {
    owner: [65]u8
    owned: bool
    // The owned answer is in this owner's local record.
    saved: bool
    connected: bool
    // The node's current quote; zero until one has arrived.
    price: s64
    regular: s64
    percent: s32
    stage: s32
    retry_at: float64
    // Locale key of the last outcome, or empty, and how long it shows.
    notice: string
    notice_until: float64
    // This owner's saved record says Island is unlocked. It shows as theirs
    // while the node checks; only the node's answer opens it.
    remembered: bool
    // The price the Unlock control showed when it was pressed, or
    // ISLAND_WANTED_OPEN. Zero when nothing was asked.
    wanted: s64
    // Sign in or the Dew page, for the host to open once.
    action: s32
}

// The one exact confirmation waiting to go out.
island_request: [64]u8;

// Asks the node again, so an unlock made on another device shows and the
// price is the node's current one. A press already under way is left alone.
IslandUnlockRefresh :: (unlock: *IslandUnlock) {
    if unlock.wanted != 0 { return }
    if unlock.stage == ISLAND_IDLE || unlock.stage == ISLAND_READY {
        unlock.stage = ISLAND_IDLE
        unlock.retry_at = 0.0
    }
}

// The exact confirmation is waiting to go out or for its answer.
IslandUnlockBusy :: (unlock: *IslandUnlock) -> bool {
    return unlock.stage == ISLAND_CONFIRM_NEEDED || unlock.stage == ISLAND_CONFIRMING
}

IslandUnlockSay :: (unlock: *IslandUnlock, notice: string, now: float64) {
    unlock.notice = notice
    unlock.notice_until = now + ISLAND_NOTICE_SECONDS
}

// Gives up what a press asked for, with why when there is something to say.
IslandUnlockDrop :: (unlock: *IslandUnlock, notice: string, now: float64) {
    if unlock.wanted == 0 { return }
    unlock.wanted = 0
    if notice != "" { IslandUnlockSay(unlock, notice, now) }
}

// A press bought at the price its control showed, and at no other: a
// different quote shows first and waits for another press.
IslandUnlockWanted :: (unlock: *IslandUnlock, now: float64) {
    if unlock.wanted <= 0 || unlock.stage != ISLAND_READY { return }
    if unlock.wanted != unlock.price {
        IslandUnlockDrop(unlock, "shovey_island_changed", now)
        return
    }
    if !IslandUnlockBuy(unlock) { IslandUnlockDrop(unlock, "shovey_island_failed", now) }
}

// The one press on Unlock, or on Play while a remembered unlock is checked.
// Signed out it asks for the sign-in page; otherwise the purchase goes out
// as soon as the node quotes the shown price, with nothing to confirm.
IslandUnlockPress :: (unlock: *IslandUnlock, now: float64) {
    if unlock.owned || unlock.wanted != 0 || IslandUnlockBusy(unlock) { return }
    unlock.notice = ""
    if unlock.remembered {
        unlock.wanted = ISLAND_WANTED_OPEN
        return
    }
    if !unlock.connected {
        unlock.action = ISLAND_ACTION_SIGN_IN
        return
    }
    price, regular, percent := IslandUnlockShown(unlock)
    unlock.wanted = price
    if unlock.stage == ISLAND_READY { IslandUnlockWanted(unlock, now) }
    else if unlock.stage == ISLAND_IDLE { unlock.retry_at = 0.0 }
}

// The page the last answer asks the host to open, once.
IslandUnlockTakeAction :: (unlock: *IslandUnlock) -> s32 {
    action := unlock.action
    unlock.action = ISLAND_ACTION_NONE
    return action
}

// The request to send now, or "" to only read the status.
IslandUnlockNext :: (unlock: *IslandUnlock, now: float64) -> string {
    if unlock.owned { return "" }
    if unlock.stage == ISLAND_IDLE && now >= unlock.retry_at {
        unlock.stage = ISLAND_SYNCING
        return "refresh"
    }
    if unlock.stage == ISLAND_QUOTE_NEEDED {
        unlock.stage = ISLAND_QUOTING
        return "shovey.island.quote"
    }
    if unlock.stage == ISLAND_CONFIRM_NEEDED {
        unlock.stage = ISLAND_CONFIRMING
        return TextUntilNul(island_request[:])
    }
    return ""
}

// Starts the exact-quote purchase. Nothing is sent without a current quote.
IslandUnlockBuy :: (unlock: *IslandUnlock) -> bool {
    if unlock.owned || unlock.stage != ISLAND_READY || unlock.price <= 0 { return false }
    text: Vec(u8)
    BuilderPrint(*text, "shovey.island:%", unlock.price)
    copied := CopyCString(TextView(VecSlice(text, 0, text.count)), island_request[:])
    VecFree(text)
    if !copied { return false }
    unlock.notice = ""
    unlock.stage = ISLAND_CONFIRM_NEEDED
    return true
}

IslandAnswerStatus :: (answer: string, value: string) -> bool {
    status: [32]u8
    return ReadStringText(answer, FieldAt(answer, 0, "status"), status[:]) >= 0 && TextUntilNul(status[:]) == value
}

IslandAnswerUnits :: (answer: string, name: string) -> s64 {
    value := ReadNumber(answer, FieldAt(answer, 0, name))
    if !value.valid || value.value <= 0.0 || value.value > 1000000000000.0 { return 0 }
    units := cast(s64)value.value
    return ifx cast(float64)units == value.value then units else 0
}

// Applies an entity.game-shop answer. True when its owner differs from the
// previous one, so the caller restores that owner's own record.
IslandUnlockAnswer :: (unlock: *IslandUnlock, answer: string, now: float64) -> bool {
    owner: [65]u8
    if ReadStringText(answer, FieldAt(answer, 0, "owner"), owner[:]) < 0 { return false }
    changed := TextUntilNul(owner[:]) != TextUntilNul(unlock.owner[:])
    if changed {
        unlock.* = IslandUnlock.{}
        unlock.owner = owner
    }
    unlock.connected = MatchLiteral(answer, FieldAt(answer, 0, "connected"), "true")
    if MatchLiteral(answer, FieldAt(answer, 0, "island_owned"), "true") && unlock.owner[0] != 0 {
        unlock.owned = true
        unlock.stage = ISLAND_IDLE
        unlock.notice = ""
        unlock.wanted = 0
        return changed
    }
    if unlock.owned || IslandAnswerStatus(answer, "pending") { return changed }
    if unlock.stage == ISLAND_SYNCING {
        if !unlock.connected {
            unlock.stage = ISLAND_IDLE
            unlock.retry_at = now + ISLAND_RETRY_SIGNED_OUT
            // Signed out again: the saved record belongs to nobody here.
            unlock.remembered = false
            IslandUnlockDrop(unlock, "shovey_island_signin", now)
        } else if IslandAnswerStatus(answer, "failed") {
            unlock.stage = ISLAND_IDLE
            unlock.retry_at = now + ISLAND_RETRY_OFFLINE
            IslandUnlockDrop(unlock, "shovey_island_offline", now)
        } else {
            // The node's ledger holds no unlock for this owner, whatever a
            // saved record says: Play was never a promise to buy.
            unlock.remembered = false
            if unlock.wanted < 0 { unlock.wanted = 0 }
            unlock.stage = ISLAND_QUOTE_NEEDED
        }
    } else if unlock.stage == ISLAND_QUOTING {
        price := IslandAnswerUnits(answer, "island_price_units")
        if price > 0 {
            unlock.price = price
            unlock.regular = IslandAnswerUnits(answer, "island_regular_price_units")
            percent := ReadNumber(answer, FieldAt(answer, 0, "island_discount_percent"))
            unlock.percent = ifx percent.valid && percent.value > 0.0 && percent.value < 100.0 then cast(s32)percent.value else 0
            unlock.stage = ISLAND_READY
            IslandUnlockWanted(unlock, now)
        } else {
            unlock.stage = ISLAND_IDLE
            unlock.retry_at = now + ifx unlock.connected then ISLAND_RETRY_OFFLINE else ISLAND_RETRY_SIGNED_OUT
            IslandUnlockDrop(unlock, ifx unlock.connected then "shovey_island_offline" else "shovey_island_signin", now)
        }
    } else if unlock.stage == ISLAND_CONFIRMING {
        unlock.wanted = 0
        if IslandAnswerStatus(answer, "price_changed") {
            // The charge never happened; show the new price before any retry.
            unlock.price = 0
            IslandUnlockSay(unlock, "shovey_island_changed", now)
            unlock.stage = ISLAND_QUOTE_NEEDED
        } else {
            unlock.stage = ISLAND_READY
            if IslandAnswerStatus(answer, "insufficient") {
                // The Dew page opens, and the quote stays ready for after it.
                IslandUnlockSay(unlock, "shovey_island_insufficient", now)
                unlock.action = ISLAND_ACTION_BUY_DEW
            } else if IslandAnswerStatus(answer, "signin") {
                IslandUnlockSay(unlock, "shovey_island_signin", now)
                unlock.action = ISLAND_ACTION_SIGN_IN
            } else { IslandUnlockSay(unlock, "shovey_island_failed", now) }
        }
    }
    return changed
}

IslandUnlockRecordName :: (unlock: *IslandUnlock, output: []u8) -> string {
    if unlock.owner[0] == 0 { return "" }
    text: Vec(u8)
    BuilderPrint(*text, "island.v1.%", TextUntilNul(unlock.owner[:]))
    copied := CopyCString(TextView(VecSlice(text, 0, text.count)), output)
    VecFree(text)
    return ifx copied then TextUntilNul(output) else ""
}

IslandUnlockRecord :: (unlock: *IslandUnlock, output: []u8) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "{\"version\":1,\"owner\":\"%\",\"owned\":true}", TextUntilNul(unlock.owner[:]))
    copied := CopyCString(TextView(VecSlice(text, 0, text.count)), output)
    VecFree(text)
    return ifx copied then TextUntilNul(output) else ""
}

// Only this owner's verified answer restores; a guest never owns Island.
// The record also marks Island as remembered, for hosts whose own
// entitlement check still has to pass before it opens.
IslandUnlockRestore :: (unlock: *IslandUnlock, record: string) {
    if unlock.owner[0] == 0 || record == "" { return }
    owner: [65]u8
    version := ReadNumber(record, FieldAt(record, 0, "version"))
    if !version.valid || version.value != 1.0 ||
    ReadStringText(record, FieldAt(record, 0, "owner"), owner[:]) < 0 ||
    TextUntilNul(owner[:]) != TextUntilNul(unlock.owner[:]) ||
    !MatchLiteral(record, FieldAt(record, 0, "owned"), "true") { return }
    unlock.owned = true
    unlock.saved = true
    unlock.remembered = true
    unlock.stage = ISLAND_IDLE
}

// What to show: the node's quote, or the launch price until one has arrived.
IslandUnlockShown :: (unlock: *IslandUnlock) -> (price: s64, regular: s64, percent: s32) {
    if unlock.price > 0 {
        return unlock.price, ifx unlock.regular > 0 then unlock.regular else unlock.price, unlock.percent
    }
    return ISLAND_LAUNCH_UNITS, ISLAND_REGULAR_UNITS, ISLAND_LAUNCH_PERCENT
}

IslandDewText :: (units: s64, output: []u8) -> string {
    if !DewFormat(units, DewUnits, output, "Dew") { return "" }
    return TextUntilNul(output)
}

// The line under a locked cover's title: the price and any offer.
IslandUnlockCaption :: (unlock: *IslandUnlock, output: []u8) -> string {
    if unlock.owned { return "" }
    price, regular, percent := IslandUnlockShown(unlock)
    digits: [32]u8
    amount := IslandDewText(price, digits[:])
    text: Vec(u8)
    if percent > 0 && regular > price { BuilderPrint(*text, "% · %", amount, AppLocaleHost("shovey_island_off")) }
    else { BuilderPrint(*text, "%", amount) }
    copied := CopyCString(TextView(VecSlice(text, 0, text.count)), output)
    VecFree(text)
    return ifx copied then TextUntilNul(output) else ""
}

// What the Unlock control reads: Unlock and the shown price, or what a
// press is waiting for. The price has no separate line.
IslandUnlockLabel :: (unlock: *IslandUnlock, output: []u8) -> string {
    if unlock.wanted < 0 {
        return ifx CopyCString(AppLocaleHost("shovey_island_opening"), output) then TextUntilNul(output) else ""
    }
    if unlock.wanted > 0 || IslandUnlockBusy(unlock) {
        return ifx CopyCString(AppLocaleHost("shovey_island_unlocking"), output) then TextUntilNul(output) else ""
    }
    price, regular, percent := IslandUnlockShown(unlock)
    digits: [32]u8
    text: Vec(u8)
    BuilderPrint(*text, "% · %", AppLocaleHost("shovey_island_unlock"), IslandDewText(price, digits[:]))
    copied := CopyCString(TextView(VecSlice(text, 0, text.count)), output)
    VecFree(text)
    return ifx copied then TextUntilNul(output) else ""
}

// The offer rides on the Unlock control while it reads the price.
IslandOffer :: (unlock: *IslandUnlock) -> bool {
    if unlock.owned || unlock.remembered || unlock.wanted != 0 || IslandUnlockBusy(unlock) { return false }
    price, regular, percent := IslandUnlockShown(unlock)
    return percent > 0 && regular > price
}

// Why the last press did not unlock, for a few seconds after it.
IslandUnlockNotice :: (unlock: *IslandUnlock, now: float64) -> string {
    if unlock.owned || unlock.notice == "" || now >= unlock.notice_until { return "" }
    return AppLocaleHost(unlock.notice)
}
