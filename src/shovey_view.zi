frame: AppUiFrame;
game: ShoveyGame;
progress: ShoveyProgress;
selector_open: bool;
levels_scroll: s32;
levels_focus_pending: bool;
loaded: bool;
shared_progress: SharedProgressSession;
completion_path: CompletionPath;
shared_account_changed: bool;
help_open: bool;
friend_guide: ShoveyGuide;
friend_loaded: bool;
// An embedded mini page opens straight into a level with only its levels
// and restart controls.
mini: bool;
save_failed: bool;
replay_ack_failed: bool;
help_scroll: s32;
// Touch-first: hidden until the board is touched, then hidden again for keyboard.
last_tick: float64;
// A slide plays one cell at a time: the boards it passes through, and which
// one is drawn next. Input waits until the last is shown.
// Keep every internal step for both animation and route evidence. A slide
// stops on a repeated cell, so a board's cells plus its first step suffice.
SLIDE_FRAMES :: SHOVEY_CELLS + 1
SLIDE_SECONDS :: 0.06
slide_boards: [SLIDE_FRAMES]ShoveyGame;
slide_count: s32;
slide_next: s32;
slide_at: float64;
header_bytes: [256]u8;
level_preview_paths: [SHOVEY_PROGRESS_LEVELS][64]u8;
level_preview_landscape: bool;
// Whether a level still starts from the board its built-in picture shows.
level_preview_current: [SHOVEY_PROGRESS_LEVELS]bool;
// The live campaign request: the host service, its request and next poll.
live_service: string;
live_request: [24]u8;
live_waiting: bool;
live_poll_at: float64;
live_bytes: [96]u8;
// The cached campaign, read back from records of at most LIVE_CHUNK bytes:
// enough chunks for SHOVEY_LIVE_MAX compact levels. A downloaded document
// is about 1.9 KB a level; 1 MiB is the largest fixed array.
LIVE_CHUNK :: 49152
LIVE_CHUNKS :: 15
LIVE_DOCUMENT :: 1048576
live_cache: [LIVE_CHUNK * LIVE_CHUNKS]u8;
live_cache_length: s32;
live_names: [LIVE_CHUNKS][24]u8;
// A downloaded campaign being checked, and the mark of the last one checked.
live_document: [LIVE_DOCUMENT]u8;
live_checking: bool;
live_mark: [24]u8;
// New levels from the node: -1 unread, 0 off, 1 on, 2 not asked yet.
level_updates: s32 = -1;
SHOVEY_ASKS_UPDATES :: !#defined(SHOVEY_WEB)
SHOVEY_ALWAYS_UPDATES :: #defined(SHOVEY_WEB)
SHOVEY_READS_NODE :: #defined(PLATFORM_WEB)
SHOVEY_ASKS_HOST :: !#defined(PLATFORM_WEB)
sprite_names: [SPRITE_COUNT]string;


AppendText :: (bytes: []u8, length: *s32, text: string) {
    if length.* + text.count > bytes.count { return }
    for index: cast(s64)0..text.count - 1 {
        bytes[length.*] = text[index]
        length.* += 1
    }
}

HeaderText :: () -> string {
    length: s32 = 0
    digits: [24]u8
    AppendText(header_bytes[:], *length, AppLocaleHost("shovey_level"))
    AppendText(header_bytes[:], *length, " ")
    if ShoveySecret(game.level) {
        if game.level == CHEST_LEVEL { AppendText(header_bytes[:], *length, "29a"); return TextView(header_bytes[:length]) }
        // The secret levels beside the last one are named after it.
        AppendText(header_bytes[:], *length, FormatInteger(cast(s64)ShoveyLevelCount(), digits[:]))
        AppendText(header_bytes[:], *length, ifx game.level == SHOVEY_SECRET_UP then "a" else "b")
        return TextView(header_bytes[:length])
    }
    AppendText(header_bytes[:], *length, FormatInteger(cast(s64)game.level, digits[:]))
    AppendText(header_bytes[:], *length, " / ")
    AppendText(header_bytes[:], *length, FormatInteger(cast(s64)ShoveyLevelCount(), digits[:]))
    return TextView(header_bytes[:length])
}

Fill :: (key: u64, bounds: Rectangle, color: Color, radius: float32 = 0.0) {
    Box(frame.session, BoxProps.{.key = key, .bounds = bounds, .fill = color, .radius = radius})
}

Caption :: (key: u64, bounds: Rectangle, text: string, font: s32 = 16, center: bool = false) {
    Text(frame.session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = font,
            .wrap = TextWrap.TextWrapAuto,
            .align = ifx center then TextAlign.TextAlignCenter else TextAlign.TextAlignStart,
            .vertical_align = TextAlign.TextAlignCenter})
}

FriendSave :: () {
    bytes: [10]u8
    if GuideWrite(*friend_guide, bytes[:]) && !PathSaveRecord("local.guide.seen", TextView(bytes[:])) { save_failed = true }
}

FriendPrepare :: () {
    if mini || ShoveySecret(game.level) || game.level == ShoveyFinaleLevel() { return }
    if !friend_loaded {
        friend_loaded = true
        if !GuideRead(*friend_guide, PathRecord("local.guide.seen")) {
            GuideSeedEarlier(*friend_guide, game.level)
            if game.moves > 0 { friend_guide.seen = friend_guide.seen | GuideBoardTopics(*game) }
            if friend_guide.seen != 0 { FriendSave() }
        }
    }
    GuideOffer(*friend_guide, *game)
}

FriendCard :: (width: float32, top: float32, bottom: float32, key: s32, grid: TileMapResult, landscape: bool) {
    topic := GuideNext(*friend_guide)
    if topic < 0 { return }
    text := AppLocaleHost(GuideTextKey(topic))
    card_width: float32 = ifx width > 504.0 then 480.0 else width - 24.0
    text_width: float32 = card_width - 108.0
    text_height := cast(float32)TextHeight(frame.session, TextProps.{.text = text,
            .bounds = Rectangle.{0.0, 0.0, text_width, 0.0}, .font = 15, .wrap = TextWrap.TextWrapAuto})
    height: float32 = text_height + 98.0
    if height < 154.0 { height = 154.0 }
    y: float32 = bottom - height - 12.0
    if y < top + 64.0 { y = top + 64.0 }
    x: float32 = width - card_width - 12.0
    // Pip sits in the scene beside a speech bubble; the puzzle stays visible.
    unused Box(frame.session, BoxProps.{.key = cast(u64)20600,
            .bounds = Rectangle.{x + 68.0, y, card_width - 68.0, height}, .radius = 18.0,
            .fill = Color.{53, 61, 54, 250}, .border = Color.{161, 193, 112, 255}})
    Caption(20601, Rectangle.{x + 94.0, y + 12.0, text_width, 24.0}, AppLocaleHost("shovey_friend_name"), 18)
    Caption(20602, Rectangle.{x + 94.0, y + 42.0, text_width, text_height + 4.0}, text, 15)
    bob := cast(float32)Math.Sin(frame.now * 2.0) * 2.5
    Image(frame.session, ImageProps.{.key = cast(u64)20603,
            .bounds = Rectangle.{x - 4.0, y + height - 112.0 + bob, 110.0, 116.0},
            .asset_path = "assets/shovey/pip.png", .alt_text = AppLocaleHost("shovey_friend_name"),
            .fit = ImageFit.ImageFitContain, .smooth = true})
    // Point out the new mechanic without revealing a route through the puzzle.
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        focus := (GuideKind(game.ground[at]) | GuideKind(game.objects[at])) & GuideBit(topic)
        if topic == GUIDE_HOME && ShoveyHome(game.ground[at]) { focus = 1 }
        if focus != 0 {
            cell := TileMapCell(grid, BoardDisplayIndex(at, landscape))
            unused Box(frame.session, BoxProps.{.key = cast(u64)20605, .bounds = cell,
                    .fill = Color.{181, 221, 104, 28}, .border = Color.{207, 242, 139, 255}, .radius = 4.0})
            break
        }
    }
    if Control(20604, Rectangle.{x + card_width - 104.0, y + height - 46.0, 88.0, 36.0},
        AppLocaleHost("shovey_friend_continue")) || key == 257 || key == 32 || key == 256 {
        if GuideAcknowledge(*friend_guide) { FriendSave() }
    }
}

// A button; with an icon it shows only the icon and keeps label for
// screen readers and tooltips.
Control :: (id: s32, bounds: Rectangle, label: string, disabled: bool = false, detail: string = "",
    icon: string = "") -> bool {
    return Button(frame.session, ButtonProps.{.key = cast(u64)id, .id = id,
            .bounds = bounds, .label = label, .detail = detail, .disabled = disabled,
            .icon_shape = icon, .icon_only = icon != "",
            .fit_content = true, .tone = ButtonTone.ButtonToneNeutral,
            .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0
}

// One of a set of choices; the chosen one stands out and reads as selected.
Choice :: (id: s32, bounds: Rectangle, label: string, chosen: bool) -> bool {
    return Button(frame.session, ButtonProps.{.key = cast(u64)id, .id = id, .bounds = bounds, .label = label,
            .selected = chosen, .tone = ifx chosen then ButtonTone.ButtonToneAccent else ButtonTone.ButtonToneNeutral,
            .emphasis = ifx chosen then ButtonEmphasis.ButtonEmphasisFilled else ButtonEmphasis.ButtonEmphasisSoft}) != 0
}

// The first time a level opens, Shovey asks how to move: swipe and tap on
// the left, the movement pad on the right, each shown as it plays. Help
// changes it later. Nothing behind the question takes input meanwhile.
ControlsChoice :: (width: float32, top: float32, bottom: float32) {
    full := Rectangle.{0.0, top, width, bottom - top}
    Box(frame.session, BoxProps.{.key = cast(u64)20050, .bounds = full, .fill = Color.{0, 0, 0, 160}})
    unused Press(frame.session, PressProps.{.key = cast(u64)20051, .id = 20051, .bounds = full,
            .label = AppLocaleHost("shovey_controls_choose"), .now = frame.now, .capture = true})
    card_width := ifx width - 24.0 < 640.0 then width - 24.0 else 640.0
    tile_width := (card_width - 48.0 - 14.0) / 2.0
    tile_height := tile_width * 1.25 + 70.0
    if tile_height > bottom - top - 150.0 { tile_height = bottom - top - 150.0 }
    card_height := tile_height + 130.0
    x := (width - card_width) / 2.0
    y := top + (bottom - top - card_height) / 2.0
    if y < top + 8.0 { y = top + 8.0 }
    Box(frame.session, BoxProps.{.key = cast(u64)20052, .bounds = Rectangle.{x, y, card_width, card_height},
            .fill = Color.{59, 64, 63, 255}, .border = Color.{93, 98, 97, 255}, .radius = 18.0})
    Caption(20053, Rectangle.{x + 16.0, y + 16.0, card_width - 32.0, 34.0}, AppLocaleHost("shovey_controls_choose"), 22, true)
    Caption(20054, Rectangle.{x + 16.0, y + 50.0, card_width - 32.0, 24.0}, AppLocaleHost("shovey_controls_later"), 14, true)
    tiles_y := y + 90.0
    if ChoiceTile(20055, Rectangle.{x + 24.0, tiles_y, tile_width, tile_height}, false) { ControlsSetPad(false) }
    // Each tile uses its id to id + 13, so the two stay apart.
    if ChoiceTile(20080, Rectangle.{x + 24.0 + tile_width + 14.0, tiles_y, tile_width, tile_height}, true) { ControlsSetPad(true) }
}

// One way to move, shown as it plays: Shovey on the grass with a swipe, or
// the movement pad itself, which can be tried right here.
ChoiceTile :: (id: s32, bounds: Rectangle, pad: bool) -> bool {
    press := Press(frame.session, PressProps.{.key = cast(u64)id, .id = id, .bounds = bounds,
            .label = AppLocaleHost(ifx pad then "shovey_controls_pad" else "shovey_controls_swipe"), .now = frame.now})
    Box(frame.session, BoxProps.{.key = cast(u64)(id + 1), .bounds = bounds, .fill = Color.{74, 80, 78, 255},
            .border = ifx press.down then Color.{52, 185, 48, 255} else Color.{106, 112, 110, 255}, .radius = 14.0})
    art := Rectangle.{bounds.x + 12.0, bounds.y + 12.0, bounds.width - 24.0, bounds.height - 86.0}
    side := ifx art.width < art.height then art.width else art.height
    square := Rectangle.{art.x + (art.width - side) / 2.0, art.y + (art.height - side) / 2.0, side, side}
    chosen := press.clicked
    if !pad {
        // A patch of grass, Shovey in its middle, and a finger swiping right.
        cell := side / 3.0
        for row: cast(s32)0..2 {
            for column: cast(s32)0..2 {
                Sprite(cast(u64)(id + 2 + row * 3 + column), SPRITE_GRASS_EDGE, Rectangle.{square.x + cast(float32)column * cell,
                        square.y + cast(float32)row * cell, cell, cell}, "")
            }
        }
        Sprite(cast(u64)(id + 2 + 9), SPRITE_PLAYER + 2, Rectangle.{square.x + cell, square.y + cell, cell, cell}, "Shovey")
        SvgIcon(frame.session, SvgIconProps.{.bounds = Rectangle.{square.x + side * 0.56, square.y + side * 0.46, side * 0.44, side * 0.44},
                .shape = FingerSwipe.Shape, .color = Color.{255, 255, 255, 240}})
        SvgIcon(frame.session, SvgIconProps.{.bounds = Rectangle.{square.x + side * 0.08, square.y + side * 0.02, side * 0.6, side * 0.3},
                .shape = "S2.5rr:M3 12H19M14 7L19 12L14 17", .color = Color.{255, 236, 170, 235}})
    } else {
        tried := DirectionPad(frame.session, DirectionPadProps.{.key = cast(u64)(id + 2), .id = id + 2, .bounds = square,
                .label = AppLocaleHost("shovey_controls_pad"), .now = frame.now, .repeat_seconds = 0.16})
        chosen = chosen || tried.step
    }
    Caption(cast(u64)(id + 3 + 9), Rectangle.{bounds.x + 8.0, bounds.y + bounds.height - 72.0, bounds.width - 16.0, 26.0},
        AppLocaleHost(ifx pad then "shovey_controls_pad" else "shovey_controls_swipe"), 17, true)
    Caption(cast(u64)(id + 4 + 9), Rectangle.{bounds.x + 8.0, bounds.y + bounds.height - 44.0, bounds.width - 16.0, 38.0},
        AppLocaleHost(ifx pad then "shovey_controls_pad_hint" else "shovey_controls_swipe_hint"), 12, true)
    return chosen
}

TileName :: (kind: s32) -> string {
    if kind == 10 { return "Shovey" }
    return AppLocaleHost(ShoveyPieceKey(kind))
}

// Each sprite number's description, for the board's pictures. The names
// come from the host's locale, so they are read once, not every frame.
sprite_names_ready: bool;

SpriteNames :: () {
    if sprite_names_ready { return }
    sprite_names_ready = true
    for kind: cast(s32)0..40 { sprite_names[kind] = TileName(kind) }
    sprite_names[SPRITE_CHERRY] = TileName(56)
    for kind: cast(s32)44..55 { sprite_names[SPRITE_NEW_COLOR + kind - 44] = TileName(kind) }
    for index: cast(s32)SPRITE_PLAYER..SPRITE_DOOR_OPEN - 1 { sprite_names[index] = "Shovey" }
    sprite_names[SPRITE_DOOR_OPEN] = TileName(14)
    for material: cast(s32)0..3 { sprite_names[SPRITE_MOSS_FLOOR + material] = TileName(14) }
    for index: cast(s32)SPRITE_SENSOR..SPRITE_SHOT - 1 { sprite_names[index] = TileName(22) }
    sprite_names[SPRITE_SHOT] = AppLocaleHost("shovey_ammo")
}

// One board kind for the help list, standing on floor when it is a piece.
Tile :: (key: u64, kind: s32, bounds: Rectangle) {
    floor := FloorSprite(kind)
    if floor >= 0 { Sprite(key, floor, bounds, AppLocaleHost("shovey_floor")) }
    sprite := ifx kind == 10 then PlayerSprite(*game) else KindSprite(*game, kind, -1, frame.now)
    if sprite >= 0 { Sprite(key + 2, sprite, bounds, TileName(kind)) }
}

Sprite :: (key: u64, index: s32, bounds: Rectangle, label: string) {
    Image(frame.session, ImageProps.{.key = key, .asset_path = SpriteFile(index),
            .alt_text = label, .bounds = bounds, .fit = ImageFit.ImageFitContain, .smooth = true})
}

// The solved-level count last reported to the leaderboard.
reported_levels: s32 = -1;

Remember :: () {
    // A secret level is never saved: the game reopens on the last level.
    if ShoveySecret(game.level) { return }
    if replay_ack_failed { ReplayOpened() }
    ShoveyRecordWin(*progress, *game)
    save_failed = !SaveLocalCampaign(ShoveyCampaignSave(*progress, *game)) || replay_ack_failed
    if !PathSave(*completion_path, *game) { save_failed = true }
    if game.won {
        if !PathKeepBest(*completion_path, *game) { save_failed = true }
        if PathSubmit(*completion_path, *game) == 2 { shared_progress.poll_at = 0.0 }
        if !PathSave(*completion_path, *game) { save_failed = true }
        unused SharedProgressSave(*shared_progress, game.level, true)
        ReportSolvedLevels(progress.completed[:], *reported_levels)
    }
}

OpenLevels :: () {
    selector_open = true
    levels_focus_pending = true
}

ChangeLevel :: (level: s32) {
    friend_guide.level = 0
    slide_count = 0
    slide_next = 0
    if ShoveySecret(level) && game.level == level {
        unused ShoveyLoad(*game, level)
        last_tick = frame.now
        won_at = 0.0
        selector_open = false
        help_open = false
        return
    }
    if ShoveySelectLevel(*progress, *game, level) {
        secret_visit.valid = false
        PathStart(*completion_path, *game, ShoveyLevelBoard(game.level), TextUntilNul(shared_progress.owner[:]))
        ReplayOpened()
        last_tick = frame.now
        selector_open = false
        help_open = false
        Remember()
    }
}

// Animals wander on their own: each waits its own random half second to two
// seconds between steps and glides to the next cell, so a field of ducks
// never moves in step. Stored routes keep the engine's shared tick.
animal_due: [SHOVEY_CELLS]float64;
animal_level: s32;
animal_random: u32 = 2463534242;

AnimalRoll :: () -> u32 {
    animal_random = animal_random ^ (animal_random << 13)
    animal_random = animal_random ^ (animal_random >> 17)
    animal_random = animal_random ^ (animal_random << 5)
    return animal_random
}

AnimalWait :: (shortest: float64, longest: float64) -> float64 {
    return shortest + (longest - shortest) * cast(float64)(AnimalRoll() % 1000) / 1000.0
}

AnimalsWander :: () -> bool {
    if game.won || game.lost || game.level == ShoveyFinaleLevel() { return false }
    if animal_level != game.level {
        for at: cast(s32)0..SHOVEY_CELLS - 1 { animal_due[at] = 0.0 }
        BoardGlidesClear()
        animal_level = game.level
    }
    moved: [SHOVEY_CELLS]bool
    for at: cast(s32)0..SHOVEY_CELLS - 1 { moved[at] = false }
    changed := false
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if moved[at] || !ShoveyAnimal(game.ground[at]) { continue }
        if animal_due[at] <= 0.0 { animal_due[at] = frame.now + AnimalWait(0.2, 1.6); continue }
        if frame.now < animal_due[at] { continue }
        to := ShoveyAnimalStep(*game, at, AnimalRoll())
        animal_due[at] = 0.0
        if to < 0 { continue }
        moved[to] = true
        animal_due[to] = frame.now + AnimalWait(0.5, 2.0)
        BoardGlideStart(at, to, frame.now)
        changed = true
    }
    return changed
}

// The throw control: a round glass button with the shot on it, floating over
// the board's bottom right corner, opposite where the pad rests, glowing and
// pulsing while it is there.
ThrowButton :: (width: float32, top: float32, bottom: float32) -> bool {
    short := ifx width < bottom - top then width else bottom - top
    size := short * 0.17
    if size < 64.0 { size = 64.0 }
    if size > 104.0 { size = 104.0 }
    bounds := Rectangle.{width - size - 16.0, bottom - size - 16.0, size, size}
    pulse := cast(float32)(0.5 + 0.5 * Math.Sin(frame.now * 4.0))
    glow := size * (0.08 + 0.06 * pulse)
    unused Box(frame.session, BoxProps.{.key = cast(u64)20060, .radius = (size + glow * 2.0) / 2.0,
            .bounds = Rectangle.{bounds.x - glow, bounds.y - glow, size + glow * 2.0, size + glow * 2.0},
            .fill = Color.{255, 226, 150, cast(u8)(40.0 + 50.0 * pulse)}})
    unused Box(frame.session, BoxProps.{.key = cast(u64)20061, .bounds = bounds, .radius = size / 2.0,
            .fill = Color.{40, 46, 45, 200}, .border = Color.{255, 226, 150, 255}})
    // The drawn shot sits right of and below its frame's centre.
    shot := size * 1.25
    Image(frame.session, ImageProps.{.key = cast(u64)20062, .asset_path = sprite_files[SPRITE_SHOT],
            .alt_text = AppLocaleHost("shovey_ammo"), .fit = ImageFit.ImageFitContain, .smooth = true,
            .bounds = Rectangle.{bounds.x + (size - shot) / 2.0 - shot * 0.047, bounds.y + (size - shot) / 2.0 - shot * 0.078, shot, shot}})
    press := Press(frame.session, PressProps.{.key = cast(u64)20063, .id = 20063, .bounds = bounds,
            .label = AppLocaleHost("shovey_fire"), .now = frame.now})
    return press.clicked
}

// Moves (or throws, for direction -1) and plays what the move did.
ShoveyAct :: (direction: s32) -> bool {
    before := game
    changed := false
    if slide_next < slide_count { return false }
    if direction < 0 { changed = ShoveyFire(*game) }
    else if (game.powers & SHOVEY_SLIDE) != 0 || game.ground[game.player] == SHOVEY_ICE || ShoveyHasIce(*game) {
        slide_count = ShoveyMoveFrames(*game, direction, slide_boards[:])
        slide_next = 1
        if slide_count > 0 {
            changed = true
            slide_at = frame.now
            game = slide_boards[0]
            // Sound and the win check judge the board the slide ends on.
            final := slide_boards[slide_count - 1]
            PathAction(*completion_path, *before, slide_boards[:slide_count], direction)
            slid := ShoveyEvent(*before, *final)
            if slid != SHOVEY_EVENT_NONE && !SoundMuted() {
                sounds: [10]string = .["", "assets/shovey/sounds/push.wav", "assets/shovey/sounds/pit.wav",
                "assets/shovey/sounds/goal.wav", "assets/shovey/sounds/pickup.wav", "assets/shovey/sounds/door.wav",
                "assets/shovey/sounds/teleport.wav", "assets/shovey/sounds/shot.wav", "assets/shovey/sounds/won.wav",
                "assets/shovey/sounds/lost.wav"]
                unused AppSoundHost(sounds[slid])
            }
            return true
        }
        changed = ShoveyMove(*game, direction)
    } else { changed = ShoveyMove(*game, direction) }
    if changed || game.direction != before.direction {
        result: [1]ShoveyGame
        result[0] = game
        PathAction(*completion_path, *before, result[:], direction)
    }
    event := SHOVEY_EVENT_NONE
    if changed { event = ShoveyEvent(*before, *game) }
    if event != SHOVEY_EVENT_NONE && !SoundMuted() {
        sounds: [10]string = .["", "assets/shovey/sounds/push.wav", "assets/shovey/sounds/pit.wav",
        "assets/shovey/sounds/goal.wav", "assets/shovey/sounds/pickup.wav", "assets/shovey/sounds/door.wav",
        "assets/shovey/sounds/teleport.wav", "assets/shovey/sounds/shot.wav", "assets/shovey/sounds/won.wav",
        "assets/shovey/sounds/lost.wav"]
        unused AppSoundHost(sounds[event])
    }
    return changed
}

// A level's picture built with this release, or its board drawn small when
// the level changed since.
LevelPicture :: (number: s32, picture: Rectangle, image_key: u64, board_key: u64, landscape: bool) {
    at := number - 1
    digits: [24]u8
    label := FormatInteger(cast(s64)number, digits[:])
    if level_preview_paths[at][0] == 0 {
        level_preview_current[at] = ShoveyLevelBoard(number) == ShoveyLevelData(number)
        length: s32 = 0
        AppendText(level_preview_paths[at][:], *length, ifx landscape then "assets/shovey/levels-landscape/" else "assets/shovey/levels/")
        AppendText(level_preview_paths[at][:], *length, label)
        AppendText(level_preview_paths[at][:], *length, ".png")
        level_preview_paths[at][length] = 0
    }
    if level_preview_current[at] { Image(frame.session, ImageProps.{.key = image_key,
                .asset_path = TextUntilNul(level_preview_paths[at][:]),
                .alt_text = label, .bounds = picture,
                .fit = ImageFit.ImageFitContain, .smooth = true}) }
    else { ShoveyBoardPreview(frame.session, number, picture, board_key, sprite_names[:], landscape) }
}

ResetLevelPreviews :: (landscape: bool) {
    if level_preview_landscape == landscape && level_preview_paths[0][0] != 0 { return }
    for at: cast(s32)0..ShoveyLevelCount() - 1 {
        level_preview_paths[at][0] = 0
    }
    level_preview_landscape = landscape
}

// Hosts keep records below 64 KiB, so the cached campaign is split.
LiveChunkName :: (index: s32) -> string {
    length: s32 = 0
    digits: [24]u8
    AppendText(live_names[index][:], *length, "live-campaign-")
    AppendText(live_names[index][:], *length, FormatInteger(cast(s64)index, digits[:]))
    return TextView(live_names[index][:length])
}

LiveCacheRead :: () -> string {
    live_cache_length = 0
    for index: cast(s32)0..LIVE_CHUNKS - 1 {
        chunk := AppRecordHost(LiveChunkName(index))
        if chunk == "" || chunk.count > LIVE_CHUNK { break }
        for byte: chunk { live_cache[live_cache_length] = byte; live_cache_length += 1 }
        if chunk.count < LIVE_CHUNK { break }
    }
    return TextView(live_cache[:live_cache_length])
}

LiveCacheWrite :: (document: string) -> bool {
    if document.count >= LIVE_CHUNK * LIVE_CHUNKS { return false }
    // Full chunks, then one shorter, possibly empty, chunk that ends it.
    at: s64 = 0
    for index: cast(s32)0..LIVE_CHUNKS - 1 {
        end := ifx at + LIVE_CHUNK < document.count then at + LIVE_CHUNK else document.count
        if !SaveAppRecordHost(LiveChunkName(index), document[at:end]) { return false }
        if end - at < LIVE_CHUNK {
            return SaveAppRecordHost("live-campaign-base", SHOVEY_APPROVED_CAMPAIGN_MARK)
        }
        at = end
    }
    return true
}

// The website always plays the node's latest levels. Standalone Shovey and
// Arcade ask once on their covers whether games download new levels and pass
// the answer on as arcade.updates, which Help changes. Inside Breeze, which
// updates the games themselves, a game never fetches levels on its own.
LevelUpdates :: () -> s32 {
    #if SHOVEY_ALWAYS_UPDATES {
        return 1
    }
    if level_updates < 0 {
        level_updates = ifx AppSupports("arcade.updates") && AppService("arcade.updates", "get") == "on" then 1 else 0
    }
    return level_updates
}

LevelUpdatesSet :: (on: bool) {
    was := level_updates
    if !AppSupports("arcade.updates") || AppService("arcade.updates", ifx on then "set-on" else "set-off") == "" { return }
    level_updates = ifx on then 1 else 0
    if on && was != 1 { LiveCampaignFetch() }
}

// One request to the node's publications, from the host or, in the
// compiled browser game, straight from Entity's reader.
LiveAsk :: (request: string) -> string {
    #if SHOVEY_READS_NODE {
        return PublicationsReadAnswer(request)
    }
    #if SHOVEY_ASKS_HOST {
        return AppService(live_service, request)
    }
}

// The cached live campaign replaces the built-in levels before progress is
// restored; with updates on, the node's latest is then fetched once per
// session.
LiveCampaignStart :: () {
    shovey_live_count = 0
    cached := LiveCacheRead()
    if cached != "" { unused ShoveyLiveLoadCached(cached, AppRecordHost("live-campaign-base")) }
    // A campaign shorter than this release's is older than it.
    if shovey_live_count < SHOVEY_APPROVED_LEVEL_COUNT { shovey_live_count = 0 }
    if LevelUpdates() == 1 { LiveCampaignFetch() }
}

LiveCampaignFetch :: () {
    live_service = "publications.read"
    #if SHOVEY_ASKS_HOST {
        live_service = ""
        if AppSupports("publications") { live_service = "publications" }
        else if AppSupports("publications.read") { live_service = "publications.read" }
    }
    if live_service == "" { return }
    length: s32 = 0
    AppendText(live_bytes[:], *length, "{\"operation\":\"fetch\",\"id\":\"")
    AppendText(live_bytes[:], *length, LIVE_CAMPAIGN_ID)
    AppendText(live_bytes[:], *length, "\"}")
    reply := LiveAsk(TextView(live_bytes[:length]))
    number_at := FieldAt(reply, 0, "request")
    end := ValueEnd(reply, number_at, 0)
    if number_at < 0 || end <= number_at || end - number_at >= live_request.count { return }
    for index: cast(s32)0..end - number_at - 1 { live_request[index] = reply[number_at + index] }
    live_request[end - number_at] = 0
    live_waiting = true
    live_poll_at = frame.now
}

LiveCampaignPump :: () {
    if !live_waiting || frame.now < live_poll_at { return }
    live_poll_at = frame.now + 0.5
    length: s32 = 0
    AppendText(live_bytes[:], *length, "{\"operation\":\"status\",\"request\":")
    AppendText(live_bytes[:], *length, TextUntilNul(live_request[:]))
    AppendText(live_bytes[:], *length, "}")
    reply := LiveAsk(TextView(live_bytes[:length]))
    status: [16]u8
    if ReadStringText(reply, FieldAt(reply, 0, "status"), status[:]) < 0 { live_waiting = false; return }
    if TextUntilNul(status[:]) == "pending" { return }
    live_waiting = false
    if TextUntilNul(status[:]) != "done" { return }
    document_at := FieldAt(reply, 0, "document")
    end := ValueEnd(reply, document_at, 0)
    if document_at < 0 || end <= document_at || end - document_at > live_document.count { return }
    // A campaign already checked is not checked again.
    mark: u64 = 2166136261
    for at: cast(s64)document_at..end - 1 { mark = ((mark ^ cast(u64)reply[at]) * 16777619) & 4294967295 }
    digits: [24]u8
    mark_text := FormatInteger(cast(s64)mark, digits[:])
    if ShoveyLiveAlreadyChecked(mark_text, AppRecordHost("live-campaign-mark"),
        AppRecordHost("live-campaign-base")) { return }
    for at: cast(s64)0..mark_text.count - 1 { live_mark[at] = mark_text[at] }
    live_mark[mark_text.count] = 0
    for at: cast(s64)document_at..end - 1 { live_document[at - document_at] = reply[at] }
    live_checking = ShoveyLiveCheckStart(TextView(live_document[:end - document_at]))
}

// Checks a downloaded campaign a few moves per frame, then switches to it.
LiveCampaignCheck :: () {
    if !live_checking { return }
    compact: string
    result := ShoveyLiveCheckStep(40, *compact)
    if result < 0 { return }
    live_checking = false
    if result == 0 { return }
    if shovey_live_count < SHOVEY_APPROVED_LEVEL_COUNT {
        // Older than this release: keep the levels it ships, or the newer
        // campaign saved earlier.
        shovey_live_count = 0
        cached := LiveCacheRead()
        if cached != "" { unused ShoveyLiveLoadCached(cached, AppRecordHost("live-campaign-base")) }
        if shovey_live_count < SHOVEY_APPROVED_LEVEL_COUNT { shovey_live_count = 0 }
        unused SaveAppRecordHost("live-campaign-mark", TextUntilNul(live_mark[:]))
        return
    }
    if compact != LiveCacheRead() || AppRecordHost("live-campaign-base") != SHOVEY_APPROVED_CAMPAIGN_MARK {
        unused LiveCacheWrite(compact)
    }
    unused SaveAppRecordHost("live-campaign-mark", TextUntilNul(live_mark[:]))
    LevelReplayReset(TextUntilNul(shared_progress.owner[:]))
    for at: cast(s32)0..SHOVEY_PROGRESS_LEVELS - 1 { level_preview_paths[at][0] = 0 }
    // An untouched level reopens on its new board; a level in play keeps its
    // board until it is restarted or left.
    if !game.won && game.moves == 0 && game.level <= ShoveyLevelCount() {
        unused ShoveyLoad(*game, game.level)
        PathStart(*completion_path, *game, ShoveyLevelBoard(game.level), TextUntilNul(shared_progress.owner[:]))
        ReplayOpened()
    }
}

// A won level stays on screen for a moment and dips to dark, and the next
// level fades in (level_change.zi), instead of its board replacing the last
// in one frame. These hold when each part began, or 0.
won_at: float64;
entered_at: float64;

ContinueGame :: () {
    slide_count = 0
    slide_next = 0
    advanced := ShoveyContinue(*progress, *game)
    // Past the last level Continue opens it afresh, not its ending.
    if game.won && game.level >= ShoveyLevelCount() { advanced = ShoveyLoad(*game, ShoveyLevelCount()) }
    // Continuing an attempt keeps its exact map and route, even if a newer
    // campaign arrived while playing. Only a newly opened board is acknowledged.
    if advanced { PathStart(*completion_path, *game, ShoveyLevelBoard(game.level), TextUntilNul(shared_progress.owner[:])) }
    ReplayOpened()
    selector_open = false
    help_open = false
    last_tick = frame.now
    won_at = 0.0
    entered_at = frame.now
    Remember()
}

// Milliseconds since a moment of a level change, within a minute.
LevelChangeMs :: (since: float64) -> s32 {
    elapsed := frame.now - since
    if elapsed <= 0.0 { return 0 }
    if elapsed >= 60.0 { return 60000 }
    return cast(s32)(elapsed * 1000.0)
}

// The win is saved at once; the next level follows after the pause.
WinPause :: () {
    if won_at == 0.0 {
        won_at = frame.now
        Remember()
    }
    if LevelWinContinues(LevelChangeMs(won_at)) { ContinueGame() }
}

// The campaign's end. Once Shovey steps onto the bridge of the last level
// he walks out to the boat by himself and jumps aboard; the boat sails away
// with him (shovey_board.zi draws it) while the camera follows it out over
// open water, the picture fades, and THE END rolls over the campaign's
// boards until a level is chosen. A last level won at a house rests a moment
// first.
SAIL_SECONDS :: 14.0
ENDING_REST_SECONDS :: 1.6
ENDING_FADE_SECONDS :: 2.5
ENDING_ROW_SECONDS :: 2.6
ending_level: s32;
ending_won_at: float64;
ending_at: float64;
// Shovey jumps into a boat beside him by himself once everything is done,
// a moment after he arrives; this holds when he arrived, or 0.
BOAT_JUMP_WAIT :: 0.25
boat_beside_at: float64;

// The walk out along the bridge: the steps, the next one, and when the
// last was taken. walk_tried is where a walk was looked for, so a cell with
// no way to the boat is searched once.
WALK_SECONDS :: 0.16
walk_steps: [SHOVEY_CELLS]s32;
walk_count: s32;
walk_next: s32;
walk_at: float64;
walk_level: s32;
walk_tried: s32 = -1;
// The board's corner, cell and size where it rests, from the last frame
// without a camera; and the boat's middle when it cast off, 0 until then.
scene_cell: float32;
scene_origin: Vector2;
scene_size: Vector2;
sail_start_x: float32;
sail_start_y: float32;
// How far the camera has zoomed out once the boat has made way.
BOAT_ZOOM :: 0.7
ocean_layers: [4096]s32;

// The secret levels: off the top edge of the last level's beach lies 175a,
// off its bottom edge 175b, and back again (engine directions: up the beach
// is 2, down is 0). The same downward edge on 29's sand leads to 29a.
// Boards slide past each other; the exact parent board waits in secret_visit.
EDGE_SECONDS :: 0.55
edge_from: s32;
edge_at: float64;
edge_visible: s32;
secret_visit: ShoveySecretVisit;
// Steps Shovey across an open edge into the board beyond; false when the
// step stays on this board.
EdgeTravel :: (direction: s32, landscape: bool) -> bool {
    previous := game.level
    if !ShoveySecretEdge(*game, *secret_visit, direction) { return false }
    if game.level == CHEST_LEVEL {
        unused PathSaveRecord("local.secret29a", "1")
    }
    edge_from = previous
    edge_at = frame.now
    edge_visible = ifx landscape then (direction + 3) % 4 else direction
    // The campaign route waits with its exact parent board. Secret actions
    // belong to another map and never become invented parent-route steps.
    slide_count = 0
    slide_next = 0
    walk_count = 0
    won_at = 0.0
    return true
}

// A step, or a crossing into the board beyond an open edge.
ShoveyStepOrCross :: (direction: s32, landscape: bool) -> bool {
    if EdgeTravel(direction, landscape) { return true }
    return ShoveyAct(direction)
}

// 0 to 1 while the boards slide after a crossing, or -1.
EdgeSlide :: () -> float32 {
    if edge_at <= 0.0 { return -1.0 }
    share := cast(float32)((frame.now - edge_at) / EDGE_SECONDS)
    if share >= 1.0 { edge_at = 0.0; return -1.0 }
    return share
}

// A secret level won rests a moment, then Shovey is back on the last level
// where he left it.
SecretWinPause :: () {
    if won_at == 0.0 { won_at = frame.now }
    if !LevelWinContinues(LevelChangeMs(won_at)) { return }
    if !ShoveyReturnFromSecret(*game, *secret_visit) { return }
    won_at = 0.0
    entered_at = frame.now
}

// Open water: the engine keeps water as ground 64; nothing floats or stands
// in it.
OpenWater :: (at: s32) -> bool {
    return at >= 0 && game.tiles[at] == 64 && game.ground[at] == 64 && game.objects[at] == 0
}

// Whether Shovey stands on a bridge: floor with open water at both sides.
OnBridge :: () -> bool {
    at := game.player
    if at < 0 || game.tiles[at] == 64 { return false }
    return (OpenWater(ShoveyNeighbor(at, 0)) && OpenWater(ShoveyNeighbor(at, 2))) ||
    (OpenWater(ShoveyNeighbor(at, 1)) && OpenWater(ShoveyNeighbor(at, 3)))
}

// Finds Shovey's walk to the boat through the engine, step by step from
// each cell he can reach; false when there is none.
BoatWalk :: () -> bool {
    from: [SHOVEY_CELLS]s32
    way: [SHOVEY_CELLS]s32
    queue: [SHOVEY_CELLS]s32
    if game.player < 0 { return false }
    for at: cast(s32)0..SHOVEY_CELLS - 1 { from[at] = -2 }
    from[game.player] = -1
    queue[0] = game.player
    head: s32 = 0
    tail: s32 = 1
    goal: s32 = -1
    while head < tail && goal < 0 {
        at := queue[head]
        head += 1
        for side: cast(s32)0..3 {
            probe := game
            probe.player = at
            if !ShoveyMove(*probe, side) || probe.player < 0 || probe.player == at || from[probe.player] != -2 { continue }
            from[probe.player] = at
            way[probe.player] = side
            queue[tail] = probe.player
            tail += 1
            if probe.won { goal = probe.player; break }
        }
    }
    if goal < 0 { return false }
    count: s32 = 0
    at := goal
    while from[at] >= 0 { count += 1; at = from[at] }
    at = goal
    index := count - 1
    while index >= 0 { walk_steps[index] = way[at]; at = from[at]; index -= 1 }
    walk_count = count
    return true
}

// Open water all round the area while the camera follows the boat out to
// sea, its cells in step with the board's, which start at origin.
OceanBackdrop :: (area: Rectangle, origin: Vector2, cell: float32, landscape: bool) {
    if cell <= 1.0 { return }
    first := Vector2.{origin.x - cell * BackdropSteps(origin.x - area.x, cell), origin.y - cell * BackdropSteps(origin.y - area.y, cell)}
    columns := cast(s32)((area.x + area.width - first.x) / cell) + 1
    rows := cast(s32)((area.y + area.height - first.y) / cell) + 1
    if columns < 1 || rows < 1 || cast(s64)(columns * rows) > ocean_layers.count { return }
    water := KindSprite(*game, 64, -1, frame.now, landscape)
    for at: cast(s32)0..columns * rows - 1 { ocean_layers[at] = water }
    unused TileMap(frame.session, TileMapProps.{.key = cast(u64)20099,
            .bounds = Rectangle.{first.x, first.y, cast(float32)columns * cell, cast(float32)rows * cell},
            .columns = columns, .rows = rows, .tiles = ifx landscape then landscape_sprite_files[:] else sprite_files[:],
            .names = sprite_names[:], .layers = ocean_layers[:columns * rows], .layer_count = 1, .label = "", .pixel_snap = board_pixel_snap})
}

// The screen direction of an engine direction: in landscape the board is
// turned a quarter, so its directions are one quarter behind the screen's.
EngineVector :: (engine: s32, landscape: bool) -> Vector2 {
    visible := ifx landscape then (engine + 3) % 4 else engine
    vectors: [4]Vector2 = .[Vector2.{-1.0, 0.0}, Vector2.{0.0, -1.0}, Vector2.{1.0, 0.0}, Vector2.{0.0, 1.0}]
    return vectors[visible]
}

// The boards round the last level while the ending plays, so the camera
// shows one island: the secret beaches 175a and 175b continue its shore up
// and down the coast, and the levels Shovey came through lie inland.
NeighbourBoards :: (origin: Vector2, size: Vector2, landscape: bool) {
    up := EngineVector(2, landscape)
    inland := EngineVector(1, landscape)
    steps: [8]Vector2 = .[Vector2.{0.0, 1.0}, Vector2.{0.0, -1.0}, Vector2.{1.0, 0.0}, Vector2.{1.0, 1.0},
    Vector2.{1.0, -1.0}, Vector2.{2.0, 0.0}, Vector2.{2.0, 1.0}, Vector2.{2.0, -1.0}]
    for index: cast(s32)0..7 {
        level := ifx index == 0 then SHOVEY_SECRET_UP else ifx index == 1 then SHOVEY_SECRET_DOWN else game.level - index + 1
        if level < 1 { continue }
        away := Vector2.{inland.x * steps[index].x + up.x * steps[index].y, inland.y * steps[index].x + up.y * steps[index].y}
        ShoveyBoardPreview(frame.session, level, Rectangle.{origin.x + away.x * size.x, origin.y + away.y * size.y,
                size.x, size.y}, cast(u64)(62000 + index * 16), sprite_names[:], landscape, true)
    }
}

// 0 to 1 eased in and out, from a share of a stretch of time.
EaseInOut :: (share: float32) -> float32 {
    t: float32 = ifx share < 0.0 then 0.0 else ifx share > 1.0 then 1.0 else share
    return t * t * (3.0 - 2.0 * t)
}

// Whole cells from a board edge back past the area's edge, `gap` away.
BackdropSteps :: (gap: float32, cell: float32) -> float32 {
    steps := gap / cell
    whole := cast(float32)cast(s32)steps
    if whole > steps { whole -= 1.0 }
    return whole + 1.0
}

// The way to a boat beside Shovey, or -1.
BoatBeside :: () -> s32 {
    for side: cast(s32)0..3 {
        next := ShoveyNeighbor(game.player, side)
        if next >= 0 && game.ground[next] == SHOVEY_BOAT { return side }
    }
    return -1
}

// Follows the win of the last level: when it was won, how far the boat has
// sailed, and when THE END began.
EndingPump :: () {
    if !game.won || game.level != ShoveyLevelCount() || slide_next < slide_count {
        ending_won_at = 0.0
        ending_at = 0.0
        board_sail = -1.0
        return
    }
    if ending_won_at == 0.0 || ending_level != game.level {
        ending_won_at = frame.now
        ending_level = game.level
        ending_at = 0.0
    }
    elapsed := cast(float32)(frame.now - ending_won_at)
    aboard := game.player >= 0 && game.ground[game.player] == SHOVEY_BOAT
    wait := ifx aboard then SAIL_SECONDS else ENDING_REST_SECONDS
    board_sail = ifx !aboard then -1.0 else ifx elapsed >= wait then 1.0 else elapsed / wait
    if ending_at == 0.0 && elapsed >= wait { ending_at = frame.now }
}

// How far the board has faded into the slate before THE END, 0 to 1.
EndingShade :: () -> float32 {
    if ending_won_at == 0.0 { return 0.0 }
    elapsed := cast(float32)(frame.now - ending_won_at)
    wait := ifx board_sail >= 0.0 then SAIL_SECONDS else ENDING_REST_SECONDS
    shade := (elapsed - (wait - ENDING_FADE_SECONDS)) / ENDING_FADE_SECONDS
    return ifx shade < 0.0 then 0.0 else ifx shade > 1.0 then 1.0 else shade
}

// THE END over the campaign's boards, which roll slowly upwards in a loop,
// on the whole screen with no bar: a click, a touch or Enter goes back to
// the title, and the game opens on the level list from then on.
EndingScreen :: (width: float32, top: float32, bottom: float32, key: s32) {
    area := Rectangle.{0.0, top, width, bottom - top}
    board_pixel_snap = true
    landscape := BoardLandscape(width, bottom - top)
    ResetLevelPreviews(landscape)
    SpriteNames()
    columns: s32 = ifx landscape then 4 else 3
    gap: float32 = 12.0
    card_width := (width - gap * cast(float32)(columns + 1)) / cast(float32)columns
    card_height := card_width * ifx landscape then 3.0 / 5.0 else 5.0 / 3.0
    row_height := card_height + gap
    count := ShoveyLevelCount()
    rows := (count + columns - 1) / columns
    rolled := cast(float32)((frame.now - ending_at) / ENDING_ROW_SECONDS) * row_height
    first := cast(s32)(rolled / row_height)
    shown := cast(s32)(area.height / row_height) + 2
    // The boards roll inside a still scroll area, which keeps them on the
    // screen.
    clip := Scroll(frame.session, ScrollProps.{.key = cast(u64)20110, .bounds = area, .content_height = cast(s32)area.height})
    if clip.opened {
        for slot: cast(s32)0..shown - 1 {
            row := first + slot
            y := clip.content.y + gap + cast(float32)row * row_height - rolled
            for column: cast(s32)0..columns - 1 {
                number := (row % rows) * columns + column + 1
                if number > count { continue }
                part := slot * columns + column
                LevelPicture(number, Rectangle.{clip.content.x + gap + cast(float32)column * (card_width + gap), y, card_width, card_height},
                    cast(u64)(60000 + part), cast(u64)(61000 + part * 8), landscape)
            }
        }
        End(frame.session)
    }
    // A veil over the boards keeps the words clear; the first moments rise
    // out of the slate the board faded into.
    veil := ColorFromPacked(cast(u32)SHOVEY_SLATE)
    rise := cast(float32)((frame.now - ending_at) / ENDING_FADE_SECONDS)
    veil.a = cast(u8)(ifx rise >= 1.0 then 170.0 else 255.0 - 85.0 * rise)
    Fill(cast(u64)20098, area, veil)
    middle := area.y + area.height * 0.42
    Caption(20025, Rectangle.{16.0, middle - 44.0, width - 32.0, 72.0}, AppLocaleHost("shovey_the_end"), 52, true)
    Caption(20026, Rectangle.{24.0, middle + 36.0, width - 48.0, 64.0}, AppLocaleHost("shovey_finale"), 18, true)
    press := Press(frame.session, PressProps.{.key = cast(u64)20111, .id = 20111, .bounds = area,
            .label = AppLocaleHost("shovey_back"), .now = frame.now})
    if press.clicked || key == 257 || key == 32 || key == 256 {
        OpenLevels()
        LeaveForGameSelection()
    }
    RewardCard(width, bottom)
}

// A chest stays available until the node confirms its reward. Closing its
// dialog never marks that reward as claimed.
RewardCard :: (width: float32, bottom: float32) {
    if reward_card < 0 { return }
    campaign := reward_card == REWARD_CAMPAIGN
    // Claimed on another device before the player asked here: nothing to say.
    if campaign && reward_card_empty && !reward_asked[reward_card] {
        reward_card = -1
        return
    }
    title := AppLocaleHost(ifx campaign then "shovey_campaign_reward" else
        ifx reward_card_empty then "shovey_chest_empty" else "shovey_chest_found")
    detail: Vec(u8)
    defer { VecFree(detail) }
    if reward_card_empty {
        BuilderPrint(*detail, "%", AppLocaleHost(ifx campaign then "shovey_reward_claimed" else "shovey_chest_empty_detail"))
    } else if reward_card_signin {
        BuilderPrint(*detail, "%", AppLocaleHost("shovey_reward_signin"))
    } else if reward_card_amount[0] != 0 {
        BuilderPrint(*detail, "+% %", TextUntilNul(reward_card_amount[:]), AppLocaleHost("shovey_dew"))
    } else if reward_card_failed {
        BuilderPrint(*detail, "%", AppLocaleHost(ifx !reward_card_ineligible then "shovey_reward_failed" else
            ifx reward_card == REWARD_CHEST then "shovey_reward_chest_requirements" else "shovey_reward_campaign_requirements"))
    } else {
        BuilderPrint(*detail, "%", AppLocaleHost(ifx reward_claiming == reward_card then
            "shovey_reward_pending" else "shovey_reward_unclaimed"))
    }
    actions: [2]ActionModalAction
    count: s64 = 0
    can_retry := !reward_card_empty && reward_card_amount[0] == 0 && reward_claiming != reward_card
    if can_retry {
        actions[0] = ActionModalAction.{.label = AppLocaleHost(ifx reward_card_signin then
                "shovey_reward_connect" else "shovey_reward_claim"),
            .tone = ButtonTone.ButtonToneAccent, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}
        count += 1
    }
    actions[count] = ActionModalAction.{.label = AppLocaleHost("shovey_close"),
        .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}
    count += 1
    result := ActionModal(frame.session, ActionModalProps.{.key = cast(u64)20120, .id = 20120,
            .title = title, .message = TextView(VecSlice(detail, 0, detail.count)), .max_width = 440,
            .show_close = true, .close_label = AppLocaleHost("shovey_close")}, actions[:count])
    if can_retry && result.action == 1 {
        if reward_card_signin { unused AppService("entity.profile", "open") }
        else { RewardRetry(reward_card, frame.now) }
    } else if result.action != 0 {
        reward_card = -1
    }
}

// Every level completed: the game then opens on the level list.
ShoveyAllDone :: () -> bool {
    for level: cast(s32)1..ShoveyLevelCount() {
        if !progress.completed[level - 1] { return false }
    }
    return true
}

// How dark the board is at this moment of a level change, 0 to 1.
LevelChangeShade :: () -> float32 {
    since_win := ifx won_at > 0.0 then LevelChangeMs(won_at) else -1
    since_enter := ifx entered_at > 0.0 then LevelChangeMs(entered_at) else -1
    if since_enter >= LEVEL_ENTER_FADE_MS { entered_at = 0.0 }
    return cast(float32)LevelChangeShadeAt(since_win, since_enter) / cast(float32)LEVEL_SHADE_FULL
}

// Back from the level list or help returns to the level; false while
// playing, so the host returns to the cover that opened the game.
ShoveyBack :: () -> bool {
    if reward_card >= 0 { reward_card = -1; return true }
    if !selector_open && !help_open { return false }
    selector_open = false
    help_open = false
    return true
}

ReplayOpened :: () {
    if ShoveySecret(game.level) || completion_path.level != game.level { return }
    replay_ack_failed = !LevelReplayOpened(game.level, TextUntilNul(completion_path.map[:]), TextUntilNul(shared_progress.owner[:]), ShoveyLevelBoard(game.level))
    if replay_ack_failed { save_failed = true }
}

ShoveyFrame :: () {
    frame = ReadAppUiHost()
    if !loaded {
        // The host's cover is the title: every open goes straight to play.
        mini = AppMini()
        LiveCampaignStart()
        if shared_account_changed || !ShoveyCampaignRestore(*progress, *game, LocalCampaignRecord()) {
            if !shared_account_changed && ShoveyRestore(*game, AppRecordHost("position")) {
                progress = ShoveyMigrateProgress(*game)
                // That record predates the shipped boards: restart its level.
                unused ShoveyLoad(*game, game.level)
            } else {
                unused ShoveyLoad(*game, 1)
                progress = ShoveyProgressNew()
            }
        }
        shared_account_changed = false
        SharedProgressStart(*shared_progress, ShoveySharedRecord(*progress), frame.now)
        if shared_progress.available { ShoveySharedRestore(*progress, *shared_progress.record) }
        // Entering play keeps the campaign, so its record exists from the
        // start; an embedded mini page saves only once something changes.
        latest := ShoveyOpenLatest(*progress, *game)
        if latest || !PathRestore(*completion_path, *game) {
            PathStart(*completion_path, *game, ShoveyLevelBoard(game.level), TextUntilNul(shared_progress.owner[:]))
        }
        ReplayOpened()
        if latest || !mini { Remember() }
        if ShoveyAllDone() { OpenLevels() }
        ReportSolvedLevels(progress.completed[:], *reported_levels)
        last_tick = frame.now
        loaded = true
    }
    LiveCampaignPump()
    LiveCampaignCheck()
    // Finishing every level earns the campaign's reward, also for players
    // who finished before it existed.
    if !RewardEarned(REWARD_CAMPAIGN) && ShoveyAllDone() { RewardEarn(REWARD_CAMPAIGN, frame.now) }
    // Its modal asks the player to claim it, after the boat has sailed off.
    last_won := game.won && game.level == ShoveyLevelCount()
    if !help_open && (!last_won || ending_at > 0.0) { RewardOffer(REWARD_CAMPAIGN) }
    RewardsPump(frame.now)
    shared_change := SharedProgressPump(*shared_progress, frame.now, ShoveySecret(game.level) || (game.moves > 0 && !game.won))
    if shared_change == 2 { loaded = false; shared_account_changed = true; return }
    // Hydration may finish while an untouched board is idle. Bind that fresh
    // attempt to the cached owner; active attempts retain their original owner.
    if game.moves == 0 && completion_path.actions_count == 0 && !game.won && !game.lost &&
    TextUntilNul(completion_path.owner[:]) != TextUntilNul(shared_progress.owner[:]) {
        PathStart(*completion_path, *game, ShoveyLevelBoard(game.level), TextUntilNul(shared_progress.owner[:]))
        ReplayOpened()
    }
    if shared_change == 1 {
        LevelReplayReset(TextUntilNul(shared_progress.owner[:]))
        ShoveySharedRestore(*progress, *shared_progress.record)
        // Account hydration can finish after the first frame. Open its
        // latest puzzle unless this device already has a board in progress.
        if ShoveyOpenLatest(*progress, *game) {
            PathStart(*completion_path, *game, ShoveyLevelBoard(game.level), TextUntilNul(shared_progress.owner[:]))
            ReplayOpened()
            Remember()
        }
        ReportSolvedLevels(progress.completed[:], *reported_levels)
    }
    width := cast(float32)frame.width
    top := cast(float32)frame.top
    bottom := cast(float32)(frame.height - frame.bottom)
    ShoveyDress(frame.session, width, top, bottom)
    key := AppKeyHost()
    if reward_card >= 0 {
        if key == 256 || key == 4 { reward_card = -1 }
        key = 0
    }
    if selector_open && key == 256 {
        unused ShoveyBack()
        key = 0
    }
    if selector_open {
        landscape := BoardLandscape(width, bottom - top)
        ResetLevelPreviews(landscape)
        if Button(frame.session, ButtonProps.{.key = cast(u64)20022, .id = 20022,
                .bounds = Rectangle.{12.0, top + 8.0, 112.0, 48.0}, .label = AppLocaleHost("shovey_back"),
                .icon_shape = ICON_PREVIOUS, .fit_content = true,
                .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
            if !ShoveyBack() { LeaveForGameSelection() }
            return
        }
        heading_x: float32 = 136.0
        Caption(20103, Rectangle.{heading_x, top + 12.0, width - 144.0 - heading_x, 44.0}, AppLocaleHost("shovey_levels"), 24)
        if Control(20104, Rectangle.{width - 128.0, top + 12.0, 112.0, 44.0}, AppLocaleHost("shovey_continue")) {
            ContinueGame()
        }
        columns := cast(s32)((width - 24.0) / 112.0)
        if columns < 2 { columns = 2 }
        listed := ShoveyLevelCount()
        rows := (listed + columns - 1) / columns
        cell := (width - 32.0 - cast(float32)(columns - 1) * 8.0) / cast(float32)columns
        preview_height := (cell - 12.0) * ifx landscape then 3.0 / 5.0 else 5.0 / 3.0
        row_height := cast(s32)(preview_height + 52.0 + 8.0)
        if levels_focus_pending {
            latest := progress.unlocked
            if latest < 1 { latest = 1 }
            if latest > listed { latest = listed }
            levels_scroll = (latest - 1) / columns * row_height
            levels_focus_pending = false
        }
        scroll := Scroll(frame.session, ScrollProps.{.key = cast(u64)20105,
                .bounds = Rectangle.{16.0, top + 72.0, width - 32.0, bottom - top - 88.0},
                .content_height = rows * row_height, .scroll_offset = levels_scroll})
        levels_scroll = scroll.scroll_offset
        if scroll.opened {
            SpriteNames()
            for slot: cast(s32)1..listed {
                number := slot
                at := slot - 1
                bounds := Rectangle.{scroll.content.x + cast(float32)(at % columns) * (cell + 8.0),
                    scroll.content.y + cast(float32)(at / columns) * cast(float32)row_height, cell, preview_height + 52.0}
                // Only the cards in view are built; slow phones paid for all of them every frame.
                if bounds.y + bounds.height < scroll.viewport.y || bounds.y > scroll.viewport.y + scroll.viewport.height { continue }
                unlocked := ShoveyLevelUnlocked(*progress, number)
                completed := progress.completed[number - 1]
                digits: [24]u8
                label := FormatInteger(cast(s64)number, digits[:])
                // Status stays accessible in the semantic label, while the
                // visual card uses a lock/check icon and an unlocked board.
                status := AppLocaleHost(ifx !unlocked then "shovey_locked" else ifx completed then "shovey_completed" else "shovey_available")
                if Button(frame.session, ButtonProps.{.key = cast(u64)(33000 + number), .id = 33000 + number,
                        .bounds = bounds, .label = label, .disabled = !unlocked,
                        .selected = completed, .fit_content = true,
                        .tone = ifx completed then ButtonTone.ButtonToneSuccess else ButtonTone.ButtonToneNeutral,
                        .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
                    ChangeLevel(number)
                }
                if unlocked {
                    // Cover the centered visual label only inside the picture
                    // area, then repeat the number in the card's footer.
                    picture := Rectangle.{bounds.x + 6.0, bounds.y + 6.0, bounds.width - 12.0, preview_height}
                    LevelPicture(number, picture, cast(u64)(35000 + number), cast(u64)(52000 + number), landscape)
                }
                {
                    Caption(cast(u64)(41000 + number), Rectangle.{bounds.x + 10.0, bounds.y + preview_height + 12.0, bounds.width - 48.0, 28.0}, label, 18)
                }
                icon := ""
                if !unlocked {
                    icon = "S2rr:M6 10H18V21H6ZM8 10V6L10 4H14L16 6V10M12 14V17"
                } else if completed {
                    icon = "S2rr:M5 12L10 17L19 7"
                }
                if icon != "" {
                    // A disabled icon button is a canonical widget, with a
                    // translated accessibility label and no extra action.
                    unused Button(frame.session, ButtonProps.{.key = cast(u64)(37000 + number),
                            .bounds = ifx unlocked then Rectangle.{bounds.x + bounds.width - 32.0, bounds.y + preview_height + 12.0, 28.0, 28.0} else
                            Rectangle.{bounds.x + bounds.width / 2.0 - 22.0, bounds.y + preview_height * 0.5 - 18.0, 44.0, 44.0},
                            .label = status, .icon_only = true, .icon_shape = icon, .disabled = true,
                            .tone = ifx completed then ButtonTone.ButtonToneSuccess else ButtonTone.ButtonToneNeutral,
                            .emphasis = ButtonEmphasis.ButtonEmphasisGhost})
                }
                if unlocked && LevelReplayDot(number, ShoveyLevelBoard(number), completed, TextUntilNul(shared_progress.owner[:])) {
                    unused Circle(frame.session, CircleProps.{.key = cast(u64)(43000 + number),
                            .center = Vector2.{bounds.x + bounds.width - 13.0, bounds.y + 13.0},
                            .radius = 4.0, .fill = Color.{255, 226, 150, 255}})
                }
            }
            End(frame.session)
        }
        LevelReplayPump(24)
        RewardCard(width, bottom)
        return
    }
    if game.won && game.level < ShoveyLevelCount() { WinPause() }
    if game.won && ShoveySecret(game.level) { SecretWinPause() }
    EndingPump()
    if key == 72 { help_open = !help_open }
    if key == 256 { help_open = false }
    if help_open {
        if Control(20022, Rectangle.{8.0, top + 6.0, 80.0, 44.0}, AppLocaleHost("shovey_back")) {
            if !ShoveyBack() { LeaveForGameSelection() }
            return
        }
        Caption(20001, Rectangle.{100.0, top + 6.0, width - 160.0, 44.0}, AppLocaleHost("shovey_help"), 20)
        // Closing the guide returns to the level, like H and Escape.
        if Control(20017, Rectangle.{width - 52.0, top + 6.0, 44.0, 44.0}, AppLocaleHost("shovey_close_help"), false, "", ICON_CLOSE) {
            help_open = false
            return
        }
        instructions := AppLocaleHost("shovey_instructions")
        intro_height := cast(float32)TextHeight(frame.session, TextProps.{.text = instructions,
                .bounds = Rectangle.{0.0, 0.0, width - 64.0, 0.0}, .font = 16, .wrap = TextWrap.TextWrapAuto}) + 16.0
        // The touch controls choice comes first, above the guide, then
        // whether an installed game downloads new levels.
        // Only standalone Shovey and Arcade keep this choice (arcade.updates).
        updates_setting := false
        #if SHOVEY_ASKS_UPDATES {
            updates_setting = AppSupports("arcade.updates")
        }
        friend_setting := !ShoveySecret(game.level) && game.level < ShoveyFinaleLevel()
        settings_height: float32 = (ifx updates_setting then 170.0 else 92.0) + (ifx friend_setting then 52.0 else 0.0)
        scroll := Scroll(frame.session, ScrollProps.{.key = cast(u64)20005,
                .bounds = Rectangle.{16.0, top + 62.0, width - 32.0, bottom - top - 70.0},
                .content_height = cast(s32)(settings_height + intro_height) + SHOVEY_HELP_COUNT * 68, .scroll_offset = help_scroll})
        help_scroll = scroll.scroll_offset
        if scroll.opened {
            Caption(20030, Rectangle.{scroll.content.x, scroll.content.y, scroll.content.width - 16.0, 28.0}, AppLocaleHost("shovey_controls_setting"), 16)
            choice_width := (scroll.content.width - 24.0) / 2.0
            pad := ControlsPad()
            if Choice(20031, Rectangle.{scroll.content.x, scroll.content.y + 34.0, choice_width, 44.0}, AppLocaleHost("shovey_controls_swipe"), !pad) {
                ControlsSetPad(false)
            }
            if Choice(20032, Rectangle.{scroll.content.x + choice_width + 8.0, scroll.content.y + 34.0, choice_width, 44.0}, AppLocaleHost("shovey_controls_pad"), pad) {
                ControlsSetPad(true)
            }
            if updates_setting {
                updates := LevelUpdates() == 1
                Caption(20033, Rectangle.{scroll.content.x, scroll.content.y + 90.0, scroll.content.width - 16.0, 28.0}, AppLocaleHost("shovey_updates_setting"), 16)
                if Choice(20034, Rectangle.{scroll.content.x, scroll.content.y + 124.0, choice_width, 44.0}, AppLocaleHost("shovey_updates_no"), !updates) {
                    LevelUpdatesSet(false)
                }
                if Choice(20035, Rectangle.{scroll.content.x + choice_width + 8.0, scroll.content.y + 124.0, choice_width, 44.0}, AppLocaleHost("shovey_updates_yes"), updates) {
                    LevelUpdatesSet(true)
                }
            }
            if friend_setting && Control(20606, Rectangle.{scroll.content.x, scroll.content.y + settings_height - 48.0, scroll.content.width - 16.0, 40.0},
                AppLocaleHost("shovey_friend_replay")) {
                GuideReplay(*friend_guide, *game)
                help_open = false
            }
            Caption(20006, Rectangle.{scroll.content.x, scroll.content.y + settings_height, scroll.content.width - 16.0, intro_height}, instructions)
            for index: cast(s32)0..SHOVEY_HELP_COUNT - 1 {
                kind := shovey_help_kinds[index]
                y := scroll.content.y + settings_height + intro_height + cast(float32)index * 68.0
                Tile(cast(u64)(40000 + index * 16), kind, Rectangle.{scroll.content.x, y, 40.0, 40.0})
                Caption(cast(u64)(45000 + index), Rectangle.{scroll.content.x + 52.0, y, scroll.content.width - 68.0, 44.0}, TileName(kind))
            }
            End(frame.session)
        }
        return
    }
    if ending_at > 0.0 {
        EndingScreen(width, top, bottom, key)
        return
    }
    // On the bridge Shovey walks the rest of the way by himself; from then
    // on the ending plays on the whole screen, without the bar or the status.
    walking := walk_count > 0 && walk_level == game.level && !game.won && !game.lost
    if !walking { walk_count = 0 }
    cinematic := walking || board_sail >= 0.0
    // Return sits at the edge, then the game's own navigation and status.
    if !cinematic {
        if !mini && Control(20022, Rectangle.{8.0, top + 4.0, 80.0, 44.0}, AppLocaleHost("shovey_back")) {
            if !ShoveyBack() { LeaveForGameSelection() }
            return
        }
        levels_x: float32 = ifx mini then 8.0 else 92.0
        if Control(20002, Rectangle.{levels_x, top + 4.0, 44.0, 44.0}, AppLocaleHost("shovey_levels"), false, "", ICON_LEVELS) {
            OpenLevels()
        }
        restart_x := ifx mini then width - 52.0 else width - 156.0
        Caption(20001, Rectangle.{levels_x + 48.0, top + 4.0, restart_x - levels_x - 48.0, 44.0}, HeaderText(), 14, true)
        if Control(20016, Rectangle.{restart_x, top + 4.0, 44.0, 44.0}, AppLocaleHost("shovey_restart"), false, "", ICON_RESTART) {
            ChangeLevel(game.level)
        }
        if !mini && Control(20017, Rectangle.{width - 104.0, top + 4.0, 44.0, 44.0},
            AppLocaleHost(ifx help_open then "shovey_close_help" else "shovey_help"), false, "",
            ifx help_open then ICON_CLOSE else ICON_HELP) {
            help_open = !help_open
        }
        if !mini && Control(20023, Rectangle.{width - 52.0, top + 4.0, 44.0, 44.0},
            AppLocaleHost(ifx SoundMuted() then "shovey_unmute" else "shovey_mute"), false, "",
            ifx SoundMuted() then ICON_SOUND_OFF else ICON_SOUND_ON) {
            SoundSetMuted(!SoundMuted())
        }
    }
    // The board fills the space under the bar, in portrait or landscape.
    status_y := top + 52.0
    area := Rectangle.{8.0, status_y + 28.0, width - 16.0, bottom - status_y - 36.0}
    FriendPrepare()
    pad_mode := ControlsPad() && !mini
    landscape := BoardLandscape(area.width, area.height)
    before_direction := game.direction
    changed := false
    keyed: s32 = -1
    if key == 263 || key == 65 { keyed = 0 }
    if key == 265 || key == 87 { keyed = 1 }
    if key == 262 || key == 68 { keyed = 2 }
    if key == 264 || key == 83 { keyed = 3 }
    // Until the controls question is answered it takes every key.
    choosing := !mini && !ControlsChosen()
    guiding := !mini && !cinematic && !game.won && !ShoveySecret(game.level) && GuideNext(*friend_guide) >= 0
    friend_key := key
    if choosing || guiding || walking || edge_at > 0.0 || reward_card >= 0 { keyed = -1; key = 0 }
    if keyed >= 0 { changed = ShoveyStepOrCross(BoardEngineDirection(keyed, landscape), landscape) }
    if key == 32 { changed = ShoveyAct(-1) }
    if key == 82 { ChangeLevel(game.level) }
    if !guiding && slide_next < slide_count && frame.now - slide_at >= SLIDE_SECONDS {
        game = slide_boards[slide_next]
        slide_next += 1
        slide_at = frame.now
        changed = true
    }
    sliding := slide_next < slide_count
    // Moving blocks and animals never decide a level, so their steps are
    // saved with the next move instead of writing the save every second.
    if !guiding && !sliding && frame.now - last_tick >= 1.0 {
        unused ShoveyBlocksTick(*game)
        last_tick = frame.now
    }
    if !guiding && !sliding { unused AnimalsWander() }
    if guiding { last_tick = frame.now; slide_at = frame.now; boat_beside_at = 0.0 }
    SpriteNames()
    // While the ending plays the whole screen is the scene: the island the
    // last level belongs to and the open water round it. Once the boat sails
    // the camera follows it, catching up gently and keeping it in the middle.
    // The scene is drawn as the board lay at rest, seen through a camera
    // that eases from the middle of the screen onto the boat and zooms out
    // gently, so more of the island shows as they sail.
    screen := Rectangle.{0.0, top, width, bottom - top}
    centre := Vector2.{screen.x + screen.width / 2.0, screen.y + screen.height / 2.0}
    focus := centre
    zoom: float32 = 1.0
    board_bounds := area
    if board_sail < 0.0 { sail_start_x = 0.0 }
    if board_sail >= 0.0 && sail_start_x > 0.0 {
        boat := Vector2.{sail_start_x + BoardSailTravel(board_sail) * scene_cell, sail_start_y}
        follow := EaseInOut(board_sail / 0.35)
        focus = Vector2.{centre.x + (boat.x - centre.x) * follow, centre.y + (boat.y - centre.y) * follow}
        zoom = 1.0 - (1.0 - BOAT_ZOOM) * EaseInOut((board_sail - BOAT_HOP) / 0.45)
    }
    board_pixel_snap = board_sail < 0.0
    // After a crossing the boards slide past each other: the new one in
    // from the side Shovey went to, the old one out the other way.
    crossing := EdgeSlide()
    if crossing >= 0.0 && scene_cell > 0.0 {
        board_pixel_snap = false
        eased := EaseInOut(crossing)
        travel := EngineVector(ifx landscape then (edge_visible + 1) % 4 else edge_visible, landscape)
        arrive := Vector2.{scene_origin.x + travel.x * scene_size.x * (1.0 - eased), scene_origin.y + travel.y * scene_size.y * (1.0 - eased)}
        OceanBackdrop(screen, arrive, scene_cell, landscape)
        ShoveyBoardPreview(frame.session, edge_from, Rectangle.{arrive.x - travel.x * scene_size.x, arrive.y - travel.y * scene_size.y,
                scene_size.x, scene_size.y}, cast(u64)63000, sprite_names[:], landscape, true)
        board_bounds = Rectangle.{arrive.x, arrive.y, scene_size.x, scene_size.y}
    }
    if cinematic && scene_cell > 0.0 {
        origin := Vector2.{centre.x + (scene_origin.x - focus.x) * zoom, centre.y + (scene_origin.y - focus.y) * zoom}
        size := Vector2.{scene_size.x * zoom, scene_size.y * zoom}
        OceanBackdrop(screen, origin, scene_cell * zoom, landscape)
        NeighbourBoards(origin, size, landscape)
        board_bounds = Rectangle.{origin.x, origin.y, size.x, size.y}
    }
    board_chest = ifx ChestHere() then CHEST_CELL else -1
    board_chest_open = RewardEarned(REWARD_CHEST)
    board_chest_claimed = RewardClaimed(REWARD_CHEST)
    grid := ShoveyBoard(frame.session, *game, board_bounds, cast(u64)22000, frame.now, sprite_names[:], landscape)
    board_chest = -1
    if board_sail < 0.0 && crossing < 0.0 {
        scene_cell = grid.cell
        scene_origin = Vector2.{grid.board.x, grid.board.y}
        scene_size = Vector2.{grid.board.width, grid.board.height}
    }
    if board_sail >= 0.0 && sail_start_x == 0.0 && game.player >= 0 {
        // The middle of the boat, three cells wide with its hull on its cell.
        boat_cell := TileMapCell(grid, BoardDisplayIndex(game.player, landscape))
        sail_start_x = boat_cell.x + grid.cell * 1.5
        sail_start_y = boat_cell.y - grid.cell * 0.5
    }
    shade := LevelChangeShade()
    ending_shade := EndingShade()
    if ending_shade > shade { shade = ending_shade }
    if shade > 0.0 {
        // The won board dissolves into the slate backdrop and the next one
        // rises from it, never through black.
        backdrop := ColorFromPacked(cast(u32)SHOVEY_SLATE)
        backdrop.a = cast(u8)(shade * 255.0)
        Fill(cast(u64)20097, ifx cinematic then screen else area, backdrop)
    }
    // No move or piece counters: the line speaks only when there is news.
    status := ""
    status_icon := ""
    if BoardRemaining() == 0 {
        status = AppLocaleHost("shovey_ready")
        status_icon = "S2rr:M6 10H18V21H6ZM8 10V6L10 4H14L16 6V10"
    }
    if game.lost {
        status = AppLocaleHost("shovey_lost")
        status_icon = "S2rr:M6 6L18 18M18 6L6 18"
    }
    if game.won {
        status = AppLocaleHost("shovey_won")
        status_icon = "S2rr:M5 12L10 17L19 7"
    }
    if game.level == ShoveyFinaleLevel() {
        status = AppLocaleHost("shovey_finale")
        status_icon = "S2rr:M12 4L14 10H20L15 14L17 20L12 16L7 20L9 14L4 10H10Z"
    }
    if status_icon != "" && !cinematic {
        unused Button(frame.session, ButtonProps.{.key = cast(u64)20021, .id = 20021,
                .bounds = Rectangle.{width / 2.0 - 20.0, status_y - 8.0, 40.0, 40.0},
                .label = status, .icon_shape = status_icon, .icon_only = true,
                .disabled = true, .fit_content = true, .emphasis = ButtonEmphasis.ButtonEmphasisGhost})
    }
    if save_failed { Caption(20019, Rectangle.{16.0, bottom - 28.0, width - 32.0, 24.0}, AppLocaleHost("shovey_save_failed"), 14, true) }
    if choosing {
        ControlsChoice(width, top, bottom)
        return
    }
    if guiding {
        FriendCard(width, top, bottom, friend_key, grid, landscape)
        return
    }
    disabled := game.won || game.lost || walking || edge_at > 0.0 || game.level == ShoveyFinaleLevel() || reward_card >= 0
    // Touch: swipe anywhere under the bar to step, or tap a cell or the space
    // beside the board to step towards it; hold either to keep walking. With
    // the movement pad chosen, only the pad steps. The pad and Fire come
    // after, so they stay on top.
    step: s32 = -1
    if !pad_mode {
        play := Rectangle.{0.0, top + 52.0, width, bottom - top - 52.0}
        gesture := SwipeArea(frame.session, SwipeAreaProps.{.key = cast(u64)31000, .id = 31000, .bounds = play,
                .label = AppLocaleHost("shovey_controls"), .now = frame.now, .min_distance = grid.cell * 0.6, .repeat_seconds = 0.16, .secondary_tap = true, .disabled = disabled})
        step = BoardEngineDirection(gesture.swiped, landscape)
        if gesture.down && !disabled {
            feedback_size := grid.cell * 1.1
            if feedback_size < 44.0 { feedback_size = 44.0 }
            if feedback_size > 72.0 { feedback_size = 72.0 }
            SwipeFeedback(frame.session, SwipeFeedbackProps.{.key = cast(u64)20070,
                    .gesture = gesture, .size = feedback_size})
        }
        if gesture.tapped || gesture.held {
            cell := TileMapCellAt(grid, gesture.x, gesture.y)
            cell = BoardLogicalIndex(cell, landscape)
            // Tapping Shovey himself throws the shot he holds.
            if gesture.tapped && cell >= 0 && cell == game.player && (game.powers & SHOVEY_AMMO) != 0 {
                changed = ShoveyAct(-1) || changed
            } else if cell >= 0 {
                step = TouchDirection(cast(float32)(cell % SHOVEY_WIDTH - game.player % SHOVEY_WIDTH),
                    cast(float32)(cell / SHOVEY_WIDTH - game.player / SHOVEY_WIDTH), 1.0)
            } else {
                at := TileMapCell(grid, BoardDisplayIndex(game.player, landscape))
                step = BoardEngineDirection(TouchDirection(gesture.x - at.x - at.width / 2.0,
                    gesture.y - at.y - at.height / 2.0, grid.cell / 2.0), landscape)
            }
        }
    } else {
        // Kryon keeps the floating pad thumb-sized and inset in both orientations.
        pad := DirectionPad(frame.session, DirectionPadProps.{.key = cast(u64)20040, .id = 20040,
                .bounds = DirectionPadBounds(Rectangle.{0.0, top + 52.0, width, bottom - top - 52.0}),
                .label = AppLocaleHost("shovey_controls_pad"), .now = frame.now, .repeat_seconds = 0.16, .disabled = disabled,
                .floating = true})
        if pad.step { step = BoardEngineDirection(pad.direction, landscape) }
    }
    // The throw button shows only while Shovey holds a shot.
    if (game.powers & SHOVEY_AMMO) != 0 && !disabled {
        if ThrowButton(width, top, bottom) { changed = ShoveyAct(-1) || changed }
    }
    if step >= 0 { changed = ShoveyStepOrCross(step, landscape) || changed }
    if walking && slide_next >= slide_count && frame.now - walk_at >= WALK_SECONDS {
        walk_at = frame.now
        changed = ShoveyAct(walk_steps[walk_next]) || changed
        walk_next += 1
        if walk_next >= walk_count { walk_count = 0 }
    } else if !OnBridge() {
        walk_tried = -1
    } else if !disabled && slide_next >= slide_count && game.player != walk_tried && game.level == ShoveyLevelCount() &&
    ShoveyRemaining(*game) == 0 {
        walk_tried = game.player
        if BoatWalk() {
            walk_level = game.level
            walk_next = 0
            walk_at = frame.now
        }
    }
    boat := ifx disabled || slide_next < slide_count || ShoveyRemaining(*game) > 0 then -1 else BoatBeside()
    if boat < 0 { boat_beside_at = 0.0 }
    else if boat_beside_at == 0.0 { boat_beside_at = frame.now }
    else if frame.now - boat_beside_at >= BOAT_JUMP_WAIT {
        boat_beside_at = 0.0
        changed = ShoveyAct(boat) || changed
    }
    if (changed || before_direction != game.direction) && slide_next >= slide_count {
        if game.won && game.level < ShoveyLevelCount() { WinPause() }
        else { Remember() }
    }
    // Stepping onto the secret chest opens it.
    if ChestHere() && game.player == CHEST_CELL {
        chest := TileMapCell(grid, BoardDisplayIndex(CHEST_CELL, landscape))
        tapped := Press(frame.session, PressProps.{.key = cast(u64)20126, .id = 20126,
                .bounds = chest, .label = AppLocaleHost("shovey_chest_found"),
                .now = frame.now, .disabled = reward_card >= 0}).clicked
        if changed || tapped {
            first_open := !RewardEarned(REWARD_CHEST)
            RewardOpen(REWARD_CHEST, frame.now)
            if first_open && !SoundMuted() { unused AppSoundHost("assets/shovey/sounds/goal.wav") }
        }
    }
    if !cinematic { RewardCard(width, bottom) }
}

// The separate hidden beach room has the chest; level 29 never does.
ChestHere :: () -> bool {
    return game.level == CHEST_LEVEL && game.tiles[CHEST_CELL] == 78 && game.ground[CHEST_CELL] == 0
}
