// One account record per edition, through the common Entity service.
// Only earned unlocks are shared. The unfinished board stays on this device.
Progress :: #import "entity/game_progress";
#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"
#import "std/c_string"
#import, file "controls.zi";
#import, file "progress_rules.zi";
#import, file "progress_laws.zi";

SharedProgressSession :: struct {
    record: Progress.GameProgressRecord
    owner: [65]u8
    owner_known: bool
    available: bool
    dirty: bool
    retiring: bool
    poll_at: float64
}

SharedProgressStatusField :: (reply: string, field: string, expected: string) -> bool {
    bytes: [80]u8
    return ReadStringText(reply, FieldAt(reply, 0, field), bytes[:]) >= 0 && TextUntilNul(bytes[:]) == expected
}

SharedProgressSave :: (session: *SharedProgressSession, record: *Progress.GameProgressRecord, won: bool) -> bool {
    if !SharedProgressShouldPublish(won, !Progress.GameProgressSame(*session.record, record)) { return true }
    unused Progress.GameProgressMerge(*session.record, record)
    session.dirty = true
    return session.available && SharedProgressPut(session)
}

// Only a newly earned completion reaches the account store; movement is a
// local campaign write and never enters this service.
SharedProgressPut :: (session: *SharedProgressSession) -> bool {
    put: Vec(u8)
    BuilderPrint(*put, "{\"operation\":\"put\",\"kind\":\"game-progress\",\"schema\":\"entity.game-progress.v1\",\"document\":")
    Progress.GameProgressWrite(*session.record, *put)
    BuilderPrint(*put, "}")
    saved := ProgressAccountService(TextView(VecSlice(put, 0, put.count)))
    VecFree(put)
    if !SharedProgressStatusField(saved, "status", "done") { return false }
    session.dirty = false
    session.retiring = true
    return true
}

SharedProgressStart :: (session: *SharedProgressSession, record: Progress.GameProgressRecord, now: float64) {
    session.* = SharedProgressSession.{.record = record, .dirty = record.unlocked > 1 || TextUntilNul(record.completed[:]) != ""}
    unused SharedProgressPump(session, now)
}

// 1 means another device changed this campaign; 2 means the account changed
// and the caller must reload the current account before saving anything.
SharedProgressPump :: (session: *SharedProgressSession, now: float64, playing: bool = false) -> s32 {
    // Read account progress on entry and between puzzles. An active puzzle
    // needs no account queries; its moves and board belong to this device.
    if playing { return 0 }
    if now < session.poll_at { return 0 }
    session.poll_at = now + 15.0
    status := ProgressAccountService("{\"operation\":\"status\"}")
    session.available = SharedProgressStatusField(status, "status", "done") &&
    SharedProgressStatusField(status, "game_progress", "account-v1")
    if !session.available { return 0 }
    owner: [65]u8
    unused ReadStringText(status, FieldAt(status, 0, "account"), owner[:])
    if session.owner_known && TextUntilNul(owner[:]) != TextUntilNul(session.owner[:]) {
        session.* = .{}
        return 2
    }
    session.owner = owner
    session.owner_known = true
    synced := SharedProgressStatusField(status, "sync", "synced")
    request: Vec(u8)
    BuilderPrint(*request, "{\"operation\":\"get\",\"kind\":\"game-progress\",\"game\":\"%\"}", TextUntilNul(session.record.game[:]))
    reply := ProgressAccountService(TextView(VecSlice(request, 0, request.count)))
    VecFree(request)
    before := session.record
    remote: Progress.GameProgressRecord
    at := FieldAt(reply, 0, "document")
    end := ValueEnd(reply, at, 0)
    found := SharedProgressStatusField(reply, "status", "done") && at >= 0 && end > at &&
    Progress.GameProgressRead(reply[at:end], *remote)
    if found { unused Progress.GameProgressMerge(*session.record, *remote) }
    changed := !Progress.GameProgressSame(*before, *session.record)
    if session.dirty || (found && !Progress.GameProgressSame(*session.record, *remote)) {
        unused SharedProgressPut(session)
    } else if session.retiring && synced && TextUntilNul(session.owner[:]) != "" {
        // Read back first; only retire a legacy copy after account sync.
        ProgressRetireLegacy()
        session.retiring = false
    }
    return ifx changed then 1 else 0
}
