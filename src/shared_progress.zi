// Earned progress follows the owner; unfinished campaigns stay on this device.
Progress :: #import "entity/game_progress";
Client :: #import "entity/game_progress_client";
#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"
#import "std/c_string"
#import, file "controls.zi";
#import, file "progress_rules.zi";
#import, file "progress_laws.zi";

SHARED_PROGRESS_LOADING_TIMEOUT :: 30.0

SharedProgressSession :: struct {
    // Public snapshots retained for every edition and the rewards adapter.
    record: Progress.GameProgressRecord
    owner: [65]u8
    owner_known: bool
    available: bool
    dirty: bool
    retiring: bool
    poll_at: float64
    client: Client.GameProgressClient
    bound: bool
    now: float64
    loading_since: float64
    sync_check_pending: bool
    sync_pending: bool
    sync_settled_reread: bool
}

SharedProgressStatusField :: (reply: string, field: string, expected: string) -> bool {
    bytes: [80]u8
    return ReadStringText(reply, FieldAt(reply, 0, field), bytes[:]) >= 0 && TextUntilNul(bytes[:]) == expected
}

// A status callback verifies identity without exposing account keys. Active
// play never enters the client, so it makes no account queries at all.
// Callbacks are synchronous and non-reentrant. Select the active edition's
// session before entering the client (portable VM cannot cast opaque pointers).
shared_progress_active: *SharedProgressSession;
shared_progress_verified: [65]u8;
SharedProgressOwner :: (context: *void) -> string {
    unused context
    session := shared_progress_active
    status := ProgressAccountService("{\"operation\":\"status\"}")
    shared_progress_verified = .{}
    if !SharedProgressStatusField(status, "status", "done") ||
    !SharedProgressStatusField(status, "game_progress", "account-v1") ||
    ReadStringText(status, FieldAt(status, 0, "account"), shared_progress_verified[:]) < 0 {
        session.available = false
        shared_progress_verified = session.owner
        return TextUntilNul(shared_progress_verified[:])
    }
    session.available = true
    // Entity uses both an empty ID and 'local' for an unsigned profile.
    if TextUntilNul(shared_progress_verified[:]) == "local" { shared_progress_verified = .{} }
    return TextUntilNul(shared_progress_verified[:])
}
SharedProgressService :: (context: *void, service: string, request: string) -> string {
    unused context
    session := shared_progress_active
    unused service
    if !session.available { return "{\"status\":\"unavailable\"}" }
    reply := ProgressAccountService(request)
    if SharedProgressStatusField(request, "operation", "get") {
        missing := SharedProgressStatusField(reply, "status", "missing")
        session.sync_check_pending = missing
        if !missing { session.sync_pending = false }
    }
    return reply
}
SharedProgressName :: (owner: string, game: string, output: []u8) -> string {
    if !Progress.GameProgressGameValid(game) { return "" }
    for byte: owner {
        if !((byte >= #char "a" && byte <= #char "z") || (byte >= #char "A" && byte <= #char "Z") ||
        (byte >= #char "0" && byte <= #char "9") || byte == #char "-" || byte == #char "_") { return "" }
    }
    name: Vec(u8)
    // The guest namespace cannot collide with an account named 'guest'.
    BuilderPrint(*name, "earned.%.%", game, ifx owner == "" then "guest" else "account.")
    if owner != "" { BuilderPrint(*name, "%", owner) }
    BuilderPrint(*name, ".v1")
    copied := CopyCString(TextView(VecSlice(name, 0, name.count)), output)
    VecFree(name)
    return ifx copied then TextUntilNul(output) else ""
}
SharedProgressPersist :: (context: *void, owner: string, record: *Progress.GameProgressRecord, pending: bool) -> bool {
    unused context
    if !ProgressStorageReady() { return false }
    name_bytes: [256]u8
    name := SharedProgressName(owner, TextUntilNul(record.game[:]), name_bytes[:])
    if name == "" { return false }
    text: Vec(u8)
    BuilderPrint(*text, "{\"pending\":%,\"earned\":", ifx pending then "true" else "false")
    Progress.GameProgressWrite(record, *text)
    BuilderPrint(*text, "}")
    defer { VecFree(text) }
    return PathSaveRecord(name, TextView(VecSlice(text, 0, text.count))) && ProgressStorageFlush()
}
SharedProgressLoad :: (owner: string, record: *Progress.GameProgressRecord, pending: *bool) -> bool {
    // A prior write may have been staged but failed its flush. A bind must
    // never call that memory-backed read durable without a successful barrier.
    if !ProgressStorageReady() || !ProgressStorageFlush() { return false }
    name_bytes: [256]u8
    name := SharedProgressName(owner, TextUntilNul(record.game[:]), name_bytes[:])
    if name == "" { return false }
    text := PathRecord(name)
    if text == "" {
        if !ProgressStorageMissing() { return false }
        pending.* = false
        return SharedProgressPersist(null, owner, record, false)
    }
    at := FieldAt(text, 0, "earned")
    end := ValueEnd(text, at, 0)
    saved: Progress.GameProgressRecord
    if at < 0 || end <= at || !Progress.GameProgressRead(text[at:end], *saved) ||
    TextUntilNul(saved.game[:]) != TextUntilNul(record.game[:]) { return false }
    marker := FieldAt(text, 0, "pending")
    marker_end := ValueEnd(text, marker, 0)
    if marker < 0 || marker_end <= marker { return false }
    if text[marker:marker_end] == "true" { pending.* = true }
    else if text[marker:marker_end] == "false" { pending.* = false }
    else { return false }
    record.* = saved
    return true
}
SharedProgressSnapshot :: (session: *SharedProgressSession) {
    unused Client.GameProgressClientRead(*session.client, *session.record)
    session.dirty = session.client.result.dirty
    if session.client.result.state == Client.GameProgressClientState.Acknowledged && !session.dirty { session.retiring = true }
}
SharedProgressSave :: (session: *SharedProgressSession, level: s32, won: bool) -> bool {
    if !won { return true }
    shared_progress_active = session
    if level < 1 || level >= Progress.GAME_PROGRESS_LIMIT { return false }
    record := session.record
    count := cast(s32)TextUntilNul(record.completed[:]).count
    while count < level { record.completed[count] = #char "0"; count += 1 }
    record.completed[count] = 0
    record.completed[level - 1] = #char "1"
    // Keep the account's legacy prefix. Completed predecessors supply all
    // newer graph unlocks without granting skipped sibling branches.
    if !SharedProgressShouldPublish(won, !Progress.GameProgressSame(*session.record, *record)) {
        return session.bound && session.client.result.durable
    }
    if !session.bound { return false }
    if SharedProgressOwner(null) != TextUntilNul(session.owner[:]) {
        // The just-finished attempt belonged to the original owner. Keep it
        // there, never seed the next account from the device's campaign.
        unused SharedProgressPersist(null, TextUntilNul(session.owner[:]), *record, true)
        session.poll_at = 0.0
        return false
    }
    unused Client.GameProgressClientQueue(*session.client, *record)
    // One bounded client step; acknowledgement can finish on later frames.
    unused Client.GameProgressClientPump(*session.client, cast(s64)(session.now * 1000.0), true)
    SharedProgressSnapshot(session)
    session.poll_at = 0.0
    return session.available && session.client.result.durable && session.client.result.error == Client.GameProgressClientError.None
}
SharedProgressStart :: (session: *SharedProgressSession, record: Progress.GameProgressRecord, now: float64) {
    Client.GameProgressClientReset(*session.client)
    session.* = .{}
    // Only the game identity is a seed. Device unlocks/resume positions do
    // not establish earned progress for a signed-in account or a guest.
    session.record.game = record.game
    session.record.unlocked = 1
    unused SharedProgressPump(session, now)
}

SharedProgressAccountLoading :: (session: *SharedProgressSession) -> bool {
    if !session.available || !session.owner_known || !session.bound || TextUntilNul(session.owner[:]) == "" ||
    session.client.result.state == Client.GameProgressClientState.Failed ||
    session.client.result.error != Client.GameProgressClientError.None { return false }
    if session.loading_since <= 0.0 || session.now - session.loading_since >= SHARED_PROGRESS_LOADING_TIMEOUT { return false }
    return !session.client.result.hydrated || session.sync_check_pending || session.sync_pending ||
        session.sync_settled_reread
}

// 1: earned progress changed; 2: account changed (the caller's existing
// policy reloads its campaign). A same-owner Start never reports a change.
SharedProgressPump :: (session: *SharedProgressSession, now: float64, playing: bool = false, retire_legacy: bool = true) -> s32 {
    shared_progress_active = session
    session.now = now
    if playing { return 0 }
    if now < session.poll_at { return 0 }
    status := ProgressAccountService("{\"operation\":\"status\"}")
    session.available = SharedProgressStatusField(status, "status", "done") &&
        SharedProgressStatusField(status, "game_progress", "account-v1")
    if !session.available { session.poll_at = now + 15.0; return 0 }
    owner: [65]u8
    if ReadStringText(status, FieldAt(status, 0, "account"), owner[:]) < 0 { session.available = false; return 0 }
    if TextUntilNul(owner[:]) == "local" { owner = .{} }
    if session.owner_known && TextUntilNul(owner[:]) != TextUntilNul(session.owner[:]) {
        Client.GameProgressClientReset(*session.client)
        session.* = .{}
        return 2
    }
    before := session.record
    session.owner = owner
    session.owner_known = true
    if session.loading_since <= 0.0 { session.loading_since = now }
    if !session.bound {
        pending: bool
        if !SharedProgressLoad(TextUntilNul(owner[:]), *session.record, *pending) { return 0 }
        session.client.context = null
        session.client.service = SharedProgressService
        session.client.owner = SharedProgressOwner
        session.client.persist = SharedProgressPersist
        session.client.read_delay = 15000
        result := Client.GameProgressClientBind(*session.client, TextUntilNul(owner[:]), *session.record, pending)
        session.bound = result.state != Client.GameProgressClientState.OwnerChanged && result.error == Client.GameProgressClientError.None
        if !session.bound { return 0 }
    }
    was_sync_pending := session.sync_pending
    status_syncing := SharedProgressStatusField(status, "sync", "syncing")
    status_pending := SharedProgressStatusField(status, "sync", "pending")
    result := Client.GameProgressClientPump(*session.client, cast(s64)(now * 1000.0), true)
    if result.state == Client.GameProgressClientState.OwnerChanged {
        session.* = .{}
        return 2
    }
    SharedProgressSnapshot(session)
    // Keep stepping hydration, pending operations and durable acknowledgement
    // promptly; idle account reads retain Shovey's fifteen-second interval.
    if session.sync_check_pending {
        session.sync_pending = true
        session.sync_check_pending = false
    }
    else {
        session.sync_pending = status_syncing || status_pending
    }
    client_idle := result.state == Client.GameProgressClientState.Ready ||
        result.state == Client.GameProgressClientState.Acknowledged
    if client_idle {
        session.poll_at = ifx session.sync_pending then now + 0.5 else now + 15.0
        if was_sync_pending && !session.sync_pending {
            session.sync_settled_reread = true
            session.client.next_read = 0
            session.poll_at = now
        }
        else if session.sync_settled_reread && !session.sync_pending {
            session.sync_settled_reread = false
        }
    } else {
        session.poll_at = now
    }
    if retire_legacy && session.retiring && !result.dirty && result.durable &&
    SharedProgressStatusField(status, "sync", "synced") && TextUntilNul(owner[:]) != "" {
        session.retiring = !ProgressRetireLegacy()
    }
    return ifx !Progress.GameProgressSame(*before, *session.record) then 1 else 0
}

// Local results use the same validated pack/profile namespace as earned progress.
// They never enter the account client or affect purchases and rewards.
#import, file "progress.zi";
LevelResultKey :: (pack: string, owner: string, level: s32, output: []u8) -> string {
    namespace: [256]u8
    name := SharedProgressName(owner, pack, namespace[:])
    if name == "" || level < 1 || level > 1003 { return "" }
    hash: u64 = 2166136261
    for byte: name { hash = ((hash ^ cast(u64)byte) * 16777619) & 4294967295 }
    key: Vec(u8)
    BuilderPrint(*key, "local.result.%.%", hash, level)
    copied := CopyCString(TextView(VecSlice(key, 0, key.count)), output)
    VecFree(key)
    return ifx copied then TextUntilNul(output) else ""
}

GetLevelResult :: (pack: string, owner: string, level: s32, board_mark: u64, par: s32) -> ShoveyLevelResult {
    key: [96]u8
    if LevelResultKey(pack, owner, level, key[:]) == "" || !ProgressStorageReady() { return .{} }
    text := PathRecord(TextUntilNul(key[:]))
    saved_owner: [65]u8
    saved_pack: [65]u8
    mark := ReadNumber(text, FieldAt(text, 0, "board"))
    moves := ReadNumber(text, FieldAt(text, 0, "moves"))
    saved_level := ReadNumber(text, FieldAt(text, 0, "level"))
    if ReadStringText(text, FieldAt(text, 0, "owner"), saved_owner[:]) < 0 ||
    ReadStringText(text, FieldAt(text, 0, "pack"), saved_pack[:]) < 0 ||
    TextUntilNul(saved_owner[:]) != owner || TextUntilNul(saved_pack[:]) != pack ||
    !saved_level.valid || saved_level.value != cast(float64)level ||
    !mark.valid || mark.value != cast(float64)board_mark || !moves.valid ||
    moves.value < 1.0 || moves.value > 2147483647.0 || moves.value != cast(float64)cast(s32)moves.value { return .{} }
    return ShoveyScoreResult(cast(s32)moves.value, par)
}

RecordLevelResult :: (pack: string, owner: string, level: s32, board_mark: u64, moves: s32, par: s32, won: bool) -> bool {
    if !won || moves <= 0 { return false }
    key: [96]u8
    if LevelResultKey(pack, owner, level, key[:]) == "" || !ProgressStorageReady() { return false }
    // Flush staged data before treating a previous best as durable.
    if !ProgressStorageFlush() { return false }
    existing := PathRecord(TextUntilNul(key[:]))
    if existing == "" {
        if !ProgressStorageMissing() { return false }
    } else {
        // Hashes shorten host keys only. A collision must never overwrite
        // another profile or pack's record, even with an identical board.
        saved_owner: [65]u8
        saved_pack: [65]u8
        saved_level := ReadNumber(existing, FieldAt(existing, 0, "level"))
        if ReadStringText(existing, FieldAt(existing, 0, "owner"), saved_owner[:]) < 0 ||
        ReadStringText(existing, FieldAt(existing, 0, "pack"), saved_pack[:]) < 0 ||
        TextUntilNul(saved_owner[:]) != owner || TextUntilNul(saved_pack[:]) != pack ||
        !saved_level.valid || saved_level.value != cast(float64)level { return false }
    }
    best := GetLevelResult(pack, owner, level, board_mark, par)
    if best.best_moves > 0 && best.best_moves <= moves { return true }
    // A failed read must not overwrite a possibly better durable result.
    if best.best_moves == 0 && PathRecord(TextUntilNul(key[:])) == "" && !ProgressStorageMissing() { return false }
    text: Vec(u8)
    BuilderPrint(*text, "{\"pack\":\"%\",\"owner\":\"%\",\"level\":%,\"board\":%,\"moves\":%}", pack, owner, level, board_mark, moves)
    saved := PathSaveRecord(TextUntilNul(key[:]), TextView(VecSlice(text, 0, text.count))) && ProgressStorageFlush()
    VecFree(text)
    return saved
}
