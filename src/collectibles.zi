// One-time collectibles: special items hidden on campaign boards. The view
// draws each as an overlay over its cell, like the secret chest, so no board
// or level picture changes and older players keep accepting the campaign.
// Stepping onto one records it once for that owner in a single durable
// bitmap, the same way completion coins are kept.
Records :: #import, file "controls.zi";
#import "std/c_string"
#import "std/text_buffer"
#import "std/vec"

COLLECTIBLE_COUNT :: 16;
// The bitmap keeps room for items added later; old records stay readable.
COLLECTIBLE_SLOTS :: 64;

CollectibleId :: (index: s32) -> string {
    if index == 0 { return "lucky-pebble" }
    if index == 1 { return "rusty-key" }
    if index == 2 { return "message-bottle" }
    if index == 3 { return "four-leaf-clover" }
    if index == 4 { return "snail-shell" }
    if index == 5 { return "golden-feather" }
    if index == 6 { return "giant-acorn" }
    if index == 7 { return "silver-pinecone" }
    if index == 8 { return "honeycomb" }
    if index == 9 { return "firefly-jar" }
    if index == 10 { return "frost-leaf" }
    if index == 11 { return "glow-crystal" }
    if index == 12 { return "tiny-fossil" }
    if index == 13 { return "chipped-teacup" }
    if index == 14 { return "sleepy-starfish" }
    if index == 15 { return "brass-compass" }
    return ""
}

// Levels and cells (y * 12 + x) on the portrait board.
CollectibleLevel :: (index: s32) -> s32 {
    if index == 0 { return 4 }
    if index == 1 { return 15 }
    if index == 2 { return 26 }
    if index == 3 { return 40 }
    if index == 4 { return 53 }
    if index == 5 { return 63 }
    if index == 6 { return 72 }
    if index == 7 { return 83 }
    if index == 8 { return 93 }
    if index == 9 { return 97 }
    if index == 10 { return 98 }
    if index == 11 { return 108 }
    if index == 12 { return 124 }
    if index == 13 { return 143 }
    if index == 14 { return 158 }
    if index == 15 { return 170 }
    return -1
}

CollectibleCell :: (index: s32) -> s32 {
    if index == 0 { return 5 * 12 + 4 }
    if index == 1 { return 14 * 12 + 3 }
    if index == 2 { return 10 * 12 + 7 }
    if index == 3 { return 7 * 12 + 1 }
    if index == 4 { return 18 * 12 + 5 }
    if index == 5 { return 5 * 12 + 2 }
    if index == 6 { return 8 * 12 + 1 }
    if index == 7 { return 18 * 12 + 5 }
    if index == 8 { return 3 * 12 + 10 }
    if index == 9 { return 16 * 12 + 4 }
    if index == 10 { return 10 * 12 + 6 }
    if index == 11 { return 10 * 12 + 10 }
    if index == 12 { return 2 * 12 + 1 }
    if index == 13 { return 5 * 12 + 2 }
    if index == 14 { return 1 * 12 + 9 }
    if index == 15 { return 1 * 12 + 2 }
    return -1
}

