// The item hidden on this level's cell, or -1.
CollectibleAt :: (level: s32, cell: s32) -> s32 {
    for index: cast(s32)0..COLLECTIBLE_COUNT - 1 {
        if CollectibleLevel(index) == level && CollectibleCell(index) == cell { return index }
    }
    return -1
}

// The item hidden somewhere on this level, or -1.
CollectibleOnLevel :: (level: s32) -> s32 {
    for index: cast(s32)0..COLLECTIBLE_COUNT - 1 {
        if CollectibleLevel(index) == level { return index }
    }
    return -1
}

CollectibleRecordName :: (owner: string, output: []u8) -> string {
    if owner != "" {
        if owner.count != 64 { return "" }
        for byte: owner {
            if !(byte >= #char "0" && byte <= #char "9") && !(byte >= #char "a" && byte <= #char "f") { return "" }
        }
    }
    out: Vec(u8)
    BuilderPrint(*out, "collectibles.v1.%", ifx owner == "" then "guest" else owner)
    copied := CopyCString(TextView(VecSlice(out, 0, out.count)), output)
    VecFree(out)
    return ifx copied then TextUntilNul(output) else ""
}

// False when storage cannot answer yet; a missing record reads as empty.
CollectibleRead :: (name: string, marks: []u8) -> bool {
    if name == "" || !Records.ProgressStorageReady() || !Records.ProgressStorageFlush() { return false }
    text := Records.PathRecord(name)
    if text == "" {
        if !Records.ProgressStorageMissing() { return false }
        for index: 0..COLLECTIBLE_SLOTS - 1 { marks[index] = #char "0" }
        return true
    }
    if text.count != COLLECTIBLE_SLOTS { return false }
    for index: 0..COLLECTIBLE_SLOTS - 1 {
        if text[index] != #char "0" && text[index] != #char "1" { return false }
        marks[index] = text[index]
    }
    return true
}

// The found marks of one owner, cached until a pickup or another owner.
collectible_owner: [65]u8;
collectible_cached: bool;
collectible_marks: [COLLECTIBLE_SLOTS]u8;

CollectibleInvalidate :: () { collectible_cached = false }

CollectibleRefresh :: (owner: string) {
    if TextUntilNul(collectible_owner[:]) != owner {
        unused CopyCString(owner, collectible_owner[:])
        collectible_marks = .{}
        collectible_cached = false
    }
    if collectible_cached { return }
    // Keep the owner-bound marks while storage starts, then retry so a book
    // opened before hydration can show its saved finds without reopening.
    name: [96]u8
    marks: [COLLECTIBLE_SLOTS]u8
    if !CollectibleRead(CollectibleRecordName(owner, name[:]), marks[:]) { return }
    collectible_marks = marks
    collectible_cached = true
}

CollectibleFound :: (owner: string, index: s32) -> bool {
    if index < 0 || index >= COLLECTIBLE_COUNT { return false }
    CollectibleRefresh(owner)
    return collectible_marks[index] == #char "1"
}

CollectibleFoundCount :: (owner: string) -> s32 {
    count: s32
    for index: cast(s32)0..COLLECTIBLE_COUNT - 1 { if CollectibleFound(owner, index) { count += 1 } }
    return count
}

// 1 when this pickup is new, 0 when it was already found, -1 to retry once
// storage answers. The record is re-read first, so another instance's find
// is never lost and an item never counts twice.
CollectibleRecord :: (owner: string, index: s32) -> s32 {
    if index < 0 || index >= COLLECTIBLE_COUNT { return 0 }
    name_bytes: [96]u8
    name := CollectibleRecordName(owner, name_bytes[:])
    marks: [COLLECTIBLE_SLOTS]u8
    if !CollectibleRead(name, marks[:]) { return -1 }
    if marks[index] == #char "1" { CollectibleInvalidate(); return 0 }
    marks[index] = #char "1"
    if !Records.PathSaveRecord(name, TextView(marks[:])) || !Records.ProgressStorageFlush() { return -1 }
    CollectibleInvalidate()
    return 1
}

// A pickup belongs to the owner who stepped on it, even if the host rebinds
// its profile before storage answers.
CollectiblePending :: struct { active: bool; owner: [65]u8; index: s32 }

CollectibleBegin :: (pending: *CollectiblePending, owner: string, index: s32) {
    if pending.active || index < 0 || index >= COLLECTIBLE_COUNT { return }
    if CollectibleFound(owner, index) { return }
    if !CopyCString(owner, pending.owner[:]) { return }
    pending.index = index
    pending.active = true
}

CollectibleFinish :: (pending: *CollectiblePending) -> s32 {
    if !pending.active { return 0 }
    result := CollectibleRecord(TextUntilNul(pending.owner[:]), pending.index)
    if result >= 0 { pending.active = false }
    return result
}
