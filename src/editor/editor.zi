#import "apps/node_types"
#import "apps/node_app"
#import, file "editor_view.zi";

// Shovey's level editor, its own game beside Classic: it keeps custom levels
// in its own records.
#program_export "ShoveyEditorMain"
Main :: () -> s32 { return RunNodeApp(EditorNodeFrame, EditorNodeBack) }

EditorNodeFrame :: (message: AppMessage) -> bool {
    EditorFrame(message.locale)
    return true
}

// Back leaves a page of the editor; on its first page the host leaves the editor.
EditorNodeBack :: (message: AppMessage) -> bool {
    unused message
    return EditorBack()
}
