#import "apps/node_types"
#import, file "editor_view.zi";
host_api :: #system_library "host_api";
ReadAppHost :: () -> AppMessage #foreign host_api;
WriteAppHost :: (message: AppMessage) #foreign host_api;

// The level editor for both Shovey editions, its own game beside Classic and
// Island: it keeps custom levels in its own records.
#program_export "ShoveyEditorMain"
Main :: () -> s32 {
    message := ReadAppHost()
    if message.abi != MODULE_ABI { return -1 }
    if message.action == MODULE_IDENTIFY { return MODULE_NODE_APP }
    message.succeeded = message.action == APP_ROUTE
    if message.action == APP_FRAME {
        EditorFrame(message.locale)
        message.succeeded = true
    }
    // Back leaves a page of the editor; on its first page the host leaves the editor.
    if message.action == APP_BACK { message.succeeded = EditorBack() }
    WriteAppHost(message)
    return 0
}
