// Shovey's levels in Entity's level collections (entity/level_collections),
// which owns the collection envelope, the account's private drafts and the
// host's "publications" requests and replies. Shovey adds its own format,
// its levels' JSON and the checks a shared level must pass. The editor's
// view sends the requests with AppServiceHost where AppSupportsHost says
// the host offers the service, and shows sharing as unavailable elsewhere.
//
// A shared collection, UTF-8 JSON:
//   {"format":"shovey-levels-1","edition":"classic","title":"...",
//    "levels":[{"name":"...","route":"...","cells":[20 rows of 24 hex digits]}]}
// Every level carries a route that wins it; a level whose route does not
// replay to a win is refused. The author comes from the host's account,
// never from the game.
#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"
Collections :: #import "entity/level_collections";
#import, file "edit.zi";

SHARING_EDITION :: "classic"
// The service takes documents up to 240 KiB.
SHARING_DOCUMENT_MAX :: 245760
SHARING_TITLE_MAX :: 80
SHARING_LEVELS :: 200
SHARING_RESULTS :: 50

// ---------------------------------------------------------------------------
// Writing a collection

sharing_level_bytes: [EDIT_ROUTE + 16384]u8;

// One level as JSON: its name, its winning route and its board's rows.
SharingLevelJson :: (writer: *EditWriter, name: string, level: *EditLevel, indent: string) {
    EditPut(writer, "{\"name\": ")
    EditPutJson(writer, name)
    EditPut(writer, ", \"route\": ")
    EditPutJson(writer, EditField(level.route[:], level.route_length))
    EditPut(writer, ",")
    EditPutRows(writer, *level.board, indent)
    EditPut(writer, "}")
}

SharingDocumentBegin :: (out: *Vec(u8), title: string) {
    Collections.CollectionDocumentBegin(out, SHARING_FORMAT, SHARING_EDITION, title)
}

// Adds one level; first is true for the first one. False when it is too
// large to write.
SharingDocumentLevel :: (out: *Vec(u8), name: string, level: *EditLevel, first: bool) -> bool {
    writer := EditWriter.{.bytes = sharing_level_bytes[:]}
    SharingLevelJson(*writer, name, level, "  ")
    if writer.full { return false }
    Collections.CollectionDocumentLevel(out, TextView(sharing_level_bytes[0:writer.length]), first)
    return true
}

SharingDocumentEnd :: (out: *Vec(u8)) { Collections.CollectionDocumentEnd(out) }

// A title or search without the spaces around it.
SharingTrim :: (text: string) -> string {
    start: s64 = 0
    end := text.count
    while start < end && (text[start] == #char " " || text[start] == cast(u8)9) { start += 1 }
    while end > start && (text[end - 1] == #char " " || text[end - 1] == cast(u8)9) { end -= 1 }
    return text[start:end]
}

// ---------------------------------------------------------------------------
// Reading a collection

// Reads a collection's head at `at`. False when it is not a Shovey Classic
// collection or too large.
SharingDocumentRead :: (text: string, at: s32, document: *Collections.CollectionDocument) -> bool {
    if text.count > cast(s64)SHARING_DOCUMENT_MAX * 2 { return false }
    if !Collections.CollectionDocumentRead(text, at, SHARING_FORMAT, document) { return false }
    return TextUntilNul(document.edition[:]) == SHARING_EDITION && document.level_count <= SHARING_LEVELS
}

sharing_hex: [EDIT_CELLS * 6]u8;

// Reads the level object at `at`: its name into name (its length through
// name_length), its board and its route. A shared level needs a name and a
// route; a draft may have neither yet. False when the level is malformed: a
// board the engine cannot load, a route with letters a level cannot hold.
// Whether the route wins is for EditReplay to say.
SharingLevelRead :: (text: string, at: s32, name: []u8, name_length: *s32, level: *EditLevel, draft: bool) -> bool {
    if at < 0 { return false }
    name_length.* = EditJsonText(text, at, "name", name)
    if name_length.* < 0 {
        if !draft { return false }
        name_length.* = 0
    }
    if !EditRowsRead(text, FieldAt(text, at, "cells"), sharing_hex[:], 0) { return false }
    layered := FieldAt(text, at, "tiles") >= 0
    if layered && !EditRowsRead(text, FieldAt(text, at, "tiles"), sharing_hex[:], EDIT_CELLS * 2) { return false }
    decorated := FieldAt(text, at, "decorations") >= 0
    if decorated && (!layered || !EditRowsRead(text, FieldAt(text, at, "decorations"), sharing_hex[:], EDIT_CELLS * 4)) { return false }
    layers: s32 = ifx decorated then 3 else ifx layered then 2 else 1
    if !EditBoardRead(*level.board, TextView(sharing_hex[0:EDIT_CELLS * 2 * layers])) { return false }
    if EditShovey(*level.board) < 0 { return false }
    route_at := FieldAt(text, at, "route")
    span := ReadString(text, route_at)
    if route_at < 0 || !span.valid || span.end - span.start > EDIT_ROUTE { return false }
    if !draft && span.end <= span.start { return false }
    route := text[span.start:span.end]
    for letter: route {
        move := letter >= #char "0" && letter <= #char "3"
        if !move && letter != #char "f" && letter != #char "t" { return false }
    }
    return EditSetRoute(level, route)
}

// Reads level `index` of a shared collection.
SharingDocumentLevelRead :: (text: string, document: *Collections.CollectionDocument, index: s32, name: []u8,
    name_length: *s32, level: *EditLevel) -> bool {
    at := Collections.CollectionDocumentLevelAt(text, document, index)
    return at >= 0 && SharingLevelRead(text, at, name, name_length, level, false)
}
