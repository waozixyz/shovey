// The editor may read the base game's explicitly exported device save.
// Displaying those unlocks never publishes them to an account.
#import "std/json_scan"
#import "std/text_buffer"
#import, file "../progress.zi";
#import, file "../engine.zi";
#import "levels"
Progress :: #import "entity/game_progress";

// Merge individual earned destinations; a high-numbered branch must not
// make every smaller story board available in the editor.
EditorMergeProgress :: (progress: *ShoveyProgress, access: []bool) {
    for level: cast(s32)1..ShoveyLevelCount() {
        if level <= access.count && ShoveyLevelUnlocked(progress, level) { access[level - 1] = true }
    }
}

EditorMergeAccountAccess :: (reply: string, access: []bool) {
    status: [16]u8
    if ReadStringText(reply, FieldAt(reply, 0, "status"), status[:]) < 0 || TextUntilNul(status[:]) != "done" { return }
    record: Progress.GameProgressRecord
    if !Progress.GameProgressReply(reply, *record) || TextUntilNul(record.game[:]) != "shovey.classic" { return }
    progress := ShoveyProgress.{.unlocked = record.unlocked}
    if progress.unlocked > ShoveyLevelLimit() { progress.unlocked = ShoveyLevelLimit() }
    Progress.GameProgressMarkLevels(*record, progress.completed[:])
    EditorMergeProgress(*progress, access)
}

EditorMergeCampaignAccess :: (text: string, access: []bool) {
    progress: ShoveyProgress; board: ShoveyGame
    if ShoveyCampaignRestore(*progress, *board, text) { EditorMergeProgress(*progress, access) }
}

EditorMergeDeviceAccess :: (reply: string, access: []bool) {
    status: [16]u8
    if ReadStringText(reply, FieldAt(reply, 0, "status"), status[:]) < 0 || TextUntilNul(status[:]) != "done" { return }
    text: [4096]u8
    count := ReadStringText(reply, FieldAt(reply, 0, "text"), text[:])
    if count > 0 { EditorMergeCampaignAccess(TextView(text[:count]), access) }
}

EditorAccountUnlocked :: (reply: string) -> s32 {
    status: [16]u8
    if ReadStringText(reply, FieldAt(reply, 0, "status"), status[:]) < 0 || TextUntilNul(status[:]) != "done" { return 1 }
    at := FieldAt(reply, 0, "document")
    if at < 0 { return 1 }
    value := ReadNumber(reply, FieldAt(reply, at, "unlocked"))
    if !value.valid || value.value < 1.0 || value.value > 1000.0 || cast(float64)cast(s32)value.value != value.value { return 1 }
    return cast(s32)value.value
}

EditorDeviceUnlocked :: (reply: string) -> s32 {
    status: [16]u8
    if ReadStringText(reply, FieldAt(reply, 0, "status"), status[:]) < 0 || TextUntilNul(status[:]) != "done" { return 0 }
    text: [4096]u8
    count := ReadStringText(reply, FieldAt(reply, 0, "text"), text[:])
    if count < 1 { return 0 }
    progress: ShoveyProgress
    board: ShoveyGame
    if !ShoveyCampaignRestore(*progress, *board, TextView(text[:count])) { return 0 }
    return progress.unlocked
}

#if #defined(SHOVEY_WEB) {
    // Classic and Editor share this first-party page's document store.
    EditorBrowserDeviceUnlocked :: (text: string) -> s32 {
        progress: ShoveyProgress
        board: ShoveyGame
        if !ShoveyCampaignRestore(*progress, *board, text) { return 0 }
        return progress.unlocked
    }
}

EditorVisibleUnlocked :: (account: s32, device: s32) -> s32 {
    value := ifx account > device then account else device
    if value < 1 { value = 1 }
    count := ShoveyLevelCount()
    return ifx value > count then count else value
}
