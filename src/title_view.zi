// The game's title, shared by the standalone player and every node host.
Carousel :: #import "kryon/carousel";
#import "kryon/session"
#import "kryon/geometry"

Image :: #import "kryon/image";

Button :: #import "kryon/button";

Text :: #import "kryon/text";
Box :: #import "kryon/box";
#import "kryon/text_align"
#import "kryon/drawing_props"
#import "kryon/app_context"
#import "kryon/widget_palette"
#import "kryon/control_props"
#import "std/number_text"
#import "std/c_string"
#import "std/text_buffer"
#import "std/json_scan"
#import, file "shovey_theme.zi";
#import, file "controls.zi";
Shop :: #import, file "shop_view.zi";
Wallet :: #import, file "shop_state.zi";
Book :: #import, file "collectible_book.zi";
#import "apps/node_types"
host_api :: #system_library "host_api";
AppLocaleHost :: (key: string) -> string #foreign host_api;
AppServiceHost :: (name: string, request: string) -> string #foreign host_api;
ReadAppUiHost :: () -> AppUiFrame #foreign host_api;
AppKeyHost :: () -> s32 #foreign host_api;

state: Carousel.CarouselState;
prepared: bool;
has_progress: bool;

// The title-bar picture is the player's equipped Shovey skin, so a wardrobe
// choice shows at once and everywhere this title is drawn. Shovey publishes
// the same skin to the account, where the shared picture record and the game
// HUD read it.
TitleProfilePicture :: (bounds: Rectangle) -> Image.Props {
    skin := Shop.Skin()
    image := Image.Props.{.bounds = bounds, .fit = Image.ImageFit.ImageFitContain,
        .smooth = true, .radius = bounds.width * 0.5,
        .alt_text = AppLocaleHost("shovey_shop_profile")}
    image.asset_path = Shop.SkinPath()
    image.key = cast(u64)(50204 + skin)
    return image
}

Action :: (session: Session, key: u64, bounds: Rectangle, path: string, label: string,
    image_key: u64 = 0) -> bool {
    unused Image.Draw(session, Image.Props.{.key = ifx image_key != 0 then image_key else key + 1,
        .bounds = bounds, .asset_path = path, .fit = Image.ImageFit.ImageFitContain,
        .smooth = true, .alt_text = AppLocaleHost(label)})
    return Button.Draw(session, Button.Props.{.key = key, .id = cast(s32)key,
        .bounds = bounds, .label = AppLocaleHost(label), .invisible = true}) != 0
}

Amount :: (session: Session, key: u64, bounds: Rectangle, dew: bool, value: string) {
    unused Image.Draw(session, Image.Props.{.key = key,
        .bounds = Rectangle.{bounds.x, bounds.y + 2.0, 24.0, 24.0},
        .asset_path = ifx dew then "assets/shovey/shop/dew.png" else "assets/shovey/shop/coins.png",
        .fit = Image.ImageFit.ImageFitContain, .smooth = true,
        .alt_text = AppLocaleHost(ifx dew then "shovey_shop_dew" else "shovey_shop_coins")})
    Text.Draw(session, Text.Props.{.key = key + 1,
        .bounds = Rectangle.{bounds.x + 28.0, bounds.y + 4.0, bounds.width - 28.0, 24.0},
        .text = value, .size = 15})
}

Back :: () -> bool {
    if Book.BookBack() { return true }
    return Shop.Back()
}

map_requested: bool;
Frame :: (today: s64) -> bool {
    frame := ReadAppUiHost()
    bounds := Rectangle.{0.0, cast(float32)frame.top, cast(float32)frame.width,
        cast(float32)(frame.height - frame.bottom - frame.top)}
    if !prepared {
        prepared = true
        Shop.RefreshWallet()
        has_progress = LocalCampaignRecord() != ""
    }
    if Book.BookFrame(frame.session, bounds, "") || Shop.ShopFrame(frame.session, bounds, frame.now, today) { return false }
    unused WidgetPaletteUse(frame.session, ShoveyPalette())
    defer { unused WidgetPaletteRestore(frame.session) }
    items: [3]Carousel.CarouselItem
    items[0] = Carousel.CarouselItem.{.label = "Shovey", .portrait = "assets/shovey/title/shovey-portrait.jpg",
        .landscape = "assets/shovey/title/shovey-landscape.jpg", .logo = "assets/shovey/title/shovey-logo.png",
        .action = AppLocaleHost(ifx has_progress then "shovey_continue" else "shovey_play")}
    standalone := AppSupports("shovey.standalone")
    island_enabled := standalone && AppSupports("shovey.island.enabled")
    // A locked Island carries its price and offer on the Unlock action, and
    // one press on it unlocks. An unlock the host remembers reads Play while
    // the node checks it.
    owned := island_enabled && AppSupports("shovey.island.owned")
    shown := owned || (island_enabled && AppSupports("shovey.island.shown"))
    // Copied before the next host call can reuse the reply.
    unlock_text: [128]u8
    unlock := ""
    if island_enabled && !owned && CopyCString(AppServiceHost("arcade.navigation", "island-unlock"), unlock_text[:]) {
        unlock = TextUntilNul(unlock_text[:])
    }
    items[1] = Carousel.CarouselItem.{.label = AppLocaleHost("shovey_island_title"),
        .portrait = "assets/shovey/title/shovey-island-portrait.jpg",
        .landscape = "assets/shovey/title/shovey-island-landscape.jpg", .logo = "assets/shovey/title/shovey-island-logo.png",
        .action = ifx unlock != "" then unlock else ifx shown then AppLocaleHost("shovey_play") else AppLocaleHost("shovey_island_unlock"),
        .action_ribbon = ifx island_enabled && !owned then AppServiceHost("arcade.navigation", "island-offer") else ""}
    editor := Carousel.CarouselItem.{.label = AppLocaleHost("shovey_editor"),
        .portrait = "assets/shovey/title/shovey-editor-portrait.jpg",
        .landscape = "assets/shovey/title/shovey-editor-landscape.jpg", .logo = "assets/shovey/title/shovey-editor-logo.png",
        .action = AppLocaleHost("shovey_open"), .disabled = !ClassicEditorAvailable()}
    count: s64 = 3
    if !island_enabled { items[1] = editor; count = 2 }
    else { items[2] = editor }
    selected := Carousel.Draw(frame.session, Carousel.Props.{.key = cast(u64)50000, .bounds = bounds,
        .now = frame.now, .key_pressed = AppKeyHost(), .label = "Shovey", .scale = 1.0,
        .previous_label = AppLocaleHost("shovey_page_previous"), .next_label = AppLocaleHost("shovey_page_next"),
        .logo_max_width = ifx bounds.width < 600.0 then bounds.width * 0.58 else 360.0,
        .logo_top = 120.0}, items[:count], *state)
    if state.selected == 0 {
        action_y := bounds.y + bounds.height - 196.0
        if action_y < bounds.y + bounds.height * 0.5 { action_y = bounds.y + bounds.height * 0.5 }
        map_width := ifx bounds.width - 64.0 < 260.0 then bounds.width - 64.0 else 260.0
        if Button.Draw(frame.session, Button.Props.{.key = cast(u64)49224,
            .bounds = Rectangle.{bounds.x + (bounds.width - map_width) * 0.5, action_y - 56.0, map_width, 44.0},
            .label = AppLocaleHost("shovey_levels"), .pill = true,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 {
            prepared = false
            map_requested = true
            return true
        }
    }
    Shop.Pump(frame.now, today)
    // Why a press did not unlock Island, briefly, above its action.
    if island_enabled && !owned && state.selected == 1 {
        notice_text: [192]u8
        if CopyCString(AppServiceHost("arcade.navigation", "island-notice"), notice_text[:]) && notice_text[0] != 0 {
            width := ifx bounds.width - 48.0 < 420.0 then bounds.width - 48.0 else 420.0
            action_y := bounds.y + bounds.height - 196.0
            if action_y < bounds.y + bounds.height * 0.5 { action_y = bounds.y + bounds.height * 0.5 }
            note := Rectangle.{bounds.x + (bounds.width - width) / 2.0, action_y - 86.0, width, 56.0}
            palette := ShoveyPalette()
            unused Box.Draw(frame.session, Box.Props.{.key = cast(u64)49220, .bounds = note,
                .fill = ColorFromPacked(palette.base), .border = ColorFromPacked(palette.border), .radius = 14.0})
            unused Text.Draw(frame.session, Text.Props.{.key = cast(u64)49221,
                .bounds = Rectangle.{note.x + 12.0, note.y + 4.0, note.width - 24.0, note.height - 8.0},
                .text = TextUntilNul(notice_text[:]), .size = 15, .wrap = Text.Wrap.TextWrapAuto,
                .align = TextAlign.TextAlignCenter, .vertical_align = TextAlign.TextAlignCenter})
        }
    }
    y := bounds.y + 12.0
    if Action(frame.session, 49200, Rectangle.{12.0, y, 44.0, 44.0}, "assets/shovey/shop/stall.png", "shovey_shop_shop") { Shop.Open(1) }
    if Shop.ChestAction(frame.session, 49202, Rectangle.{12.0, y + 60.0, 44.0, 44.0}) { Shop.Open(2) }
    if Action(frame.session, 49208, Rectangle.{bounds.width - 152.0, y, 44.0, 44.0}, "assets/shovey/shop/book.png", "shovey_book") { Book.BookOpen() }
    digits: [24]u8
    Amount(frame.session, 49210, Rectangle.{60.0, y, bounds.width - 224.0, 28.0}, false, FormatInteger(cast(s64)Wallet.ShopCoins(), digits[:]))
    Amount(frame.session, 49212, Rectangle.{60.0, y + 30.0, bounds.width - 224.0, 28.0}, true, Shop.DewText())
    profile_bounds := Rectangle.{bounds.width - 104.0, y, 44.0, 44.0}
    if AppSupports("entity.profile.picture") {
        Image.Draw(frame.session, TitleProfilePicture(profile_bounds))
        if Button.Draw(frame.session, Button.Props.{.key = cast(u64)49204, .bounds = profile_bounds,
            .label = AppLocaleHost("shovey_shop_profile"), .invisible = true}) != 0 { unused AppServiceHost("entity.profile", "open") }
    } else if Button.Draw(frame.session, Button.Props.{.key = cast(u64)49204, .bounds = profile_bounds,
        .label = AppLocaleHost("shovey_shop_profile"), .icon_only = true, .circle = true,
        .icon_shape = "S2rr:M20 21V19C20 16.79 18.21 15 16 15H8C5.79 15 4 16.79 4 19V21M16 7A4 4 0 1 1 8 7A4 4 0 1 1 16 7"}) != 0 {
        unused AppServiceHost("entity.profile", "open")
    }
    if Action(frame.session, 49206, Rectangle.{bounds.width - 56.0, y, 44.0, 44.0}, "assets/shovey/shop/trophy.png", "shovey_shop_leaderboard") { unused AppServiceHost("entity.profile", "leaderboard") }
    if selected == 0 { prepared = false; map_requested = false; return true }
    if selected == count - 1 { unused OpenClassicEditor() }
    else if island_enabled && selected == 1 {
        unused AppServiceHost("arcade.navigation", "island")
    }
    return false
}
