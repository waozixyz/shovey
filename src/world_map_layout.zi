#import "kryon/geometry"
Math :: #import "std/math";


// Segment indices run from the first (lowest) journey segment to the last.
// Invalid levels and indices return -1; invalid geometry returns negative bounds.
WorldMapSegmentCount :: 16;
WorldMapLevelCount :: 175;
WorldMapSceneCount :: 37;

// One uniform world zoom preserves the whole paintings and sampled roads.
// Buttons stay 52px across with 56px circular hit targets in the view.
WorldMapWorldZoom :: 1.33;
WorldMapScale :: (width: float32) -> float32 { return width / 390.0 * WorldMapWorldZoom }

// Tables are authored painting coordinates. WorldMapWorldZoom converts those
// coordinates to world units; width/390 converts world units to screen pixels.
// A camera width of 240 therefore means 0.8 screen pixels per authored unit,
// rather than the 1.04 produced by width 312. Source bitmap pixels additionally
// use their own source rectangle's ratio to the authored painting bounds.
WorldMapSourcePoint :: (point: Vector2, source: Rectangle, painting: Rectangle) -> Vector2 {
    if source.width <= 0.0 || source.height <= 0.0 { return Vector2.{-1.0, -1.0} }
    return Vector2.{painting.x + (point.x - source.x) * painting.width / source.width,
        painting.y + (point.y - source.y) * painting.height / source.height}
}

WorldMapPointDistance :: (a: Vector2, b: Vector2) -> float32 {
    dx := cast(float64)b.x - cast(float64)a.x
    dy := cast(float64)b.y - cast(float64)a.y
    return cast(float32)Math.Sqrt(dx * dx + dy * dy)
}

WorldMapPolylineLength :: (points: []Vector2) -> float32 {
    length: float32
    for index: cast(s32)1..cast(s32)points.count - 1 {
        length += WorldMapPointDistance(points[index - 1],points[index])
    }
    return length
}

// Arc-length sampling retains every authored bend. Repeated samples have no
// length and cannot introduce a straight shortcut between separate paintings.
WorldMapPolylineSample :: (points: []Vector2, t: float32) -> Vector2 {
    if points.count == 0 { return Vector2.{-1.0, -1.0} }
    if t <= 0.0 { return points[0] }
    if t >= 1.0 { return points[points.count - 1] }
    remaining := WorldMapPolylineLength(points) * t
    for index: cast(s32)1..cast(s32)points.count - 1 {
        a := points[index - 1]; b := points[index]
        length := WorldMapPointDistance(a,b)
        if length <= 0.0 { continue }
        if remaining <= length {
            fraction := remaining / length
            return Vector2.{a.x + (b.x - a.x) * fraction,a.y + (b.y - a.y) * fraction}
        }
        remaining -= length
    }
    return points[points.count - 1]
}

// The caller supplies slots for its existing identities, including the shared
// entry and merge. Allocation never changes IDs, prerequisites or slot count.
WorldMapAllocateRoute :: (points: []Vector2, centers: []Vector2) -> bool {
    if points.count < 2 || centers.count < 2 || WorldMapPolylineLength(points) <= 0.0 { return false }
    for index: cast(s32)0..cast(s32)centers.count - 1 {
        centers[index] = WorldMapPolylineSample(points,cast(float32)index / cast(float32)(centers.count - 1))
    }
    return true
}

WorldMapMinimumCenterDistance :: (centers: []Vector2) -> float32 {
    if centers.count < 2 { return 0.0 }
    minimum: float32 = 1000000000.0
    for index: cast(s32)0..cast(s32)centers.count - 2 {
        for other: index + 1..cast(s32)centers.count - 1 {
            distance := WorldMapPointDistance(centers[index],centers[other])
            if distance < minimum { minimum = distance }
        }
    }
    return minimum
}

// Native derived scene rectangles. The identical shared bands are baked
// into both neighboring assets; no runtime warp or opacity is required.
WorldMapSceneBounds :: (index: s32, width: float32 = 390.0, landscape: bool = false) -> Rectangle {
    if index < 0 || index >= WorldMapSceneCount || width <= 0.0 { return Rectangle.{-1.0,-1.0,-1.0,-1.0} }
    scale := WorldMapScale(width)
    at := index * 4
    if landscape { return Rectangle.{world_map_scene_landscape[at] * scale,world_map_scene_landscape[at+1] * scale,world_map_scene_landscape[at+2] * scale,world_map_scene_landscape[at+3] * scale} }
    return Rectangle.{world_map_scene_portrait[at] * scale,world_map_scene_portrait[at+1] * scale,world_map_scene_portrait[at+2] * scale,world_map_scene_portrait[at+3] * scale}
}

WorldMapSegmentStart :: (index: s32) -> s32 {
    starts: [16]s32 = .[1, 13, 25, 36, 49, 62, 76, 86, 96, 101, 113, 125, 136, 151, 163, 175]
    if index < 0 || index >= WorldMapSegmentCount { return -1 }
    return starts[index]
}

WorldMapSegmentEnd :: (index: s32) -> s32 {
    if index < 0 || index >= WorldMapSegmentCount { return -1 }
    if index == WorldMapSegmentCount - 1 { return WorldMapLevelCount }
    return WorldMapSegmentStart(index + 1) - 1
}

WorldMapLevelSegment :: (level: s32) -> s32 {
    if level < 1 || level > WorldMapLevelCount { return -1 }
    index: s32 = 0
    while index < WorldMapSegmentCount {
        if level <= WorldMapSegmentEnd(index) { return index }
        index += 1
    }
    return -1
}

// Continuous world coordinates, shared by terrain, routes and hit targets.
WorldMapWorldBounds :: (landscape: bool = false) -> Rectangle {
    scale: float32 = WorldMapWorldZoom
    if landscape { return Rectangle.{0.0,0.0,28756.0 * scale,941.0 * scale} }
    return Rectangle.{0.0,0.0,1086.0 * scale,25310.0 * scale}
}

WorldMapSegmentBaseHeight :: (index: s32) -> float32 {
    if index < 0 || index >= WorldMapSegmentCount { return -1.0 }
    return WorldMapSegmentBounds(index, 390.0).height
}
WorldMapHeight :: (width: float32) -> float32 {
    if width <= 0.0 { return -1.0 }
    return WorldMapWorldBounds().height * width / 390.0
}
WorldMapSegmentBounds :: (index: s32, width: float32) -> Rectangle {
    if index < 0 || index >= WorldMapSegmentCount || width <= 0.0 { return Rectangle.{-1.0, -1.0, -1.0, -1.0} }
    minimum: float32 = WorldMapWorldBounds().height
    maximum: float32 = 0.0
    for level: WorldMapSegmentStart(index)..WorldMapSegmentEnd(index) {
        point := WorldMapLevelPosition(level, width)
        if point.y < minimum { minimum = point.y }
        if point.y > maximum { maximum = point.y }
    }
    return Rectangle.{0.0, minimum - 100.0, WorldMapWorldBounds().width * width / 390.0, maximum - minimum + 200.0}
}
WorldMapLevelPosition :: (level: s32, width: float32, landscape: bool = false) -> Vector2 {
    if level < 1 || level > WorldMapLevelCount || width <= 0.0 { return Vector2.{-1.0, -1.0} }
    at := (level - 1) * 2
    scale := WorldMapScale(width)
    if landscape { return Vector2.{world_map_landscape_positions[at] * scale, world_map_landscape_positions[at + 1] * scale} }
    return Vector2.{world_map_positions[at] * scale, world_map_positions[at + 1] * scale}
}
WorldMapFocusOffset :: (level: s32, width: float32, viewport_height: float32) -> float32 {
    if level < 1 || level > WorldMapLevelCount || width <= 0.0 || viewport_height <= 0.0 { return 0.0 }
    maximum := WorldMapHeight(width) - viewport_height
    if maximum <= 0.0 { return 0.0 }
    offset := WorldMapLevelPosition(level, width).y - viewport_height * 0.5
    if offset < 0.0 { return 0.0 }
    if offset > maximum { return maximum }
    return offset
}

// Source pixels and authored coordinates now agree exactly. Camera width
// supplies screen/world scaling; it never changes the native road geometry.
