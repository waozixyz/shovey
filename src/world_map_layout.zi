#scope_export
WorldMapRailSampleCount :: 33;
WorldMapRailSample :: (edge: s32, sample: s32, width: float32, landscape: bool) -> Vector2 {
    if edge < 0 || edge >= 176 || sample < 0 || sample >= 33 || width <= 0.0 { return Vector2.{-1.0,-1.0} }
    scale := WorldMapScale(width)
    group := edge / 5; at := ((edge - group * 5) * 33 + sample) * 2
    if landscape {
        if group == 0 { return Vector2.{world_map_rail_landscape0[at] * scale,world_map_rail_landscape0[at+1] * scale} }
        if group == 1 { return Vector2.{world_map_rail_landscape1[at] * scale,world_map_rail_landscape1[at+1] * scale} }
        if group == 2 { return Vector2.{world_map_rail_landscape2[at] * scale,world_map_rail_landscape2[at+1] * scale} }
        if group == 3 { return Vector2.{world_map_rail_landscape3[at] * scale,world_map_rail_landscape3[at+1] * scale} }
        if group == 4 { return Vector2.{world_map_rail_landscape4[at] * scale,world_map_rail_landscape4[at+1] * scale} }
        if group == 5 { return Vector2.{world_map_rail_landscape5[at] * scale,world_map_rail_landscape5[at+1] * scale} }
        if group == 6 { return Vector2.{world_map_rail_landscape6[at] * scale,world_map_rail_landscape6[at+1] * scale} }
        if group == 7 { return Vector2.{world_map_rail_landscape7[at] * scale,world_map_rail_landscape7[at+1] * scale} }
