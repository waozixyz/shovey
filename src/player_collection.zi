// Shovey's collection, which the player opens on its covers. Classic, Island
// and Editor keep the independent verified identities they have in Arcade.
#import "kryon/app_context"
#import "kryon/app_protocol"

#program_export
Main :: () -> s32 {
    if AppMode() == APP_IDENTIFY {
        AppIdentity("shovey")
        AppDescribe("Shovey", "")
        return APP_PROTOCOL
    }
    return 0
}
