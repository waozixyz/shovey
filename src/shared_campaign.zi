#import "std/text_buffer"
#import "std/c_string"
Progress :: #import "entity/game_progress";
#import, file "progress.zi";
#import, file "engine.zi";
#import, file "levels.zi";
#import, file "shared_progress.zi";

ShoveySharedRecord :: (progress: *ShoveyProgress) -> Progress.GameProgressRecord {
    value: Progress.GameProgressRecord
    unused CopyCString("shovey.classic", value.game[:])
    value.unlocked = progress.unlocked
    Progress.GameProgressSetLevels(*value, progress.completed[:])
    return value
}

ShoveySharedRestore :: (progress: *ShoveyProgress, value: *Progress.GameProgressRecord) {
    incoming := value.unlocked
    if incoming > ShoveyLevelLimit() { incoming = ShoveyLevelLimit() }
    if incoming > progress.unlocked { progress.unlocked = incoming }
    Progress.GameProgressMarkLevels(value, progress.completed[:])
}
