Referral :: #import "entity/referral_native";
Payment :: #import "entity/dew_play";
ReferralLink :: #import "entity/referral_model";
ReferralAndroid :: #import "entity/referral_android";
// Only the outer player owns Entity, the account Profile. Shovey's games
// reach it through the player's services, as they do inside Arcade.
#import "entity/native_host"
#import "entity/model"
#import "kryon/app_context_host"
#import "kryon/app_protocol"
#import "std/file"
#import "std/c_string"
#import "std/vec"
#import "std/text_buffer"
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/key_input"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "player_platform"
#import "shovey_theme"
#import "kryon/widget_palette"
#import "kryon/drawing_props"
#import "kryon/box_widget"
#import "kryon/box_props"
#import "kryon/text_widget"
#import "kryon/text_props"
#import "kryon/modal_props"
#import "kryon/modal_frame_widget"
#import "kryon/tree"

entity_bundle: string;
entity_ready: bool;
entity_visible: bool;
entity_heading: string = "shovey_shop_profile";
EntityLocaleText :: #type (key: string) -> string;
entity_locale_text: EntityLocaleText;
EntityCopy :: (key: string) -> string { return ifx entity_locale_text != null then entity_locale_text(key) else key }
entity_typed: [1024]u8;
entity_page_title: [256]u8;

EntityTitle :: (fallback: string) -> string {
    if !entity_ready { return EntityCopy(fallback) }
    portable.command = "page-title"
    if !AppContextRun(*portable, APP_COMMAND) || portable.reply == "" ||
    !CopyCString(portable.reply, entity_page_title[:]) { return EntityCopy(fallback) }
    return TextUntilNul(entity_page_title[:])
}

// The profile's theme tokens in Shovey's slate, like the game around it.
EntityShoveyTokens :: () {
    names: [6]string = .["canvas", "surface", "border", "text", "accent", "link"]
    colors: [6]u32 = .[0x2a2e2dff, 0x3b403fff, 0x5d6261ff, 0xe8eceaff, 0x34b930ff, 0x34b930ff]
    for index: 0..5 {
        name: [16]u8
        for byte, at: names[index] { name[at] = byte }
        unused SetStyleTokenColorBytes(name[:names[index].count], colors[index])
    }
}

// The account keeps the place and name Arcade's player gave it, so existing
// players keep their account and keys.
EntityOpen :: (bytes: string, data: string) -> bool {
    EntityShoveyTokens()
    root := Join(data, "entity")
    defer { EntityFree(root) }
    unused Referral.EntityReferralsSource(ifx Payment.DewPlayEdition() then "play" else "direct", "shovey")
    EntityHostGameContext("shovey")
    entity_ready = EntityHostOpen(bytes, root, "arcade", true)
    return entity_ready
}

EntityOpenFile :: (directory: string, data: string) -> bool {
    path := Join(directory, "entity.zx")
    defer { EntityFree(path) }
    file := OpenRead(path)
    if !file.valid { return false }
    defer { unused CloseFile(file) }
    size := FileSize(file)
    if size <= 0 || size > 16777216 { return false }
    bytes: Vec(u8)
    for index: 0..size - 1 {
        if !VecPush(bytes, cast(u8)0) { VecFree(bytes); return false }
    }
    if ReadAt(file, VecSlice(bytes, 0, size), 0) != size { VecFree(bytes); return false }
    entity_bundle = BuilderFinish(bytes)
    return EntityOpen(entity_bundle, data)
}

EntityShow :: () -> bool { return EntityShowPage("open") }

EntityShowPage :: (page: string) -> bool {
    if !entity_ready { return false }
    referral := page == "referrals" || (page.count > 10 && page[:10] == "referrals:")
    if page != "open" && page != "leaderboard" && page != "dew" && !referral { return false }
    if entity_visible && !EntityHostSave() { return false }
    if referral {
        code: [129]u8
        if page.count > 10 && !ReferralLink.ReferralCodeFromLink(page[10:], code[:]) { return false }
        if !EntityHostReferrals(TextUntilNul(code[:])) { return false }
    } else if !EntityHostProfileRequest(page) { return false }
    entity_heading = ifx page == "leaderboard" then "shovey_shop_leaderboard" else ifx page == "dew" then "shovey_shop_dew" else "shovey_shop_profile"
    entity_visible = true
    return true
}

EntityBack :: () -> bool {
    if !entity_visible { return false }
    if EntityHostBack() { entity_heading = "shovey_shop_profile"; return true }
    if EntityHostSave() { entity_visible = false }
    return true
}

EntityFrame :: (session: Session, viewport: Rectangle, key: s32, modifiers: s32) -> bool {
    unused WidgetPaletteUse(session, ShoveyPalette())
    defer { unused WidgetPaletteRestore(session) }
    Box(session, BoxProps.{.key = cast(u64)49010, .bounds = viewport,
            .fill = StyleTokenColorOr("canvas", Color.{239, 246, 244, 255})})
    width := viewport.width - 32.0
    height := viewport.height - 32.0
    if width > 560.0 { width = 560.0 }
    if height > 720.0 { height = 720.0 }
    modal := ModalFrame(session, ModalFrameProps.{.key = cast(u64)49000, .id = 49000,
            .title = EntityTitle(entity_heading), .width = cast(s32)width, .height = cast(s32)height, .scale = 1.0,
            .has_right_action = true, .right_label = EntityCopy("shovey_shop_back")})
    if modal.dismissed || modal.right_clicked { unused EntityBack() }
    if !modal.opened { return true }
    input := TextFieldInputFor(key, modifiers, TypedTextTake(session, entity_typed[:]))
    ok := EntityHostFrame(session, modal.layout.content, key, modifiers, input, true)
    unused End(session)
    if !ok { return false }
    return true
}

EntityPump :: () {
    EntityHostPump()
    invitation: [129]u8
    if entity_ready && ReferralAndroid.EntityTakeReferralInvitation(invitation[:]) {
        request: Vec(u8)
        BuilderPrint(*request, "referrals:%", TextUntilNul(invitation[:]))
        page := BuilderFinish(request)
        unused EntityShowPage(page)
        EntityFree(page)
    }
}

EntityClose :: () -> bool {
    if !entity_ready { return true }
    if !EntityHostClose() { return false }
    entity_ready = false
    entity_visible = false
    EntityFree(entity_bundle)
    entity_bundle = ""
    return true
}
