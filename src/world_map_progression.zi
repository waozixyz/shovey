#scope_export
WorldMapForkAt :: (index: s32) -> WorldMapFork {
    if index < 0 || index >= WORLD_MAP_FORK_COUNT { return .{} }
    at := index * 5
    return WorldMapFork.{world_map_forks[at], world_map_forks[at + 1], world_map_forks[at + 2],
        world_map_forks[at + 3], world_map_forks[at + 4]}
}

// Draw only these edges: sibling arms and secret rooms have no route edge.
WorldMapEdgeAt :: (index: s32) -> WorldMapEdge {
    if index < 0 || index >= WORLD_MAP_EDGE_COUNT { return .{} }
    return WorldMapEdge.{world_map_edges[index * 2], world_map_edges[index * 2 + 1]}
}

WorldMapLevelCompleted :: (completed: []bool, level: s32) -> bool {
    return level >= 1 && level <= WORLD_MAP_CLASSIC_LEVELS &&
        level <= completed.count && completed[level - 1]
}

WorldMapLevelAvailable :: (earned_unlocked: s32, completed: []bool, level: s32) -> bool {
    if level < 1 || level > WORLD_MAP_CLASSIC_LEVELS { return false }
    // Preserve every previously earned unlock, even sparse old saves which
    // recorded no wins. A completion itself also always remains revisitable.
    if level == 1 || level <= earned_unlocked || WorldMapLevelCompleted(completed, level) { return true }
    for index: cast(s32)0..WORLD_MAP_EDGE_COUNT - 1 {
        edge := WorldMapEdgeAt(index)
        if edge.to_level == level && WorldMapLevelCompleted(completed, edge.from_level) { return true }
    }
    return false
}

// A completed entry with two unfinished successors asks the player to choose.
WorldMapAvailableSuccessorCount :: (earned_unlocked: s32, completed: []bool, current: s32) -> s32 {
    count: s32 = 0
    for index: cast(s32)0..WORLD_MAP_EDGE_COUNT - 1 {
        edge := WorldMapEdgeAt(index)
        if edge.from_level == current && WorldMapLevelAvailable(earned_unlocked, completed, edge.to_level) &&
            !WorldMapLevelCompleted(completed, edge.to_level) { count += 1 }
    }
    return count
}

WorldMapChoicePending :: (earned_unlocked: s32, completed: []bool, current: s32) -> bool {
    return WorldMapLevelCompleted(completed, current) &&
        WorldMapAvailableSuccessorCount(earned_unlocked, completed, current) > 1
}

// Follow the chosen route, walking past completed successors without asking
// the player to solve them again. Edge order is the deterministic fallback
// when a caller has not presented the fork choice. Return 0 at the route end.
WorldMapNextLevel :: (earned_unlocked: s32, completed: []bool, current: s32) -> s32 {
    if current < 1 || current > WORLD_MAP_CLASSIC_LEVELS { return 0 }
    pending: [WORLD_MAP_CLASSIC_LEVELS]s32
    seen: [WORLD_MAP_CLASSIC_LEVELS]bool
    pending[0] = current
    seen[current - 1] = true
    read: s32 = 0
    count: s32 = 1
    while read < count {
        from := pending[read]
        read += 1
        for index: cast(s32)0..WORLD_MAP_EDGE_COUNT - 1 {
            edge := WorldMapEdgeAt(index)
            if edge.from_level != from || seen[edge.to_level - 1] { continue }
            seen[edge.to_level - 1] = true
            if !WorldMapLevelAvailable(earned_unlocked, completed, edge.to_level) { continue }
            if !WorldMapLevelCompleted(completed, edge.to_level) { return edge.to_level }
            pending[count] = edge.to_level
            count += 1
        }
    }
    return 0
}

// Keep a current unfinished board meaningful; otherwise prefer its unfinished
// continuation, then the furthest available unfinished board. Never focus a
// locked node solely because it has the largest ID.
WorldMapFocusLevel :: (earned_unlocked: s32, completed: []bool, current: s32) -> s32 {
    if WorldMapLevelAvailable(earned_unlocked, completed, current) {
        if !WorldMapLevelCompleted(completed, current) { return current }
        next := WorldMapNextLevel(earned_unlocked, completed, current)
        if next != 0 { return next }
    }
    latest: s32 = 1
    for level: cast(s32)1..WORLD_MAP_CLASSIC_LEVELS {
        if WorldMapLevelAvailable(earned_unlocked, completed, level) { latest = level }
    }
    level := latest
    while level >= 1 {
        if WorldMapLevelAvailable(earned_unlocked, completed, level) &&
            !WorldMapLevelCompleted(completed, level) { return level }
        level -= 1
    }
    return latest
}

WorldMapSecretDestination :: struct {
    level: s32
    parent_level: s32
    label: string
    discovery_key: string
    detached: bool
}

WorldMapSecretLevel :: (index: s32) -> s32 {
    if index == 0 { return CHEST_LEVEL }
    if index == 1 { return 1001 }
    if index == 2 { return 1002 }
    return 0
}

WorldMapSecretDiscoveryKey :: (level: s32) -> string {
    if level == CHEST_LEVEL { return "local.secret29a" }
    if level == 1001 { return "local.secret175a" }
    if level == 1002 { return "local.secret175b" }
    return ""
}

WorldMapSecretVisible :: (level: s32, discovery_record: string) -> bool {
    return WorldMapSecretDiscoveryKey(level) != "" && discovery_record == "1"
}

// The caller reads the actual discovery record, not ordinary level availability.
// An undiscovered room returns no marker, label, lock, position or destination.
WorldMapDiscoveredSecretAt :: (index: s32, discovery_record: string) -> WorldMapSecretDestination {
    level := WorldMapSecretLevel(index)
    if !WorldMapSecretVisible(level, discovery_record) { return .{} }
    return WorldMapSecretDestination.{
        .level = level,
        .parent_level = ifx level == CHEST_LEVEL then CHEST_PARENT_LEVEL else WORLD_MAP_CLASSIC_LEVELS,
        .label = ifx level == CHEST_LEVEL then "29a" else ifx level == 1001 then "175a" else "175b",
        .discovery_key = WorldMapSecretDiscoveryKey(level),
        .detached = true}
}
