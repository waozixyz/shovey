// The Classic journey graph. IDs identify boards, never their prerequisites.
// Each authored fork is a compact diamond: either arm opens the merge.
// One board per arm lets existing numeric earned prefixes stay lossless;
// longer arms require versioned availability persistence, not a max-ID gate.
#import, file "reward_locations.zi";

WORLD_MAP_CLASSIC_LEVELS :: 175
WORLD_MAP_FORK_COUNT :: 6
WORLD_MAP_EDGE_COUNT :: 180
WORLD_MAP_SECRET_COUNT :: 3

WorldMapEdge :: struct { from_level: s32; to_level: s32 }
WorldMapFork :: struct { entry: s32; left: s32; right: s32; merge: s32; segment: s32 }

#scope_file
// Flat scalar storage keeps the immutable authored tables portable.
world_map_forks: [30]s32 = .[
    17, 18, 19, 20, 1,
    39, 40, 41, 42, 3,
    65, 66, 67, 68, 5,
    89, 90, 91, 92, 7,
    117, 118, 119, 120, 10,
    140, 141, 142, 143, 12,
];

