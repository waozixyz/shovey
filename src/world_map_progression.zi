#scope_export
WorldMapForkAt :: (index: s32) -> WorldMapFork {
    if index < 0 || index >= WORLD_MAP_FORK_COUNT { return .{} }
    at := index * 5
    return WorldMapFork.{world_map_forks[at], world_map_forks[at + 1], world_map_forks[at + 2],
        world_map_forks[at + 3], world_map_forks[at + 4]}
}

// Draw only these edges: sibling arms and secret rooms have no route edge.
WorldMapEdgeAt :: (index: s32) -> WorldMapEdge {
    if index < 0 || index >= WORLD_MAP_EDGE_COUNT { return .{} }
    return WorldMapEdge.{world_map_edges[index * 2], world_map_edges[index * 2 + 1]}
}

WorldMapLevelCompleted :: (completed: []bool, level: s32) -> bool {
    return level >= 1 && level <= WORLD_MAP_CLASSIC_LEVELS &&
        level <= completed.count && completed[level - 1]
}

WorldMapLevelAvailable :: (earned_unlocked: s32, completed: []bool, level: s32) -> bool {
    if level < 1 || level > WORLD_MAP_CLASSIC_LEVELS { return false }
    // Preserve every previously earned unlock, even sparse old saves which
    // recorded no wins. A completion itself also always remains revisitable.
    if level == 1 || level <= earned_unlocked || WorldMapLevelCompleted(completed, level) { return true }
    for index: cast(s32)0..WORLD_MAP_EDGE_COUNT - 1 {
        edge := WorldMapEdgeAt(index)
        if edge.to_level == level && WorldMapLevelCompleted(completed, edge.from_level) { return true }
    }
    return false
}

// A completed entry with two unfinished successors asks the player to choose.
WorldMapAvailableSuccessorCount :: (earned_unlocked: s32, completed: []bool, current: s32) -> s32 {
    count: s32 = 0
    for index: cast(s32)0..WORLD_MAP_EDGE_COUNT - 1 {
        edge := WorldMapEdgeAt(index)
        if edge.from_level == current && WorldMapLevelAvailable(earned_unlocked, completed, edge.to_level) &&
            !WorldMapLevelCompleted(completed, edge.to_level) { count += 1 }
    }
    return count
}

WorldMapChoicePending :: (earned_unlocked: s32, completed: []bool, current: s32) -> bool {
    return WorldMapLevelCompleted(completed, current) &&
        WorldMapAvailableSuccessorCount(earned_unlocked, completed, current) > 1
}

// Continue locally, including replays of completed ordinary boards. Only a
// completed fork merge is skipped when returning from an arm. Prefer unfinished
// arms, then edge order when no fork choice was presented. Return 0 at the end.
WorldMapNextLevel :: (earned_unlocked: s32, completed: []bool, current: s32) -> s32 {
    if current < 1 || current > WORLD_MAP_CLASSIC_LEVELS { return 0 }
    pending: [WORLD_MAP_CLASSIC_LEVELS]s32
    seen: [WORLD_MAP_CLASSIC_LEVELS]bool
    pending[0] = current
    seen[current - 1] = true
    read: s32 = 0
    count: s32 = 1
    while read < count {
        from := pending[read]
        read += 1
        replay: s32 = 0
        for index: cast(s32)0..WORLD_MAP_EDGE_COUNT - 1 {
            edge := WorldMapEdgeAt(index)
            if edge.from_level != from || seen[edge.to_level - 1] { continue }
            seen[edge.to_level - 1] = true
            if !WorldMapLevelAvailable(earned_unlocked, completed, edge.to_level) { continue }
            if !WorldMapLevelCompleted(completed, edge.to_level) { return edge.to_level }
            merge := false
            for fork_index: cast(s32)0..WORLD_MAP_FORK_COUNT - 1 {
                if WorldMapForkAt(fork_index).merge == edge.to_level { merge = true; break }
            }
            if merge {
                pending[count] = edge.to_level
                count += 1
            } else if replay == 0 { replay = edge.to_level }
        }
        if replay != 0 { return replay }
    }
    return 0
}

// Keep a current unfinished board meaningful; otherwise prefer its unfinished
// continuation, then the furthest available unfinished board. Never focus a
// locked node solely because it has the largest ID.
WorldMapFocusLevel :: (earned_unlocked: s32, completed: []bool, current: s32) -> s32 {
    if WorldMapLevelAvailable(earned_unlocked, completed, current) {
        if !WorldMapLevelCompleted(completed, current) { return current }
        next := current
        while next != 0 {
            next = WorldMapNextLevel(earned_unlocked, completed, next)
            if next != 0 && !WorldMapLevelCompleted(completed, next) { return next }
        }
    }
    latest: s32 = 1
    for level: cast(s32)1..WORLD_MAP_CLASSIC_LEVELS {
        if WorldMapLevelAvailable(earned_unlocked, completed, level) { latest = level }
    }
    level := latest
    while level >= 1 {
        if WorldMapLevelAvailable(earned_unlocked, completed, level) &&
            !WorldMapLevelCompleted(completed, level) { return level }
        level -= 1
    }
    return latest
}

WorldMapSecretDestination :: struct {
    level: s32
    parent_level: s32
    label: string
    discovery_key: string
    detached: bool
}

WorldMapSecretLevel :: (index: s32) -> s32 {
    if index == 0 { return CHEST_LEVEL }
    if index == 1 { return 1001 }
    if index == 2 { return 1002 }
    return 0
}

WorldMapSecretDiscoveryKey :: (level: s32) -> string {
    if level == CHEST_LEVEL { return "local.secret29a" }
    if level == 1001 { return "local.secret175a" }
    if level == 1002 { return "local.secret175b" }
    return ""
}

WorldMapSecretVisible :: (level: s32, discovery_record: string) -> bool {
    return WorldMapSecretDiscoveryKey(level) != "" && discovery_record == "1"
}

// The caller reads the actual discovery record, not ordinary level availability.
// An undiscovered room returns no marker, label, lock, position or destination.
WorldMapDiscoveredSecretAt :: (index: s32, discovery_record: string) -> WorldMapSecretDestination {
    level := WorldMapSecretLevel(index)
    if !WorldMapSecretVisible(level, discovery_record) { return .{} }
    return WorldMapSecretDestination.{
        .level = level,
        .parent_level = ifx level == CHEST_LEVEL then CHEST_PARENT_LEVEL else WORLD_MAP_CLASSIC_LEVELS,
        // Immutable authored labels; regression-tested against the formatter below.
        .label = ifx level == CHEST_LEVEL then "21-S" else ifx level == 1001 then "159-S1" else "159-S2",
        .discovery_key = WorldMapSecretDiscoveryKey(level),
        .detached = true}
}

// Display identity never indexes boards or saved progress. Branches use one
// main number for every board of either arm, then advance once at the OR merge.
// This surface supports the current disjoint, two-arm forks (not nested forks).
WorldMapDisplayIdentity :: struct {
    level: s32
    main_number: s32
    branch: s32 // 0 main road, 1 A, 2 B
    step: s32
    fork_entry: s32
    merge: s32
    secret_anchor: s32 // storage ID; zero for ordinary boards
    secret_index: s32 // 1-based within the anchor
    secret_count: s32
    detached: bool
}

// Follow graph edges, never storage-ID adjacency. Secrets have no successors.
WorldMapFirstSuccessor :: (level: s32) -> s32 {
    for index: cast(s32)0..WORLD_MAP_EDGE_COUNT - 1 {
        edge := WorldMapEdgeAt(index)
        if edge.from_level == level { return edge.to_level }
    }
    return 0
}

WorldMapLevelDisplayIdentity :: (level: s32) -> WorldMapDisplayIdentity {
    anchor: s32 = 0
    if level == CHEST_LEVEL { anchor = CHEST_PARENT_LEVEL }
    if level == 1001 || level == 1002 { anchor = WORLD_MAP_CLASSIC_LEVELS }
    target := ifx anchor != 0 then anchor else level
    if target < 1 || target > WORLD_MAP_CLASSIC_LEVELS { return .{} }
    result: WorldMapDisplayIdentity
    current: s32 = 1
    number: s32 = 1
    for visit: cast(s32)1..WORLD_MAP_CLASSIC_LEVELS {
        if current == target {
            result = WorldMapDisplayIdentity.{.main_number = number}
            break
        }
        fork: WorldMapFork
        for index: cast(s32)0..WORLD_MAP_FORK_COUNT - 1 {
            candidate := WorldMapForkAt(index)
            if candidate.entry == current { fork = candidate; break }
        }
        if fork.entry != 0 {
            for side: cast(s32)1..2 {
                arm := ifx side == 1 then fork.left else fork.right
                for step: cast(s32)1..WORLD_MAP_CLASSIC_LEVELS {
                    if arm == 0 || arm == fork.merge { break }
                    if arm == target {
                        result = WorldMapDisplayIdentity.{.main_number = number + 1,
                            .branch = side, .step = step, .fork_entry = fork.entry, .merge = fork.merge}
                        break
                    }
                    arm = WorldMapFirstSuccessor(arm)
                }
                if result.main_number != 0 { break }
            }
            if result.main_number != 0 { break }
            current = fork.merge
            number += 2
        } else {
            current = WorldMapFirstSuccessor(current)
            number += 1
        }
        if current == 0 { return .{} }
    }
    if result.main_number == 0 { return .{} }
    result.level = level
    if anchor != 0 {
        result.secret_anchor = anchor
        result.secret_index = ifx level == 1002 then 2 else 1
        result.secret_count = ifx anchor == CHEST_PARENT_LEVEL then 1 else 2
        result.detached = true
    }
    return result
}

// Returned text borrows caller storage. Keep a separate buffer for every label
// retained by a UI tree. 32 bytes suffices for every current authored label.
// Invalid IDs and insufficient buffers return empty rather than partial names.
WorldMapLevelDisplayName :: (level: s32, output: []u8) -> string {
    identity := WorldMapLevelDisplayIdentity(level)
    if output.count > 0 { output[0] = 0 }
    if identity.level == 0 { return "" }
    bytes: [48]u8
    digits: [24]u8
    length: s64 = 0
    {
        main := FormatInteger(cast(s64)identity.main_number, digits[:])
        for byte: main { bytes[length] = byte; length += 1 }
    }
    if identity.branch != 0 {
        bytes[length] = #char "-"; length += 1
        bytes[length] = ifx identity.branch == 1 then #char "A" else #char "B"; length += 1
        step := FormatInteger(cast(s64)identity.step, digits[:])
        for byte: step { bytes[length] = byte; length += 1 }
    }
    if identity.detached {
        bytes[length] = #char "-"; length += 1
        bytes[length] = #char "S"; length += 1
        if identity.secret_count > 1 {
            ordinal := FormatInteger(cast(s64)identity.secret_index, digits[:])
            for byte: ordinal { bytes[length] = byte; length += 1 }
        }
    }
    if cast(s64)output.count <= length { return "" }
    unused CopyCString(TextView(bytes[:length]), output)
    return TextView(output[:length])
}

// Use this discovery-gated variant for map secrets, with the same record used
// by WorldMapDiscoveredSecretAt; ordinary availability cannot reveal a room.
WorldMapDiscoveredSecretDisplayName :: (index: s32, discovery_record: string, output: []u8) -> string {
    level := WorldMapSecretLevel(index)
    if !WorldMapSecretVisible(level, discovery_record) {
        if output.count > 0 { output[0] = 0 }
        return ""
    }
    return WorldMapLevelDisplayName(level, output)
}
