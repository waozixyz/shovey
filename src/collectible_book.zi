// The Collectible Book: every special item Shovey has found on the campaign
// boards, with its picture, name and a short line, and a dark shape for each
// one still out there. A cover opens it beside the Chest; Back closes it.
#import "kryon/session"
#import "kryon/app_context"
#import "kryon/geometry"
#import "kryon/drawing_props"
Box :: #import "kryon/box";

Text :: #import "kryon/text";

#import "kryon/text_align"
Button :: #import "kryon/button";
#import "kryon/control_props"

Image :: #import "kryon/image";

Scroll :: #import "kryon/scroll";

#import "kryon/tree"
#import "kryon/widget_palette"
#import "std/text_buffer"
#import "std/c_string"
#import "std/vec"
#import "std/json_scan"
Collectibles :: #import, file "collectibles.zi";
#import, file "controls.zi";
#import, file "shovey_theme.zi";
#if #defined(SHOVEY_WEB) {
    Locale :: #import, file "web/host.zi";
    BookText :: (key: string) -> string { return Locale.AppLocaleHost(key) }
} else {
    host_api :: #system_library "host_api";
    AppLocaleHost :: (key: string) -> string #foreign host_api;
    BookText :: (key: string) -> string { return AppLocaleHost(key) }
}

// Multiplied into an unfound item's picture, leaving its dark shape.
BOOK_SHADOW :: 0x1c2230ff
// How long the note of a newly found item stays, in seconds.
BOOK_TOAST_SECONDS :: 2.6

book_open: bool;
book_host_route: bool;
book_scroll: s32;
book_count: [64]u8;
BOOK_ITEMS :: 16 // Collectibles.COLLECTIBLE_COUNT; a local constant bounds the array.
book_toast: [128]u8;

BookCopy :: (bytes: Vec(u8), into: []u8) -> string {
    unused CopyCString(TextView(VecSlice(bytes, 0, bytes.count)), into)
    VecFree(bytes)
    return TextUntilNul(into)
}

BookCaption :: (session: Session, key: u64, bounds: Rectangle, text: string, font: s32, center: bool = false) {
    unused Text.Draw(session, Text.Props.{.key = key, .bounds = bounds, .text = text, .size = font,
            .wrap = Text.Wrap.TextWrapAuto, .align = ifx center then TextAlign.TextAlignCenter else TextAlign.TextAlignStart,
            .vertical_align = TextAlign.TextAlignCenter})
}

#program_export
BookOpen :: () {
    book_open = true
    book_host_route = false
    book_scroll = 0
    // Another instance may have found items since this one last read them.
    Collectibles.CollectibleInvalidate()
}

#program_export
BookIsOpen :: () -> bool { return book_open }

#program_export
BookBack :: () -> bool {
    if !book_open { return false }
    book_open = false
    if book_host_route {
        book_host_route = false
        unused AppService("arcade.navigation", "back")
    }
    return true
}

// A cover's Book button is navigation only, sent like its Chest button.
#program_export
BookRequest :: () {
    if PathRecord("shop.request") == "book" && PathSaveRecord("shop.request", "") { BookOpen(); book_host_route = true }
}

// The signed-in account, as the account records service names it; the
// caller's last known owner while that service cannot answer.
book_owner: [65]u8;
BookOwner :: (fallback: string) -> string {
    status := ProgressAccountService("{\"operation\":\"status\"}")
    account: [65]u8
    if status.count == 0 || status[0] != #char "{" || ReadStringText(status, FieldAt(status, 0, "account"), account[:]) < 0 {
        unused CopyCString(fallback, book_owner[:])
    } else if TextUntilNul(account[:]) == "local" {
        book_owner = .{}
    } else {
        book_owner = account
    }
    return TextUntilNul(book_owner[:])
}

// A cover's Book button: its picture and an invisible button for input.
#program_export
BookCoverAction :: (session: Session, key: u64, bounds: Rectangle) -> bool {
    unused Image.Draw(session, Image.Props.{.key = key + cast(u64)1, .asset_path = "assets/shovey/shop/book.png",
            .bounds = bounds, .alt_text = BookText("shovey_book"), .fit = Image.ImageFit.ImageFitContain, .smooth = true})
    return Button.Draw(session, Button.Props.{.key = key, .id = cast(s32)key, .bounds = bounds,
            .label = BookText("shovey_book"), .invisible = true}) != 0
}

// The open book over bounds for the signed-in owner's finds. True while it
// is open.
#program_export
BookFrame :: (session: Session, bounds: Rectangle, fallback_owner: string) -> bool {
    if !book_open { return false }
    owner := BookOwner(fallback_owner)
    unused WidgetPaletteUse(session, ShoveyPalette())
    defer { unused WidgetPaletteRestore(session) }
    unused Box.Draw(session, Box.Props.{.key = cast(u64)64000, .bounds = bounds, .fill = Color.{42, 46, 45, 255}})
    if Button.Draw(session, Button.Props.{.key = cast(u64)64001, .id = 64001,
            .bounds = Rectangle.{bounds.x + 10.0, bounds.y + 8.0, 76.0, 44.0}, .label = BookText("shovey_shop_back"),
            .fit_content = true, .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        unused BookBack()
        return true
    }
    BookCaption(session, 64002, Rectangle.{bounds.x + 94.0, bounds.y + 8.0, bounds.width - 104.0, 44.0}, BookText("shovey_book"), 17)
    width := bounds.width - 24.0
    if width > 900.0 { width = 900.0 }
    x := bounds.x + (bounds.width - width) / 2.0
    unused Image.Draw(session, Image.Props.{.key = cast(u64)64003, .asset_path = "assets/shovey/shop/book.png",
            .bounds = Rectangle.{x, bounds.y + 62.0, 64.0, 64.0}, .alt_text = BookText("shovey_book"),
            .fit = Image.ImageFit.ImageFitContain, .smooth = true})
    found := Collectibles.CollectibleFoundCount(owner)
    count: Vec(u8)
    BuilderPrint(*count, "% / %", found, Collectibles.COLLECTIBLE_COUNT)
    BookCaption(session, 64004, Rectangle.{x + 76.0, bounds.y + 62.0, width - 76.0, 30.0}, BookCopy(count, book_count[:]), 20)
    BookCaption(session, 64005, Rectangle.{x + 76.0, bounds.y + 94.0, width - 76.0, 32.0},
        BookText(ifx found == Collectibles.COLLECTIBLE_COUNT then "shovey_book_complete" else "shovey_book_hint"), 14)
    top := bounds.y + 138.0
    inner := width - 16.0 // Allow for the host scrollbar.
    columns: s32 = ifx inner >= 740.0 then 4 else ifx inner >= 490.0 then 3 else 2
    gap: float32 = 12.0
    cell_width := (inner - gap * cast(float32)(columns - 1)) / cast(float32)columns
    picture: float32 = ifx cell_width - 24.0 < 96.0 then cell_width - 24.0 else 96.0
    cell_height := picture + 104.0
    rows := (Collectibles.COLLECTIBLE_COUNT + columns - 1) / columns
    viewport_height := bounds.y + bounds.height - top - 8.0
    if viewport_height < 1.0 { return true }
    panel := Scroll.Draw(session, Scroll.Props.{.key = cast(u64)64006, .bounds = Rectangle.{x, top, width, viewport_height},
            .content_height = cast(s32)(cast(float32)rows * (cell_height + gap)), .scroll_offset = book_scroll})
    book_scroll = panel.scroll_offset
    if panel.opened {
        for index: cast(s32)0..Collectibles.COLLECTIBLE_COUNT - 1 {
            earned := Collectibles.CollectibleFound(owner, index)
            cell := Rectangle.{panel.content.x + cast(float32)(index % columns) * (cell_width + gap),
                panel.content.y + cast(float32)(index / columns) * (cell_height + gap), cell_width, cell_height}
            key := cast(u64)(64100 + index * 10)
            unused Box.Draw(session, Box.Props.{.key = key, .bounds = cell, .radius = 12.0,
                    .fill = ColorFromPacked(cast(u32)(ifx earned then 0x3b403fff else 0x2e3332ff)),
                    .border = ColorFromPacked(cast(u32)(ifx earned then 0xffca0cff else 0x4a4f4eff))})
            name := ifx earned then BookText(Collectibles.CollectibleNameKey(index)) else ""
            unused Image.Draw(session, Image.Props.{.key = key + cast(u64)1, .asset_path = Collectibles.CollectibleIcon(index),
                    .bounds = Rectangle.{cell.x + (cell.width - picture) / 2.0, cell.y + 8.0, picture, picture},
                    .alt_text = name, .fit = Image.ImageFit.ImageFitContain, .smooth = true,
                    .tint = ifx earned then cast(u32)0 else cast(u32)BOOK_SHADOW})
            if earned {
                BookCaption(session, key + cast(u64)2, Rectangle.{cell.x + 8.0, cell.y + picture + 10.0, cell.width - 16.0, 28.0}, name, 15, true)
                BookCaption(session, key + cast(u64)3, Rectangle.{cell.x + 8.0, cell.y + picture + 38.0, cell.width - 16.0, 60.0},
                    BookText(Collectibles.CollectibleLineKey(index)), 13, true)
            }
        }
        unused End(session)
    }
    return true
}

// The note of a newly found item over the top of the play area. It takes no
// input, so play goes on under it.
#program_export
BookToast :: (session: Session, bounds: Rectangle, index: s32, age: float64) {
    if index < 0 || age < 0.0 || age >= BOOK_TOAST_SECONDS { return }
    width := ifx bounds.width - 32.0 < 380.0 then bounds.width - 32.0 else 380.0
    rise := ifx age < 0.25 then cast(float32)(0.25 - age) * 48.0 else 0.0
    note := Rectangle.{bounds.x + (bounds.width - width) / 2.0, bounds.y + 8.0 - rise, width, 60.0}
    unused Box.Draw(session, Box.Props.{.key = cast(u64)64400, .bounds = note, .fill = ColorFromPacked(cast(u32)0x23282aee),
            .border = ColorFromPacked(cast(u32)0xffca0cff), .radius = 14.0})
    name := BookText(Collectibles.CollectibleNameKey(index))
    unused Image.Draw(session, Image.Props.{.key = cast(u64)64401, .asset_path = Collectibles.CollectibleIcon(index),
            .bounds = Rectangle.{note.x + 8.0, note.y + 6.0, 48.0, 48.0}, .alt_text = name,
            .fit = Image.ImageFit.ImageFitContain, .smooth = true})
    line: Vec(u8)
    BuilderPrint(*line, "%\n%", BookText("shovey_book_found"), name)
    BookCaption(session, 64402, Rectangle.{note.x + 64.0, note.y, note.width - 72.0, 60.0}, BookCopy(line, book_toast[:]), 15)
}
