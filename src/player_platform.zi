#import "std/c_string"
#import "std/byte_text_linux"
#import "std/vec"
#if #defined(ANDROID_BUILD) {
    #import "kryon/android_jni"
}

libc :: #system_library "libc";
GetEnvironment :: (key: *u8) -> *u8 #foreign libc "getenv";
ReadLink :: (name: *u8, output: *u8, limit: usize) -> isize #foreign libc "readlink";
ChangeDirectory :: (path: *u8) -> s32 #foreign libc "chdir";
WriteError :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "write";

EnvironmentText :: (key: string) -> string {
    name: [64]u8
    if !CopyCString(key, name[:]) { return "" }
    value := GetEnvironment(*name[0])
    return ifx value == null then "" else TextFromCString(value)
}

Join :: (left: string, right: string) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "%/%", left, right)
    return BuilderFinish(path)
}

ExecutableDirectory :: () -> string {
    name: [32]u8
    path: [4096]u8
    unused CopyCString("/proc/self/exe", name[:])
    length := ReadLink(*name[0], *path[0], cast(usize)4095)
    if length <= 0 || length >= 4095 { return "" }
    at := cast(s64)length - 1
    while at > 0 && path[at] != cast(u8)47 { at -= 1 }
    result: Vec(u8)
    BuilderPrint(*result, "%", TextFromBytes(path[:at]))
    return BuilderFinish(result)
}

DataDirectory :: () -> string {
    // Android keeps saves directly in the app's private files folder,
    // which Android creates for the app.
    #if #defined(ANDROID_BUILD) {
        resolved: [4096]u8
        private := AndroidPrivateDataPath(resolved[:])
        if private == "" { return "" }
        result: Vec(u8)
        BuilderPrint(*result, "%", private)
        return BuilderFinish(result)
    }
    // The browser keeps saves in the page's persistent storage, which Kryon
    // mounts at /kryon-apps. Every platform keeps the folder Arcade's player
    // used, so existing players keep their progress and account.
    #if #defined(PLATFORM_WEB) {
        return Join("/kryon-apps", "arcade")
    }
    exact := EnvironmentText("ARCADE_DATA")
    if exact != "" { return exact }
    #if #defined(_WIN32) {
        // Windows keeps per-user application data under Local AppData. File
        // storage takes forward slashes, as Kryon's own players pass them.
        local := EnvironmentText("LOCALAPPDATA")
        if local == "" { return "" }
        path: Vec(u8)
        for byte: local {
            unused VecPush(path, ifx byte == cast(u8)92 then cast(u8)47 else byte)
        }
        BuilderPrint(*path, "%", "/Arcade")
        return BuilderFinish(path)
    }
    base := EnvironmentText("XDG_DATA_HOME")
    if base == "" {
        home := EnvironmentText("HOME")
        if home == "" { return "" }
        base = Join(home, ".local/share")
    }
    return Join(base, "arcade")
}

EnterDirectory :: (path: string) -> bool {
    bytes: [4096]u8
    return CopyCString(path, bytes[:]) && ChangeDirectory(*bytes[0]) == 0
}

#if #defined(ANDROID_BUILD) {
    android_log :: #system_library "log";
    AndroidLogWrite :: (priority: s32, tag: *u8, message: *u8) -> s32 #foreign android_log "__android_log_write";
}

Report :: (message: string) {
    bytes: [1024]u8
    if CopyCString(message, bytes[:]) {
        // Android shows the system log (adb logcat), not standard error.
        #if #defined(ANDROID_BUILD) {
            tag: [8]u8
            unused CopyCString("Shovey", tag[:])
            unused AndroidLogWrite(6, *tag[0], *bytes[0])
        } else {
            unused WriteError(2, *bytes[0], cast(usize)message.count)
        }
    }
}
