// shovey.waozi.xyz: the player in the browser, running a release's own
// shovey.zx, shovey.json and entity.zx, as the downloads do, and opening on
// Shovey's covers. Saves stay in the page's persistent storage.
using Canvas :: #import "kryon/Canvas";
#import "kryon/bundle_storage_web"
#import "kryon/app_files"
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/Frame"
#import "kryon/ScrollDevice"
#import "kryon/key_input"
#import "kryon/TestDriver"
#import "kryon/page_core"
#import "std/file"
#import "std/web"
#import "std/byte_text_linux"
#import "player_platform"
#import "player_host"
#import "player_entity"

player_receipt: [4096]u8;

// The page passes the collection's build receipt (its digest and trusted
// Apps controller) as Module.arcadeReceipt, beside the preloaded /app.zx.
PlayerReceipt :: () -> string {
    handle := WebAsObject(WebGet(WebGetObject(WebGlobal, WebName("Module")), WebName("arcadeReceipt")))
    if handle == 0 { return "" }
    length := WebCopyString(handle, player_receipt[:])
    if length <= 0 || length >= cast(s32)player_receipt.count { return "" }
    return TextFromBytes(player_receipt[:length])
}

PlayerFrame :: (session: Session) -> bool {
    BeginCanvasFrame()
    viewport := CanvasViewport()
    modifiers := CanvasModifiers()
    KeyboardModifiersSend(session, modifiers)
    key := CanvasPressedKey()
    if key == 256 && CollectionBack() { key = 0 }
    KeyboardSend(session, key)
    point := CanvasTypedCodepoint()
    while point != 0 { unused TypedCodepointSend(session, point); point = CanvasTypedCodepoint() }
    pointer := PollPointer()
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
    wheel := CanvasWheelMove()
    PointerWheelSend(session, pointer.x, pointer.y, wheel)
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
        pointer.down, pointer.released, wheel, PageNow() / 1000.0)
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk { return false }
    if !CollectionFrame(session, viewport, key, modifiers) {
        TreeCancel(session)
        return false
    }
    // Only damaged pixels are cleared and repainted; the rest of the page stays.
    if EndCanvasUiFrame(session) != FrameStatus.FrameOk { return false }
    TestDriverFrame(session)
    CanvasCursor(session)
    ok := EndCanvasFrame()
    CollectionCollect()
    return ok
}

#program_export
main :: () -> s32 {
    if !OpenCanvas() { return 1 }
    defer CloseCanvas()
    if !BundleStorageOpen() { return 1 }
    while !BundleStorageReady() && !BundleStorageFailed() { WebSleep(10) }
    if !BundleStorageReady() { return 1 }
    data := DataDirectory()
    // The page preloads the released collection and its Profile.
    bytes, found := ReadEntireFile("/app.zx")
    profile, profile_found := ReadEntireFile("/entity.zx")
    defer { AppFileFree(bytes) }
    receipt := PlayerReceipt()
    if !found || !profile_found || receipt == "" { return 1 }
    if !CollectionOpenShoveyBytes(bytes, receipt, data) { return 1 }
    if !EntityOpen(profile, data) { unused CollectionClose(); return 1 }
    session := SessionOpen()
    if !SessionValid(session) { unused CollectionClose(); return 1 }
    defer { SessionClose(session) }
    saved := PageNow()
    ok := true
    while ok && PollCanvas() {
        scope := WebScope()
        ok = PlayerFrame(session)
        // main returning does not notify Emscripten's onExit unless its
        // runtime exits too. Tell the page explicitly, so a failed game can
        // never leave an apparently live library with no input loop.
        if !ok {
            WebSet(WebGetObject(WebGlobal, WebName("Module")), WebName("arcadeFailed"), WebBool(true))
        } else {
            WebSet(WebGetObject(WebGlobal, WebName("Module")), WebName("profileReady"), WebBool(true))
        }
        // Saves reach the browser's storage about once a second.
        if PageNow() - saved >= 1000.0 {
            unused BundleStorageSync(false)
            saved = PageNow()
        }
        WebEnd(scope)
    }
    unused CollectionClose()
    unused BundleStorageSync(false)
    return ifx ok then 0 else 1
}
