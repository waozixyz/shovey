#import, file "level_change.zi";

// Laws for changing levels. Each states the expected behavior independently
// of the implementation; `ziran check` proves it over every listed input.
// An implementation edit may not change this file.

// A won level never jumps straight to the next: the won board stays fully
// visible at first, and the next level waits for the pause to end.
#law WonBoardStaysVisible forall ms: 0..400 => LevelChangeShadeAt(ms, -1) == 0;
#law NoCutToTheNextLevel forall ms: 0..749 => !LevelWinContinues(ms);
#law NextLevelFollows forall ms: 750..5000 => LevelWinContinues(ms);

// The board is fully dark when the next level replaces it, and it darkens
// smoothly, never brightening on the way.
#law DarkWhenReplaced custom LevelChangeShadeAt(750, -1) == LEVEL_SHADE_FULL;
#law DarkensSmoothly forall ms: 0..749 => LevelChangeShadeAt(ms + 1, -1) >= LevelChangeShadeAt(ms, -1) && LevelChangeShadeAt(ms + 1, -1) - LevelChangeShadeAt(ms, -1) <= 10;

// The next level starts dark and fades in without a jump, ending clear.
#law EntersFromDark custom LevelChangeShadeAt(-1, 0) == LEVEL_SHADE_FULL;
#law FadesInSmoothly forall ms: 0..400 => LevelChangeShadeAt(-1, ms + 1) <= LevelChangeShadeAt(-1, ms) && LevelChangeShadeAt(-1, ms) - LevelChangeShadeAt(-1, ms + 1) <= 10;
#law EndsClear forall ms: 350..5000 => LevelChangeShadeAt(-1, ms) == 0;

// Shade always stays within its range, and nothing is shaded at rest.
#law ShadeInRange forall win: -1..1000, enter: -1..500 => LevelChangeShadeAt(win, enter) >= 0 && LevelChangeShadeAt(win, enter) <= LEVEL_SHADE_FULL;
#law RestIsClear custom LevelChangeShadeAt(-1, -1) == 0;
