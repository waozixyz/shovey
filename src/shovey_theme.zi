Math :: #import "std/math";
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/button_props"
#import "kryon/control_props"
#import "kryon/button_widget"
#import "kryon/widget_palette"

// Every Shovey screen wears the courtyard's own colours, in whatever app it
// runs: a slate backdrop, raised stone controls and Shovey's green for what
// is chosen. The host draws the widgets, so each frame asks it for this
// palette first; the host goes back to its own style when the frame ends.
SHOVEY_SLATE :: 0x2a2e2dff;

ShoveyPalette :: () -> WidgetPalette {
    return WidgetPalette.{.background = cast(u32)SHOVEY_SLATE, .base = cast(u32)0x3b403fff,
        .text = cast(u32)0xe8eceaff, .selected = cast(u32)0x34b930ff,
        .selected_text = cast(u32)0x00210cff, .border = cast(u32)0x5d6261ff,
        .danger = cast(u32)0xe60000ff, .warning = cast(u32)0xffca0cff,
        .success = cast(u32)0x34b930ff, .material = true}
}

// Lays the slate inside the game's content, above the host's navigation.
ShoveyDress :: (session: Session, width: float32, top: float32, bottom: float32) {
    unused WidgetPaletteUse(session, ShoveyPalette())
    Box(session, BoxProps.{.key = cast(u64)19990, .bounds = Rectangle.{0.0, top, width, bottom - top},
            .fill = ColorFromPacked(cast(u32)SHOVEY_SLATE)})
}

// Pip's green light, pulsing round the cell he points at: rings that breathe
// outward and a soft tint inside, so the cell stays readable. Keys key to
// key + 5.
PipGlow :: (session: Session, key: u64, cell: Rectangle, now: float64) {
    pulse := cast(float32)(0.5 + 0.5 * Math.Sin(now * 4.0))
    unused Box(session, BoxProps.{.key = key, .bounds = cell, .radius = 6.0,
            .fill = Color.{207, 242, 139, cast(u8)(24.0 + 40.0 * pulse)}})
    for ring: cast(s32)0..4 {
        grow := cast(float32)ring * (1.5 + 1.5 * pulse)
        alpha := (255.0 - cast(float32)ring * 50.0) * (0.55 + 0.45 * pulse)
        unused Box(session, BoxProps.{.key = key + cast(u64)(ring + 1), .radius = 6.0 + grow,
                .bounds = Rectangle.{cell.x - grow, cell.y - grow, cell.width + grow * 2.0, cell.height + grow * 2.0},
                .border = Color.{207, 242, 139, cast(u8)alpha}})
    }
}

// The button that continues Pip's guide: Shovey's green, filled, with a glow
// pulsing behind it. Keys key and key + 1; true when pressed.
PipContinue :: (session: Session, key: s32, bounds: Rectangle, label: string, now: float64) -> bool {
    pulse := cast(float32)(0.5 + 0.5 * Math.Sin(now * 4.0))
    glow := 3.0 + 4.0 * pulse
    unused Box(session, BoxProps.{.key = cast(u64)(key + 1), .radius = 12.0 + glow,
            .bounds = Rectangle.{bounds.x - glow, bounds.y - glow, bounds.width + glow * 2.0, bounds.height + glow * 2.0},
            .fill = Color.{52, 185, 48, cast(u8)(50.0 + 70.0 * pulse)}})
    return Button(session, ButtonProps.{.key = cast(u64)key, .id = key, .bounds = bounds, .label = label,
            .fit_content = true, .tone = ButtonTone.ButtonToneAccent,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0
}
