Math :: #import "std/math";
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
Box :: #import "kryon/box";

Button :: #import "kryon/button";
#import "kryon/control_props"

Text :: #import "kryon/text";
Image :: #import "kryon/image";
#import "kryon/text_align"

#import "kryon/widget_palette"

// Warm parchment around the garden, with forest green for primary actions.
// The same palette serves the game, its controls and the account Profile.
SHOVEY_SLATE :: 0xf5ecd9ff;

ShoveyPalette :: () -> WidgetPalette {
    return WidgetPalette.{.background = cast(u32)SHOVEY_SLATE, .base = cast(u32)0xfff7e5ff,
        .text = cast(u32)0x283b2cff, .selected = cast(u32)0x3e6e46ff,
        .selected_text = cast(u32)0xfff8e9ff, .border = cast(u32)0xc7b692ff,
        .danger = cast(u32)0xad3932ff, .warning = cast(u32)0xb77716ff,
        .success = cast(u32)0x3e6e46ff, .material = true}
}

// Lays the canvas inside the game's content, above the host's navigation.
ShoveyDress :: (session: Session, width: float32, top: float32, bottom: float32) {
    unused WidgetPaletteUse(session, ShoveyPalette())
    Box.Draw(session, Box.Props.{.key = cast(u64)19990, .bounds = Rectangle.{0.0, top, width, bottom - top},
            .fill = ColorFromPacked(cast(u32)SHOVEY_SLATE)})
}

SHOVEY_HEADER_HEIGHT :: 56.0;
SHOVEY_BACK_ICON :: "S2rr:M15 5L8 12L15 19";
SHOVEY_BALANCE_WIDTH :: 60.0;

// One balance line: its picture and the amount, centred in the row.
ShoveyHeaderBalance :: (session: Session, key: u64, bounds: Rectangle, path: string, label: string, value: string) {
    unused Image.Draw(session, Image.Props.{.key = key,
        .bounds = Rectangle.{bounds.x, bounds.y + 2.0, 18.0, 18.0},
        .asset_path = path, .fit = Image.ImageFit.ImageFitContain, .smooth = true, .alt_text = label})
    unused Text.Draw(session, Text.Props.{.key = key + 1,
        .bounds = Rectangle.{bounds.x + 22.0, bounds.y, bounds.width - 22.0, bounds.height},
        .text = value, .size = 14, .vertical_align = TextAlign.TextAlignCenter})
}

// Shared top title bar: surface and divider, the player's balances when the
// caller supplies them, and the icon-only Back control. True when Back is
// pressed. Keys key to key + 5.
ShoveyHeaderBar :: (session: Session, key: u64, x: float32, y: float32, width: float32,
    height: float32 = SHOVEY_HEADER_HEIGHT, back_key: s32 = 0, back_label: string = "",
    coins: string = "", coins_label: string = "", dew: string = "", dew_label: string = "",
    balance_x: float32 = 56.0) -> bool {
    palette := ShoveyPalette()
    unused Box.Draw(session, Box.Props.{.key = key, .bounds = Rectangle.{x, y, width, height},
            .fill = ColorFromPacked(palette.base)})
    unused Box.Draw(session, Box.Props.{.key = key + 1, .bounds = Rectangle.{x, y + height - 1.0, width, 1.0},
            .fill = ColorFromPacked(palette.border)})
    row: float32 = 22.0
    gap := (height - row * 2.0) / 3.0
    if gap < 2.0 { gap = 2.0 }
    if coins != "" {
        ShoveyHeaderBalance(session, key + 2, Rectangle.{x + balance_x, y + gap, SHOVEY_BALANCE_WIDTH, row},
            "assets/shovey/shop/coins.png", coins_label, coins)
    }
    if dew != "" {
        ShoveyHeaderBalance(session, key + 4, Rectangle.{x + balance_x, y + gap * 2.0 + row, SHOVEY_BALANCE_WIDTH, row},
            "assets/shovey/shop/dew.png", dew_label, dew)
    }
    if back_key != 0 && Button.Draw(session, Button.Props.{.key = cast(u64)back_key, .id = back_key,
            .bounds = Rectangle.{x + 8.0, y + (height - 44.0) * 0.5, 44.0, 44.0},
            .label = back_label, .icon_shape = SHOVEY_BACK_ICON, .icon_only = true,
            .tone = ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisSoft}) != 0 {
        return true
    }
    return false
}

// A slow, soft golden light behind an available reward. Keys key to key + 3.
ShoveyRewardGlow :: (session: Session, key: u64, bounds: Rectangle, now: float64) {
    pulse := cast(float32)(0.5 + 0.5 * Math.Sin(now * 1.8))
    size := ifx bounds.width < bounds.height then bounds.width else bounds.height
    for ring: cast(s32)0..3 {
        grow := size * (0.05 + cast(float32)(3 - ring) * 0.045) * (0.85 + 0.15 * pulse)
        unused Box.Draw(session, Box.Props.{.key = key + cast(u64)ring,
            .bounds = Rectangle.{bounds.x - grow, bounds.y - grow, bounds.width + grow * 2.0, bounds.height + grow * 2.0},
            .fill = Color.{255, 218, 126, cast(u8)(7.0 + 7.0 * pulse)}, .radius = size * 0.3 + grow})
    }
}

// Pip's green light, pulsing round the cell he points at: rings that breathe
// outward and a soft tint inside, so the cell stays readable. Keys key to
// key + 5.
PipGlow :: (session: Session, key: u64, cell: Rectangle, now: float64) {
    pulse := cast(float32)(0.5 + 0.5 * Math.Sin(now * 4.0))
    unused Box.Draw(session, Box.Props.{.key = key, .bounds = cell, .radius = 6.0,
            .fill = Color.{207, 242, 139, cast(u8)(24.0 + 40.0 * pulse)}})
    for ring: cast(s32)0..4 {
        grow := cast(float32)ring * (1.5 + 1.5 * pulse)
        alpha := (255.0 - cast(float32)ring * 50.0) * (0.55 + 0.45 * pulse)
        unused Box.Draw(session, Box.Props.{.key = key + cast(u64)(ring + 1), .radius = 6.0 + grow,
                .bounds = Rectangle.{cell.x - grow, cell.y - grow, cell.width + grow * 2.0, cell.height + grow * 2.0},
                .border = Color.{207, 242, 139, cast(u8)alpha}})
    }
}

// The button that continues Pip's guide: Shovey's green, filled, with a glow
// pulsing behind it. Keys key and key + 1; true when pressed.
PipContinue :: (session: Session, key: s32, bounds: Rectangle, label: string, now: float64) -> bool {
    pulse := cast(float32)(0.5 + 0.5 * Math.Sin(now * 4.0))
    glow := 3.0 + 4.0 * pulse
    unused Box.Draw(session, Box.Props.{.key = cast(u64)(key + 1), .radius = 12.0 + glow,
            .bounds = Rectangle.{bounds.x - glow, bounds.y - glow, bounds.width + glow * 2.0, bounds.height + glow * 2.0},
            .fill = Color.{52, 185, 48, cast(u8)(50.0 + 70.0 * pulse)}})
    return Button.Draw(session, Button.Props.{.key = cast(u64)key, .id = key, .bounds = bounds, .label = label,
            .fit_content = true, .tone = ButtonTone.ButtonToneAccent,
            .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0
}
