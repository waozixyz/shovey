// Exact retired official boards: a stale live publication must not undo a
// shipped correction. Full byte comparison preserves every custom revision.
RETIRED_CLASSIC_97 :: ""

RETIRED_CLASSIC_98 :: ""

RETIRED_CLASSIC_93 :: ""

RETIRED_CLASSIC_97_WORKSHOP :: ""

RETIRED_CLASSIC_98_WORKSHOP :: ""

RETIRED_CLASSIC_97_GARDEN :: ""

RETIRED_CLASSIC_98_FROZEN :: ""

RETIRED_CLASSIC_99 :: ""

RETIRED_CLASSIC_125_BARRELS :: ""

RETIRED_CLASSIC_89_BEFORE_SHOOTERS :: ""

RETIRED_CLASSIC_90_BEFORE_SHOOTERS :: ""

RETIRED_CLASSIC_91_BEFORE_SHOOTERS :: ""

RETIRED_CLASSIC_92_BEFORE_SHOOTERS :: ""

RETIRED_CLASSIC_93_BEFORE_SHOOTERS :: ""

ShoveyRetiredOfficialBoard :: (level: s32, board: string) -> bool {
    return (level == 89 && board == RETIRED_CLASSIC_89_BEFORE_SHOOTERS) ||
           (level == 90 && board == RETIRED_CLASSIC_90_BEFORE_SHOOTERS) ||
           (level == 91 && board == RETIRED_CLASSIC_91_BEFORE_SHOOTERS) ||
           (level == 92 && board == RETIRED_CLASSIC_92_BEFORE_SHOOTERS) ||
           (level == 93 && board == RETIRED_CLASSIC_93_BEFORE_SHOOTERS) ||
           (level == 125 && board == RETIRED_CLASSIC_125_BARRELS) ||
           (level == 97 && board == RETIRED_CLASSIC_97_GARDEN) ||
           (level == 98 && board == RETIRED_CLASSIC_98_FROZEN) ||
           (level == 99 && board == RETIRED_CLASSIC_99) ||
           (level == 93 && board == RETIRED_CLASSIC_93) ||
           (level == 97 && board == RETIRED_CLASSIC_97_WORKSHOP) ||
           (level == 98 && board == RETIRED_CLASSIC_98_WORKSHOP) ||
           (level == 97 && board == RETIRED_CLASSIC_97) ||
           (level == 98 && board == RETIRED_CLASSIC_98)
}
