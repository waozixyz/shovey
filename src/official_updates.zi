// Exact retired official boards: a stale live publication must not undo a
// shipped correction. Full byte comparison preserves every custom revision.
RETIRED_CLASSIC_97 :: ""

RETIRED_CLASSIC_98 :: ""

ShoveyRetiredOfficialBoard :: (level: s32, board: string) -> bool {
    return (level == 97 && board == RETIRED_CLASSIC_97) ||
           (level == 98 && board == RETIRED_CLASSIC_98)
}
