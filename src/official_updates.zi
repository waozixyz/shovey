// Exact retired official boards: a stale live publication must not undo a
// shipped correction. Full byte comparison preserves every custom revision.
RETIRED_CLASSIC_97 :: ""

RETIRED_CLASSIC_98 :: ""

RETIRED_CLASSIC_93 :: ""

RETIRED_CLASSIC_97_WORKSHOP :: ""

RETIRED_CLASSIC_98_WORKSHOP :: ""

ShoveyRetiredOfficialBoard :: (level: s32, board: string) -> bool {
    return (level == 93 && board == RETIRED_CLASSIC_93) ||
           (level == 97 && board == RETIRED_CLASSIC_97_WORKSHOP) ||
           (level == 98 && board == RETIRED_CLASSIC_98_WORKSHOP) ||
           (level == 97 && board == RETIRED_CLASSIC_97) ||
           (level == 98 && board == RETIRED_CLASSIC_98)
}
