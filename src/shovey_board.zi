// Classic's board as a Kryon TileMap: floor under pieces, the ground, the
// pieces and Shovey are four layers of the sprites in assets/shovey/sprites.
// The game view and the level tools draw the board with it.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/tile_map"
#import "std/number_text"
#import "std/c_string"
#import "std/text_buffer"
Math :: #import "std/math";
#import, file "engine.zi";
#import, file "orientation.zi";

// Sprites by number: tile-0 to tile-40 by board kind, then Shovey's facings,
// the open gate, the sensor animation and a shot.
SPRITE_PLAYER :: 41
SPRITE_CHARGED :: 45
SPRITE_DOOR_OPEN :: 49
SPRITE_SENSOR :: 50
SPRITE_SHOT :: 58
SPRITE_NEW_COLOR :: 59
SPRITE_CHERRY :: 71
// The newer kinds 57 to 75, one picture each.
SPRITE_NEW_TILE :: 72
SPRITE_DOG :: 94
SPRITE_TURTLE :: 98
SPRITE_TREE :: 102
SPRITE_GRASS_EDGE :: 103
SPRITE_PORTAL :: 119
SPRITE_WATER :: 122
SPRITE_CRAB :: 126
SPRITE_FISH :: 130
SPRITE_GATE :: 178
SPRITE_GATE_OPEN :: 179
SPRITE_LEVER :: 180
SPRITE_ABYSS :: 182
SPRITE_WALL :: 198
SPRITE_MATERIAL_FLOOR :: 202
SPRITE_DOOR :: 207
SPRITE_LANTERN :: 209
SPRITE_COLORED_GATE :: 210
SPRITE_COLORED_DOOR :: 222
SPRITE_BOULDER :: 228
SPRITE_MOSS_WALL :: 229
SPRITE_MOSS_BUTTON :: 233
SPRITE_DECORATION :: 237
SPRITE_MOSS_FLOOR :: 245
SPRITE_COUNT :: 249
sprite_files: [SPRITE_COUNT]string;
landscape_sprite_files: [SPRITE_COUNT]string;
sprites_ready: bool;
board_layers: [SHOVEY_CELLS * 4]s32;
fall_active: bool;
fall_started: float64;
fall_level: s32;
fall_moves: s32;
fall_position: s32;
fall_points: [4]Vector2;
portal_seen: bool;
portal_level: s32;
portal_moves: s32;
portal_count: s32;
portal_previous: s32;
portal_entry: s32;
portal_exit: s32;
portal_started: float64;
portal_active: bool;

PortalTravelProgress :: (game: *ShoveyGame, now: float64) -> float32 {
    if !portal_seen || portal_level != game.level || game.moves < portal_moves || game.teleports < portal_count {
        portal_active = false
    } else if game.teleports > portal_count {
        entrance := ShoveyNeighbor(portal_previous, game.direction)
        portal_active = entrance >= 0 && (game.ground[entrance] == 8 || ShoveyColorPortal(game.ground[entrance]))
        portal_entry = entrance
        portal_exit = game.player
        portal_started = now
    } else if game.player != portal_exit { portal_active = false }
    portal_seen = true
    portal_level = game.level
    portal_moves = game.moves
    portal_count = game.teleports
    portal_previous = game.player
    if !portal_active { return -1.0 }
    progress := cast(float32)((now - portal_started) / 0.16)
    if progress >= 1.0 { portal_active = false; return -1.0 }
    return progress
}

PortalTravelMesh :: (cell: Rectangle, progress: float32) -> ImageMesh {
    scale := ifx progress < 0.5 then 1.0 - progress * 2.0 else (progress - 0.5) * 2.0
    angle := cast(float64)progress * 12.566370614359172
    cosine := cast(float32)Math.Cos(angle)
    sine := cast(float32)Math.Sin(angle)
    half := cell.width * 0.5 * scale
    for corner: cast(s32)0..3 {
        x := ifx corner % 2 == 0 then -half else half
        y := ifx corner < 2 then -half else half
        fall_points[corner] = Vector2.{cell.x + cell.width * 0.5 + x * cosine - y * sine,
                cell.y + cell.height * 0.5 + x * sine + y * cosine}
    }
    return ImageMesh.{.columns = 2, .rows = 2, .points = fall_points[:]}
}

// The loss stays in the engine immediately; only the picture falls away.
AbyssFallProgress :: (game: *ShoveyGame, now: float64) -> float32 {
    if !game.lost || game.player < 0 || game.ground[game.player] != SHOVEY_PIT {
        fall_active = false
        return -1.0
    }
    if !fall_active || fall_level != game.level || fall_moves != game.moves || fall_position != game.player {
        fall_started = now
        fall_level = game.level
        fall_moves = game.moves
        fall_position = game.player
        fall_active = true
    }
    progress := cast(float32)((now - fall_started) / 0.8)
    return ifx progress >= 1.0 then 1.0 else ifx progress < 0.0 then 0.0 else progress
}

// A rotating, shrinking quad follows a small inward spiral inside the hole.
AbyssFallMesh :: (cell: Rectangle, progress: float32) -> ImageMesh {
    angle := cast(float64)(progress * (2.0 + progress)) * 6.283185307179586
    cosine := cast(float32)Math.Cos(angle)
    sine := cast(float32)Math.Sin(angle)
    scale := (1.0 - progress) * (1.0 - progress)
    half := cell.width * 0.5 * scale
    orbit := cell.width * 0.4 * progress * (1.0 - progress)
    center := Vector2.{cell.x + cell.width * 0.5 + sine * orbit,
            cell.y + cell.height * 0.5 + (1.0 - cosine) * orbit * 0.5}
    for corner: cast(s32)0..3 {
        x := ifx corner % 2 == 0 then -half else half
        y := ifx corner < 2 then -half else half
        fall_points[corner] = Vector2.{center.x + x * cosine - y * sine,
                center.y + x * sine + y * cosine}
    }
    return ImageMesh.{.columns = 2, .rows = 2, .points = fall_points[:]}
}

SpritePathIn :: (files: []string, index: s32, folder: string, name: string) {
    bytes: Vec(u8)
    BuilderPrint(*bytes, "assets/%/sprites/%.png", folder, name)
    files[index] = BuilderFinish(bytes)
}

#if #defined(KRYON_HOSTED_UI) {
    SPRITE_LANDSCAPE_FOLDER :: "shovey/landscape"
} else {
    SPRITE_LANDSCAPE_FOLDER :: "shovey-landscape"
}

SpritePath :: (index: s32, name: string) {
    SpritePathIn(sprite_files[:], index, "shovey", name)
    SpritePathIn(landscape_sprite_files[:], index, SPRITE_LANDSCAPE_FOLDER, name)
}

SpritesPrepare :: () {
    digits: [24]u8
    for kind: cast(s32)0..40 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "tile-%", FormatInteger(cast(s64)kind, digits[:]))
        SpritePath(kind, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
    }
    for kind: cast(s32)44..55 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "tile-%", FormatInteger(cast(s64)kind, digits[:]))
        SpritePath(SPRITE_NEW_COLOR + kind - 44, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
    }
    SpritePath(SPRITE_CHERRY, "tile-56")
    for kind: cast(s32)57..78 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "tile-%", FormatInteger(cast(s64)kind, digits[:]))
        SpritePath(SPRITE_NEW_TILE + kind - 57, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
    }
    // Engine directions are left, up, right, down.
    facings: [4]string = .["left", "up", "right", "down"]
    for direction: cast(s32)0..3 {
        dog: Vec(u8)
        BuilderPrint(*dog, "dog-%", facings[direction])
        SpritePath(SPRITE_DOG + direction, BuilderFinish(dog))
        turtle: Vec(u8)
        BuilderPrint(*turtle, "turtle-%", facings[direction])
        SpritePath(SPRITE_TURTLE + direction, BuilderFinish(turtle))
    }
    SpritePath(SPRITE_TREE, "tile-84")
    SpritePath(SPRITE_GATE, "tile-92")
    SpritePath(SPRITE_GATE_OPEN, "gate-open")
    SpritePath(SPRITE_LEVER, "tile-93")
    SpritePath(SPRITE_LEVER + 1, "tile-94")
    SpritePath(SPRITE_DOOR, "tile-104")
    SpritePath(SPRITE_DOOR + 1, "tile-105")
    SpritePath(SPRITE_LANTERN, "tile-106")
    SpritePath(SPRITE_BOULDER, "tile-122")
    for kind: cast(s32)SHOVEY_MUSHROOMS..SHOVEY_STUMP {
        name: Vec(u8)
        BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)kind, digits[:]))
        SpritePath(SPRITE_DECORATION + kind - SHOVEY_MUSHROOMS, BuilderFinish(name))
    }
    for material: cast(s32)0..3 {
        wall: Vec(u8)
        BuilderPrint(*wall, "tile-%", FormatInteger(cast(s64)(SHOVEY_MOSS_WALL + material), digits[:]))
        SpritePath(SPRITE_MOSS_WALL + material, BuilderFinish(wall))
        button: Vec(u8)
        BuilderPrint(*button, "tile-%", FormatInteger(cast(s64)(SHOVEY_MOSS_BUTTON + material), digits[:]))
        SpritePath(SPRITE_MOSS_BUTTON + material, BuilderFinish(button))
        lowered: Vec(u8)
        BuilderPrint(*lowered, "moss-lowered-%", FormatInteger(cast(s64)material, digits[:]))
        SpritePath(SPRITE_MOSS_FLOOR + material, BuilderFinish(lowered))
    }
    for color: cast(s32)0..2 {
        for part: cast(s32)0..2 {
            name: Vec(u8)
            BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)(107 + color * 3 + part), digits[:]))
            SpritePath(SPRITE_COLORED_GATE + color * 4 + (ifx part == 0 then 0 else part + 1), BuilderFinish(name))
        }
        name: Vec(u8)
        BuilderPrint(*name, "gate-open-%", FormatInteger(cast(s64)color, digits[:]))
        SpritePath(SPRITE_COLORED_GATE + color * 4 + 1, BuilderFinish(name))
    }
    for door: cast(s32)0..5 {
        name: Vec(u8)
        BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)(116 + door), digits[:]))
        SpritePath(SPRITE_COLORED_DOOR + door, BuilderFinish(name))
    }
    for wall: cast(s32)0..3 {
        name: Vec(u8)
        BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)(95 + wall), digits[:]))
        SpritePath(SPRITE_WALL + wall, BuilderFinish(name))
    }
    for floor: cast(s32)0..4 {
        name: Vec(u8)
        BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)(99 + floor), digits[:]))
        SpritePath(SPRITE_MATERIAL_FLOOR + floor, BuilderFinish(name))
    }
    for color: cast(s32)0..2 {
        portal: Vec(u8)
        BuilderPrint(*portal, "tile-%", FormatInteger(cast(s64)(85 + color), digits[:]))
        SpritePath(SPRITE_PORTAL + color, BuilderFinish(portal))
    }
    for frame: cast(s32)0..3 {
        water: Vec(u8)
        BuilderPrint(*water, "water-%", FormatInteger(cast(s64)frame, digits[:]))
        SpritePath(SPRITE_WATER + frame, BuilderFinish(water))
    }
    for direction: cast(s32)0..3 {
        crab: Vec(u8)
        BuilderPrint(*crab, "crab-%", facings[direction])
        SpritePath(SPRITE_CRAB + direction, BuilderFinish(crab))
    }
    fish_names: [3]string = .["gold", "koi", "minnow"]
    for fish: cast(s32)0..2 {
        for frame: cast(s32)0..3 {
            for direction: cast(s32)0..3 {
                name: Vec(u8)
                BuilderPrint(*name, "fish-%-%-%", fish_names[fish], FormatInteger(cast(s64)frame, digits[:]), facings[direction])
                SpritePath(SPRITE_FISH + fish * 16 + frame * 4 + direction, BuilderFinish(name))
            }
        }
    }
    for mask: cast(s32)0..15 {
        edge: Vec(u8)
        BuilderPrint(*edge, "grass-edge-%", FormatInteger(cast(s64)mask, digits[:]))
        SpritePath(SPRITE_GRASS_EDGE + mask, BuilderFinish(edge))
        abyss: Vec(u8)
        BuilderPrint(*abyss, "abyss-edge-%", FormatInteger(cast(s64)mask, digits[:]))
        SpritePath(SPRITE_ABYSS + mask, BuilderFinish(abyss))
    }
    for direction: cast(s32)0..3 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "player-%", facings[direction])
        SpritePath(SPRITE_PLAYER + direction, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
        charged: Vec(u8)
        BuilderPrint(*charged, "charged-%", facings[direction])
        SpritePath(SPRITE_CHARGED + direction, TextView(VecSlice(charged, 0, charged.count)))
        VecFree(charged)
    }
    SpritePath(SPRITE_DOOR_OPEN, "door-open")
    for frame_number: cast(s32)0..7 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "sensor-%", FormatInteger(cast(s64)(frame_number + 1), digits[:]))
        SpritePath(SPRITE_SENSOR + frame_number, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
    }
    SpritePath(SPRITE_SHOT, "projectile")
    sprites_ready = true
}

// The picture file of one sprite number.
SpriteFile :: (index: s32) -> string {
    if !sprites_ready { SpritesPrepare() }
    return sprite_files[index]
}

// Pieces that stand on the floor rather than being a whole floor tile.
OnFloor :: (kind: s32) -> bool {
    return (kind >= 1 && kind <= 3) || (kind >= 44 && kind <= 46) || kind == 9 ||
    (kind >= 15 && kind <= 17) || (kind >= 50 && kind <= 52) || kind == 19 ||
    kind == 21 || kind == 56 || (kind >= 25 && kind <= 29) || kind == 32 || (kind >= 33 && kind <= 38) ||
    (kind >= 53 && kind <= 55) || kind == 40 || kind == 72
}

// The floor drawn under a piece: the moving block's path, plain floor, or
// none (-1) for whole tiles.
FloorSprite :: (kind: s32) -> s32 {
    if !OnFloor(kind) { return -1 }
    return ifx kind == 29 || kind == 32 then 31 else 0
}

// The sprite of one board kind at a cell, or -1. An open gate shows open;
// active sensors turn, one frame every 100 milliseconds.
KindSprite :: (game: *ShoveyGame, kind: s32, position: s32, now: float64, landscape: bool = false) -> s32 {
    if position >= 0 && ShoveyOpenDoor(game.ground[position]) {
        floor := ShoveyWallFloor(kind)
        if floor >= 0 { return ifx floor == 0 then 0 else SPRITE_MATERIAL_FLOOR + floor - 99 }
    }
    moss := ShoveyMossColor(kind)
    if moss >= 0 {
        if position >= 0 && ShoveyDoorOpen(game, position) { return ifx moss == 0 then SPRITE_DOOR_OPEN else SPRITE_MOSS_FLOOR + moss - 1 }
        return ifx moss == 0 then 14 else SPRITE_MOSS_WALL + moss - 1
    }
    if kind >= SHOVEY_MOSS_BUTTON && kind <= SHOVEY_LAST_KIND { return SPRITE_MOSS_BUTTON + kind - SHOVEY_MOSS_BUTTON }
    if kind == SHOVEY_BOULDER { return SPRITE_BOULDER }
    if kind >= SHOVEY_MUSHROOMS && kind <= SHOVEY_STUMP { return SPRITE_DECORATION + kind - SHOVEY_MUSHROOMS }
    color := ShoveyGateColor(kind)
    if color >= 0 {
        open := ifx position >= 0 then ShoveyGateOpen(game, position) else ShoveyGateStartsOpen(kind)
        if color == 0 { return ifx open then SPRITE_GATE_OPEN else SPRITE_GATE }
        return SPRITE_COLORED_GATE + (color - 1) * 4 + (ifx open then 1 else 0)
    }
    lever_color := ShoveyLeverColor(kind)
    if lever_color > 0 { return SPRITE_COLORED_GATE + (lever_color - 1) * 4 + (ifx ShoveyLeverActive(kind) then 3 else 2) }
    if kind >= 116 && kind <= 121 { return SPRITE_COLORED_DOOR + kind - 116 }
    if kind == SHOVEY_LANTERN { return SPRITE_LANTERN }
    if kind == SHOVEY_DOOR || kind == SHOVEY_DOOR_OPEN { return SPRITE_DOOR + kind - SHOVEY_DOOR }
    if ShoveyMaterialFloor(kind) { return SPRITE_MATERIAL_FLOOR + kind - 99 }
    // Hosts may supply Unix time. Reduce the wide frame counter before
    // converting to a sprite index, so animation also works after 2038.
    if kind == 64 { return SPRITE_WATER + cast(s32)(cast(s64)(now * 2.0) % 4) }
    if kind >= 95 && kind <= 98 { return SPRITE_WALL + kind - 95 }
    if ShoveyLever(kind) { return SPRITE_LEVER + kind - SHOVEY_LEVER }
    if kind >= 85 && kind <= 87 { return SPRITE_PORTAL + kind - 85 }
    if kind == SHOVEY_TREE { return SPRITE_TREE }
    if ShoveyAnimal(kind) {
        facing := ifx position >= 0 && game.light_from[position] < 4 then game.light_from[position] else BoardEngineDirection(1, landscape)
        if ShoveyFish(kind) { return SPRITE_FISH + (kind - SHOVEY_FISH) * 16 + facing }
        if kind == SHOVEY_CRAB { return SPRITE_CRAB + facing }
        return (ifx kind == SHOVEY_DOG then SPRITE_DOG else SPRITE_TURTLE) + facing
    }
    sprite := kind
    if kind >= 44 && kind <= 55 { sprite = SPRITE_NEW_COLOR + kind - 44 }
    if kind == 56 { sprite = SPRITE_CHERRY }
    if kind >= 57 && kind <= 78 { sprite = SPRITE_NEW_TILE + kind - 57 }
    if kind == 22 || kind == 24 || kind == 41 || kind == 42 { sprite = SPRITE_SENSOR + cast(s32)(cast(s64)(now * 10.0) % 8) }
    if kind == 43 { sprite = 31 }
    if sprite < 0 || sprite >= SPRITE_COUNT { return -1 }
    return sprite
}

// Shovey facing its direction, charged or not.
PlayerSprite :: (game: *ShoveyGame, landscape: bool = false) -> s32 {
    facing := ifx game.moves == 0 then BoardEngineDirection(1, landscape) else ifx game.direction >= 0 && game.direction <= 3 then game.direction else BoardEngineDirection(1, landscape)
    return (ifx (game.powers & SHOVEY_CHARGED) != 0 then SPRITE_CHARGED else SPRITE_PLAYER) + facing
}

// Draws the board fitted in bounds. `names` describes each sprite number.
// The caller chooses the same orientation used for its input mapping.
// Uses keys from `key` to key + 4 * SHOVEY_CELLS + 1.
ShoveyBoard :: (session: Session, game: *ShoveyGame, bounds: Rectangle, key: u64, now: float64, names: []string,
        landscape: bool) -> TileMapResult {
    if !sprites_ready { SpritesPrepare() }
    columns := cast(s32)(ifx landscape then SHOVEY_HEIGHT else SHOVEY_WIDTH)
    rows := cast(s32)(ifx landscape then SHOVEY_WIDTH else SHOVEY_HEIGHT)
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ground := game.ground[at]
        object := game.objects[at]
        display := BoardDisplayIndex(at, landscape)
        base := game.tiles[at]
        board_layers[display] = KindSprite(game, base, at, now, landscape)
        if base == SHOVEY_PIT {
            board_layers[display] = -1
        }
        if base == 77 {
            mask: s32 = 0
            for direction: cast(s32)0..3 {
                neighbor := ShoveyNeighbor(at, direction)
                if neighbor >= 0 && game.tiles[neighbor] != 77 { mask |= 1 << direction }
            }
            board_layers[display] = SPRITE_GRASS_EDGE + mask
        }
        board_layers[SHOVEY_CELLS + display] = ifx ground == 0 || ground == base || (ShoveyBlockingDecoration(ground) && game.decorations[at] == ground) || ShoveyAnimal(ground) then -1 else KindSprite(game, ground, at, now, landscape)
        decoration := game.decorations[at]
        board_layers[SHOVEY_CELLS * 2 + display] = ifx decoration == 0 then -1 else KindSprite(game, decoration, at, now, landscape)
        piece := ifx object != 0 then object else ifx ShoveyAnimal(ground) then ground else 0
        board_layers[SHOVEY_CELLS * 3 + display] = ifx piece == 0 then -1 else KindSprite(game, piece, at, now, landscape)
    }
    // Fractional cell sizes round neighbouring sprites to different pixel
    // rows and look separated. Fit to one integer cell before drawing.
    cell := bounds.width / cast(float32)columns
    height_cell := bounds.height / cast(float32)rows
    if height_cell < cell { cell = height_cell }
    if cell > 0.0 {
        cell = cast(float32)(cast(s32)cell)
        bounds = Rectangle.{cast(float32)cast(s32)(bounds.x + (bounds.width - cell * cast(float32)columns) / 2.0),
            cast(float32)cast(s32)(bounds.y + (bounds.height - cell * cast(float32)rows) / 2.0),
            cell * cast(float32)columns, cell * cast(float32)rows}
    }
    // Mobile density can put tile edges between physical pixels even with
    // integer logical cells. Match the abyss interior behind the tiles so
    // those edges cannot reveal a pale grid through a joined opening.
    grid := TileMap(session, TileMapProps.{.key = key, .bounds = bounds, .columns = columns, .rows = rows,
            .tiles = ifx landscape then landscape_sprite_files[:] else sprite_files[:], .names = names, .layers = board_layers[:], .layer_count = 4,
            .fill = Color.{2, 4, 5, 255}, .label = "Shovey"})
    // TileMap smooths its pictures. On mobile, filtering can wrap a bright
    // rim onto the opposite edge of the same texture. Draw the abyss's
    // pixel art without filtering, over the matching dark background.
    // Objects and decorations cannot occupy abyss cells.
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.tiles[at] != SHOVEY_PIT { continue }
        mask: s32 = 0
        for direction: cast(s32)0..3 {
            neighbor := ShoveyNeighbor(at, direction)
            if neighbor < 0 || game.tiles[neighbor] != SHOVEY_PIT { mask |= 1 << direction }
        }
        display := BoardDisplayIndex(at, landscape)
        sprite := SPRITE_ABYSS + mask
        files := ifx landscape then landscape_sprite_files[:] else sprite_files[:]
        Image(session, ImageProps.{.key = key + cast(u64)(1 + display), .asset_path = files[sprite],
                .alt_text = ifx cast(s64)sprite < names.count then names[sprite] else "Abyss",
                .bounds = TileMapCell(grid, display), .fit = ImageFit.ImageFitContain, .smooth = false})
    }
    if game.player >= 0 && game.player < SHOVEY_CELLS {
        files := ifx landscape then landscape_sprite_files[:] else sprite_files[:]
        portal := PortalTravelProgress(game, now)
        position := ifx portal >= 0.0 && portal < 0.5 then portal_entry else game.player
        cell := TileMapCell(grid, BoardDisplayIndex(position, landscape))
        fall := AbyssFallProgress(game, now)
        image := ImageProps.{.key = key + cast(u64)(1 + SHOVEY_CELLS * 4), .asset_path = files[PlayerSprite(game, landscape)],
                .alt_text = "Shovey", .bounds = cell, .fit = ImageFit.ImageFitContain, .smooth = true}
        // Fully collapsed quads have no area. Omit them instead of handing
        // the rasterizer a singular image transform at the end/midpoint.
        visible := fall < 0.97 && (portal < 0.49 || portal > 0.51)
        if visible {
            if fall >= 0.0 { image.mesh = AbyssFallMesh(cell, fall) }
            else if portal >= 0.0 { image.mesh = PortalTravelMesh(cell, portal) }
            Image(session, image)
        }
    }
    // A held shot shows as a small ball at Shovey's corner.
    if (game.powers & SHOVEY_AMMO) != 0 && !game.lost && game.player >= 0 && game.player < SHOVEY_CELLS {
        cell := TileMapCell(grid, BoardDisplayIndex(game.player, landscape))
        s := cell.width
        Image(session, ImageProps.{.key = key + cast(u64)(2 + SHOVEY_CELLS * 4), .asset_path = sprite_files[SPRITE_SHOT],
                .alt_text = ifx cast(s64)SPRITE_SHOT < names.count then names[SPRITE_SHOT] else "",
                .bounds = Rectangle.{cell.x + s * 0.58, cell.y + s * 0.58, s * 0.4, s * 0.4},
                .fit = ImageFit.ImageFitContain, .smooth = true})
    }
    return grid
}
