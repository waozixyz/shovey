// Classic's board as a Kryon TileMap: floor under pieces, the ground, the
// pieces and Shovey are four layers of the sprites in assets/shovey/sprites.
// The game view and the level tools draw the board with it.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/image_props"
#import "kryon/image_mesh"
#import "kryon/image_widget"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
#import "kryon/tile_map"
#import "std/number_text"
#import "std/c_string"
#import "std/text_buffer"
Math :: #import "std/math";
#import, file "engine.zi";
#import, file "orientation.zi";

// Sprites by number: tile-0 to tile-40 by board kind, then Shovey's facings,
// the open gate, the sensor animation and a shot.
SPRITE_PLAYER :: 41
SPRITE_CHARGED :: 45
SPRITE_DOOR_OPEN :: 49
SPRITE_SENSOR :: 50
SPRITE_SHOT :: 58
SPRITE_NEW_COLOR :: 59
SPRITE_CHERRY :: 71
// The newer kinds 57 to 75, one picture each.
SPRITE_NEW_TILE :: 72
SPRITE_DOG :: 94
SPRITE_TURTLE :: 98
SPRITE_TREE :: 102
SPRITE_GRASS_EDGE :: 103
SPRITE_PORTAL :: 119
SPRITE_WATER :: 122
SPRITE_CRAB :: 126
SPRITE_FISH :: 130
SPRITE_GATE :: 178
SPRITE_GATE_OPEN :: 179
SPRITE_LEVER :: 180
SPRITE_ABYSS :: 182
SPRITE_WALL :: 198
SPRITE_MATERIAL_FLOOR :: 202
SPRITE_DOOR :: 207
SPRITE_LANTERN :: 209
SPRITE_COLORED_GATE :: 210
SPRITE_COLORED_DOOR :: 222
SPRITE_BOULDER :: 228
SPRITE_MOSS_WALL :: 229
SPRITE_MOSS_BUTTON :: 233
SPRITE_DECORATION :: 237
SPRITE_MOSS_FLOOR :: 245
SPRITE_BURST :: 249
SPRITE_EXPLOSION :: 255
SPRITE_ABYSS_CORNER :: 263
SPRITE_COUNT :: 279
sprite_files: [SPRITE_COUNT]string;
landscape_sprite_files: [SPRITE_COUNT]string;
sprites_ready: bool;
board_layers: [SHOVEY_CELLS * 4]s32;
abyss_sprite_indices: [16]s32;
fall_active: bool;
fall_started: float64;
fall_level: s32;
fall_moves: s32;
fall_position: s32;
fall_points: [4]Vector2;
held_points: [4]Vector2;
portal_seen: bool;
portal_level: s32;
portal_moves: s32;
portal_count: s32;
portal_previous: s32;
portal_entry: s32;
portal_exit: s32;
portal_started: float64;
portal_active: bool;

PortalTravelProgress :: (game: *ShoveyGame, now: float64) -> float32 {
    if !portal_seen || portal_level != game.level || game.moves < portal_moves || game.teleports < portal_count {
        portal_active = false
    } else if game.teleports > portal_count {
        entrance := ShoveyNeighbor(portal_previous, game.direction)
        portal_active = entrance >= 0 && (game.ground[entrance] == 8 || ShoveyColorPortal(game.ground[entrance]))
        portal_entry = entrance
        portal_exit = game.player
        portal_started = now
    } else if game.player != portal_exit { portal_active = false }
    portal_seen = true
    portal_level = game.level
    portal_moves = game.moves
    portal_count = game.teleports
    portal_previous = game.player
    if !portal_active { return -1.0 }
    progress := cast(float32)((now - portal_started) / 0.16)
    if progress >= 1.0 { portal_active = false; return -1.0 }
    return progress
}

PortalTravelMesh :: (cell: Rectangle, progress: float32) -> ImageMesh {
    scale := ifx progress < 0.5 then 1.0 - progress * 2.0 else (progress - 0.5) * 2.0
    center := Vector2.{cell.x + cell.width * 0.5, cell.y + cell.height * 0.5}
    return ImageMeshQuad(cell, Camera.{.target = center, .offset = center,
            .zoom = scale, .rotation = progress * 720.0}, fall_points[:])
}

// The loss stays in the engine immediately; only the picture falls away.
AbyssFallProgress :: (game: *ShoveyGame, now: float64) -> float32 {
    if !game.lost || game.player < 0 || game.ground[game.player] != SHOVEY_PIT {
        fall_active = false
        return -1.0
    }
    if !fall_active || fall_level != game.level || fall_moves != game.moves || fall_position != game.player {
        fall_started = now
        fall_level = game.level
        fall_moves = game.moves
        fall_position = game.player
        fall_active = true
    }
    progress := cast(float32)((now - fall_started) / 0.8)
    return ifx progress >= 1.0 then 1.0 else ifx progress < 0.0 then 0.0 else progress
}

// A rotating, shrinking quad follows a small inward spiral inside the hole.
AbyssFallMesh :: (cell: Rectangle, progress: float32) -> ImageMesh {
    angle := cast(float64)(progress * (2.0 + progress)) * 6.283185307179586
    cosine := cast(float32)Math.Cos(angle)
    sine := cast(float32)Math.Sin(angle)
    scale := (1.0 - progress) * (1.0 - progress)
    orbit := cell.width * 0.4 * progress * (1.0 - progress)
    center := Vector2.{cell.x + cell.width * 0.5, cell.y + cell.height * 0.5}
    offset := Vector2.{center.x + sine * orbit, center.y + (1.0 - cosine) * orbit * 0.5}
    return ImageMeshQuad(cell, Camera.{.target = center, .offset = offset,
            .zoom = scale, .rotation = progress * (2.0 + progress) * 360.0}, fall_points[:])
}

shock_active: bool;
shock_started: float64;
shock_level: s32;
shock_moves: s32;
SHOCK_SECONDS :: 1.3

// Too much charge: the loss stays in the engine at once; the picture shows
// a bolt striking Shovey, Shovey shaking among sparks, then charred and
// smoking where he stood.
ShockProgress :: (game: *ShoveyGame, now: float64) -> float32 {
    if !game.lost || game.player < 0 || game.ground[game.player] != 27 {
        shock_active = false
        return -1.0
    }
    if !shock_active || shock_level != game.level || shock_moves != game.moves {
        shock_started = now
        shock_level = game.level
        shock_moves = game.moves
        shock_active = true
    }
    progress := cast(float32)((now - shock_started) / SHOCK_SECONDS)
    return ifx progress >= 1.0 then 1.0 else ifx progress < 0.0 then 0.0 else progress
}

SHOCK_BOLT :: "F:M13 1L5 13H11L8 23L19 9H13Z"
SHOCK_SPARK :: "S2rr:M3 12L8 8L11 14L16 9L21 12"
// The board's tile map keys each cell of its four layers with WidgetPartKey
// parts 0 to SHOVEY_CELLS * 4 - 1, and the preview's player takes the next
// part; the effects over the board come after them, so no effect ever
// shares a key with a cell (a shared key makes Kryon refuse the frame).
BoardOverlayKey :: (key: u64, part: s32) -> u64 {
    return WidgetPartKey(key, SHOVEY_CELLS * 5 + part)
}

CHARGE_SECONDS :: 0.65

// Taking the first charge lights Shovey up without the charring of a loss.
ChargeEffects :: (session: Session, key: u64, cell: Rectangle, progress: float32) {
    size := cell.width
    cx := cell.x + size * 0.5
    cy := cell.y + size * 0.5
    fade := 1.0 - progress
    glow := size * (1.2 + progress * 0.6)
    unused Box(session, BoxProps.{.key = WidgetPartKey(key, 1),
            .bounds = Rectangle.{cx - glow / 2.0, cy - glow / 2.0, glow, glow},
            .fill = Color.{255, 248, 180, cast(u8)(140.0 * fade * fade)},
            .border = Color.{135, 235, 255, cast(u8)(230.0 * fade)}, .radius = glow / 2.0})
    for spark: cast(s32)0..5 {
        angle := cast(float64)spark * 1.047197551 + cast(float64)progress * 1.2
        reach := size * (0.4 + progress * 0.55)
        spark_size := size * (0.16 + fade * 0.3)
        sx := cx + cast(float32)Math.Cos(angle) * reach
        sy := cy + cast(float32)Math.Sin(angle) * reach
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{sx - spark_size / 2.0, sy - spark_size / 2.0, spark_size, spark_size},
                .shape = SHOCK_SPARK, .color = Color.{185, 245, 255, cast(u8)(255.0 * fade)}})
    }
    if progress < 0.4 {
        bolt_size := size * 0.7
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{cx - bolt_size / 2.0, cell.y - size * (0.35 + progress * 0.4), bolt_size, bolt_size},
                .shape = SHOCK_BOLT, .color = Color.{255, 245, 145, cast(u8)(255.0 * (1.0 - progress / 0.4))}})
    }
}

// Shovey's picture while shocked: he shakes and flickers between lit and
// charred, then stays charred and slumps a little.
ShockShovey :: (image: *ImageProps, cell: Rectangle, progress: float32, now: float64) {
    size := cell.width
    if progress < 0.62 {
        shake: float32 = ifx cast(s32)(now * 40.0) % 2 == 0 then 1.0 else -1.0
        image.bounds.x += shake * size * 0.05
        if cast(s32)(now * 16.0) % 2 == 0 { image.tint = 0x3a3a40ff }
    } else {
        slump := (progress - 0.62) / 0.38
        image.tint = 0x3a3a40ff
        image.bounds.y += size * 0.06 * slump
        image.bounds.height -= size * 0.06 * slump
    }
}

// The strike and its flash, sparks around Shovey, and smoke once charred.
ShockEffects :: (session: Session, key: u64, cell: Rectangle, progress: float32, now: float64) {
    size := cell.width
    cx := cell.x + size * 0.5
    cy := cell.y + size * 0.5
    if progress < 0.18 {
        // The bolt comes down from two cells above, as two stacked bolts.
        fade := 1.0 - progress / 0.18
        bolt := Color.{255, 240, 140, cast(u8)(255.0 * fade)}
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{cell.x, cell.y - size * 2.0, size, size}, .shape = SHOCK_BOLT, .color = bolt})
        SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{cell.x, cell.y - size, size, size}, .shape = SHOCK_BOLT, .color = bolt})
        flash := size * 1.8
        unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 700), .bounds = Rectangle.{cx - flash / 2.0, cy - flash / 2.0, flash, flash},
                .fill = Color.{255, 250, 210, cast(u8)(200.0 * fade)}, .radius = flash / 2.0})
    }
    if progress < 0.7 {
        // Sparks jump around him, a new pattern every few frames.
        step := cast(s32)(now * 14.0)
        for spark: cast(s32)0..3 {
            angle := cast(float64)(step * 7 + spark * 23) * 0.9
            reach := size * 0.42
            sx := cx + cast(float32)Math.Cos(angle) * reach
            sy := cy + cast(float32)Math.Sin(angle) * reach
            spark_size := size * 0.42
            SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{sx - spark_size / 2.0, sy - spark_size / 2.0, spark_size, spark_size},
                    .shape = SHOCK_SPARK, .color = Color.{255, 236, 120, 235}})
        }
        glow := size * 1.15
        pulse := ifx cast(s32)(now * 16.0) % 2 == 0 then 110.0 else 50.0
        unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 701), .bounds = Rectangle.{cx - glow / 2.0, cy - glow / 2.0, glow, glow},
                .fill = Color.{255, 230, 120, cast(u8)pulse}, .radius = glow / 2.0})
    }
    if progress > 0.5 {
        // Three puffs of smoke rise and fade, over and over.
        for puff: cast(s32)0..2 {
            rise := now * 0.8 + cast(float64)puff / 3.0
            phase := cast(float32)(rise - cast(float64)cast(s64)rise)
            puff_size := size * (0.18 + 0.22 * phase)
            px := cx + size * (cast(float32)puff - 1.0) * 0.14 + size * 0.06 * cast(float32)Math.Sin(cast(float64)phase * 6.283)
            py := cell.y + size * 0.2 - size * 0.6 * phase
            unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 702 + puff), .bounds = Rectangle.{px - puff_size / 2.0, py - puff_size / 2.0, puff_size, puff_size},
                    .fill = Color.{90, 90, 96, cast(u8)(150.0 * (1.0 - phase))}, .radius = puff_size / 2.0})
        }
    }
}

SpritePathIn :: (files: []string, index: s32, folder: string, name: string) {
    bytes: Vec(u8)
    BuilderPrint(*bytes, "assets/%/sprites/%.png", folder, name)
    files[index] = BuilderFinish(bytes)
}

// Hosted games and the website pack the landscape art inside the game's
// own folder; desktop builds read the repository's folders.
#if #defined(KRYON_HOSTED_UI) || #defined(SHOVEY_WEB) {
    SPRITE_LANDSCAPE_FOLDER :: "shovey/landscape"
} else {
    SPRITE_LANDSCAPE_FOLDER :: "shovey-landscape"
}

SpritePath :: (index: s32, name: string) {
    SpritePathIn(sprite_files[:], index, "shovey", name)
    SpritePathIn(landscape_sprite_files[:], index, SPRITE_LANDSCAPE_FOLDER, name)
}

SpritesPrepare :: () {
    for index: cast(s32)0..15 { abyss_sprite_indices[index] = SPRITE_ABYSS + index }
    digits: [24]u8
    for kind: cast(s32)0..40 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "tile-%", FormatInteger(cast(s64)kind, digits[:]))
        SpritePath(kind, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
    }
    for kind: cast(s32)44..55 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "tile-%", FormatInteger(cast(s64)kind, digits[:]))
        SpritePath(SPRITE_NEW_COLOR + kind - 44, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
    }
    SpritePath(SPRITE_CHERRY, "tile-56")
    for kind: cast(s32)57..78 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "tile-%", FormatInteger(cast(s64)kind, digits[:]))
        SpritePath(SPRITE_NEW_TILE + kind - 57, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
    }
    // Engine directions are left, up, right, down.
    facings: [4]string = .["left", "up", "right", "down"]
    for direction: cast(s32)0..3 {
        dog: Vec(u8)
        BuilderPrint(*dog, "dog-%", facings[direction])
        SpritePath(SPRITE_DOG + direction, BuilderFinish(dog))
        turtle: Vec(u8)
        BuilderPrint(*turtle, "turtle-%", facings[direction])
        SpritePath(SPRITE_TURTLE + direction, BuilderFinish(turtle))
    }
    SpritePath(SPRITE_TREE, "tile-84")
    SpritePath(SPRITE_GATE, "tile-92")
    SpritePath(SPRITE_GATE_OPEN, "gate-open")
    SpritePath(SPRITE_LEVER, "tile-93")
    SpritePath(SPRITE_LEVER + 1, "tile-94")
    SpritePath(SPRITE_DOOR, "tile-104")
    SpritePath(SPRITE_DOOR + 1, "tile-105")
    SpritePath(SPRITE_LANTERN, "tile-106")
    SpritePath(SPRITE_BOULDER, "tile-122")
    for kind: cast(s32)SHOVEY_MUSHROOMS..SHOVEY_STUMP {
        name: Vec(u8)
        BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)kind, digits[:]))
        SpritePath(SPRITE_DECORATION + kind - SHOVEY_MUSHROOMS, BuilderFinish(name))
    }
    for material: cast(s32)0..3 {
        wall: Vec(u8)
        BuilderPrint(*wall, "tile-%", FormatInteger(cast(s64)(SHOVEY_MOSS_WALL + material), digits[:]))
        SpritePath(SPRITE_MOSS_WALL + material, BuilderFinish(wall))
        button: Vec(u8)
        BuilderPrint(*button, "tile-%", FormatInteger(cast(s64)(SHOVEY_MOSS_BUTTON + material), digits[:]))
        SpritePath(SPRITE_MOSS_BUTTON + material, BuilderFinish(button))
        lowered: Vec(u8)
        BuilderPrint(*lowered, "moss-lowered-%", FormatInteger(cast(s64)material, digits[:]))
        SpritePath(SPRITE_MOSS_FLOOR + material, BuilderFinish(lowered))
    }
    for color: cast(s32)0..2 {
        for part: cast(s32)0..2 {
            name: Vec(u8)
            BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)(107 + color * 3 + part), digits[:]))
            SpritePath(SPRITE_COLORED_GATE + color * 4 + (ifx part == 0 then 0 else part + 1), BuilderFinish(name))
        }
        name: Vec(u8)
        BuilderPrint(*name, "gate-open-%", FormatInteger(cast(s64)color, digits[:]))
        SpritePath(SPRITE_COLORED_GATE + color * 4 + 1, BuilderFinish(name))
    }
    for door: cast(s32)0..5 {
        name: Vec(u8)
        BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)(116 + door), digits[:]))
        SpritePath(SPRITE_COLORED_DOOR + door, BuilderFinish(name))
    }
    for wall: cast(s32)0..3 {
        name: Vec(u8)
        BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)(95 + wall), digits[:]))
        SpritePath(SPRITE_WALL + wall, BuilderFinish(name))
    }
    for floor: cast(s32)0..4 {
        name: Vec(u8)
        BuilderPrint(*name, "tile-%", FormatInteger(cast(s64)(99 + floor), digits[:]))
        SpritePath(SPRITE_MATERIAL_FLOOR + floor, BuilderFinish(name))
    }
    for color: cast(s32)0..2 {
        portal: Vec(u8)
        BuilderPrint(*portal, "tile-%", FormatInteger(cast(s64)(85 + color), digits[:]))
        SpritePath(SPRITE_PORTAL + color, BuilderFinish(portal))
    }
    for frame: cast(s32)0..3 {
        water: Vec(u8)
        BuilderPrint(*water, "water-%", FormatInteger(cast(s64)frame, digits[:]))
        SpritePath(SPRITE_WATER + frame, BuilderFinish(water))
    }
    for direction: cast(s32)0..3 {
        crab: Vec(u8)
        BuilderPrint(*crab, "crab-%", facings[direction])
        SpritePath(SPRITE_CRAB + direction, BuilderFinish(crab))
    }
    fish_names: [3]string = .["gold", "koi", "minnow"]
    for fish: cast(s32)0..2 {
        for frame: cast(s32)0..3 {
            for direction: cast(s32)0..3 {
                name: Vec(u8)
                BuilderPrint(*name, "fish-%-%-%", fish_names[fish], FormatInteger(cast(s64)frame, digits[:]), facings[direction])
                SpritePath(SPRITE_FISH + fish * 16 + frame * 4 + direction, BuilderFinish(name))
            }
        }
    }
    for mask: cast(s32)0..15 {
        edge: Vec(u8)
        BuilderPrint(*edge, "grass-edge-%", FormatInteger(cast(s64)mask, digits[:]))
        SpritePath(SPRITE_GRASS_EDGE + mask, BuilderFinish(edge))
        abyss: Vec(u8)
        BuilderPrint(*abyss, "abyss-edge-%", FormatInteger(cast(s64)mask, digits[:]))
        SpritePath(SPRITE_ABYSS + mask, BuilderFinish(abyss))
        corner: Vec(u8)
        BuilderPrint(*corner, "abyss-corner-%", FormatInteger(cast(s64)mask, digits[:]))
        SpritePath(SPRITE_ABYSS_CORNER + mask, BuilderFinish(corner))
    }
    for direction: cast(s32)0..3 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "player-%", facings[direction])
        SpritePath(SPRITE_PLAYER + direction, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
        charged: Vec(u8)
        BuilderPrint(*charged, "charged-%", facings[direction])
        SpritePath(SPRITE_CHARGED + direction, TextView(VecSlice(charged, 0, charged.count)))
        VecFree(charged)
    }
    SpritePath(SPRITE_DOOR_OPEN, "door-open")
    for frame_number: cast(s32)0..7 {
        bytes: Vec(u8)
        BuilderPrint(*bytes, "sensor-%", FormatInteger(cast(s64)(frame_number + 1), digits[:]))
        SpritePath(SPRITE_SENSOR + frame_number, TextView(VecSlice(bytes, 0, bytes.count)))
        VecFree(bytes)
    }
    SpritePath(SPRITE_SHOT, "projectile")
    for frame_number: cast(s32)0..7 {
        if frame_number < 6 {
            burst: Vec(u8)
            BuilderPrint(*burst, "burst-%", FormatInteger(cast(s64)frame_number, digits[:]))
            SpritePath(SPRITE_BURST + frame_number, BuilderFinish(burst))
        }
        blast: Vec(u8)
        BuilderPrint(*blast, "explosion-%", FormatInteger(cast(s64)frame_number, digits[:]))
        SpritePath(SPRITE_EXPLOSION + frame_number, BuilderFinish(blast))
    }
    sprites_ready = true
}

// The picture file of one sprite number.
SpriteFile :: (index: s32) -> string {
    if !sprites_ready { SpritesPrepare() }
    return sprite_files[index]
}

// Pieces that stand on the floor rather than being a whole floor tile.
OnFloor :: (kind: s32) -> bool {
    return (kind >= 1 && kind <= 3) || (kind >= 44 && kind <= 46) || kind == 9 ||
    (kind >= 15 && kind <= 17) || (kind >= 50 && kind <= 52) || kind == 19 ||
    kind == 21 || kind == 56 || (kind >= 25 && kind <= 29) || kind == 32 || (kind >= 33 && kind <= 38) ||
    (kind >= 53 && kind <= 55) || kind == 40 || kind == 72
}

// The floor drawn under a piece: the moving block's path, plain floor, or
// none (-1) for whole tiles.
FloorSprite :: (kind: s32) -> s32 {
    if !OnFloor(kind) { return -1 }
    return ifx kind == 29 || kind == 32 then 31 else 0
}

// The sprite of one board kind at a cell, or -1. An open gate shows open;
// active sensors turn, one frame every 100 milliseconds.
KindSprite :: (game: *ShoveyGame, kind: s32, position: s32, now: float64, landscape: bool = false) -> s32 {
    if position >= 0 && ShoveyOpenDoor(game.ground[position]) {
        floor := ShoveyWallFloor(kind)
        if floor >= 0 { return ifx floor == 0 then 0 else SPRITE_MATERIAL_FLOOR + floor - 99 }
    }
    moss := ShoveyMossColor(kind)
    if moss >= 0 {
        if position >= 0 && ShoveyDoorOpen(game, position) { return ifx moss == 0 then SPRITE_DOOR_OPEN else SPRITE_MOSS_FLOOR + moss - 1 }
        return ifx moss == 0 then 14 else SPRITE_MOSS_WALL + moss - 1
    }
    if kind >= SHOVEY_MOSS_BUTTON && kind <= SHOVEY_LAST_KIND { return SPRITE_MOSS_BUTTON + kind - SHOVEY_MOSS_BUTTON }
    if kind == SHOVEY_BOULDER { return SPRITE_BOULDER }
    if kind >= SHOVEY_MUSHROOMS && kind <= SHOVEY_STUMP { return SPRITE_DECORATION + kind - SHOVEY_MUSHROOMS }
    color := ShoveyGateColor(kind)
    if color >= 0 {
        open := ifx position >= 0 then ShoveyGateOpen(game, position) else ShoveyGateStartsOpen(kind)
        if color == 0 { return ifx open then SPRITE_GATE_OPEN else SPRITE_GATE }
        return SPRITE_COLORED_GATE + (color - 1) * 4 + (ifx open then 1 else 0)
    }
    lever_color := ShoveyLeverColor(kind)
    if lever_color > 0 { return SPRITE_COLORED_GATE + (lever_color - 1) * 4 + (ifx ShoveyLeverActive(kind) then 3 else 2) }
    if kind >= 116 && kind <= 121 { return SPRITE_COLORED_DOOR + kind - 116 }
    if kind == SHOVEY_LANTERN { return SPRITE_LANTERN }
    if kind == SHOVEY_DOOR || kind == SHOVEY_DOOR_OPEN { return SPRITE_DOOR + kind - SHOVEY_DOOR }
    if ShoveyMaterialFloor(kind) { return SPRITE_MATERIAL_FLOOR + kind - 99 }
    // Hosts may supply Unix time. Reduce the wide frame counter before
    // converting to a sprite index, so animation also works after 2038.
    if kind == 64 { return SPRITE_WATER + cast(s32)(cast(s64)(now * 2.0) % 4) }
    if kind >= 95 && kind <= 98 { return SPRITE_WALL + kind - 95 }
    if ShoveyLever(kind) { return SPRITE_LEVER + kind - SHOVEY_LEVER }
    if kind >= 85 && kind <= 87 { return SPRITE_PORTAL + kind - 85 }
    if kind == SHOVEY_TREE { return SPRITE_TREE }
    if ShoveyAnimal(kind) {
        facing := ifx position >= 0 && game.light_from[position] < 4 then game.light_from[position] else BoardEngineDirection(1, landscape)
        if ShoveyFish(kind) { return SPRITE_FISH + (kind - SHOVEY_FISH) * 16 + facing }
        if kind == SHOVEY_CRAB { return SPRITE_CRAB + facing }
        return (ifx kind == SHOVEY_DOG then SPRITE_DOG else SPRITE_TURTLE) + facing
    }
    sprite := kind
    if kind >= 44 && kind <= 55 { sprite = SPRITE_NEW_COLOR + kind - 44 }
    if kind == 56 { sprite = SPRITE_CHERRY }
    if kind >= 57 && kind <= 78 { sprite = SPRITE_NEW_TILE + kind - 57 }
    if kind == 22 || kind == 24 || kind == 41 || kind == 42 { sprite = SPRITE_SENSOR + cast(s32)(cast(s64)(now * 10.0) % 8) }
    if kind == 43 { sprite = 31 }
    if sprite < 0 || sprite >= SPRITE_COUNT { return -1 }
    return sprite
}

// Shovey facing its direction, charged or not.
PlayerSprite :: (game: *ShoveyGame, landscape: bool = false) -> s32 {
    facing := ifx game.moves == 0 then BoardEngineDirection(1, landscape) else ifx game.direction >= 0 && game.direction <= 3 then game.direction else BoardEngineDirection(1, landscape)
    return (ifx (game.powers & SHOVEY_CHARGED) != 0 then SPRITE_CHARGED else SPRITE_PLAYER) + facing
}

// Draws the board fitted in bounds. `names` describes each sprite number.
// The caller chooses the same orientation used for its input mapping.
// Uses keys from `key` to key + 4 * SHOVEY_CELLS + 1.
// Animals that step on their own glide to their new cell instead of jumping.
BOARD_GLIDES :: 32
BOARD_GLIDE_SECONDS :: 0.45
BoardGlide :: struct {
    from: s32
    to: s32
    start: float64
}
board_glides: [BOARD_GLIDES]BoardGlide;
board_gliding: [SHOVEY_CELLS]s32;

// Whether a cell is an open drop: an abyss tile, or floor that gave way.
BoardAbyss :: (game: *ShoveyGame, at: s32) -> bool {
    return game.tiles[at] == SHOVEY_PIT || game.ground[at] == SHOVEY_PIT
}

// The inner corners of an abyss cell, on screen: bit 0 up-left, 1 up-right,
// 2 down-left, 3 down-right, where that diagonal cell is solid ground while
// both cells beside this one are abyss. open says which cells are abyss.
board_abyss_open: [SHOVEY_CELLS]bool;

BoardAbyssCorners :: (at: s32, landscape: bool, open: [SHOVEY_CELLS]bool) -> s32 {
    corners: s32 = 0
    sides: [4]s32
    for side: cast(s32)0..3 { sides[side] = ShoveyNeighbor(at, BoardEngineDirection(side, landscape)) }
    // Up-left, up-right, down-left, down-right: the vertical side, then the
    // horizontal one.
    verticals: [4]s32 = .[1, 1, 3, 3]
    horizontals: [4]s32 = .[0, 2, 0, 2]
    for corner: cast(s32)0..3 {
        first := sides[verticals[corner]]; second := sides[horizontals[corner]]
        if first < 0 || second < 0 || !open[first] || !open[second] { continue }
        diagonal := ShoveyNeighbor(first, BoardEngineDirection(horizontals[corner], landscape))
        if diagonal >= 0 && !open[diagonal] { corners |= 1 << corner }
    }
    return corners
}

// Starts an animal's glide from one cell to the next.
BoardGlideStart :: (from: s32, to: s32, now: float64) {
    slot: s32 = 0
    for index: cast(s32)0..BOARD_GLIDES - 1 {
        if board_glides[index].start < board_glides[slot].start { slot = index }
    }
    board_glides[slot] = BoardGlide.{.from = from, .to = to, .start = now}
}

// The layers drawn last frame and the board they show. Most frames only the
// water and sensors change, so the layers are rebuilt only when a cell,
// a glide, Shovey or the orientation changed; otherwise just those
// animated cells are refreshed. A cell's sprite can depend on other cells
// (buttons, levers), so any change rebuilds every layer.
board_cache_ground: [SHOVEY_CELLS]s32;
board_cache_objects: [SHOVEY_CELLS]s32;
board_cache_light: [SHOVEY_CELLS]s32;
board_cache_tiles: [SHOVEY_CELLS]s32;
board_cache_decorations: [SHOVEY_CELLS]s32;
board_cache_gliding: [SHOVEY_CELLS]s32;
board_cache_player: s32 = -2;
board_cache_landscape: bool;
board_cache_animated: [SHOVEY_CELLS]s32;
board_cache_animated_count: s32;

BoardCacheCurrent :: (game: *ShoveyGame, landscape: bool) -> bool {
    if board_cache_player != game.player || board_cache_landscape != landscape { return false }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if board_cache_ground[at] != game.ground[at] || board_cache_objects[at] != game.objects[at] ||
        board_cache_light[at] != game.light_from[at] || board_cache_tiles[at] != game.tiles[at] ||
        board_cache_decorations[at] != game.decorations[at] || board_cache_gliding[at] != board_gliding[at] { return false }
    }
    return true
}

// Tasks left on the drawn board, counted when the board changes.
board_remaining: s32;
BoardRemaining :: () -> s32 { return board_remaining }

BoardCacheKeep :: (game: *ShoveyGame, landscape: bool) {
    board_cache_animated_count = 0
    board_remaining = ShoveyRemaining(game)
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        board_cache_ground[at] = game.ground[at]
        board_cache_objects[at] = game.objects[at]
        board_cache_light[at] = game.light_from[at]
        board_cache_tiles[at] = game.tiles[at]
        board_cache_decorations[at] = game.decorations[at]
        board_cache_gliding[at] = board_gliding[at]
        ground := game.ground[at]
        if game.tiles[at] == 64 || ground == 22 || ground == 24 || ground == 41 || ground == 42 {
            board_cache_animated[board_cache_animated_count] = at
            board_cache_animated_count += 1
        }
    }
    board_cache_player = game.player
    board_cache_landscape = landscape
}

BoardGlidesClear :: () {
    for index: cast(s32)0..BOARD_GLIDES - 1 { board_glides[index] = BoardGlide.{} }
}

// Pieces still to move glow very faintly once Shovey has stood still for a
// few seconds: balls, crates off their marks while marks are open, stars and
// colour blocks not resting on a goal. Never pits or marks. Once everything
// is done, home lights up warmly with sparkles rising from its door. Tools
// that draw still pictures turn both off.
board_guides: bool = true;
board_idle_level: s32 = -1;
board_idle_moves: s32;
board_idle_since: float64;
board_home_since: float64 = -1.0;
BOARD_IDLE_SECONDS :: 4.0

BoardPieceToMove :: (game: *ShoveyGame, at: s32, open_marks: bool, open_goals: bool) -> bool {
    object := game.objects[at]; ground := game.ground[at]
    if ShoveyBallColor(object) > 0 || object == 19 { return true }
    if object == 9 { return open_marks && ground != 18 }
    if ShoveyColorBlock(object) { return open_goals && !(ground == 39 && ShoveyColorRest(object)) }
    return false
}

BoardGuides :: (session: Session, game: *ShoveyGame, grid: TileMapResult, key: u64, now: float64, landscape: bool) {
    if !board_guides || game.won || game.lost { return }
    if board_idle_level != game.level || board_idle_moves != game.moves {
        board_idle_level = game.level; board_idle_moves = game.moves; board_idle_since = now
    }
    breath := cast(float32)(0.5 + 0.5 * Math.Sin(now * 2.4))
    if board_remaining == 0 {
        if board_home_since < 0.0 { board_home_since = now }
        rise := cast(float32)((now - board_home_since) / 0.6)
        if rise > 1.0 { rise = 1.0 }
        for at: cast(s32)0..SHOVEY_CELLS - 1 {
            if game.ground[at] != 7 { continue }
            cell := TileMapCell(grid, BoardDisplayIndex(at, landscape))
            cx := cell.x + cell.width / 2.0; cy := cell.y + cell.height / 2.0
            light := cell.width * 1.5
            unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 600), .bounds = Rectangle.{cx - light / 2.0, cy - light / 2.0, light, light},
                    .fill = Color.{255, 214, 120, cast(u8)(rise * (40.0 + 30.0 * breath))}, .radius = light / 2.0})
            for spark: cast(s32)0..2 {
                phase := now * 0.7 + cast(float64)spark / 3.0
                t := cast(float32)(phase - cast(float64)cast(s64)phase)
                sx := cx + cast(float32)Math.Sin(cast(float64)t * 6.283 + cast(float64)spark * 2.1) * cell.width * 0.22
                sy := cy + cell.height * 0.15 - t * cell.height * 0.85
                size := cell.width * 0.1
                unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 601 + spark), .bounds = Rectangle.{sx - size / 2.0, sy - size / 2.0, size, size},
                        .fill = Color.{255, 244, 190, cast(u8)(rise * (1.0 - t) * 230.0)}, .radius = size / 2.0})
            }
            break
        }
        return
    }
    board_home_since = -1.0
    idle := cast(float32)(now - board_idle_since) - BOARD_IDLE_SECONDS
    if idle <= 0.0 { return }
    fade := ifx idle > 1.5 then 1.0 else idle / 1.5
    open_marks := false; open_goals := false
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.ground[at] == 18 && game.objects[at] != 9 { open_marks = true }
        if game.ground[at] == 39 && !ShoveyColorRest(game.objects[at]) { open_goals = true }
    }
    shown: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if shown >= 48 || !BoardPieceToMove(game, at, open_marks, open_goals) { continue }
        cell := TileMapCell(grid, BoardDisplayIndex(at, landscape))
        halo := cell.width * 1.3
        unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 500 + shown), .bounds = Rectangle.{cell.x + (cell.width - halo) / 2.0,
                cell.y + (cell.height - halo) / 2.0, halo, halo}, .fill = Color.{255, 240, 190, cast(u8)(fade * (10.0 + 16.0 * breath))},
                .border = Color.{255, 240, 190, cast(u8)(fade * (24.0 + 36.0 * breath))}, .radius = halo / 2.0})
        shown += 1
    }
}

// Throws and blasts play over the board. The engine reports no events, so
// the board from the frame before tells what the last move did: a shot that
// left Shovey's hand flies along its line and every target it passed bursts
// as it gets there; a cracked wall that became floor explodes.
BOARD_EFFECTS :: 16
BOARD_FLIGHT_STEP :: 0.05
BOARD_BURST_FRAME :: 0.06
BOARD_BLAST_FRAME :: 0.08
BoardEffect :: struct {
    // 1 a struck target, 2 a blast, 3 a ball dropping into its pit,
    // 4 the first electric charge; 0 a free slot.
    kind: s32
    at: s32
    start: float64
    // The ball that dropped.
    piece: s32
}
board_effects: [BOARD_EFFECTS]BoardEffect;
board_flight_from: s32 = -1;
board_flight_direction: s32;
board_flight_cells: s32;
board_flight_start: float64;
board_seen: bool;
board_seen_level: s32;
board_seen_moves: s32;
board_seen_powers: s32;
board_seen_ground: [SHOVEY_CELLS]s32;
board_seen_objects: [SHOVEY_CELLS]s32;

BoardEffectStart :: (kind: s32, at: s32, start: float64, piece: s32 = 0) {
    slot: s32 = 0
    for index: cast(s32)0..BOARD_EFFECTS - 1 {
        if board_effects[index].kind == 0 { slot = index; break }
        if board_effects[index].start < board_effects[slot].start { slot = index }
    }
    board_effects[slot] = BoardEffect.{.kind = kind, .at = at, .start = start, .piece = piece}
}

BoardEffectsNotice :: (game: *ShoveyGame, now: float64) {
    if !board_seen || board_seen_level != game.level || game.moves < board_seen_moves {
        // A new level, a restart or an undo: nothing from before plays on.
        for index: cast(s32)0..BOARD_EFFECTS - 1 { board_effects[index].kind = 0 }
        board_flight_from = -1
    } else if !game.lost && game.player >= 0 && game.moves > board_seen_moves &&
    (board_seen_powers & SHOVEY_CHARGED) == 0 && (game.powers & SHOVEY_CHARGED) != 0 {
        // A fast move or an animal tick may skip an intermediate frame.
        // The power transition still identifies the first touch exactly once.
        BoardEffectStart(4, game.player, now)
    }
    if game.lost {
        // A second touch uses the fatal shock, even if the first burst is fresh.
        for index: cast(s32)0..BOARD_EFFECTS - 1 {
            if board_effects[index].kind == 4 { board_effects[index].kind = 0 }
        }
    }
    if board_seen && board_seen_level == game.level && game.moves == board_seen_moves + 1 {
        if (board_seen_powers & SHOVEY_AMMO) != 0 && (game.powers & SHOVEY_AMMO) == 0 && game.player >= 0 {
            // Targets never stop a shot, so the line is the same on the new board.
            cells: s32 = 0
            at := ShoveyNeighbor(game.player, game.direction)
            while at >= 0 && !ShoveyShotStops(game, at) {
                if board_seen_objects[at] == 28 { BoardEffectStart(1, at, now + cast(float64)cells * BOARD_FLIGHT_STEP) }
                cells += 1
                at = ShoveyNeighbor(at, game.direction)
            }
            board_flight_from = game.player
            board_flight_direction = game.direction
            board_flight_cells = cells
            board_flight_start = now
        }
        for at: cast(s32)0..SHOVEY_CELLS - 1 {
            if board_seen_ground[at] == SHOVEY_CRACKED_WALL && game.ground[at] != SHOVEY_CRACKED_WALL { BoardEffectStart(2, at, now) }
        }
        // A ball pushed into its pit: Shovey stands where the ball was.
        before := ifx game.player >= 0 then board_seen_objects[game.player] else 0
        if ShoveyBallColor(before) > 0 {
            pit := ShoveyNeighbor(game.player, game.direction)
            if pit >= 0 && ShoveyPitColor(game.ground[pit]) > 0 && game.objects[pit] == 0 { BoardEffectStart(3, pit, now, before) }
        }
    }
    board_seen = true
    board_seen_level = game.level
    board_seen_moves = game.moves
    board_seen_powers = game.powers
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        board_seen_ground[at] = game.ground[at]
        board_seen_objects[at] = game.objects[at]
    }
}

// The cell `steps` cells along a direction from a cell, as drawn, or the
// last one on the board.
BoardAlong :: (grid: TileMapResult, from: s32, direction: s32, steps: s32, landscape: bool) -> Rectangle {
    at := from
    for step: cast(s32)0..steps - 1 {
        next := ShoveyNeighbor(at, direction)
        if next < 0 { break }
        at = next
    }
    return TileMapCell(grid, BoardDisplayIndex(at, landscape))
}

ShoveyBoard :: (session: Session, game: *ShoveyGame, bounds: Rectangle, key: u64, now: float64, names: []string,
    landscape: bool) -> TileMapResult {
    if !sprites_ready { SpritesPrepare() }
    BoardEffectsNotice(game, now)
    columns := cast(s32)(ifx landscape then SHOVEY_HEIGHT else SHOVEY_WIDTH)
    rows := cast(s32)(ifx landscape then SHOVEY_WIDTH else SHOVEY_HEIGHT)
    for at: cast(s32)0..SHOVEY_CELLS - 1 { board_gliding[at] = -1 }
    for index: cast(s32)0..BOARD_GLIDES - 1 {
        glide := board_glides[index]
        if glide.start > 0.0 && now - glide.start < BOARD_GLIDE_SECONDS && glide.to >= 0 && glide.to < SHOVEY_CELLS &&
        ShoveyAnimal(game.ground[glide.to]) && game.objects[glide.to] == 0 {
            board_gliding[glide.to] = index
        }
    }
    cached := BoardCacheCurrent(game, landscape)
    if cached {
        // Only water ripples and sensors move.
        for index: cast(s32)0..board_cache_animated_count - 1 {
            at := board_cache_animated[index]
            display := BoardDisplayIndex(at, landscape)
            if game.tiles[at] == 64 { board_layers[display] = KindSprite(game, 64, at, now, landscape) }
            ground := game.ground[at]
            if ground == 22 || ground == 24 || ground == 41 || ground == 42 {
                board_layers[SHOVEY_CELLS + display] = KindSprite(game, ground, at, now, landscape)
            }
        }
    }
    if !cached {
        BoardLayersFill(game, board_layers[:], now, landscape, true)
        BoardCacheKeep(game, landscape)
    }
    // Mobile density can put tile edges between physical pixels even with
    // integer logical cells. Match the abyss interior behind the tiles so
    // those edges cannot reveal a pale grid through a joined opening.
    grid := TileMap(session, TileMapProps.{.key = key, .bounds = bounds, .columns = columns, .rows = rows,
            .tiles = ifx landscape then landscape_sprite_files[:] else sprite_files[:], .names = names, .layers = board_layers[:], .layer_count = 4,
            .fill = Color.{2, 4, 5, 255}, .label = "Shovey", .pixel_snap = true, .nearest_tiles = abyss_sprite_indices[:]})
    return ShoveyBoardPieces(session, game, grid, key, now, names, landscape)
}

// The floor a neighbouring cell shows, for drawing under an arrow.
BoardArrowFloor :: (game: *ShoveyGame, at: s32) -> s32 {
    for side: cast(s32)0..3 {
        neighbor := ShoveyNeighbor(at, side)
        if neighbor < 0 { continue }
        tile := game.tiles[neighbor]
        if tile == 77 || ShoveyMaterialFloor(tile) { return tile }
    }
    return 0
}

// The board's four picture layers: floor, ground, decorations and pieces.
// Animals gliding to a cell are drawn by the board itself while `glides`.
BoardLayersFill :: (game: *ShoveyGame, layers: []s32, now: float64, landscape: bool, glides: bool) {
    for at: cast(s32)0..SHOVEY_CELLS - 1 { board_abyss_open[at] = BoardAbyss(game, at) }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ground := game.ground[at]
        object := game.objects[at]
        display := BoardDisplayIndex(at, landscape)
        base := game.tiles[at]
        layers[display] = KindSprite(game, base, at, now, landscape)
        // An abyss, drawn or left by cracked floor, joins its neighbours into
        // one drop. Its edges go by screen direction, so the far cliff always
        // shows at the top of the opening.
        if BoardAbyss(game, at) {
            mask: s32 = 0
            for side: cast(s32)0..3 {
                neighbor := ShoveyNeighbor(at, BoardEngineDirection(side, landscape))
                if neighbor < 0 || !BoardAbyss(game, neighbor) { mask |= 1 << side }
            }
            layers[display] = SPRITE_ABYSS + mask
            corners := BoardAbyssCorners(at, landscape, board_abyss_open)
            layers[SHOVEY_CELLS + display] = ifx corners != 0 then SPRITE_ABYSS_CORNER + corners else -1
        } else if base == 77 {
            // Grass runs up to an abyss's own lip; other floors get a soft edge.
            mask: s32 = 0
            for direction: cast(s32)0..3 {
                neighbor := ShoveyNeighbor(at, direction)
                if neighbor >= 0 && game.tiles[neighbor] != 77 && !BoardAbyss(game, neighbor) { mask |= 1 << direction }
            }
            layers[display] = SPRITE_GRASS_EDGE + mask
        }
        if !BoardAbyss(game, at) {
            layers[SHOVEY_CELLS + display] = ifx ground == 0 || ground == base || (ShoveyBlockingDecoration(ground) && game.decorations[at] == ground) || ShoveyAnimal(ground) then -1 else KindSprite(game, ground, at, now, landscape)
        }
        // An arrow is painted on the floor around it, not on the black
        // behind the board.
        if ShoveyArrow(base) >= 0 {
            layers[display] = KindSprite(game, BoardArrowFloor(game, at), at, now, landscape)
            layers[SHOVEY_CELLS + display] = KindSprite(game, base, at, now, landscape)
        }
        decoration := game.decorations[at]
        layers[SHOVEY_CELLS * 2 + display] = ifx decoration == 0 then -1 else KindSprite(game, decoration, at, now, landscape)
        piece := ifx object != 0 then object else ifx ShoveyAnimal(ground) && (!glides || board_gliding[at] < 0) then ground else 0
        layers[SHOVEY_CELLS * 3 + display] = ifx piece == 0 then -1 else KindSprite(game, piece, at, now, landscape)
    }
}

// A level's board drawn small for the level list, where the picture built
// with this release shows an older board or none: a level published or
// changed on the node since.
board_preview_game: ShoveyGame;
board_preview_layers: [SHOVEY_CELLS * 4]s32;

ShoveyBoardPreview :: (session: Session, level: s32, bounds: Rectangle, key: u64, names: []string, landscape: bool) {
    if !sprites_ready { SpritesPrepare() }
    if !ShoveyLoad(*board_preview_game, level) { return }
    BoardLayersFill(*board_preview_game, board_preview_layers[:], 0.0, landscape, false)
    files := ifx landscape then landscape_sprite_files[:] else sprite_files[:]
    grid := TileMap(session, TileMapProps.{.key = key, .bounds = bounds,
            .columns = cast(s32)(ifx landscape then SHOVEY_HEIGHT else SHOVEY_WIDTH),
            .rows = cast(s32)(ifx landscape then SHOVEY_WIDTH else SHOVEY_HEIGHT),
            .tiles = files, .names = names, .layers = board_preview_layers[:], .layer_count = 4,
            .fill = Color.{2, 4, 5, 255}, .label = "", .nearest_tiles = abyss_sprite_indices[:]})
    player := board_preview_game.player
    if player >= 0 && player < SHOVEY_CELLS {
        Image(session, ImageProps.{.key = WidgetPartKey(key, SHOVEY_CELLS * 4), .asset_path = files[PlayerSprite(*board_preview_game, landscape)],
                .alt_text = "Shovey", .bounds = TileMapCell(grid, BoardDisplayIndex(player, landscape)),
                .fit = ImageFit.ImageFitContain, .smooth = true})
    }
}

// Shovey, gliding animals, effects and guides over the board's tiles.
ShoveyBoardPieces :: (session: Session, game: *ShoveyGame, grid: TileMapResult, key: u64, now: float64, names: []string,
    landscape: bool) -> TileMapResult {
    glide_files := ifx landscape then landscape_sprite_files[:] else sprite_files[:]
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        index := board_gliding[at]
        if index < 0 { continue }
        glide := board_glides[index]
        from_cell := TileMapCell(grid, BoardDisplayIndex(glide.from, landscape))
        to_cell := TileMapCell(grid, BoardDisplayIndex(glide.to, landscape))
        progress := cast(float32)((now - glide.start) / BOARD_GLIDE_SECONDS)
        eased := progress * progress * (3.0 - 2.0 * progress)
        // Land animals give a small hop; fish just swim.
        hop: float32 = ifx ShoveyFish(game.ground[at]) then 0.0 else 4.0 * progress * (1.0 - progress) * to_cell.height * 0.08
        cell := Rectangle.{from_cell.x + (to_cell.x - from_cell.x) * eased, from_cell.y + (to_cell.y - from_cell.y) * eased - hop,
            to_cell.width, to_cell.height}
        sprite := KindSprite(game, game.ground[at], at, now, landscape)
        if sprite >= 0 {
            Image(session, ImageProps.{.key = key + cast(u64)(3 + SHOVEY_CELLS * 4 + index), .asset_path = glide_files[sprite],
                    .alt_text = ifx cast(s64)sprite < names.count then names[sprite] else "", .bounds = cell,
                    .fit = ImageFit.ImageFitContain, .smooth = true})
        }
    }
    if game.player >= 0 && game.player < SHOVEY_CELLS {
        files := ifx landscape then landscape_sprite_files[:] else sprite_files[:]
        portal := PortalTravelProgress(game, now)
        position := ifx portal >= 0.0 && portal < 0.5 then portal_entry else game.player
        cell := TileMapCell(grid, BoardDisplayIndex(position, landscape))
        fall := AbyssFallProgress(game, now)
        shock := ShockProgress(game, now)
        image := ImageProps.{.key = key + cast(u64)(1 + SHOVEY_CELLS * 4), .asset_path = files[PlayerSprite(game, landscape)],
            .alt_text = "Shovey", .bounds = cell, .fit = ImageFit.ImageFitContain, .smooth = true}
        // Fully collapsed quads have no area. Omit them instead of handing
        // the rasterizer a singular image transform at the end/midpoint.
        visible := fall < 0.97 && (portal < 0.49 || portal > 0.51)
        if visible {
            if fall >= 0.0 { image.mesh = AbyssFallMesh(cell, fall) }
            else if portal >= 0.0 { image.mesh = PortalTravelMesh(cell, portal) }
            if shock >= 0.0 { ShockShovey(*image, cell, shock, now) }
            Image(session, image)
        }
        if shock >= 0.0 { ShockEffects(session, key, cell, shock, now) }
    }
    BoardGuides(session, game, grid, key, now, landscape)
    files := ifx landscape then landscape_sprite_files[:] else sprite_files[:]
    shot_label := ifx cast(s64)SPRITE_SHOT < names.count then names[SPRITE_SHOT] else ""
    // Shovey holds a picked-up shot at his side, and dots show where a
    // throw would fly; targets on that line are ringed.
    if (game.powers & SHOVEY_AMMO) != 0 && !game.lost && !game.won && game.player >= 0 && game.player < SHOVEY_CELLS {
        cell := TileMapCell(grid, BoardDisplayIndex(game.player, landscape))
        size := cell.width
        ahead := ShoveyNeighbor(game.player, game.direction)
        dot: s32 = 0
        at := ahead
        while at >= 0 && !ShoveyShotStops(game, at) && dot < 24 {
            spot := TileMapCell(grid, BoardDisplayIndex(at, landscape))
            if game.objects[at] == 28 {
                unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 300 + dot), .bounds = Rectangle.{spot.x + size * 0.04, spot.y + size * 0.04,
                        size * 0.92, size * 0.92}, .border = Color.{236, 64, 48, 230}, .radius = size * 0.46})
            } else {
                unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 300 + dot), .bounds = Rectangle.{spot.x + size * 0.43, spot.y + size * 0.43,
                        size * 0.14, size * 0.14}, .fill = Color.{255, 226, 150, 190}, .radius = size * 0.07})
            }
            dot += 1
            at = ShoveyNeighbor(at, game.direction)
        }
        // He holds the shot against his body beside his left eye, pointing
        // the way he looks, so it turns with him. The sprite points right.
        facing := (PlayerSprite(game, landscape) - SPRITE_PLAYER) % 4
        visible := ifx landscape then (facing + 3) % 4 else facing
        forward_x: float32 = ifx visible == 0 then -1.0 else ifx visible == 2 then 1.0 else 0.0
        forward_y: float32 = ifx visible == 1 then -1.0 else ifx visible == 3 then 1.0 else 0.0
        held := size * 0.55
        cx := cell.x + size * (0.5 + forward_x * 0.24 + forward_y * 0.34)
        cy := cell.y + size * (0.5 + forward_y * 0.24 - forward_x * 0.34)
        // The drawn shot sits right of and below its frame's centre.
        cx -= held * (forward_x * 0.047 - forward_y * 0.078)
        cy -= held * (forward_y * 0.047 + forward_x * 0.078)
        frame := Rectangle.{cx - held / 2.0, cy - held / 2.0, held, held}
        center := Vector2.{cx, cy}
        Image(session, ImageProps.{.key = key + cast(u64)(2 + SHOVEY_CELLS * 4), .asset_path = files[SPRITE_SHOT],
                .alt_text = shot_label, .bounds = frame, .fit = ImageFit.ImageFitContain, .smooth = true,
                .mesh = ImageMeshQuad(frame, Camera.{.target = center, .offset = center, .zoom = 1.0,
                        .rotation = cast(float32)(((visible + 2) % 4) * 90)}, held_points[:])})
    }
    // A thrown shot flies along its line.
    if board_flight_from >= 0 {
        progress := cast(float32)((now - board_flight_start) / (BOARD_FLIGHT_STEP * cast(float64)(board_flight_cells + 1)))
        if progress >= 1.0 { board_flight_from = -1 }
        else {
            from := TileMapCell(grid, BoardDisplayIndex(board_flight_from, landscape))
            to := BoardAlong(grid, board_flight_from, board_flight_direction, board_flight_cells, landscape)
            size := from.width * 0.45
            x := from.x + (to.x - from.x) * progress + (from.width - size) / 2.0
            y := from.y + (to.y - from.y) * progress + (from.height - size) / 2.0
            Image(session, ImageProps.{.key = BoardOverlayKey(key, 299), .asset_path = files[SPRITE_SHOT], .alt_text = shot_label,
                    .bounds = Rectangle.{x, y, size, size}, .fit = ImageFit.ImageFitContain, .smooth = true})
        }
    }
    // Struck targets burst; blasts cover the wall and its neighbours.
    for index: cast(s32)0..BOARD_EFFECTS - 1 {
        effect := *board_effects[index]
        if effect.kind == 0 || now < effect.start { continue }
        if effect.kind == 4 {
            progress := cast(float32)((now - effect.start) / CHARGE_SECONDS)
            if progress >= 1.0 || game.lost { effect.kind = 0; continue }
            cell := TileMapCell(grid, BoardDisplayIndex(effect.at, landscape))
            ChargeEffects(session, BoardOverlayKey(key, 800 + index), cell, progress)
            continue
        }
        if effect.kind == 3 {
            // The ball shrinks down into the hole while a ripple of the
            // pit's colour spreads.
            progress := cast(float32)((now - effect.start) / 0.4)
            if progress >= 1.0 { effect.kind = 0; continue }
            cell := TileMapCell(grid, BoardDisplayIndex(effect.at, landscape))
            ripple := cell.width * (0.5 + 0.55 * progress)
            pit := ShoveyPitColor(game.ground[effect.at])
            colours: [7]Color = .[Color.{255, 255, 255, 255}, Color.{226, 64, 52, 255}, Color.{58, 110, 226, 255}, Color.{66, 180, 78, 255},
                Color.{64, 200, 214, 255}, Color.{168, 92, 214, 255}, Color.{240, 200, 50, 255}]
            tint := colours[ifx pit >= 0 && pit < 7 then pit else 0]
            tint.a = cast(u8)((1.0 - progress) * 210.0)
            unused Box(session, BoxProps.{.key = BoardOverlayKey(key, 450 + index), .bounds = Rectangle.{cell.x + (cell.width - ripple) / 2.0,
                    cell.y + (cell.height - ripple) / 2.0, ripple, ripple}, .border = tint, .radius = ripple / 2.0})
            size := cell.width * 0.85 * (1.0 - progress)
            sprite := KindSprite(game, effect.piece, -1, now, landscape)
            if sprite >= 0 && size > 1.0 {
                Image(session, ImageProps.{.key = BoardOverlayKey(key, 400 + index), .asset_path = files[sprite], .alt_text = "",
                        .bounds = Rectangle.{cell.x + (cell.width - size) / 2.0, cell.y + (cell.height - size) / 2.0 + progress * cell.height * 0.08, size, size},
                        .fit = ImageFit.ImageFitContain, .smooth = true})
            }
            continue
        }
        frame_time := ifx effect.kind == 1 then BOARD_BURST_FRAME else BOARD_BLAST_FRAME
        frames: s32 = ifx effect.kind == 1 then 6 else 8
        frame := cast(s32)((now - effect.start) / frame_time)
        if frame >= frames { effect.kind = 0; continue }
        cell := TileMapCell(grid, BoardDisplayIndex(effect.at, landscape))
        scale: float32 = ifx effect.kind == 1 then 1.4 else 2.4
        size := cell.width * scale
        Image(session, ImageProps.{.key = BoardOverlayKey(key, 400 + index), .asset_path = files[(ifx effect.kind == 1 then SPRITE_BURST else SPRITE_EXPLOSION) + frame],
                .alt_text = "", .bounds = Rectangle.{cell.x + (cell.width - size) / 2.0, cell.y + (cell.height - size) / 2.0, size, size},
                .fit = ImageFit.ImageFitContain, .smooth = false})
    }
    return grid
}
