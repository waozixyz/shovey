// Shovey Classic: a bounded 12 by 20 board, independent of graphics and storage.
#import "text_buffer"
#import, file "levels.zi";

SHOVEY_WIDTH :: 12
SHOVEY_HEIGHT :: 20
SHOVEY_CELLS :: 240
SHOVEY_TRAIL :: 1
SHOVEY_REVERSE :: 2
SHOVEY_CHARGED :: 4
SHOVEY_AMMO :: 8
SHOVEY_SLIDE :: 16

ShoveyGame :: struct {
    tiles: [SHOVEY_CELLS]s32
    decorations: [SHOVEY_CELLS]s32
    ground: [SHOVEY_CELLS]s32
    objects: [SHOVEY_CELLS]s32
    light_from: [SHOVEY_CELLS]s32
    level: s32
    player: s32
    direction: s32
    powers: s32
    keys: s32
    moves: s32
    teleports: s32
    won: bool
    lost: bool
}

// A campaign published after this release: the approved levels kept on the
// node, each proven by its own winning route (see live_campaign.zi). While
// one is loaded it replaces the release's built-in approved levels.
SHOVEY_LIVE_MAX :: 170
SHOVEY_LIVE_BOARD :: 1440
shovey_live_count: s32;
shovey_live_boards: [SHOVEY_LIVE_MAX * SHOVEY_LIVE_BOARD]u8;
shovey_live_lengths: [SHOVEY_LIVE_MAX]s32;

#if #defined(SHOVEY_RELEASE) {
    ShoveyLevelCount :: () -> s32 { return ifx shovey_live_count > 0 then shovey_live_count else SHOVEY_APPROVED_LEVEL_COUNT }
} else {
    ShoveyLevelCount :: () -> s32 { return SHOVEY_LEVEL_COUNT }
}

// The closing board after the campaign's last level, where play stops.
ShoveyFinaleLevel :: () -> s32 { return ifx shovey_live_count > 0 then shovey_live_count + 1 else SHOVEY_LEVEL_COUNT }

// The highest level number a saved game may name.
ShoveyLevelLimit :: () -> s32 {
    finale := ShoveyFinaleLevel()
    return ifx finale > SHOVEY_LEVEL_COUNT then finale else SHOVEY_LEVEL_COUNT
}

// A level's starting board, from the loaded live campaign when there is one.
ShoveyLevelBoard :: (level: s32) -> string {
    if shovey_live_count > 0 {
        if level >= 1 && level <= shovey_live_count {
            at := (level - 1) * SHOVEY_LIVE_BOARD
            return TextView(shovey_live_boards[at:at + shovey_live_lengths[level - 1]])
        }
        if level == shovey_live_count + 1 { return ShoveyLevelData(SHOVEY_LEVEL_COUNT) }
        return ""
    }
    return ShoveyLevelData(level)
}

// Directions are left, up, right, down. Never wrap an edge into another row.
ShoveyNeighbor :: (position: s32, direction: s32) -> s32 {
    if position < 0 || position >= SHOVEY_CELLS { return -1 }
    if direction == 0 && position % SHOVEY_WIDTH > 0 { return position - 1 }
    if direction == 1 && position >= SHOVEY_WIDTH { return position - SHOVEY_WIDTH }
    if direction == 2 && position % SHOVEY_WIDTH < SHOVEY_WIDTH - 1 { return position + 1 }
    if direction == 3 && position < SHOVEY_CELLS - SHOVEY_WIDTH { return position + SHOVEY_WIDTH }
    return -1
}

ShoveyBallColor :: (kind: s32) -> s32 {
    if kind >= 1 && kind <= 3 { return kind }
    if kind >= 44 && kind <= 46 { return kind - 40 }
    return -1
}

ShoveyPitColor :: (kind: s32) -> s32 {
    if kind >= 4 && kind <= 6 { return kind - 3 }
    if kind >= 47 && kind <= 49 { return kind - 43 }
    return -1
}

ShoveyPaintColor :: (kind: s32) -> s32 {
    if kind >= 15 && kind <= 17 { return kind - 14 }
    if kind >= 50 && kind <= 52 { return kind - 46 }
    return -1
}

ShoveyBallForColor :: (color: s32) -> s32 {
    if color >= 1 && color <= 3 { return color }
    if color >= 4 && color <= 6 { return color + 40 }
    return -1
}

ShoveyColorBlock :: (kind: s32) -> bool {
    return (kind >= 36 && kind <= 38) || (kind >= 53 && kind <= 55)
}

// A colour goal is done while its block shows the first colour of its set.
ShoveyColorRest :: (kind: s32) -> bool {
    return kind == 36 || kind == 53
}

// Decorations that change nothing about play, and the solid ones that act as
// walls. Cracked wall (62) is the one wall a bomb crate (72) can break.
ShoveyMaterialFloor :: (kind: s32) -> bool { return kind >= 99 && kind <= 103 }
ShoveyDecorFloor :: (kind: s32) -> bool { return (kind >= 57 && kind <= 61) || ShoveyMaterialFloor(kind) }
ShoveyBlockingDecoration :: (kind: s32) -> bool { return kind == SHOVEY_TREE || kind == SHOVEY_LANTERN || kind == SHOVEY_BOULDER || (kind >= SHOVEY_BUSH && kind <= SHOVEY_STUMP) }
ShoveySolidDecor :: (kind: s32) -> bool { return (kind >= 62 && kind <= 64) || kind == 76 || ShoveyBlockingDecoration(kind) || (kind >= 95 && kind <= 98) }
SHOVEY_CRACKED_WALL :: 62
SHOVEY_PIT :: 65
SHOVEY_ICE :: 70
SHOVEY_CRACKED_FLOOR :: 71
SHOVEY_BOMB :: 72
SHOVEY_DUCK :: 82
SHOVEY_CHICKEN :: SHOVEY_DUCK // Existing boards keep their stored kind.
SHOVEY_DOG :: SHOVEY_CHICKEN // Existing boards keep their stored kind.
SHOVEY_TURTLE :: 83
SHOVEY_TREE :: 84
SHOVEY_CRAB :: 88
SHOVEY_FISH :: 89
SHOVEY_GATE :: 92
SHOVEY_LEVER :: 93
SHOVEY_LEVER_ON :: 94
SHOVEY_DOOR :: 104
SHOVEY_DOOR_OPEN :: 105
SHOVEY_LANTERN :: 106
SHOVEY_BOULDER :: 122
SHOVEY_OPEN_GATE :: 123
SHOVEY_MOSS_WALL :: 127
SHOVEY_MOSS_BUTTON :: 131
SHOVEY_LAST_KIND :: 134
// Decorations on top of tiles: mushrooms, fallen leaves, bluebells and lily
// pads are walked over; a bush, flower pot, barrel and stump block.
SHOVEY_MUSHROOMS :: 135
SHOVEY_LILY_PADS :: 138
SHOVEY_BUSH :: 139
SHOVEY_STUMP :: 142
ShoveyMossColor :: (kind: s32) -> s32 {
    if kind == 14 { return 0 }
    if kind >= SHOVEY_MOSS_WALL && kind < SHOVEY_MOSS_BUTTON { return kind - SHOVEY_MOSS_WALL + 1 }
    return -1
}
ShoveyButtonColor :: (kind: s32) -> s32 {
    if kind == 13 { return 0 }
    if kind >= SHOVEY_MOSS_BUTTON && kind <= SHOVEY_LAST_KIND { return kind - SHOVEY_MOSS_BUTTON + 1 }
    return -1
}
ShoveyMossFloor :: (kind: s32) -> s32 { return ifx kind == 14 then 0 else 99 + kind - SHOVEY_MOSS_WALL }
ShoveyWallFloor :: (kind: s32) -> s32 {
    if ShoveyMossColor(kind) >= 0 { return ShoveyMossFloor(kind) }
    if kind >= 95 && kind <= 98 { return 99 + kind - 95 }
    if kind == 12 || kind == 62 || kind == 63 || kind == 76 { return 0 }
    return -1
}
ShoveyGateStartsOpen :: (kind: s32) -> bool { return kind >= SHOVEY_OPEN_GATE && kind <= SHOVEY_OPEN_GATE + 3 }
ShoveyGateColor :: (kind: s32) -> s32 {
    if kind == SHOVEY_GATE { return 0 }
    if ShoveyGateStartsOpen(kind) { return kind - SHOVEY_OPEN_GATE }
    if kind >= 107 && kind <= 113 && (kind - 107) % 3 == 0 { return 1 + (kind - 107) / 3 }
    return -1
}
ShoveyLeverColor :: (kind: s32) -> s32 {
    if kind == SHOVEY_LEVER || kind == SHOVEY_LEVER_ON { return 0 }
    if kind >= 108 && kind <= 115 && (kind - 108) % 3 < 2 { return 1 + (kind - 108) / 3 }
    return -1
}
ShoveyLever :: (kind: s32) -> bool { return ShoveyLeverColor(kind) >= 0 }
ShoveyLeverActive :: (kind: s32) -> bool { return kind == SHOVEY_LEVER_ON || (kind >= 108 && kind <= 115 && (kind - 108) % 3 == 1) }
ShoveyClosedDoor :: (kind: s32) -> bool { return kind == SHOVEY_DOOR || (kind >= 116 && kind <= 120 && kind % 2 == 0) }
ShoveyOpenDoor :: (kind: s32) -> bool { return kind == SHOVEY_DOOR_OPEN || (kind >= 117 && kind <= 121 && kind % 2 == 1) }
ShoveyFish :: (kind: s32) -> bool { return kind >= SHOVEY_FISH && kind <= 91 }
ShoveyAnimal :: (kind: s32) -> bool { return kind == SHOVEY_CHICKEN || kind == SHOVEY_TURTLE || kind == SHOVEY_CRAB || ShoveyFish(kind) }

// One-way arrows (66 left, 67 up, 68 right, 69 down): the direction, or -1.
ShoveyArrow :: (kind: s32) -> s32 {
    if kind >= 66 && kind <= 69 { return kind - 66 }
    return -1
}

// Portals of their own colour (cyan 73, purple 74, yellow 75) lead to the
// other portal of the same colour.
ShoveyColorPortal :: (kind: s32) -> bool { return (kind >= 73 && kind <= 75) || (kind >= 85 && kind <= 87) }

// The way the mover now entering a cell is going, so a one-way arrow can
// refuse the other three. -1 means any way: estimates that do not move.
shovey_enter: s32 = -1;

ShoveyMovable :: (kind: s32) -> bool {
    return ShoveyBallColor(kind) > 0 || kind == 9 || kind == 19 || kind == 28 ||
    ShoveyColorBlock(kind) || kind == 40 || kind == SHOVEY_BOMB
}

ShoveyHasIce :: (game: *ShoveyGame) -> bool {
    for at: cast(s32)0..SHOVEY_CELLS - 1 { if game.ground[at] == SHOVEY_ICE { return true } }
    return false
}

ShoveyDigit :: (byte: u8) -> s32 {
    if byte >= #char "0" && byte <= #char "9" { return cast(s32)(byte - #char "0") }
    if byte >= #char "a" && byte <= #char "f" { return cast(s32)(byte - #char "a") + 10 }
    return -1
}

ShoveyByte :: (text: string, at: s32) -> s32 {
    if at < 0 || at + 1 >= text.count { return -1 }
    high := ShoveyDigit(text[at]); low := ShoveyDigit(text[at + 1])
    if high < 0 || low < 0 { return -1 }
    return high * 16 + low
}

ShoveyLoad :: (game: *ShoveyGame, level: s32) -> bool {
    return ShoveyLoadData(game, level, ShoveyLevelBoard(level))
}

// Existing boards contain 480 hex digits of pieces. Layered boards append
// 480 digits of independent floor tiles. Tiles never change puzzle rules.
ShoveyTerrain :: (kind: s32) -> bool {
    return kind == 0 || kind == 12 || ShoveyMossColor(kind) >= 0 || ShoveyPitColor(kind) > 0 ||
        kind == 60 || kind == 61 || (kind >= 63 && kind <= 65) || kind == 70 || kind == 76 || kind == 77 || kind == 78 || (kind >= 95 && kind <= 103)
}

ShoveyTile :: (kind: s32) -> bool { return ShoveyTerrain(kind) || (kind >= 57 && kind <= 59) || (kind >= 66 && kind <= 69) || kind == 62 || kind == 71 }
ShoveyDecoration :: (kind: s32) -> bool { return kind == 0 || (kind >= 57 && kind <= 59) || (kind >= SHOVEY_MUSHROOMS && kind <= SHOVEY_LILY_PADS) || ShoveyBlockingDecoration(kind) }
ShoveyCosmeticTile :: (kind: s32) -> bool { return kind == 0 || (kind >= 57 && kind <= 61) || kind == 77 || kind == 78 || ShoveyMaterialFloor(kind) }
ShoveyDefaultTile :: (kind: s32) -> s32 {
    return ifx kind == 62 then 12 else ifx ShoveyFish(kind) then 64 else ifx ShoveyTerrain(kind) then kind else ifx kind == 7 then 77 else 0
}

ShoveyLoadData :: (game: *ShoveyGame, level: s32, data: string) -> bool {
    if data.count != SHOVEY_CELLS * 2 && data.count != SHOVEY_CELLS * 4 && data.count != SHOVEY_CELLS * 6 { return false }
    game.* = ShoveyGame.{.level = level, .player = -1, .direction = 1}
    for position: cast(s32)0..SHOVEY_CELLS - 1 {
        kind := ShoveyByte(data, position * 2)
        tile := ifx data.count >= SHOVEY_CELLS * 4 then ShoveyByte(data, SHOVEY_CELLS * 2 + position * 2) else ShoveyDefaultTile(kind)
        if kind < 0 || kind > SHOVEY_LAST_KIND || !ShoveyTile(tile) { return false }
        if ShoveyFish(kind) && tile != 64 { return false }
        game.tiles[position] = ifx tile == 62 then 12 else ifx tile == 71 then 0 else tile
        if !ShoveyCosmeticTile(tile) { game.ground[position] = tile }
        if data.count == SHOVEY_CELLS * 6 {
            decoration := ShoveyByte(data, SHOVEY_CELLS * 4 + position * 2)
            if decoration >= 79 && decoration <= 81 { decoration = 0 }
            if !ShoveyDecoration(decoration) { return false }
            game.decorations[position] = decoration
        }
        game.light_from[position] = 4
        if kind == 10 { game.player = position }
        else if ShoveyMovable(kind) { game.objects[position] = kind }
        else if kind == SHOVEY_CRACKED_FLOOR && (game.tiles[position] == 12 || ShoveySolidDecor(game.tiles[position])) {
            game.ground[position] = SHOVEY_CRACKED_WALL
        }
        else if kind != 0 { game.ground[position] = kind }
        if ShoveyBlockingDecoration(game.decorations[position]) {
            if kind != 0 { return false }
            game.ground[position] = game.decorations[position]
        }
    }
    return game.player >= 0
}

ShoveyDoorOpen :: (game: *ShoveyGame, position: s32) -> bool {
    if game.objects[position] != 0 { return true }
    color := ShoveyMossColor(game.ground[position])
    if color < 0 { return false }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if ShoveyButtonColor(game.ground[at]) == color && game.objects[at] != 0 { return true }
    }
    return false
}

ShoveyLeversActive :: (game: *ShoveyGame, color: s32) -> bool {
    for kind: game.ground {
        if ShoveyLeverColor(kind) == color && ShoveyLeverActive(kind) { return true }
    }
    return false
}

ShoveyToggleLevers :: (game: *ShoveyGame, color: s32) {
    active := !ShoveyLeversActive(game, color)
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        kind := game.ground[at]
        if ShoveyLeverColor(kind) == color && ShoveyLeverActive(kind) != active {
            game.ground[at] = ifx active then kind + 1 else kind - 1
        }
    }
}

ShoveyGateOpen :: (game: *ShoveyGame, position: s32) -> bool {
    if game.objects[position] != 0 || game.player == position { return true }
    color := ShoveyGateColor(game.ground[position])
    if color < 0 { return false }
    starts_open := ShoveyGateStartsOpen(game.ground[position])
    if ShoveyLeversActive(game, color) { return !starts_open }
    return starts_open
}

ShoveyRemaining :: (game: *ShoveyGame) -> s32 {
    remaining: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        object := game.objects[at]; ground := game.ground[at]
        if ShoveyBallColor(object) > 0 || object == 19 || object == 28 || object == 40 || ground == 21 || ground == 56 ||
        (ground == 18 && object != 9) || (ground == 39 && !ShoveyColorRest(object)) || ground == 29 || ground == 30 {
            remaining += 1
        }
    }
    return remaining
}

ShoveyFloorAllows :: (game: *ShoveyGame, position: s32, object: s32) -> bool {
    if position < 0 || position >= SHOVEY_CELLS { return false }
    kind := game.ground[position]
    if ShoveyAnimal(kind) { return false }
    player := object == 10
    if ShoveyClosedDoor(kind) { return player }
    if ShoveyOpenDoor(kind) { return true }
    if kind == 0 || ShoveyButtonColor(kind) >= 0 || kind == 18 || kind == 20 ||
    kind == 29 || kind == 30 || kind == 31 || kind == 41 || kind == 42 || kind == 43 { return true }
    if ShoveyMossColor(kind) >= 0 { return ShoveyDoorOpen(game, position) }
    if ShoveyGateColor(kind) >= 0 { return ShoveyGateOpen(game, position) }
    if ShoveyDecorFloor(kind) || kind == SHOVEY_ICE || kind == SHOVEY_CRACKED_FLOOR { return true }
    if kind == SHOVEY_PIT { return player }
    arrow := ShoveyArrow(kind)
    if arrow >= 0 { return shovey_enter < 0 || shovey_enter == arrow }
    if ShoveyColorPortal(kind) { return player }
    pit := ShoveyPitColor(kind)
    if pit > 0 { return player || ShoveyBallColor(object) == pit }
    if ShoveyPaintColor(kind) > 0 { return player || ShoveyBallColor(object) > 0 }
    if kind == 39 { return player || ShoveyColorBlock(object) }
    if kind == 26 { return player && (game.powers & SHOVEY_AMMO) == 0 }
    if kind == 7 || kind == 8 || kind == 11 || kind == 21 || kind == 56 || kind == 25 ||
    kind == 27 || kind == 33 || kind == 35 { return player }
    return false
}

ShoveyCanEnter :: (game: *ShoveyGame, position: s32, object: s32) -> bool {
    return position >= 0 && position < SHOVEY_CELLS && game.objects[position] == 0 &&
    ShoveyFloorAllows(game, position, object)
}

ShoveyPush :: (game: *ShoveyGame, from: s32, direction: s32) -> bool {
    object := game.objects[from]
    to := ShoveyNeighbor(from, direction)
    if !ShoveyMovable(object) || object == 40 || to == game.player { return false }
    // A bomb crate pushed into a cracked wall breaks it and is used up.
    if object == SHOVEY_BOMB && to >= 0 && game.ground[to] == SHOVEY_CRACKED_WALL && game.objects[to] == 0 {
        game.objects[from] = 0
        game.ground[to] = 0
        game.tiles[to] = 0
        return true
    }
    shovey_enter = direction
    allowed := ShoveyCanEnter(game, to, object)
    shovey_enter = -1
    if !allowed { return false }
    ground := game.ground[to]
    game.objects[from] = 0
    if ground == 42 { game.ground[to] = 23 }
    if ShoveyPitColor(ground) == ShoveyBallColor(object) && ShoveyBallColor(object) > 0 { return true }
    paint := ShoveyPaintColor(ground)
    if paint > 0 && ShoveyBallColor(object) > 0 {
        object = ShoveyBallForColor(paint)
        game.ground[to] = 0
    }
    if ShoveyColorBlock(object) {
        last: s32 = ifx object <= 38 then 38 else 55
        first: s32 = last - 2
        object = ifx object == last then first else object + 1
    }
    game.objects[to] = object
    if object == 19 {
        touching := false
        for side: cast(s32)0..3 {
            neighbor := ShoveyNeighbor(to, side)
            if neighbor >= 0 && game.objects[neighbor] == 19 {
                touching = true
                game.objects[neighbor] = 0
            }
        }
        if touching { game.objects[to] = 0 }
    }
    return true
}

// The shadow mirrors every accepted move, then the game tests whether both
// actors meet. Walls and failed pushes do not move the shadow, and neither
// does home: the shadow only crosses plain floor.
ShoveyShadowAdvance :: (game: *ShoveyGame, direction: s32) {
    shadow: s32 = -1
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.objects[at] == 40 { shadow = at; break }
    }
    if shadow < 0 { return }
    to := ShoveyNeighbor(shadow, (direction + 2) % 4)
    if to >= 0 && game.objects[to] == 0 && game.ground[to] == 0 {
        game.objects[shadow] = 0
        shadow = to
        game.objects[shadow] = 40
    }
    if shadow == game.player { game.objects[shadow] = 0 }
}

ShoveySensor :: (game: *ShoveyGame, position: s32) {
    another := false
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if at != position && game.ground[at] == 41 { another = true }
    }
    if !another { game.ground[position] = 41; return }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if at == position || game.ground[at] == 41 {
            game.ground[at] = ifx game.objects[at] == 0 then 23 else 42
        }
    }
}

ShoveyStep :: (game: *ShoveyGame, direction: s32) -> bool {
    to := ShoveyNeighbor(game.player, direction)
    if to < 0 { return false }
    if ShoveyLever(game.ground[to]) {
        ShoveyToggleLevers(game, ShoveyLeverColor(game.ground[to]))
        game.moves += 1
        return true
    }
    if game.ground[to] == 34 && game.keys > 0 {
        game.keys -= 1
        game.ground[to] = 0
        return true
    }
    // Decide floor entry before moving an object: pushing the crate off a
    // door must allow Shovey to follow it through that previously open door.
    // Conversely, a solid floor must never move an object as a side effect.
    shovey_enter = direction
    entered := ShoveyFloorAllows(game, to, 10)
    shovey_enter = -1
    if !entered { return false }
    from := game.player
    if game.objects[to] != 0 && game.objects[to] != 40 && !ShoveyPush(game, to, direction) { return false }
    kind := game.ground[to]
    if ShoveyClosedDoor(kind) { game.ground[to] = kind + 1 }
    game.player = to
    ShoveyShadowAdvance(game, direction)
    if kind == 8 || ShoveyColorPortal(kind) {
        // Teleporting scans columns first and takes the first other free portal
        // of the same kind.
        destination: s32 = -1
        for x: cast(s32)0..SHOVEY_WIDTH - 1 {
            for y: cast(s32)0..SHOVEY_HEIGHT - 1 {
                at := y * SHOVEY_WIDTH + x
                if at != to && game.ground[at] == kind && game.objects[at] == 0 {
                    destination = at
                    break
                }
            }
            if destination >= 0 { break }
        }
        if destination >= 0 {
            to = destination
            game.player = to
            ShoveyShadowAdvance(game, direction)
            game.teleports += 1
        }
    }
    game.player = to
    game.moves += 1
    // Cracked floor gives way once Shovey has stepped off it.
    if from != to && game.ground[from] == SHOVEY_CRACKED_FLOOR { game.ground[from] = SHOVEY_PIT }
    if kind == SHOVEY_PIT { game.lost = true }
    if kind == 11 { game.powers = game.powers | SHOVEY_TRAIL }
    if kind == 25 { game.powers = game.powers | SHOVEY_REVERSE; game.ground[to] = 0 }
    if kind == 26 { game.powers = game.powers | SHOVEY_AMMO; game.ground[to] = 0 }
    if kind == 35 { game.powers = game.powers | SHOVEY_SLIDE; game.ground[to] = 0 }
    if kind == 21 || kind == 56 { game.ground[to] = 0 }
    if kind == 33 { game.keys += 1; game.ground[to] = 0 }
    if kind == 27 {
        if (game.powers & SHOVEY_CHARGED) != 0 { game.lost = true }
        else { game.powers = game.powers | SHOVEY_CHARGED }
    }
    if kind == 20 || kind == 41 { ShoveySensor(game, to) }
    if kind == 42 { game.ground[to] = 23 }
    if game.ground[to] == 0 && (game.powers & SHOVEY_TRAIL) != 0 { game.ground[to] = 11 }
    if kind == 7 && ShoveyRemaining(game) == 0 { game.won = true }
    return true
}

ShoveyMove :: (game: *ShoveyGame, direction: s32) -> bool {
    if direction < 0 || direction > 3 || game.won || game.lost || game.level == ShoveyFinaleLevel() { return false }
    if (game.powers & SHOVEY_REVERSE) != 0 { direction = (direction + 2) % 4 }
    game.direction = direction
    slide := (game.powers & SHOVEY_SLIDE) != 0
    // Shovey stops sliding the moment he pushes something: a crate or ball
    // pushed on the ice moves one cell, then Shovey stands still.
    ahead := ShoveyNeighbor(game.player, direction)
    pushing := ahead >= 0 && ((game.objects[ahead] != 0 && game.objects[ahead] != 40) || ShoveyLever(game.ground[ahead]))
    changed := ShoveyStep(game, direction)
    if changed && !pushing {
        visited: [SHOVEY_CELLS]bool
        // The slide power keeps him going; so does standing on ice.
        while !game.won && !game.lost && !visited[game.player] {
            if !slide && game.ground[game.player] != SHOVEY_ICE { break }
            visited[game.player] = true
            next := ShoveyNeighbor(game.player, direction)
            stop := next >= 0 && ((game.objects[next] != 0 && game.objects[next] != 40) || ShoveyLever(game.ground[next]))
            if !ShoveyStep(game, direction) || stop { break }
        }
    }
    return changed
}

// The boards a move passes through, for drawing a slide one cell at a time:
// the same rules as ShoveyMove, recording the game after every step. Returns
// how many boards were written; the last is the board ShoveyMove leaves.
ShoveyMoveFrames :: (start: *ShoveyGame, direction: s32, frames: []ShoveyGame) -> s32 {
    if frames.count < 2 { return 0 }
    game := start.*
    if direction < 0 || direction > 3 || game.won || game.lost || game.level == ShoveyFinaleLevel() { return 0 }
    if (game.powers & SHOVEY_REVERSE) != 0 { direction = (direction + 2) % 4 }
    game.direction = direction
    slide := (game.powers & SHOVEY_SLIDE) != 0
    ahead := ShoveyNeighbor(game.player, direction)
    pushing := ahead >= 0 && ((game.objects[ahead] != 0 && game.objects[ahead] != 40) || ShoveyLever(game.ground[ahead]))
    count: s32 = 0
    if !ShoveyStep(*game, direction) { return 0 }
    frames[count] = game
    count += 1
    if !pushing {
        visited: [SHOVEY_CELLS]bool
        while !game.won && !game.lost && !visited[game.player] {
            if !slide && game.ground[game.player] != SHOVEY_ICE { break }
            visited[game.player] = true
            next := ShoveyNeighbor(game.player, direction)
            stop := next >= 0 && ((game.objects[next] != 0 && game.objects[next] != 40) || ShoveyLever(game.ground[next]))
            if !ShoveyStep(*game, direction) { break }
            if count < frames.count { count += 1 }
            frames[count - 1] = game
            if stop { break }
        }
    }
    return count
}

ShoveyFire :: (game: *ShoveyGame) -> bool {
    if game.won || game.lost || game.level == ShoveyFinaleLevel() || (game.powers & SHOVEY_AMMO) == 0 { return false }
    game.powers = game.powers & ~SHOVEY_AMMO
    at := ShoveyNeighbor(game.player, game.direction)
    while at >= 0 {
        ground := game.ground[at]
        object := game.objects[at]
        // A shot pierces targets but stops at solid objects,
        // walls, doors and pickups. In particular a star survives the shot.
        if object == 28 { game.objects[at] = 0 }
        else if ShoveyBallColor(object) > 0 || object == 9 || object == 19 ||
        ShoveyColorBlock(object) || object == SHOVEY_BOMB || ground == 12 || ShoveySolidDecor(ground) || ShoveyMossColor(ground) >= 0 ||
        ground == 26 || ground == 33 || ground == 34 || ShoveyGateColor(ground) >= 0 || ShoveyClosedDoor(ground) || ShoveyLever(ground) { break }
        at = ShoveyNeighbor(at, game.direction)
    }
    game.moves += 1
    return true
}

// What one move or shot did that is worth hearing. The engine reports no
// events, so the view keeps the board from before and compares.
SHOVEY_EVENT_NONE :: 0
SHOVEY_EVENT_PUSH :: 1
SHOVEY_EVENT_PIT :: 2
SHOVEY_EVENT_GOAL :: 3
SHOVEY_EVENT_PICKUP :: 4
SHOVEY_EVENT_DOOR :: 5
SHOVEY_EVENT_TELEPORT :: 6
SHOVEY_EVENT_SHOT :: 7
SHOVEY_EVENT_WON :: 8
SHOVEY_EVENT_LOST :: 9

ShoveyTally :: struct {
    balls: s32
    apples: s32
    closed: s32
}

ShoveyCount :: (game: *ShoveyGame) -> ShoveyTally {
    tally: ShoveyTally
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        object := game.objects[at]; ground := game.ground[at]
        if ShoveyBallColor(object) > 0 { tally.balls += 1 }
        if ground == 21 || ground == 56 { tally.apples += 1 }
        if ground == 34 || ShoveyClosedDoor(ground) || (ShoveyMossColor(ground) >= 0 && !ShoveyDoorOpen(game, at)) || (ShoveyGateColor(ground) >= 0 && !ShoveyGateOpen(game, at)) { tally.closed += 1 }
    }
    return tally
}

// The most meaningful event first; a plain step is quiet.
ShoveyEvent :: (before: *ShoveyGame, after: *ShoveyGame) -> s32 {
    if after.won && !before.won { return SHOVEY_EVENT_WON }
    if after.lost && !before.lost { return SHOVEY_EVENT_LOST }
    was := ShoveyCount(before); now := ShoveyCount(after)
    if now.balls < was.balls { return SHOVEY_EVENT_PIT }
    // A crate or colour block on its goal, stars that meet, a target or
    // the shadow cleared. An eaten apple is a pickup, not a goal.
    if ShoveyRemaining(after) + was.apples - now.apples < ShoveyRemaining(before) { return SHOVEY_EVENT_GOAL }
    if now.closed < was.closed { return SHOVEY_EVENT_DOOR }
    if after.teleports > before.teleports { return SHOVEY_EVENT_TELEPORT }
    if now.apples < was.apples || after.keys > before.keys || (after.powers & ~before.powers) != 0 { return SHOVEY_EVENT_PICKUP }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        // The shadow moves by itself with every step.
        if before.objects[at] != after.objects[at] && before.objects[at] != 40 && after.objects[at] != 40 { return SHOVEY_EVENT_PUSH }
    }
    if (before.powers & SHOVEY_AMMO) != 0 && (after.powers & SHOVEY_AMMO) == 0 { return SHOVEY_EVENT_SHOT }
    return SHOVEY_EVENT_NONE
}

// Animals wander on clear floor and block both Shovey and pushed pieces.
// Trees, hazards, objects and the player are never valid destinations.
ShoveyAnimalMix :: (value: u32) -> u32 {
    mixed := (value ^ (value >> 16)) * cast(u32)0x7feb352d
    mixed = (mixed ^ (mixed >> 15)) * cast(u32)0x846ca68b
    return mixed ^ (mixed >> 16)
}

ShoveyAnimalsTick :: (game: *ShoveyGame) -> bool {
    if game.won || game.lost { return false }
    // Use the animal state already kept by saves, undo and solver searches.
    // Each animal gets its own choice, including its very first step.
    seed: u32 = 0x9e3779b9
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if ShoveyAnimal(game.ground[at]) {
            seed = ShoveyAnimalMix(seed ^ cast(u32)(at * 137 + game.ground[at] * 17 + game.light_from[at]))
        }
    }
    visited: [SHOVEY_CELLS]bool
    for at: cast(s32)0..SHOVEY_CELLS - 1 { visited[at] = false }
    moved := false
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        kind := game.ground[at]
        if visited[at] || !ShoveyAnimal(kind) { continue }
        aquatic := ShoveyFish(kind)
        direction := game.light_from[at]
        choices: [4]s32
        count: s32 = 0
        reverse: s32 = -1
        for facing: cast(s32)0..3 {
            to := ShoveyNeighbor(at, facing)
            if to < 0 || to == game.player || game.objects[to] != 0 || visited[to] { continue }
            if aquatic {
                if game.ground[to] != 64 || game.tiles[to] != 64 { continue }
            } else if game.ground[to] != 0 { continue }
            // Turn freely, and retrace a step only when it is the sole exit.
            if direction >= 0 && direction <= 3 && facing == (direction + 2) % 4 { reverse = facing; continue }
            choices[count] = facing
            count += 1
        }
        if count == 0 && reverse >= 0 { choices[0] = reverse; count = 1 }
        if count == 0 { continue }
        choice := ShoveyAnimalMix(seed ^ cast(u32)((at + 1) * 131 + kind * 7)) % cast(u32)count
        facing := choices[cast(s32)choice]
        to := ShoveyNeighbor(at, facing)
        game.ground[at] = ifx aquatic then 64 else 0
        game.light_from[at] = 4
        game.ground[to] = kind
        game.light_from[to] = facing
        visited[to] = true
        moved = true
    }
    return moved
}

ShoveyTick :: (game: *ShoveyGame) -> bool {
    if game.won || game.lost || game.level == ShoveyFinaleLevel() { return false }
    moved := ShoveyBlocksTick(game)
    return ShoveyAnimalsTick(game) || moved
}

// Moving blocks advance one cell along their paths.
ShoveyBlocksTick :: (game: *ShoveyGame) -> bool {
    if game.won || game.lost || game.level == ShoveyFinaleLevel() { return false }
    occupied: [SHOVEY_CELLS]bool
    reserved: [SHOVEY_CELLS]bool
    for at: cast(s32)0..SHOVEY_CELLS - 1 { occupied[at] = false; reserved[at] = false }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.ground[at] == 29 { occupied[at] = true }
    }
    moved := false
    for block: cast(s32)0..SHOVEY_CELLS - 1 {
        if !occupied[block] { continue }
        direction := game.light_from[block]
        if direction == 4 { direction = 2 }
        to := ShoveyNeighbor(block, direction)
        if to < 0 || occupied[to] || reserved[to] || game.objects[to] != 0 ||
        (game.ground[to] != 30 && game.ground[to] != 31) { to = -1 }
        if to < 0 {
            order: [4]s32 = .[3, 1, 2, 0]
            if direction == 1 || direction == 3 {
                order[0] = 2; order[1] = 0; order[2] = 3; order[3] = 1
            }
            for terrain: cast(s32)30..31 {
                for next: order {
                    neighbor := ShoveyNeighbor(block, next)
                    if neighbor >= 0 && !occupied[neighbor] && !reserved[neighbor] &&
                    game.objects[neighbor] == 0 && game.ground[neighbor] == terrain {
                        game.light_from[block] = next
                        break
                    }
                }
                if game.light_from[block] != 4 && game.light_from[block] != direction { break }
            }
            if game.light_from[block] == direction { game.ground[block] = 31 }
            moved = true
            continue
        }
        game.ground[block] = 31
        game.ground[to] = 29
        game.light_from[block] = 4
        game.light_from[to] = direction
        reserved[to] = true
        moved = true
    }
    return moved
}

// One animal takes its own step, by the rules of ShoveyAnimalsTick: it turns
// freely and turns back only when that is its sole way out. `roll` picks
// among its ways. Returns the cell it moved to, or -1 when it stays.
ShoveyAnimalStep :: (game: *ShoveyGame, at: s32, roll: u32) -> s32 {
    if game.won || game.lost || at < 0 || at >= SHOVEY_CELLS { return -1 }
    kind := game.ground[at]
    if !ShoveyAnimal(kind) { return -1 }
    aquatic := ShoveyFish(kind)
    direction := game.light_from[at]
    choices: [4]s32
    count: s32 = 0
    reverse: s32 = -1
    for facing: cast(s32)0..3 {
        to := ShoveyNeighbor(at, facing)
        if to < 0 || to == game.player || game.objects[to] != 0 { continue }
        if aquatic {
            if game.ground[to] != 64 || game.tiles[to] != 64 { continue }
        } else if game.ground[to] != 0 { continue }
        if direction >= 0 && direction <= 3 && facing == (direction + 2) % 4 { reverse = facing; continue }
        choices[count] = facing
        count += 1
    }
    if count == 0 && reverse >= 0 { choices[0] = reverse; count = 1 }
    if count == 0 { return -1 }
    facing := choices[cast(s32)(roll % cast(u32)count)]
    to := ShoveyNeighbor(at, facing)
    game.ground[at] = ifx aquatic then 64 else 0
    game.light_from[at] = 4
    game.ground[to] = kind
    game.light_from[to] = facing
    return to
}

save_bytes: [2432]u8;

ShoveyHexWrite :: (value: s32, at: s32, digits: s32) {
    alphabet := "0123456789abcdef"
    for index: cast(s32)0..digits - 1 {
        shift := (digits - index - 1) * 4
        save_bytes[at + index] = alphabet[(value >> shift) & 15]
    }
}

// A borrowed, fixed-size save buffer. The host copies the record during
// SaveAppRecordHost; no frame or move accumulates allocated save strings.
ShoveySave :: (game: *ShoveyGame) -> string {
    save_bytes[0] = #char "P"; save_bytes[1] = #char "1"
    ShoveyHexWrite(game.level, 2, 2)
    ShoveyHexWrite(game.player, 4, 2)
    ShoveyHexWrite(game.direction, 6, 2)
    ShoveyHexWrite(game.powers, 8, 2)
    ShoveyHexWrite(game.keys, 10, 2)
    ShoveyHexWrite(game.moves, 12, 8)
    ShoveyHexWrite(game.teleports, 20, 8)
    ShoveyHexWrite(ifx game.won then 1 else 0, 28, 2)
    ShoveyHexWrite(ifx game.lost then 1 else 0, 30, 2)
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ShoveyHexWrite(game.ground[at], 32 + at * 6, 2)
        ShoveyHexWrite(game.objects[at], 34 + at * 6, 2)
        ShoveyHexWrite(game.light_from[at], 36 + at * 6, 2)
    }
    // Keep the old save layout when the level itself supplies every tile.
    source: ShoveyGame
    same := ShoveyLoad(*source, game.level)
    for at: cast(s32)0..SHOVEY_CELLS - 1 { if game.tiles[at] != source.tiles[at] || game.decorations[at] != source.decorations[at] { same = false } }
    if same { return TextView(save_bytes[:1472]) }
    save_bytes[1] = #char "2"
    for at: cast(s32)0..SHOVEY_CELLS - 1 { ShoveyHexWrite(game.tiles[at], 1472 + at * 2, 2) }
    decorated := false
    for at: cast(s32)0..SHOVEY_CELLS - 1 { if game.decorations[at] != 0 { decorated = true } }
    if !decorated { return TextView(save_bytes[:1952]) }
    save_bytes[1] = #char "3"
    for at: cast(s32)0..SHOVEY_CELLS - 1 { ShoveyHexWrite(game.decorations[at], 1952 + at * 2, 2) }
    return TextView(save_bytes[:2432])
}

ShoveyRestore :: (game: *ShoveyGame, text: string) -> bool {
    decorated := text.count == 2432 && text[:2] == "P3"
    layered := decorated || (text.count == 1952 && text[:2] == "P2")
    if !layered && (text.count != 1472 || text[:2] != "P1") { return false }
    restored: ShoveyGame
    restored.level = ShoveyByte(text, 2)
    source: ShoveyGame
    unused ShoveyLoad(*source, restored.level)
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        tile := ifx layered then ShoveyByte(text, 1472 + at * 2) else source.tiles[at]
        if !ShoveyTile(tile) { return false }
        restored.tiles[at] = tile
        decoration := ifx decorated then ShoveyByte(text, 1952 + at * 2) else source.decorations[at]
        if decoration >= 79 && decoration <= 81 { decoration = 0 }
        if !ShoveyDecoration(decoration) { return false }
        restored.decorations[at] = decoration
    }
    restored.player = ShoveyByte(text, 4)
    restored.direction = ShoveyByte(text, 6)
    restored.powers = ShoveyByte(text, 8)
    restored.keys = ShoveyByte(text, 10)
    if restored.level < 1 || restored.level > ShoveyLevelLimit() || restored.player < 0 || restored.player >= SHOVEY_CELLS ||
    restored.direction < 0 || restored.direction > 3 || restored.powers < 0 || restored.powers > 31 || restored.keys < 0 { return false }
    for index: cast(s32)0..7 {
        digit := ShoveyDigit(text[12 + index])
        if digit < 0 || (index == 0 && digit >= 8) { return false }
        restored.moves = restored.moves * 16 + digit
        digit = ShoveyDigit(text[20 + index])
        if digit < 0 || (index == 0 && digit >= 8) { return false }
        restored.teleports = restored.teleports * 16 + digit
    }
    won := ShoveyByte(text, 28); lost := ShoveyByte(text, 30)
    if won < 0 || won > 1 || lost < 0 || lost > 1 { return false }
    restored.won = won == 1; restored.lost = lost == 1
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ground := ShoveyByte(text, 32 + at * 6)
        object := ShoveyByte(text, 34 + at * 6)
        source := ShoveyByte(text, 36 + at * 6)
        if ground < 0 || (ground > SHOVEY_LAST_KIND && !ShoveyBlockingDecoration(ground)) || object < 0 || (object != 0 && !ShoveyMovable(object)) || source < 0 || source > 4 { return false }
        if ShoveyMovable(ground) || ground == 10 || ground == 22 || ground == 24 || ground == 32 { return false }
        restored.ground[at] = ground; restored.objects[at] = object; restored.light_from[at] = source
    }
    if restored.objects[restored.player] != 0 || restored.ground[restored.player] == 12 ||
    restored.ground[restored.player] == 34 { return false }
    game.* = restored
    return true
}
