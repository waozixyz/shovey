// Android and Windows: Kryon's canonical host (kryon/android_run, or
// src/player_windows.zi) draws this Frame. Shovey's collection comes from the
// APK's assets or the files beside the program; saves and game resources live
// in the app's private files folder.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/tree_input"
#import "kryon/app_asset"
#import "kryon/ScrollDevice"
#if #defined(ANDROID_BUILD) {
    AndroidDevice :: #import "kryon/android_device";
} else {
    #import "kryon/raylib_runtime"
}
#import "std/timer_linux"
#import "std/date_time_linux"
#import "player_host"
#import "player_entity"
#import "player_platform"
#if #defined(ANDROID_BUILD) {
    #import "kryon/notification"
    #import, file "chest_reminder.zi";
    #import, file "chest_reminder_policy.zi";
    DailyReminder :: #import, file "daily_chest.zi";
    chest_reminder_session: ChestReminderSession;
    chest_reminder_permission_checked: bool;
}

// Android's Back key as raylib reports it.
PLAYER_BACK_KEY :: 4

// 0 until the first frame opens the collection, then 1, or 2 when it failed.
player_state: s32;

PlayerStart :: () -> bool {
    // Raylib loads later animation pictures asynchronously. Android's pixmap
    // host paints with its embedded outline font and decodes assets inline.
    #if !#defined(ANDROID_BUILD) {
        RaylibCompletePictureFrames(true)
    }
    data := DataDirectory()
    bundle := ReadAppAsset("shovey.zx")
    metadata := ReadAppAsset("shovey.json")
    defer { FreeAppAsset(bundle); FreeAppAsset(metadata) }
    if data == "" || bundle.count == 0 || metadata.count == 0 {
        Report("Shovey: the collection is missing from the app")
        return false
    }
    // Shovey opens on its covers.
    if !CollectionOpenShoveyBytes(bundle, metadata, data) {
        Report("Shovey: could not open the collection")
        return false
    }
    entity := ReadAppAsset("entity.zx")
    defer { FreeAppAsset(entity) }
    return entity.count > 0 && EntityOpen(entity, data)
}

#program_export
Frame :: (session: Session, viewport: Rectangle) -> s32 {
    if player_state == 0 { player_state = ifx PlayerStart() then 1 else 2 }
    if player_state != 1 { return 1 }
    #if #defined(ANDROID_BUILD) {
        reminder_now := UnixNow()
        if AndroidDevice.AndroidLifecycleFocused() != 0 && chest_reminder_session.checked_at != reminder_now {
            // Native record text is borrowed until the next read.
            reminder_enabled := AppRecordHost("chest.reminder.enabled") != "off"
            reminder_policy := ChestReminderReadPolicy(ifx reminder_enabled then "on" else "off", AppRecordHost("chest.reminder.time"))
            // Permission is an OS choice. Remember the one initial request so
            // reopening Shovey never repeats a denied prompt.
            if reminder_policy.enabled && !chest_reminder_permission_checked {
                chest_reminder_permission_checked = true
                if AppRecordHost("chest.reminder.permission") == "" &&
                    SaveAppRecordHost("chest.reminder.permission", "asked") &&
                    !NotificationsAllowed() { unused RequestNotifications() }
            }
            ChestReminderFrame(*chest_reminder_session, reminder_policy, reminder_now,
                CollectionLocaleText("shovey_shop_chest"), CollectionLocaleText("shovey_chest_reminder"),
                DailyReminder.DailyChestReminderAvailableAfter())
        }
        // Drags scroll the host's own pages, such as the profile, as the
        // desktop and Windows hosts already do.
        pointer := PointerSample(session)
        BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed, pointer.down,
            pointer.released, 0.0, cast(float64)MonotonicMilliseconds() / 1000.0)
    }
    // Back leaves a game for its library. At the library it stays unused,
    // so the host closes the app as Android users expect.
    key := KeyboardTake(session)
    if key == PLAYER_BACK_KEY && CollectionBack() { key = 0 }
    unused KeyboardSend(session, key)
    pictures_pending := false
    #if !#defined(ANDROID_BUILD) {
        pictures_pending = ImagesPending() > 0
    }
    if !CollectionFrame(session, viewport, key, 0, pictures_pending) { return 1 }
    #if !#defined(ANDROID_BUILD) {
        RaylibCompletePictureFrames(CollectionCompletePictures())
    }
    CollectionCollect()
    return 0
}
