// The browser entry supplies scoped documents and frame observations to
// the same game view Arcade uses.
#import "apps/node_types"
WebApp :: #import "kryon/app_context";
#import "translations"
#import "kryon/text_input_props"
#import "std/vec"

#program_export
ReadAppUiHost :: () -> AppUiFrame {
    area := WebApp.AppBounds()
    return AppUiFrame.{.session = WebApp.AppSession(),
        .width = cast(s32)(area.x + area.width), .height = cast(s32)(area.y + area.height),
        .top = cast(s32)area.y, .scale = WebApp.AppScale(), .font = WebApp.AppFont(),
        .now = WebApp.AppNow()}
}
AppLocaleHost :: (key: string) -> string { return GameLocaleText("en", key) }
AppRecordHost :: (name: string) -> string { return WebApp.DocumentRead(name) }
SaveAppRecordHost :: (name: string, text: string) -> bool { return WebApp.DocumentWrite(name, text) }
#program_export
AppKeyHost :: () -> s32 { return WebApp.AppKey() }
// The standalone app host currently has no packed sound effect service.
#program_export
AppSoundHost :: (path: string) -> bool { unused path; return false }

#program_export
EditorLocaleHost :: (key: string) -> string { return EditorLocaleText("en", key) }
EditorRecordPath :: (name: string) -> string {
    path: Vec(u8)
    BuilderPrint(*path, "editor/%", name)
    return BuilderFinish(path)
}
#program_export
EditorRecordHost :: (name: string) -> string { return WebApp.DocumentRead(EditorRecordPath(name)) }
#program_export
EditorSaveRecordHost :: (name: string, text: string) -> bool { return WebApp.DocumentWrite(EditorRecordPath(name), text) }
#program_export
SmoothFramesHost :: (frames: s32) -> bool { unused frames; return true }
#program_export
AppSupportsHost :: (capability: string) -> bool { return capability == "arcade.navigation" }
#program_export
AppFieldInputHost :: () -> TextFieldInput { return WebApp.AppFieldInput() }
