// A game, ready to play, on the shared standalone browser host. Like Arcade's
// library, the page opens on one cover per app, and each cover opens its app.
#import "kryon/app_context"
#import "kryon/app_protocol"
#import "kryon/app_mini"
using Canvas :: #import "kryon/Canvas";
#import "kryon/geometry"
Carousel :: #import "kryon/carousel";

Button :: #import "kryon/button";
#import "kryon/control_props"
ShopUI :: #import, file "../shop_view.zi";
Book :: #import, file "../collectible_book.zi";
#import, file "host.zi";
#import, file "../shovey_theme.zi";
#import, file "../shovey_view.zi";
#import, file "../editor/editor_view.zi";
#import, file "../controls.zi";

web_covers: Carousel.CarouselState;
// Classic and the editor, with the cover art apps.json declares for them.
WebCovers :: () {
    page := ReadAppUiHost()
    width := cast(float32)page.width
    top := cast(float32)page.top
    bottom := cast(float32)(page.height - page.bottom)
    ShoveyDress(page.session, width, top, bottom)
    items: [2]Carousel.CarouselItem = .[
    Carousel.CarouselItem.{.label = AppLocaleHost("shovey_title_art"),
        .portrait = "assets/shovey/title-portrait.png", .landscape = "assets/shovey/title-landscape.png",
        .logo = "assets/shovey/logo.png", .action = AppLocaleHost("shovey_play")},
    Carousel.CarouselItem.{.label = AppLocaleHost("shovey_editor_art"),
        .portrait = "assets/shovey/editor-portrait.png", .landscape = "assets/shovey/editor-landscape.png",
        .logo = "assets/covers/shovey-editor-logo.png", .action = AppLocaleHost("shovey_open")}
    ]
    entered := Carousel.Draw(page.session, Carousel.Props.{.key = cast(u64)20210,
            .logo_max_width = ifx width < 600.0 then width * 0.58 else 360.0, .logo_top = 120.0,
            .bounds = Rectangle.{0.0, top, width, bottom - top}, .now = page.now, .key_pressed = AppKeyHost(),
            .dark = true, .label = AppLocaleHost("shovey_title_art"), .previous_label = AppLocaleHost("shovey_page_previous"),
            .next_label = AppLocaleHost("shovey_page_next")}, items[:], *web_covers)
    if entered == 0 || entered == 1 {
        web_covers_open = false
        web_editor_open = entered == 1
        if entered == 0 {
            OpenLevels()
            selector_from_cover = true
        }
    }
    ShopUI.CoverActions(page.session, Rectangle.{12.0, top + 12.0, width - 128.0, 104.0})
    if Book.BookCoverAction(page.session, 20404, Rectangle.{64.0, top + 72.0, 44.0, 44.0}) { Book.BookOpen() }
    if AppSupports("entity.profile") {
        if ShopUI.IconAction(page.session, 20400, Rectangle.{width - 104.0, top + 12.0, 44.0, 44.0},
            ShopUI.SkinPath(), "profile") { unused AppService("entity.profile", "open") }
        if ShopUI.IconAction(page.session, 20402, Rectangle.{width - 56.0, top + 12.0, 44.0, 44.0},
            "assets/shovey/shop/trophy.png", "leaderboard") { unused AppService("entity.profile", "leaderboard") }
    }
}

#program_export
Main :: () -> s64 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        CanvasSetExitKey(0)
        AppIdentity("shovey")
        AppDescribe("Shovey", "S1.7rr:M4 4H20V20H4ZM9 9H15V15H9Z")
        return APP_PROTOCOL
    }
    if mode == APP_FRAME {
        // UTC wall time determines daily eligibility; frame.now is monotonic.
        today := cast(s64)AppNow() / 86400
        ShoveyShopSetToday(today)
        // An embedded mini page opens straight into its level.
        if !AppMini() && web_covers_open {
            page := ReadAppUiHost()
            ShopUI.Pump(page.now, today)
            if ShopUI.IsOpen() && (AppKeyHost() == 256 || AppKeyHost() == 4) { unused ShoveyShopBack() }
            if Book.BookIsOpen() && (AppKeyHost() == 256 || AppKeyHost() == 4) { unused Book.BookBack() }
            if Book.BookIsOpen() {
                unused Book.BookFrame(page.session, Rectangle.{0.0, cast(float32)page.top,
                    cast(float32)page.width, cast(float32)(page.height - page.top - page.bottom)}, "")
            } else if ShopUI.IsOpen() {
                unused ShoveyShopFrame(page.session, Rectangle.{0.0, cast(float32)page.top,
                    cast(float32)page.width, cast(float32)(page.height - page.top - page.bottom)}, page.now, today)
            } else { WebCovers() }
        }
        else if web_editor_open { EditorFrame("en") }
        else { ShoveyFrame() }
    }
    return 0
}
