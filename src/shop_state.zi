// Shovey's local coin wardrobe and Entity's verified Dew entitlements.
// UI must show its confirmation before calling ShopBuy / ShopBuyCoins.
CompletionCoins :: #import, file "completion_coins.zi";
Records :: #import, file "controls.zi";
App :: #import "kryon/app_context";
Products :: #import "entity/game_shop";
#import "std/json_scan"
#import "std/text_buffer"
#import "std/c_string"
#import "std/vec"

SHOP_SKIN_COUNT :: 8;
SHOP_COIN_MASK :: 206; // Ember, Frost, Berry, Stone, Gold (bits 1,2,3,6,7).
ShopLocal :: struct { selected: s32; owned: s32; spent: s32; hint_packs: s32; hint_used: s32; hint_free: [1004]u8; hint_loot: [1004]u8 }
shop_local: ShopLocal;
shop_owner: [65]u8;
shop_known: bool;
shop_storage_ok: bool;
shop_earned: s32;
shop_bought: s32;
shop_verified: s32;
shop_ready: bool;
shop_poll_at: float64;
shop_reported_skin: s32 = -1;

ShopSkinName :: (id: s32) -> string {
    names: [8]string = .["default", "ember", "frost", "berry", "night", "crystal", "stone", "gold"]
    return ifx id >= 0 && id < SHOP_SKIN_COUNT then names[id] else ""
}
ShopSkinCoins :: (id: s32) -> s32 {
    prices: [8]s32 = .[0, 100, 200, 300, 0, 0, 400, 600]
    return ifx id >= 0 && id < SHOP_SKIN_COUNT then prices[id] else 0
}
ShopSkinProduct :: (id: s32) -> s32 {
    if id == 4 { return 13 }
    if id == 5 { return 14 }
    return 0
}
// Entity atomic Dew units (1,000,000 per Dew), zero for coin/default skins.
ShopSkinDew :: (id: s32) -> s64 { return Products.GameShopPrice(ShopSkinProduct(id)) }
// Bundle-relative preview. Board animation uses the same prefix with
// player-{up,down,left,right}.png or charged-{up,down,left,right}.png.
ShopSkinPath :: (id: s32) -> string {
    paths: [8]string = .["assets/shovey/sprites/player-down.png",
        "assets/shovey/sprites/skin-1-player-down.png", "assets/shovey/sprites/skin-2-player-down.png",
        "assets/shovey/sprites/skin-3-player-down.png", "assets/shovey/sprites/skin-4-player-down.png",
        "assets/shovey/sprites/skin-5-player-down.png", "assets/shovey/sprites/skin-6-player-down.png",
        "assets/shovey/sprites/skin-7-player-down.png"]
    return ifx id >= 0 && id < SHOP_SKIN_COUNT then paths[id] else ""
}
ShopProfilePath :: (id: s32) -> string {
    paths: [8]string = .["assets/shovey/shop/profile-96.png",
        "assets/shovey/shop/profile-skin-1-96.png", "assets/shovey/shop/profile-skin-2-96.png",
        "assets/shovey/shop/profile-skin-3-96.png", "assets/shovey/shop/profile-skin-4-96.png",
        "assets/shovey/shop/profile-skin-5-96.png", "assets/shovey/shop/profile-skin-6-96.png",
        "assets/shovey/shop/profile-skin-7-96.png"]
    return ifx id >= 0 && id < SHOP_SKIN_COUNT then paths[id] else ""
}
ShopInteger :: (text: string, name: string, maximum: s32) -> s32 {
    value := ReadNumber(text, FieldAt(text, 0, name))
    if !value.valid || value.value < 0.0 || value.value > cast(float64)maximum { return -1 }
    result := cast(s32)value.value
    return ifx value.value == cast(float64)result then result else -1
}
ShopRecordName :: (output: []u8) -> string {
    out: Vec(u8)
    BuilderPrint(*out, "shop.v1.%", ifx shop_owner[0] == 0 then "guest" else TextUntilNul(shop_owner[:]))
    unused CopyCString(TextView(VecSlice(out, 0, out.count)), output)
    VecFree(out)
    return TextUntilNul(output)
}
ShopLoad :: () {
    shop_storage_ok = false
    if !Records.ProgressStorageReady() || !Records.ProgressStorageFlush() { return }
    name: [96]u8
    text := Records.PathRecord(ShopRecordName(name[:]))
    shop_storage_ok = text == "" && Records.ProgressStorageMissing()
    if text == "" { return }
    if ValueEnd(text, 0, 0) != text.count || !Products.GameShopField(text, "owner", TextUntilNul(shop_owner[:])) ||
    ShopInteger(text, "version", 1) != 1 { return }
    next: ShopLocal
    next.selected = ShopInteger(text, "selected", SHOP_SKIN_COUNT - 1)
    next.owned = ShopInteger(text, "owned", SHOP_COIN_MASK)
    next.spent = ShopInteger(text, "spent", 1000000000)
    if next.selected < 0 || next.owned < 0 || next.spent < 0 || (next.owned & SHOP_COIN_MASK) != next.owned { return }
    cost: s32
    for id: cast(s32)1..SHOP_SKIN_COUNT - 1 {
        if (next.owned & (1 << id)) != 0 { cost += ShopSkinCoins(id) }
    }
    if FieldAt(text, 0, "hint_packs") >= 0 {
        next.hint_packs = ShopInteger(text, "hint_packs", 1000000)
        next.hint_used = ShopInteger(text, "hint_used", 1000000000)
        free: [1005]u8
        loot: [1005]u8
        if next.hint_packs < 0 || next.hint_used < 0 ||
        ReadStringText(text, FieldAt(text, 0, "hint_free"), free[:]) != 1004 ||
        ReadStringText(text, FieldAt(text, 0, "hint_loot"), loot[:]) != 1004 { return }
        for at: 0..1003 {
            if free[at] < 48 || free[at] > 51 || loot[at] < 48 || loot[at] > 49 { return }
            next.hint_free[at] = free[at] - 48
            next.hint_loot[at] = loot[at] - 48
        }
    }
    if cost + next.hint_packs * 30 != next.spent { return }
    shop_local = next
    shop_storage_ok = true
}
// Identity comes from the public account service, never from a saved record
// or from the reply whose entitlements we are about to trust.
ShopOwner :: () -> bool {
    status := Records.ProgressAccountService("{\"operation\":\"status\"}")
    owner: [65]u8
    valid := ValueEnd(status, 0, 0) == status.count && Products.GameShopField(status, "status", "done") &&
        Products.GameShopField(status, "game_progress", "account-v1") &&
        ReadStringText(status, FieldAt(status, 0, "account"), owner[:]) >= 0
    if TextUntilNul(owner[:]) == "local" { owner = .{} }
    if owner[0] != 0 {
        if TextUntilNul(owner[:]).count != 64 { valid = false }
        for byte: TextUntilNul(owner[:]) {
            if !(byte >= #char "0" && byte <= #char "9") && !(byte >= #char "a" && byte <= #char "f") { valid = false }
        }
    }
    if !valid { owner = .{} }
    if valid != shop_known || TextUntilNul(owner[:]) != TextUntilNul(shop_owner[:]) {
        CompletionCoins.CompletionCoinInvalidate()
        shop_reported_skin = -1
        shop_owner = owner
        shop_known = valid
        shop_local = .{}
        shop_earned = 0; shop_bought = 0; shop_verified = 0
        shop_ready = false; shop_poll_at = 0.0; shop_storage_ok = false
        if valid { ShopLoad() }
    }
    return valid
}
ShopSave :: (next: ShopLocal) -> bool {
    if !shop_known || !shop_storage_ok || !Records.ProgressStorageReady() { return false }
    name: [96]u8
    out: Vec(u8)
    BuilderPrint(*out, "{\"version\":1,\"owner\":\"%\",\"selected\":%,\"owned\":%,\"spent\":%",
        TextUntilNul(shop_owner[:]), next.selected, next.owned, next.spent)
    BuilderPrint(*out, ",\"hint_packs\":%,\"hint_used\":%,\"hint_free\":\"", next.hint_packs, next.hint_used)
    for value: next.hint_free { BuilderPrint(*out, "%", cast(s32)value) }
    BuilderPrint(*out, "\",\"hint_loot\":\"")
    for value: next.hint_loot { BuilderPrint(*out, "%", cast(s32)value) }
    BuilderPrint(*out, "\"}")
    // One record publishes the choice, unlock and debit together. Keep the
    // previous in-memory state if the storage provider rejects the write.
    record := ShopRecordName(name[:])
    previous := Records.PathRecord(record)
    // Copy borrowed host storage before another host call can reuse it.
    previous_bytes: [4096]u8
    if !CopyCString(previous, previous_bytes[:]) { VecFree(out); return false }
    saved := Records.PathSaveRecord(record, TextView(VecSlice(out, 0, out.count)))
    VecFree(out)
    if !saved { return false }
    if !Records.ProgressStorageFlush() {
        restored := Records.PathSaveRecord(record, TextUntilNul(previous_bytes[:]))
        durable := Records.ProgressStorageFlush()
        if !restored || !durable { shop_storage_ok = false }
        return false
    }
    shop_local = next
    return true
}
ShopApplyStatus :: (reply: string) {
    shop_ready = false
    if ValueEnd(reply, 0, 0) != reply.count || !shop_known || shop_owner[0] == 0 || !Products.GameShopField(reply, "owner", TextUntilNul(shop_owner[:])) ||
    !Products.GameShopField(reply, "status", "done") ||
    !MatchLiteral(reply, FieldAt(reply, 0, "connected"), "true") {
        shop_verified = 0; shop_bought = 0
        return
    }
    owned := ShopInteger(reply, "shovey_owned", Products.GAME_SHOP_SHOVEY_BITS)
    bought := ShopInteger(reply, "shovey_coins", 1000000000)
    if owned < 0 || (owned & Products.GAME_SHOP_SHOVEY_BITS) != owned || bought < 0 {
        shop_verified = 0; shop_bought = 0
        return
    }
    shop_verified = owned
    shop_bought = bought // Ledger total replaces the old value, including zero.
    shop_ready = true
}
ShopPump :: (now: float64) {
    if !ShopOwner() || now < shop_poll_at { return }
    if !shop_storage_ok { ShopLoad() }
    CompletionCoins.CompletionCoinInvalidate()
    shop_poll_at = now + 5.0
    ShopApplyStatus(App.AppService(Products.GAME_SHOP_SERVICE, "status"))
    // An account switch during a host request invalidates that reply.
    unused ShopOwner()
}
// Supply the current owner's cumulative daily chest grants after ShopPump.
// This value is never saved as purchased coins and never consumes a chest.
ShopSetEarnedCoins :: (total: s32) {
    if !ShopOwner() { return }
    shop_earned = ifx total >= 0 && total <= 1000000000 then total else 0
}
ShopAvailable :: (id: s32) -> bool {
    unused ShopOwner()
    if id == 0 { return true }
    if id < 0 || id >= SHOP_SKIN_COUNT { return false }
    product := ShopSkinProduct(id)
    if product > 0 { return (shop_verified & (1 << product)) != 0 }
    return (shop_local.owned & (1 << id)) != 0
}
ShopSkin :: () -> s32 {
    unused ShopOwner()
    skin := ifx ShopAvailable(shop_local.selected) then shop_local.selected else 0
    if shop_known && shop_owner[0] != 0 && skin != shop_reported_skin {
        owner := shop_owner
        request: Vec(u8)
        BuilderPrint(*request, "skin %", skin)
        reply := App.AppService("leaderboard", TextView(VecSlice(request, 0, request.count)))
        saved := Products.GameShopField(reply, "status", "saved")
        VecFree(request)
        if !ShopOwner() || TextUntilNul(owner[:]) != TextUntilNul(shop_owner[:]) { return 0 }
        if saved { shop_reported_skin = skin }
    }
    return skin
}
ShopCoins :: () -> s32 {
    if !ShopOwner() { return 0 }
    balance := shop_earned + shop_bought + CompletionCoins.CompletionCoinTotal(TextUntilNul(shop_owner[:])) - shop_local.spent
    return ifx balance > 0 then balance else 0
}
ShopSelect :: (id: s32) -> bool {
    if !ShopOwner() { return false }
    ShopLoad()
    if !ShopAvailable(id) { return false }
    if id == shop_local.selected { return true }
    next := shop_local
    next.selected = id
    return ShopSave(next)
}
ShopPurchase :: (request: string) -> bool {
    if !ShopOwner() || shop_owner[0] == 0 { return false }
    ShopApplyStatus(App.AppService(Products.GAME_SHOP_SERVICE, "status"))
    if !ShopOwner() || !shop_ready { return false }
    expected := shop_owner
    answer := App.AppService(Products.GAME_SHOP_SERVICE, request)
    // The next identity request may reuse the host's response buffer.
    reply_bytes: [1024]u8
    copied := CopyCString(answer, reply_bytes[:])
    shop_poll_at = 0.0
    // Enqueue is not ownership. Only a later successful status restores it.
    shop_ready = false
    if !ShopOwner() || TextUntilNul(expected[:]) != TextUntilNul(shop_owner[:]) || !copied { return false }
    reply := TextUntilNul(reply_bytes[:])
    return Products.GameShopField(reply, "owner", TextUntilNul(shop_owner[:])) &&
        (Products.GameShopField(reply, "status", "pending") || Products.GameShopField(reply, "status", "done"))
}
ShopBuy :: (id: s32) -> bool {
    if !ShopOwner() { return false }
    ShopLoad()
    if id <= 0 || id >= SHOP_SKIN_COUNT || ShopAvailable(id) { return false }
    product := ShopSkinProduct(id)
    if product > 0 { return ShopPurchase(Products.GameShopProduct(product)) }
    cost := ShopSkinCoins(id)
    if cost <= 0 || ShopCoins() < cost { return false }
    next := shop_local
    next.owned |= 1 << id
    next.spent += cost
    return ShopSave(next)
}
ShopBuyCoins :: (pack: s32) -> bool {
    if Products.ShoveyCoinPackCoins(pack) <= 0 { return false }
    requests: [3]string = .["shovey-coins:1", "shovey-coins:2", "shovey-coins:3"]
    return ShopPurchase(requests[pack - 1])
}

// Allowances and one-time rewards belong to the owner, never the attempt.
ShopHintFree :: (level: s32) -> s32 {
    if !ShopOwner() || !shop_storage_ok || level < 1 || level >= 1004 { return 0 }
    return 3 - cast(s32)shop_local.hint_free[level]
}
ShopHintBank :: () -> s32 {
    if !ShopOwner() || !shop_storage_ok { return 0 }
    grants: s32
    for value: shop_local.hint_loot { grants += cast(s32)value }
    bank := shop_local.hint_packs * 3 + grants + shop_earned / 100 - shop_local.hint_used
    return ifx bank > 0 then bank else 0
}
ShopHintUse :: (level: s32) -> bool {
    if !ShopOwner() { return false }
    ShopLoad()
    if !ShopOwner() || !shop_storage_ok || level < 1 || level >= 1004 { return false }
    next := shop_local
    if next.hint_free[level] < 3 { next.hint_free[level] += 1 }
    else if ShopHintBank() > 0 { next.hint_used += 1 }
    else { return false }
    return ShopSave(next)
}
ShopBuyHints :: () -> bool {
    if !ShopOwner() { return false }
    ShopLoad()
    if !ShopOwner() || ShopCoins() < 30 || shop_local.hint_packs >= 1000000 { return false }
    next := shop_local
    next.hint_packs += 1; next.spent += 30
    return ShopSave(next)
}
ShopHintFound :: (level: s32) -> bool {
    return !ShopOwner() || !shop_storage_ok || level < 1 || level >= 1004 || shop_local.hint_loot[level] != 0
}
ShopHintReward :: (level: s32) -> bool {
    if !ShopOwner() { return false }
    ShopLoad()
    if ShopHintFound(level) { return false }
    next := shop_local
    next.hint_loot[level] = 1
    return ShopSave(next)
}
