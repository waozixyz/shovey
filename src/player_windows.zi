// Windows: Shovey's player on Kryon's SDL/Cairo desktop host. It draws the Frame
// Android draws (src/app.zi), from the collection beside the program, and
// adds the window, keyboard, scrolling and test driver src/player_desktop.zi
// gives Linux.
#import "kryon/desktop_runtime"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/geometry"
#import "kryon/tree_input"
#import "kryon/Frame"
#import "kryon/ScrollDevice"
#import "kryon/test_driver"
#import "std/c_string"
#import "std/byte_text_linux"
#import "std/timer_linux"
#import "app"
#import "player_host"
#import "player_platform"

path_sdl :: #system_library "SDL2";
ProgramBasePath :: () -> *u8 #foreign path_sdl "SDL_GetBasePath";
ReleaseBasePath :: (path: *u8) #foreign path_sdl "SDL_free";

// Escape steps back as it does on Linux.
WINDOWS_ESCAPE_KEY :: 256

WindowsDraw :: (session: Session) -> bool {
    BeginDesktopFrame()
    // Keys, held-key repeats, typed text and the test driver's keys arrive
    // in order, as they do on Linux.
    key, modifiers := DesktopInputTake(session)
    KeyboardModifiersSend(session, modifiers)
    if key == WINDOWS_ESCAPE_KEY && CollectionBack() { key = 0 }
    if key != 0 { KeyboardSend(session, key) }
    viewport := DesktopViewport()
    pointer := TestDriverPointer(session, PollPointer())
    TreePointerUpdate(session, pointer)
    TreeSecondaryPointerUpdate(session, PollSecondaryPointer())
    wheel := TestDriverWheel(DesktopWheelMove())
    PointerWheelSend(session, pointer.x, pointer.y, wheel)
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed,
        pointer.down, pointer.released, wheel, cast(float64)MonotonicMilliseconds() / 1000.0)
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk {
        unused EndDesktopFrame()
        return false
    }
    if Frame(session, viewport) != 0 {
        TreeCancel(session)
        unused EndDesktopFrame()
        return false
    }
    if EndFrame(session) != FrameStatus.FrameOk {
        unused EndDesktopFrame()
        return false
    }
    ok := EndDesktopFrame()
    TestDriverFrame(session)
    return ok
}

#program_export
main :: () -> s32 {
    // The collection, profile and font ship beside the program.
    directory := ProgramBasePath()
    if directory == null { return 1 }
    entered := EnterDirectory(TextFromCString(directory))
    ReleaseBasePath(directory)
    if !entered { return 1 }
    if !OpenDesktopTitled(480, 820, "Shovey") {
        CloseDesktop()
        Report("Shovey: could not open the window\n")
        return 1
    }
    if !WindowInterceptCloseHost(true) { CloseDesktop(); return 1 }
    session := SessionOpen()
    if !SessionValid(session) {
        CloseDesktop()
        return 1
    }
    ok := true
    while ok && PollDesktop() {
        ok = WindowsDraw(session)
        if WindowTakeCloseRequestHost() { break }
        if ok { PauseDesktop() }
    }
    if !CollectionClose() { ok = false }
    SessionClose(session)
    CloseDesktop()
    return ifx ok then 0 else 1
}
