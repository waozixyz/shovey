// Conservative reachability after a trail changes the pushing floor.
// Both solver hosts use this; the game engine remains the rule authority.
#import, file "../engine.zi";

// A wooden crate can become walkable ground when pushed into water. Static
// reachability must allow that future bridge; the engine validates each push.
SolveWaterMayBridge :: (game: *ShoveyGame) -> bool {
    for object: game.objects { if object == 9 { return true } }
    return false
}

SolveTrailWall :: (kind: s32, water_may_bridge: bool) -> bool {
    return kind == 12 || kind == 63 || (kind == 64 && !water_may_bridge) || ShoveyDrop(kind) || kind == 76 ||
        ShoveyBlockingDecoration(kind) || (kind >= 95 && kind <= 98) || kind == SHOVEY_CAVE_WALL
}

SolveTrailBallsBlocked :: (game: *ShoveyGame) -> bool {
    if (game.powers & SHOVEY_TRAIL) == 0 { return false }
    water_may_bridge := SolveWaterMayBridge(game)
    live: [SHOVEY_CELLS]bool
    queue: [SHOVEY_CELLS]s32
    count: s32 = 0
    balls: s32 = 0
    // Any paint or pit is an optimistic destination, irrespective of color.
    // Doors, locks, breakable walls and other pieces are optimistically open.
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if ShoveyBallColor(game.objects[at]) > 0 { balls += 1 }
        if ShoveyPitColor(game.ground[at]) > 0 || ShoveyPaintColor(game.ground[at]) > 0 {
            live[at] = true
            queue[count] = at
            count += 1
        }
    }
    if balls == 0 { return false }
    head: s32 = 0
    while head < count {
        to := queue[head]
        head += 1
        for side: cast(s32)0..3 {
            from := ShoveyNeighbor(to, side)
            behind := ShoveyNeighbor(from, side)
            if from < 0 || behind < 0 || live[from] { continue }
            ground := game.ground[from]
            if SolveTrailWall(ground, water_may_bridge) || ground == 7 || ground == 8 || ground == 11 || ShoveyColorPortal(ground) { continue }
            if SolveTrailWall(game.ground[behind], water_may_bridge) { continue }
            live[from] = true
            queue[count] = from
            count += 1
        }
    }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if ShoveyBallColor(game.objects[at]) > 0 && !live[at] { return true }
    }
    return false
}
