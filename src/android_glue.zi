#import "android_device"
#import "android_jni"
Handoff :: #import "entity/account_handoff";

// Registers Kryon's canonical Android natives, the document picker's among
// them, on Shovey's activity.
#program_export
JNI_OnLoad :: (vm: *JniVm, reserved: *void) -> s32 {
    unused reserved
    version := AndroidJniOnLoad(vm, "xyz/waozi/shovey/ShoveyActivity")
    if version < 0 {
        return version
    }
    Handoff.AccountHandoffJniOnLoad(vm)
    return version
}
