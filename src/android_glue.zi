#import "android_device"
#import "android_jni"

// Registers Kryon's canonical Android natives, the document picker's among
// them, on Shovey's activity.
#program_export
JNI_OnLoad :: (vm: *JniVm, reserved: *void) -> s32 {
    unused reserved
    return AndroidJniOnLoad(vm, "xyz/waozi/shovey/ShoveyActivity")
}
