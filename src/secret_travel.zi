// Hidden rooms keep the campaign's actual unfinished board and route intact.
#import, file "engine.zi";
#import, file "reward_locations.zi";
#import, file "world_map_progression.zi";

ShoveySecretVisit :: struct {
    parent: ShoveyGame
    room: s32
    valid: bool
}

ShoveyReturnFromSecret :: (game: *ShoveyGame, visit: *ShoveySecretVisit) -> bool {
    if !visit.valid || game.level != visit.room { return false }
    game.* = visit.parent
    visit.valid = false
    return true
}

// Both an actual beach crossing and a discovered map destination enter using
// this navigation primitive. The exact current campaign board waits for return.
ShoveyEnterSecret :: (game: *ShoveyGame, visit: *ShoveySecretVisit, target: s32, entry: s32, direction: s32) -> bool {
    if ShoveySecret(game.level) || !ShoveySecret(target) { return false }
    next: ShoveyGame
    if !ShoveyLoad(*next, target) || entry < 0 || entry >= SHOVEY_CELLS ||
    next.ground[entry] != 0 || next.objects[entry] != 0 { return false }
    visit.parent = game.*
    visit.room = target
    visit.valid = true
    next.player = entry
    next.direction = direction
    game.* = next
    return true
}

// Only a successful secret entry yields a discovery key for the UI to persist.
// Returning from a room, touching a closed edge or unlocking its neighbor does
// not discover anything. Existing local.secret29a records remain authoritative.
ShoveySecretEntryDiscoveryKey :: (game: *ShoveyGame, visit: *ShoveySecretVisit) -> string {
    if !visit.valid || game.level != visit.room { return "" }
    if game.level == CHEST_LEVEL && visit.parent.level != CHEST_PARENT_LEVEL { return "" }
    if (game.level == SHOVEY_SECRET_UP || game.level == SHOVEY_SECRET_DOWN) &&
        visit.parent.level != ShoveyLevelCount() { return "" }
    return WorldMapSecretDiscoveryKey(game.level)
}

ShoveySelectDiscoveredSecret :: (game: *ShoveyGame, visit: *ShoveySecretVisit, level: s32, discovery_record: string) -> bool {
    if !WorldMapSecretVisible(level, discovery_record) || game.level < 1 ||
        game.level > ShoveyLevelCount() { return false }
    entry: s32 = ifx level == CHEST_LEVEL then CHEST_ENTRY_CELL else ifx level == SHOVEY_SECRET_UP then 108 else 119
    direction: s32 = ifx level == SHOVEY_SECRET_UP then 2 else 0
    return ShoveyEnterSecret(game, visit, level, entry, direction)
}

// Logical left runs down the coast in landscape. Only actual sand on the
// open beach edge of 29 leads to 29a; ordinary walls/water/edges do not.
ShoveySecretEdge :: (game: *ShoveyGame, visit: *ShoveySecretVisit, direction: s32) -> bool {
    if game.won || game.lost || game.player < 0 || direction < 0 || direction > 3 ||
    ShoveyNeighbor(game.player, direction) >= 0 { return false }
    if ShoveySecret(game.level) {
        back := ifx game.level == SHOVEY_SECRET_UP then 0 else 2
        if game.level == CHEST_LEVEL && game.player != CHEST_ENTRY_CELL { return false }
        return direction == back && ShoveyReturnFromSecret(game, visit)
    }
    target: s32 = -1
    if game.level == CHEST_PARENT_LEVEL && direction == 0 && game.tiles[game.player] == 78 &&
    game.ground[game.player] == 0 { target = CHEST_LEVEL }
    last := ShoveyLevelCount()
    if game.level == last && direction == 2 { target = SHOVEY_SECRET_UP }
    if game.level == last && direction == 0 { target = SHOVEY_SECRET_DOWN }
    if target < 0 { return false }
    entry := ifx target == CHEST_LEVEL then CHEST_ENTRY_CELL else ifx direction == 2 then game.player - (SHOVEY_WIDTH - 1) else game.player + (SHOVEY_WIDTH - 1)
    return ShoveyEnterSecret(game, visit, target, entry, direction)
}
