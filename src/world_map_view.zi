        if section == 27 { path = "assets/shovey/world-map/continuous-27-portrait.webp" }
        if section == 28 { path = "assets/shovey/world-map/continuous-28-portrait.webp" }
        if section == 29 { path = "assets/shovey/world-map/continuous-29-portrait.webp" }
