    }
    scene := Layout.WorldMapSceneBounds(section,width,landscape)
    bounds := Rectangle.{origin.x+scene.x,origin.y+scene.y,scene.width,scene.height}
    if WorldMapViewIntersects(bounds,viewport,0.0) {
        unused Image(session,ImageProps.{.key=cast(u64)(60001+section),.bounds=bounds,
            .asset_path=path,.fit=ImageFit.ImageFitStretch,.smooth=true})
    }
}
WorldMapView :: (session: Session, bounds: Rectangle, state: *WorldMapViewState, props: WorldMapViewProps) -> WorldMapSelection {
    shown: [1003]bool
    for place: cast(s32)1..cast(s32)props.visible.count {
        if place > 1003 { break }
        shown[place - 1] = WorldMapViewBrowsable(props, place)
    }
    props.visible = shown[:]
    WorldMapViewUpdateFraming(state,props,bounds)
    width := state.world_width
    camera := WorldMapViewCameraViewport(props,bounds)
    pointer := SamplePointer()
    if pointer.pressed && pointer.x >= bounds.x && pointer.y >= bounds.y && pointer.x < bounds.x + bounds.width && pointer.y < bounds.y + bounds.height {
        state.pointer_drag = true; state.pointer_moving = false; state.drag_slop = 0.0
        state.pointer_start = Vector2.{pointer.x, pointer.y}; state.pointer_last = state.pointer_start
    }
    result := WorldMapViewKeyboard(state, props, width, bounds.height)
    if state.viewport_width > 0.0 && (state.viewport_width != bounds.width || state.viewport_height != bounds.height) { state.reveal = true }
    state.viewport_width = bounds.width; state.viewport_height = bounds.height
    extent := WorldMapViewCameraBounds(props, width, bounds.height, bounds.width)
    if state.reveal { WorldMapViewReveal(state, props, width, bounds) }
    WorldMapViewClampCamera(state, extent, bounds, width, props)
    center := Vector2.{cast(float32)state.scroll_x + camera.width * 0.5, cast(float32)state.scroll_offset + camera.height * 0.5}
    rail_moved := false
    if state.pointer_drag && pointer.down {
        dx := pointer.x - state.pointer_start.x; dy := pointer.y - state.pointer_start.y
        if !state.pointer_moving && dx * dx + dy * dy > 64.0 { state.pointer_moving = true }
        if state.pointer_moving {
            drag := Vector2.{pointer.x - state.pointer_last.x, pointer.y - state.pointer_last.y}
            unused WorldMapViewRailDrag(state, props, width, center, drag)
            state.pointer_last = Vector2.{pointer.x, pointer.y}
            state.reveal = false; rail_moved = true
        }
    }
    // The shared portable wheel helper consumes pointer input without exposing
    // a free-moving scrollbar. Scroll itself supplies clipping only.
    wheel := Carousel.CarouselWheel(session, bounds)
    scroll := Scroll(session, ScrollProps.{.key = cast(u64)20105, .bounds = bounds, .manual_scroll = true,
        .content_width = cast(s32)bounds.width, .content_height = cast(s32)bounds.height,
        .input = ScrollInput.{.enabled = true, .disabled = true}})
    if !pointer.down && wheel != 0.0 {
        unused WorldMapViewWheelMove(state, props, width, center, WorldMapViewWheelDistance(width,wheel), WorldMapViewPointerSide(bounds, pointer.x))
        rail_moved = true
    }
    if rail_moved && state.wheel_edge != 0 {
        point := WorldMapViewFramePoint(props,WorldMapViewRailPoint(state, props, width),width,camera,Route.WorldMapEdgeAt(state.wheel_edge - 1).to_level)
        state.scroll_x = cast(s32)(point.x - bounds.width * 0.5)
        state.scroll_offset = cast(s32)(point.y - camera.height * 0.5)
        WorldMapViewClampCamera(state, extent, bounds, width, props)
        WorldMapViewApplyPast(state, extent, bounds, width, props)
    }
    if !scroll.opened { return result }
    origin := Vector2.{bounds.x - cast(float32)state.scroll_x, bounds.y - cast(float32)state.scroll_offset}
    route_click := pointer.released && state.pointer_drag && !state.pointer_moving && pointer.y >= bounds.y && pointer.y < bounds.y + camera.height
    if route_click {
        place := WorldMapViewPointerPlace(props,width,origin,Vector2.{pointer.x,pointer.y})
        if place > 0 { result = WorldMapViewClick(state,props,place) }
    }
    unused Box(session, BoxProps.{.key = cast(u64)59999, .bounds = scroll.viewport, .fill = Color.{97, 157, 65, 255}})
    for section: cast(s32)0..Layout.WorldMapSceneCount - 1 { WorldMapViewSection(session, scroll.viewport, origin, width, props.landscape, section) }
    label_storage: [1003][32]u8
    for place: cast(s32)1..cast(s32)props.visible.count {
        if !WorldMapViewFlag(props.visible, place) { continue }
        point := WorldMapViewPositionFor(place, width, props)
        if point.x < 0.0 { continue }
        center := Vector2.{origin.x + point.x, origin.y + point.y}
        node := WorldMapViewTargetBounds(center)
        if !WorldMapViewIntersects(node, scroll.viewport, 64.0) { continue }
        available := WorldMapViewFlag(props.available, place)
        completed := WorldMapViewFlag(props.completed, place)
        label := WorldMapViewDisplayName(place, props, label_storage[place - 1][:])
        status := ifx !available then props.locked_label else ifx completed then props.completed_label else props.available_label
        if props.loading && !available { status = props.loading_label }
        if Button(session, ButtonProps.{.key = cast(u64)(33000 + place), .id = 33000 + place,
            .bounds = node, .label = label, .detail = ifx props.focus_only then "" else status, .disabled = !available,
            .invisible = true, .icon_only = true, .selected = place == state.focused, .circle = true}) != 0 {
            if !state.pointer_moving && !route_click { result = WorldMapViewClick(state, props, place) }
        }
        if place == state.focused {
            unused Ring(session, RingProps.{.key = cast(u64)(64000 + place), .center = center,
                .inner_radius = 27.0, .outer_radius = 28.0, .start_angle = 0.0, .end_angle = 360.0, .color = Color.{255, 250, 216, 255}})
        }
        unused Circle(session, CircleProps.{.key = cast(u64)(900000 + place), .center = center,
            .radius = WorldMapViewCircleRadius, .fill = Color.{48, 76, 46, 255}})
        unused Circle(session, CircleProps.{.key = cast(u64)(920000 + place), .center = center, .radius = 23.5,
            .fill = ifx completed then Color.{247, 223, 129, 255} else ifx available then Color.{238, 237, 191, 255} else Color.{94, 121, 76, 255}})
        earned := WorldMapViewStars(props, place)
        if completed && earned > 0 {
            for star: cast(s32)0..2 {
                SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{center.x - 17.0 + cast(float32)star * 12.0, center.y + 8.0, 10.0, 12.0},
                    .shape = "F:M12 2L15 8L22 9L17 14L18 21L12 18L6 21L7 14L2 9L9 8Z",
                    .color = ifx star < earned then Color.{110, 74, 25, 255} else Color.{204, 180, 104, 255}})
            }
        }
        if !available {
            SvgIcon(session, SvgIconProps.{.bounds = Rectangle.{center.x - 6.0, center.y - 6.0, 12.0, 12.0},
                .shape = "S2rr:M6 10H18V21H6ZM8 10V6L10 4H14L16 6V10", .color = Color.{200, 208, 162, 255}})
        }
        if WorldMapViewFlag(props.replay, place) {
            unused Circle(session, CircleProps.{.key = cast(u64)(43000 + place), .center = Vector2.{center.x + 14.0, center.y - 14.0},
                .radius = 3.0, .fill = Color.{255, 226, 150, 255}})
        }
    }
    if WorldMapViewBrowsable(props, state.focused) {
        point := WorldMapViewPositionFor(state.focused, width, props)
        unused Image(session, ImageProps.{.key = cast(u64)64999,
            .bounds = WorldMapViewAvatarBounds(Vector2.{origin.x + point.x, origin.y + point.y}),
            .asset_path = "assets/shovey/world-map/shovey-avatar.png", .alt_text = "Shovey", .fit = ImageFit.ImageFitContain, .smooth = true})
    }
    End(session)
    if pointer.released || !pointer.down { state.pointer_drag = false; state.pointer_moving = false }
    return result
}
