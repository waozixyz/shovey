#import "kryon/session"
#import "kryon/pointer_input"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/button_props"
#import "kryon/button_widget"
#import "kryon/control_props"
#import "kryon/image_props"
#import "kryon/image_widget"
#import "kryon/box_props"
#import "kryon/box_widget"
#import "kryon/shape_props"
#import "kryon/shape_widget"
#import "kryon/scroll_props"
#import "kryon/scroll_widget"
#import "kryon/scroll"
#import "kryon/tree"
#import "kryon/widget_palette"
#import "kryon/text_props"
#import "kryon/text_align"
#import "kryon/text_widget"
#import "kryon/svg_icon_props"
#import "kryon/svg_icon_widget"
#import "std/number_text"
Math :: #import "std/math";
Carousel :: #import "kryon/carousel";
Layout :: #import, file "world_map_layout.zi";
Route :: #import, file "world_map_progression.zi";
Art :: #import, file "world_map_art.zi";
#import, file "world_map_art.zi";

WorldMapViewState :: struct {
    scroll_offset: s32
    scroll_x: s32
    focused: s32
    last_click_place: s32
    last_click_time: float64
    reveal: bool
    viewport_width: float32
    viewport_height: float32
    pointer_drag: bool
    pointer_moving: bool
    pointer_start: Vector2
    pointer_last: Vector2
    pointer_scroll_x: s32
    pointer_scroll_offset: s32
    wheel_edge: s32 // edge table index + 1, zero means no current route
    wheel_t: float32
    // Wheel or drag distance past either end of the road: negative before
    // its start, positive beyond its far end. It pans the painting's long axis.
    wheel_past: float32
    // Road distance one drag has pushed past an end before panning begins.
    drag_slop: float32
    world_width: float32
    zoomed_out: bool
    framing_place: s32
    wheel_branch: [4]s32
}

// Visibility is an explicit caller decision. Public callers supply actual
// discovery records; the private editor supplies its authored places. Empty
// visibility never means "show everything". Slices are indexed by place - 1.
WorldMapViewProps :: struct {
    visible: []bool
    available: []bool
    completed: []bool
    replay: []bool
    stars: []s32 // Earned ratings, indexed by place - 1; zero means unrecorded.
    labels: []string
    focus_only: bool
    landscape: bool
    loading: bool
    now: float64
    key_pressed: s32
    available_label: string
    completed_label: string
    locked_label: string
    loading_label: string
}

WorldMapSelection :: struct {
    focused: s32
    activated: s32
}

// Browsing changes the camera's region without changing the selected board.
// Cache framing per traversed edge, rather than recomputing zoom on every tick.
WorldMapViewCameraPlace :: (state: WorldMapViewState) -> s32 {
    if state.wheel_edge > 0 && state.wheel_edge <= Route.WORLD_MAP_EDGE_COUNT {
        edge := Route.WorldMapEdgeAt(state.wheel_edge - 1)
        return ifx state.wheel_t > 0.5 then edge.to_level else edge.from_level
    }
    return state.focused
}

// The public selector overlays its 112px Play panel on the painted map.
// Frame choices and the selected avatar above it. A landscape painting fits
// the full height, so the camera may lift a low destination above the panel;
// the strip this exposes lies behind the panel. The editor's focus-only map
// has no Play panel.
WorldMapViewCameraViewport :: (props: WorldMapViewProps, viewport: Rectangle) -> Rectangle {
    if !props.focus_only && viewport.height > 168.0 { viewport.height -= 112.0 }
    return viewport
}

// A notch travels the same authored road distance before and after an adaptive
// zoom. Otherwise a reverse notch cannot retrace a forward notch across areas
// with different spacing limits. Rail movement itself still uses screen units.
WorldMapViewWheelDistance :: (width: float32, notches: float32) -> float32 {
    return notches * 90.0 * Layout.WorldMapScale(width) / WorldMapViewAuthoredScale
}

WorldMapViewFlag :: (values: []bool, place: s32) -> bool {
    return place > 0 && place <= values.count && values[place - 1]
}

// Logical pixels: do not scale or shrink the hit circles with the artwork.
WorldMapViewTargetDiameter :: 56.0;
WorldMapViewCircleRadius :: 26.0;
WorldMapViewTargetBounds :: (center: Vector2) -> Rectangle {
    return Rectangle.{center.x - 28.0, center.y - 28.0, WorldMapViewTargetDiameter, WorldMapViewTargetDiameter}
}
// The sprite's alpha reaches its bottom edge: place its feet on the node,
// leaving the lower half of the circle available for the earned rating.
WorldMapViewAvatarBounds :: (center: Vector2) -> Rectangle {
    return Rectangle.{center.x - 26.0, center.y - 48.0, 52.0, 52.0}
}
WorldMapViewStars :: (props: WorldMapViewProps, place: s32) -> s32 {
    if place < 1 || place > props.stars.count { return 0 }
    count := props.stars[place - 1]
    if count < 0 { return 0 }
    if count > 3 { return 3 }
    return count
}
WorldMapViewDisplayName :: (place: s32, props: WorldMapViewProps, output: []u8) -> string {
    if place > 0 && place <= props.labels.count && props.labels[place - 1] != "" { return props.labels[place - 1] }
    return Route.WorldMapLevelDisplayName(WorldMapViewPlace(place, props.focus_only), output)
}

WorldMapViewWidth :: (viewport_width: float32) -> float32 {
    if viewport_width <= 0.0 { return 1.0 }
    return 390.0
}

// Fit the full cross-axis of the painting; scrolling follows its long axis.
WorldMapViewAuthoredScale :: 0.54;
WorldMapViewCenterSpacing :: 80.1;
// Portrait never shrinks below the scale that keeps its closest two boards
// (137 art px apart at the second fork) one 56px hit circle apart. Narrower
// windows show the painting slightly larger and the camera pans sideways.
WorldMapViewPortraitMinimumScale :: 0.41;
WorldMapViewNativeScale :: (props: WorldMapViewProps, viewport: Rectangle) -> float32 {
    if props.landscape { return viewport.height / 941.0 }
    fit := viewport.width / 1086.0
    return ifx fit < WorldMapViewPortraitMinimumScale then WorldMapViewPortraitMinimumScale else fit
}
WorldMapViewFramingWidth :: (props: WorldMapViewProps, at: s32,
        viewport: Rectangle = Rectangle.{0.0,0.0,390.0,844.0}) -> float32 {
    unused at
    return 390.0 * WorldMapViewNativeScale(props,viewport) / Layout.WorldMapWorldZoom
}

// At a junction, frame the entry and both browsable choices as one group.
// Blend out as the camera leaves it, so the camera never snaps to another arm.
WorldMapViewFramePoint :: (props: WorldMapViewProps, point: Vector2, width: float32, viewport: Rectangle, place: s32 = 0) -> Vector2 {
    if place == 175 {
        final := WorldMapViewPositionFor(175,width,props)
        scale := Layout.WorldMapScale(width)
        // The dock source anchor and boat rectangle are recorded in scenes.json.
        minimum := Vector2.{final.x - 28.0,final.y - 48.0}
        maximum := Vector2.{final.x + 28.0,final.y + 28.0}
        boat_min := Vector2.{final.x + (ifx props.landscape then 75.0 else 125.0) * scale,
            final.y + (ifx props.landscape then -243.0 else -238.0) * scale}
        boat_max := Vector2.{final.x + (ifx props.landscape then 309.0 else 412.0) * scale,
            final.y + (ifx props.landscape then 65.0 else 82.0) * scale}
        if boat_min.x < minimum.x { minimum.x = boat_min.x }; if boat_min.y < minimum.y { minimum.y = boat_min.y }
        if boat_max.x > maximum.x { maximum.x = boat_max.x }; if boat_max.y > maximum.y { maximum.y = boat_max.y }
        if maximum.x - minimum.x <= viewport.width - 32.0 { point.x = (minimum.x + maximum.x) * 0.5 }
        if maximum.y - minimum.y <= viewport.height - 32.0 { point.y = (minimum.y + maximum.y) * 0.5 }
        return point
    }
    for index: cast(s32)0..Route.WORLD_MAP_FORK_COUNT - 1 {
        fork := Route.WorldMapForkAt(index)
        if !WorldMapViewBrowsable(props,fork.left) || !WorldMapViewBrowsable(props,fork.right) { continue }
        entry := WorldMapViewPositionFor(fork.entry,width,props)
        distance := WorldMapViewRouteDistance(point,entry)
        if distance > 160.0 { continue }
        left := WorldMapViewPositionFor(fork.left,width,props)
        right := WorldMapViewPositionFor(fork.right,width,props)
        minimum := entry; maximum := entry
        if left.x < minimum.x { minimum.x = left.x }; if right.x < minimum.x { minimum.x = right.x }
        if left.y < minimum.y { minimum.y = left.y }; if right.y < minimum.y { minimum.y = right.y }
        if left.x > maximum.x { maximum.x = left.x }; if right.x > maximum.x { maximum.x = right.x }
        if left.y > maximum.y { maximum.y = left.y }; if right.y > maximum.y { maximum.y = right.y }
        weight := 1.0 - distance / 160.0
        // Retain the rail point when a viewport cannot contain the whole group.
        if maximum.x - minimum.x <= viewport.width - 64.0 {
            point.x += ((minimum.x + maximum.x) * 0.5 - entry.x) * weight
        }
        if maximum.y - minimum.y <= viewport.height - 128.0 {
            point.y += ((minimum.y + maximum.y) * 0.5 - entry.y) * weight
        }
        return point
    }
    // Match the opposite arm at the same longitudinal position. Only visible
    // roads participate; a locked preview cannot pull the camera past its limit.
    for fork_index: cast(s32)0..Route.WORLD_MAP_FORK_COUNT - 1 {
        fork := Route.WorldMapForkAt(fork_index)
        branch := WorldMapViewBranch(fork,place)
        if branch == 0 { continue }
        best := point
        best_distance: float32 = 1000000000.0
        found := false
        for edge_index: cast(s32)0..Route.WORLD_MAP_EDGE_COUNT - 1 {
            edge := Route.WorldMapEdgeAt(edge_index)
            other_branch := WorldMapViewBranch(fork,edge.from_level)
            if other_branch == 0 { other_branch = WorldMapViewBranch(fork,edge.to_level) }
            if other_branch == 0 || other_branch == branch || !WorldMapViewBrowsable(props,edge.from_level) ||
                !WorldMapViewBrowsable(props,edge.to_level) { continue }
            previous := Layout.WorldMapRailSample(edge_index,0,width,props.landscape)
            for sample: cast(s32)1..Layout.WorldMapRailSampleCount - 1 {
                next := Layout.WorldMapRailSample(edge_index,sample,width,props.landscape)
                from := ifx props.landscape then previous.x else previous.y
                to := ifx props.landscape then next.x else next.y
                axis := ifx props.landscape then point.x else point.y
                if from != to && ((from <= axis && to >= axis) || (to <= axis && from >= axis)) {
                    t := (axis - from) / (to - from)
                    match := Vector2.{previous.x + (next.x - previous.x) * t,previous.y + (next.y - previous.y) * t}
                    distance := WorldMapViewRouteDistance(point,match)
                    if distance < best_distance { best = match; best_distance = distance; found = true }
                }
                previous = next
            }
        }
        if found {
            // Always keep the active rail and its buttons comfortably visible.
            span := ifx props.landscape then viewport.height - 128.0 else viewport.width - 64.0
            shift := best_distance * 0.5
            if shift > span * 0.5 { shift = span * 0.5 }
            if props.landscape { point.y += ifx best.y < point.y then -shift else shift }
            else { point.x += ifx best.x < point.x then -shift else shift }
        }
        break
    }
    return point
}

// The editor's three authored aliases use the same detached positions as
// their public room identities. They are accepted only in focus-only mode.
WorldMapViewPlace :: (place: s32, focus_only: bool) -> s32 {
    if focus_only && place >= 176 && place <= 178 { return place + 825 }
    return place
}

WorldMapViewPosition :: (place: s32, width: float32, focus_only: bool) -> Vector2 {
    place = WorldMapViewPlace(place, focus_only)
    if place >= 1 && place <= 175 { return Layout.WorldMapLevelPosition(place, width) }
    point := Art.WorldMapArtSecretPosition(place)
    if point.x < 0.0 { return point }
    return Vector2.{point.x * width / 390.0, point.y * width / 390.0}
}
WorldMapViewPositionFor :: (place: s32, width: float32, props: WorldMapViewProps) -> Vector2 {
    identity := WorldMapViewPlace(place, props.focus_only)
    if identity >= 1 && identity <= 175 { return Layout.WorldMapLevelPosition(identity, width, props.landscape) }
    if identity < 1001 || identity > 1003 { return Vector2.{-1.0, -1.0} }
    point := Art.WorldMapArtSecretPosition(identity, props.landscape)
    return Vector2.{point.x * width / 390.0, point.y * width / 390.0}
}
WorldMapViewArtBounds :: (width: float32, landscape: bool = false) -> Rectangle {
    scale := width / 390.0
    full := Layout.WorldMapWorldBounds(landscape)
    return Rectangle.{full.x * scale, full.y * scale, full.width * scale, full.height * scale}
}
WorldMapViewFocusOffset :: (place: s32, width: float32, height: float32, focus_only: bool) -> s32 {
    return WorldMapViewFocusOffsetInBounds(WorldMapViewPosition(place, width, focus_only), height, WorldMapViewArtBounds(width))
}
WorldMapViewFocusOffsetInBounds :: (point: Vector2, height: float32, bounds: Rectangle) -> s32 {
    if !(height > 0.0) || !(bounds.height > 0.0) || point.x != point.x || point.y != point.y || bounds.y != bounds.y { return 0 }
    if point.x == -1.0 && point.y == -1.0 { return 0 }
    maximum := bounds.y + bounds.height - height
    if maximum < bounds.y { maximum = bounds.y }
    offset := point.y - height * 0.5
    if offset < bounds.y { offset = bounds.y }
    if offset > maximum { offset = maximum }
    return cast(s32)offset
}

// The keyboard's far end: three locked nodes beyond the furthest reachable
// ordinary destination. Discovery and private editor visibility stay explicit.
WorldMapViewPublicLast :: (props: WorldMapViewProps) -> s32 {
    if props.focus_only { return Layout.WorldMapLevelCount }
    frontier: s32 = 1
    for place: cast(s32)1..Layout.WorldMapLevelCount {
        if WorldMapViewFlag(props.visible, place) && WorldMapViewFlag(props.available, place) { frontier = place }
    }
    last := frontier + 3
    if last > Layout.WorldMapLevelCount { last = Layout.WorldMapLevelCount }
    return last
}

// The whole map is browsable at any progress: every ordinary destination is
// drawn, locked ones as locked. A secret room is listed in `visible` only once
// it has been found, so it stays hidden until then.
WorldMapViewBrowsable :: (props: WorldMapViewProps, place: s32) -> bool {
    return WorldMapViewFlag(props.visible, place)
}

// Both axes come from destinations the player can browse, never terrain.
// Expanding a short range to fit the viewport reveals scenery, not new nodes.
WorldMapViewCameraBounds :: (props: WorldMapViewProps, width: float32, viewport_height: float32 = 0.0, viewport_width: float32 = 390.0) -> Rectangle {
    full := WorldMapViewArtBounds(width, props.landscape)
    // Leave camera room at the horizontal endpoints as well as at interior
    // levels. Otherwise the art edge clamps a revealed start off-center.
    if props.landscape {
        full.x -= viewport_width * 0.5
        full.width += viewport_width
    }
    minimum := Vector2.{full.x + full.width, full.y + full.height}
    maximum := Vector2.{}
    found := false
    for place: cast(s32)1..cast(s32)props.visible.count {
        if !WorldMapViewBrowsable(props, place) { continue }
        point := WorldMapViewPositionFor(place, width, props)
        if point.x < 0.0 { continue }
        found = true
        if point.x < minimum.x { minimum.x = point.x }
        if point.y < minimum.y { minimum.y = point.y }
        if point.x > maximum.x { maximum.x = point.x }
        if point.y > maximum.y { maximum.y = point.y }
    }
    if !found { minimum = WorldMapViewPositionFor(1, width, props); maximum = minimum }
    pad_x := ifx viewport_width * 0.5 > 144.0 then viewport_width * 0.5 else 144.0
    pad_y := ifx viewport_height * 0.5 > 176.0 then viewport_height * 0.5 else 176.0
    minimum.x -= pad_x; minimum.y -= pad_y
    maximum.x += pad_x; maximum.y += pad_y
    if maximum.x - minimum.x < viewport_width {
        extra := (viewport_width - maximum.x + minimum.x) * 0.5
        minimum.x -= extra; maximum.x += extra
    }
    if maximum.y - minimum.y < viewport_height {
        extra := (viewport_height - maximum.y + minimum.y) * 0.5
        minimum.y -= extra; maximum.y += extra
    }
    // The whole painting stays reachable, end to end, at any progress.
    art := WorldMapViewArtBounds(width, props.landscape)
    if minimum.x > art.x { minimum.x = art.x }
    if minimum.y > art.y { minimum.y = art.y }
    if maximum.x < art.x + art.width { maximum.x = art.x + art.width }
    if maximum.y < art.y + art.height { maximum.y = art.y + art.height }
    if minimum.x < full.x { maximum.x -= minimum.x - full.x; minimum.x = full.x }
    if minimum.y < full.y { maximum.y -= minimum.y - full.y; minimum.y = full.y }
    if maximum.x > full.x + full.width { minimum.x -= maximum.x - full.x - full.width; maximum.x = full.x + full.width }
    if maximum.y > full.y + full.height { minimum.y -= maximum.y - full.y - full.height; maximum.y = full.y + full.height }
    if minimum.x < full.x { minimum.x = full.x }
    if minimum.y < full.y { minimum.y = full.y }
    return Rectangle.{minimum.x, minimum.y, maximum.x - minimum.x, maximum.y - minimum.y}
}
WorldMapViewClampAxis :: (offset: s32, start: float32, extent: float32, viewport: float32) -> s32 {
    minimum := cast(s32)start
    if cast(float32)minimum < start { minimum += 1 }
    maximum := cast(s32)(start + extent - viewport)
    if maximum < minimum { maximum = minimum }
    if offset < minimum { return minimum }
    if offset > maximum { return maximum }
    return offset
}
WorldMapViewClampCamera :: (state: *WorldMapViewState, extent: Rectangle, viewport: Rectangle, width: float32, props: WorldMapViewProps = WorldMapViewProps.{}) {
    camera := WorldMapViewCameraViewport(props,viewport)
    state.scroll_x = WorldMapViewClampAxis(state.scroll_x, extent.x, extent.width, viewport.width)
    state.scroll_offset = WorldMapViewClampAxis(state.scroll_offset, extent.y, extent.height, camera.height)
}
WorldMapViewReveal :: (state: *WorldMapViewState, props: WorldMapViewProps, width: float32, viewport: Rectangle) {
    state.wheel_edge = 0; state.wheel_past = 0.0
    if WorldMapViewBrowsable(props, state.focused) {
        camera := WorldMapViewCameraViewport(props,viewport)
        point := WorldMapViewFramePoint(props,WorldMapViewPositionFor(state.focused, width, props),width,camera,state.focused)
        state.scroll_x = cast(s32)(point.x - viewport.width * 0.5)
        state.scroll_offset = cast(s32)(point.y - camera.height * 0.5)
    }
    WorldMapViewClampCamera(state, WorldMapViewCameraBounds(props, width, viewport.height, viewport.width), viewport, width, props)
    state.reveal = false
}
WorldMapViewIntersects :: (bounds: Rectangle, viewport: Rectangle, margin: float32) -> bool {
    return bounds.x + bounds.width >= viewport.x - margin &&
        bounds.x <= viewport.x + viewport.width + margin &&
        bounds.y + bounds.height >= viewport.y - margin &&
        bounds.y <= viewport.y + viewport.height + margin
}

WorldMapViewRouteDistance :: (from: Vector2, to: Vector2) -> float32 {
    return Layout.WorldMapPointDistance(from,to)
}

// All points share one coordinate space. An empty intermediate slice preserves
// the straight route; one point is a bend. Repeated points add no arc length.
WorldMapViewRouteSample :: (from: Vector2, to: Vector2, intermediate: []Vector2, t: float32) -> Vector2 {
    if t <= 0.0 { return from }
    if t >= 1.0 { return to }
    length: float32
    previous := from
    for index: cast(s32)0..cast(s32)intermediate.count {
        next := to
        if index < intermediate.count { next = intermediate[index] }
        length += WorldMapViewRouteDistance(previous, next)
        previous = next
    }
    if length <= 0.0 { return from }
    remaining := length * t
    previous = from
    for index: cast(s32)0..cast(s32)intermediate.count {
        next := to
        if index < intermediate.count { next = intermediate[index] }
        segment := WorldMapViewRouteDistance(previous, next)
        if segment > 0.0 {
            if remaining <= segment {
                fraction := remaining / segment
                return Vector2.{previous.x + (next.x - previous.x) * fraction,
                    previous.y + (next.y - previous.y) * fraction}
            }
            remaining -= segment
        }
        previous = next
    }
    return to
}

// Include every intermediate extremum, then apply the same map scale/origin as
// the dots. The origin includes horizontal and vertical camera translation.
WorldMapViewRouteBounds :: (from: Vector2, to: Vector2, intermediate: []Vector2,
        origin: Vector2, scale: float32) -> Rectangle {
    minimum := from
    maximum := from
    for index: cast(s32)0..cast(s32)intermediate.count {
        point := to
        if index < intermediate.count { point = intermediate[index] }
        if point.x < minimum.x { minimum.x = point.x }
        if point.y < minimum.y { minimum.y = point.y }
        if point.x > maximum.x { maximum.x = point.x }
        if point.y > maximum.y { maximum.y = point.y }
    }
    return Rectangle.{origin.x + minimum.x * scale, origin.y + minimum.y * scale,
        (maximum.x - minimum.x) * scale, (maximum.y - minimum.y) * scale}
}

// Kept separate so focus-only selection and unavailable activation can be
// exercised without a window or host input. Rendering calls this once only.
WorldMapViewSelect :: (state: *WorldMapViewState, props: WorldMapViewProps, place: s32) -> WorldMapSelection {
    result := WorldMapSelection.{.focused = state.focused}
    if !WorldMapViewBrowsable(props, place) || !WorldMapViewFlag(props.available, place) { return result }
    state.focused = place
    state.wheel_edge = 0; state.wheel_past = 0.0
    result.focused = place
    state.reveal = true
    return result
}

// Resolve overlapping circles by distance, including locked nodes so a tap
// on a locked center cannot fall through to a neighboring unlocked level.
WorldMapViewPointerPlace :: (props: WorldMapViewProps, width: float32, origin: Vector2, point: Vector2) -> s32 {
    nearest: s32
    distance: float32 = 28.01
    for place: cast(s32)1..cast(s32)props.visible.count {
        if !WorldMapViewFlag(props.visible,place) { continue }
        center := WorldMapViewPositionFor(place,width,props)
        delta := WorldMapViewRouteDistance(Vector2.{origin.x + center.x,origin.y + center.y},point)
        if delta < distance { distance = delta; nearest = place }
    }
    return nearest
}

WorldMapViewClick :: (state: *WorldMapViewState, props: WorldMapViewProps, place: s32) -> WorldMapSelection {
    result := WorldMapViewSelect(state,props,place)
    if props.focus_only || !WorldMapViewBrowsable(props,place) || !WorldMapViewFlag(props.available,place) {
        state.last_click_place = 0
        return result
    }
    if state.last_click_place == place && props.now >= state.last_click_time && props.now - state.last_click_time <= 0.4 {
        result.activated = place
        state.last_click_place = 0
    } else {
        state.last_click_place = place
        state.last_click_time = props.now
    }
    return result
}

WorldMapViewPlay :: (state: *WorldMapViewState, props: WorldMapViewProps) -> WorldMapSelection {
    result := WorldMapSelection.{.focused = state.focused}
    if !props.focus_only && WorldMapViewBrowsable(props, state.focused) && WorldMapViewFlag(props.available, state.focused) {
        result.activated = state.focused
    }
    return result
}

// Directional input follows real graph edges using their positions in the
// active orientation. WASD and arrows share the policy and reveal the focus.
WorldMapViewNavigate :: (props: WorldMapViewProps, place: s32, horizontal: s32, forward: bool) -> s32 {
    here := WorldMapViewPositionFor(place, 390.0, props)
    best := place
    score: float32 = 0.0
    // Neighbouring dots are chosen by their direction on the actual painting.
    // This makes the same arrows work on vertically and horizontally laid roads.
    for index: cast(s32)0..Route.WORLD_MAP_EDGE_COUNT - 1 {
        edge := Route.WorldMapEdgeAt(index)
        destination: s32
        if edge.from_level == place { destination = edge.to_level }
        if edge.to_level == place { destination = edge.from_level }
        if destination == 0 || !WorldMapViewBrowsable(props, destination) || !WorldMapViewFlag(props.available, destination) { continue }
        point := WorldMapViewPositionFor(destination, 390.0, props)
        dx := point.x - here.x; dy := point.y - here.y
        distance := WorldMapViewRouteDistance(here, point)
        if distance <= 0.0 { continue }
        projection := ifx horizontal != 0 then dx * cast(float32)horizontal else ifx forward then -dy else dy
        candidate := projection / distance
        if candidate > score { score = candidate; best = destination }
    }
    return best
}

WorldMapViewKeyboard :: (state: *WorldMapViewState, props: WorldMapViewProps, width: float32, height: float32) -> WorldMapSelection {
    key := props.key_pressed
    if key == 257 || key == 32 { return WorldMapViewPlay(state, props) }
    next := state.focused
    if key == 265 || key == 87 { next = WorldMapViewNavigate(props, state.focused, 0, true) }
    if key == 264 || key == 83 { next = WorldMapViewNavigate(props, state.focused, 0, false) }
    if key == 262 || key == 68 { next = WorldMapViewNavigate(props, state.focused, 1, true) }
    if key == 263 || key == 65 { next = WorldMapViewNavigate(props, state.focused, -1, false) }
    if key == 268 { next = 1; state.reveal = true }
    if key == 269 {
        next = WorldMapViewPublicLast(props)
        while next > 1 && !WorldMapViewFlag(props.available, next) { next -= 1 }
        state.reveal = true
    }
    if next != state.focused && WorldMapViewBrowsable(props, next) && WorldMapViewFlag(props.available, next) { state.focused = next; state.reveal = true; state.wheel_edge = 0; state.wheel_past = 0.0 }
    return WorldMapSelection.{.focused = state.focused}
}

// Each rail edge uses samples from the painted centerline, not a shortcut
// between destination dots. Parameters are measured by path length.
WorldMapViewRailSample :: (edge: s32, t: float32, width: float32, landscape: bool) -> Vector2 {
    points: [31]Vector2
    for index: cast(s32)0..30 { points[index] = Layout.WorldMapRailSample(edge, index + 1, width, landscape) }
    return WorldMapViewRouteSample(Layout.WorldMapRailSample(edge, 0, width, landscape),
        Layout.WorldMapRailSample(edge, Layout.WorldMapRailSampleCount - 1, width, landscape), points[:], t)
}
WorldMapViewRailLength :: (edge: s32, width: float32, landscape: bool) -> float32 {
    length: float32
    last := Layout.WorldMapRailSample(edge, 0, width, landscape)
    for index: cast(s32)1..Layout.WorldMapRailSampleCount - 1 {
        point := Layout.WorldMapRailSample(edge, index, width, landscape)
        length += WorldMapViewRouteDistance(last, point); last = point
    }
    return length
}
// Resolve the fork arm from a board identity. Branch choices persist while
// wheel movement crosses a merge, so reversing follows the same road home.
WorldMapViewBranch :: (fork: Route.WorldMapFork, place: s32) -> s32 {
    if place >= fork.left && place < fork.right { return 1 }
    if place >= fork.right && place < fork.merge { return 2 }
    return 0
}

// Use viewport coordinates, including an embedded map's nonzero origin.
WorldMapViewPointerSide :: (viewport: Rectangle, pointer_x: float32) -> s32 {
    return ifx pointer_x < viewport.x + viewport.width * 0.5 then -1 else 1
}

// Return the next visible graph edge, preserving a previously traversed arm.
WorldMapViewWheelEdge :: (state: *WorldMapViewState, props: WorldMapViewProps, node: s32, forward: bool, pointer_side: s32 = 0) -> s32 {
    desired: s32
    for index: cast(s32)0..Route.WORLD_MAP_FORK_COUNT - 1 {
        fork := Route.WorldMapForkAt(index)
        if (forward && node == fork.entry) || (!forward && node == fork.merge) {
            // Cursor choice applies only on entering a forward fork. A merge
            // uses traversal memory even if the pointer has changed sides.
            if forward && pointer_side != 0 {
                left := WorldMapViewPositionFor(fork.left, 390.0, props)
                right := WorldMapViewPositionFor(fork.right, 390.0, props)
                desired = ifx (pointer_side < 0) == (left.x <= right.x) then 1 else 2
            }
            if desired == 0 { desired = state.wheel_branch[index] }
            if desired == 0 { desired = WorldMapViewBranch(fork, state.focused) }
            if desired == 0 { desired = 1 }
            state.wheel_branch[index] = desired
            break
        }
    }
    first: s32
    for index: cast(s32)0..Route.WORLD_MAP_EDGE_COUNT - 1 {
        edge := Route.WorldMapEdgeAt(index)
        if (forward && edge.from_level != node) || (!forward && edge.to_level != node) { continue }
        if !WorldMapViewBrowsable(props, edge.from_level) || !WorldMapViewBrowsable(props, edge.to_level) { continue }
        if first == 0 { first = index + 1 }
        if desired != 0 {
            for fork_index: cast(s32)0..Route.WORLD_MAP_FORK_COUNT - 1 {
                fork := Route.WorldMapForkAt(fork_index)
                if (forward && node != fork.entry) || (!forward && node != fork.merge) { continue }
                arm_node := ifx forward then edge.to_level else edge.from_level
                if WorldMapViewBranch(fork, arm_node) == desired { return index + 1 }
            }
        }
    }
    return first
}

// Follow the current route in distance steps, leaving the selected board alone.
// The nearest edge is acquired after a drag or selection, then remembered so
// passing near another arm does not silently switch branches.
WorldMapViewWheelMove :: (state: *WorldMapViewState, props: WorldMapViewProps, width: float32, center: Vector2, distance: float32, pointer_side: s32 = 0) -> Vector2 {
    if distance == 0.0 { return .{} }
    if state.wheel_edge == 0 {
        // A rail starts at the selected destination, never at the road that
        // happens to be closest to a dragged or clamped camera.
        node := state.focused
        if node == 1003 { node = 29 }
        if node == 1001 || node == 1002 { node = 175 }
        state.wheel_edge = WorldMapViewWheelEdge(state, props, node, true, pointer_side)
        state.wheel_t = 0.0
        if state.wheel_edge == 0 {
            state.wheel_edge = WorldMapViewWheelEdge(state, props, node, false)
            state.wheel_t = 1.0
        }
    }
    if state.wheel_edge == 0 { return .{} }
    // Reversing onto the exact fork endpoint permits a fresh forward choice.
    // Once inside an arm, pointer motion cannot jump between roads.
    if distance > 0.0 && state.wheel_t == 0.0 && pointer_side != 0 {
        entry := Route.WorldMapEdgeAt(state.wheel_edge - 1).from_level
        next := WorldMapViewWheelEdge(state, props, entry, true, pointer_side)
        if next != 0 { state.wheel_edge = next }
    }
    current_edge := Route.WorldMapEdgeAt(state.wheel_edge - 1)
    for index: cast(s32)0..Route.WORLD_MAP_FORK_COUNT - 1 {
        fork := Route.WorldMapForkAt(index)
        branch := WorldMapViewBranch(fork, current_edge.from_level)
        if branch == 0 { branch = WorldMapViewBranch(fork, current_edge.to_level) }
        if branch != 0 { state.wheel_branch[index] = branch }
    }
    forward := distance > 0.0
    remaining := ifx forward then distance else -distance
    // Past a road end, moving on extends the pan; reversing first returns to
    // that end before following the road again.
    if state.wheel_past != 0.0 {
        if (state.wheel_past > 0.0) == forward {
            state.wheel_past += distance
            return .{}
        }
        back := ifx state.wheel_past > 0.0 then state.wheel_past else -state.wheel_past
        used := ifx remaining < back then remaining else back
        state.wheel_past = ifx used == back then 0.0 else state.wheel_past + (ifx forward then used else -used)
        remaining -= used
    }
    result := Vector2.{}
    road_end := false
    for step: cast(s32)0..Route.WORLD_MAP_CLASSIC_LEVELS {
        if remaining <= 0.0 || state.wheel_edge == 0 { break }
        edge := Route.WorldMapEdgeAt(state.wheel_edge - 1)
        index := state.wheel_edge - 1
        length := WorldMapViewRailLength(index, width, props.landscape)
        if length <= 0.0 { state.wheel_edge = 0; state.wheel_past = 0.0; break }
        available := length * (ifx forward then 1.0 - state.wheel_t else state.wheel_t)
        move := ifx remaining < available then remaining else available
        dt := move / length * (ifx forward then 1.0 else -1.0)
        before := WorldMapViewRailSample(index, state.wheel_t, width, props.landscape)
        state.wheel_t += dt
        after := WorldMapViewRailSample(index, state.wheel_t, width, props.landscape)
        result.x += after.x - before.x; result.y += after.y - before.y
        remaining -= move
        if move >= available {
            node := ifx forward then edge.to_level else edge.from_level
            // Record every traversed arm, including a multi-edge wheel event.
            for fork_index: cast(s32)0..Route.WORLD_MAP_FORK_COUNT - 1 {
                fork := Route.WorldMapForkAt(fork_index)
                branch := WorldMapViewBranch(fork, edge.from_level)
                if branch == 0 { branch = WorldMapViewBranch(fork, edge.to_level) }
                if branch != 0 { state.wheel_branch[fork_index] = branch }
            }
            next := WorldMapViewWheelEdge(state, props, node, forward, pointer_side)
            if next == 0 { road_end = true; break }
            state.wheel_edge = next
            state.wheel_t = ifx forward then 0.0 else 1.0
        }
    }
    // The road ends before the painting does: keep panning toward its edge.
    if road_end && remaining > 0.0 { state.wheel_past += ifx forward then remaining else -remaining }
    return result
}

// Past a road end the camera pans along the painting's long axis (toward the
// right in landscape, upward in portrait) and stops at the painting's edge.
// Distance the edge absorbs is dropped, so reversing responds at once.
WorldMapViewApplyPast :: (state: *WorldMapViewState, extent: Rectangle, viewport: Rectangle, width: float32, props: WorldMapViewProps) {
    if state.wheel_past == 0.0 { return }
    base_x := state.scroll_x; base_y := state.scroll_offset
    if props.landscape { state.scroll_x += cast(s32)state.wheel_past } else { state.scroll_offset -= cast(s32)state.wheel_past }
    WorldMapViewClampCamera(state, extent, viewport, width, props)
    applied := ifx props.landscape then cast(float32)(state.scroll_x - base_x) else cast(float32)(base_y - state.scroll_offset)
    if (state.wheel_past > 0.0 && applied < state.wheel_past) || (state.wheel_past < 0.0 && applied > state.wheel_past) {
        state.wheel_past = applied
    }
}
// Camera position is the point on the currently selected rail, clamped only
// by the playable world's viewport bounds.
WorldMapViewRailPoint :: (state: *WorldMapViewState, props: WorldMapViewProps, width: float32) -> Vector2 {
    if state.wheel_edge == 0 { return WorldMapViewPositionFor(state.focused, width, props) }
    return WorldMapViewRailSample(state.wheel_edge - 1, state.wheel_t, width, props.landscape)
}

// A zoom change can settle on an idle frame after the last wheel event.
// Apply the same paired-road and public-footer framing as reveal/movement;
// it must not rely on another input event to correct the camera afterward.
WorldMapViewUpdateFraming :: (state: *WorldMapViewState, props: WorldMapViewProps, bounds: Rectangle) {
    at := WorldMapViewCameraPlace(state.*)
    if state.world_width == 0.0 || state.viewport_width != bounds.width || state.viewport_height != bounds.height ||
        state.framing_place != at {
        next_width := WorldMapViewFramingWidth(props,at,bounds)
        if state.world_width > 0.0 && next_width != state.world_width {
            camera := WorldMapViewCameraViewport(props,bounds)
            place := state.focused
            if state.wheel_edge != 0 { place = Route.WorldMapEdgeAt(state.wheel_edge - 1).to_level }
            point := WorldMapViewFramePoint(props,WorldMapViewRailPoint(state,props,next_width),next_width,camera,place)
            state.scroll_x = cast(s32)(point.x - camera.width * 0.5)
            state.scroll_offset = cast(s32)(point.y - camera.height * 0.5)
            WorldMapViewClampCamera(state,WorldMapViewCameraBounds(props,next_width,bounds.height,bounds.width),bounds,next_width,props)
        }
        state.world_width = next_width
        state.zoomed_out = at > 7
        state.framing_place = at
    }
}
WorldMapViewRailDrag :: (state: *WorldMapViewState, props: WorldMapViewProps, width: float32, center: Vector2, drag: Vector2) -> Vector2 {
    if state.wheel_edge == 0 { unused WorldMapViewWheelMove(state, props, width, center, 0.001) }
    if state.wheel_edge == 0 { return .{} }
    a := WorldMapViewRailSample(state.wheel_edge - 1, state.wheel_t - 0.005, width, props.landscape)
    b := WorldMapViewRailSample(state.wheel_edge - 1, state.wheel_t + 0.005, width, props.landscape)
    length := WorldMapViewRouteDistance(a, b)
    if length <= 0.0 { return .{} }
    distance := -(drag.x * (b.x - a.x) + drag.y * (b.y - a.y)) / length
    // Dragging on along the road past either end pans on to the painting's
    // edge, as the wheel does. The first stretch is slop, so a sideways drag
    // at an end still keeps to the road.
    before := state.wheel_past
    moved := WorldMapViewWheelMove(state, props, width, center, distance)
    if before == 0.0 && state.wheel_past != 0.0 {
        state.drag_slop += state.wheel_past
        state.wheel_past = 0.0
        if state.drag_slop > WorldMapViewDragSlop { state.wheel_past = state.drag_slop - WorldMapViewDragSlop; state.drag_slop = 0.0 }
        if state.drag_slop < -WorldMapViewDragSlop { state.wheel_past = state.drag_slop + WorldMapViewDragSlop; state.drag_slop = 0.0 }
    }
    return moved
}
WorldMapViewDragSlop :: 24.0;
// Each native tile includes the identical final overlap of its neighbor.
WorldMapViewSection :: (session: Session, viewport: Rectangle, origin: Vector2, width: float32, landscape: bool, section: s32) {
