#import, file "../src/progress.zi";
#import, file "../src/engine.zi";
#import, file "../src/levels.zi";
#import, file "../src/island_levels.zi";
#import, file "../src/editor/edit.zi";

#program_export
Check :: () -> s32 {
    last := cast(s32)SHOVEY_APPROVED_LEVEL_COUNT
    if ShoveyLevelCount() != last || ShoveyLevelData(last + 1) != "" || ShoveyLevelSolution(last + 1) != "" || IslandLevelData(1) != "" || ISLAND_LEVEL_COUNT != 0 || EditStoryCount(true) != 0 || EditStoryCount(false) != last { return 1 }
    progress := ShoveyProgress.{.unlocked = last}
    game: ShoveyGame
    if !ShoveyLoad(*game, last) || ShoveyLoad(*game, last + 1) { return 2 }
    for letter: ShoveyLevelSolution(last) {
        if letter >= #char "0" && letter <= #char "3" { unused ShoveyMove(*game, cast(s32)(letter - #char "0")) }
        else if letter == #char "f" { unused ShoveyFire(*game) }
        else if letter == #char "t" { unused ShoveyTick(*game) }
    }
    if !game.won { return 3 }
    ShoveyRecordWin(*progress, *game)
    if !progress.completed[last - 1] || progress.unlocked != last + 1 || ShoveyContinue(*progress, *game) || ShoveySelectLevel(*progress, *game, last + 1) { return 4 }
    // A campaign from the previous full release retains its later unlocks
    // and completion marks, while this release opens the last approved board.
    later := last + 5
    game.level = later
    progress.unlocked = later
    progress.completed[22] = true
    saved := ShoveyCampaignSave(*progress, *game)
    restored: ShoveyProgress
    position: ShoveyGame
    if !ShoveyCampaignRestore(*restored, *position, saved) || position.level != last || restored.unlocked != later || !restored.completed[last - 1] || !restored.completed[22] { return 5 }
    if ShoveyOpenLatest(*restored, *position) || position.level != last { return 6 }
    // A live campaign past 175 levels saves the wide layout and restores it.
    for index: cast(s32)0..299 {
        board := ShoveyLevelData(1 + index % last)
        for at: cast(s64)0..board.count - 1 { shovey_live_boards[cast(s64)index * SHOVEY_LIVE_BOARD + at] = board[at] }
        shovey_live_lengths[index] = cast(s32)board.count
    }
    shovey_live_count = 300
    wide := ShoveyProgress.{.unlocked = 250}
    wide.completed[22] = true
    wide.completed[200] = true
    if !ShoveyLoad(*game, 240) { return 7 }
    saved = ShoveyCampaignSave(*wide, *game)
    if saved[:2] != "C5" { return 8 }
    if !ShoveyCampaignRestore(*restored, *position, saved) || restored.unlocked != 250 || !restored.completed[22] ||
    !restored.completed[200] || restored.completed[201] || position.level != 240 { return 9 }
    shovey_live_count = 0
    return 0
}
