#import, file "../src/progress.zi";
#import, file "../src/engine.zi";
#import, file "../src/levels.zi";
#import, file "../src/editor/edit.zi";
#import, file "../src/live_campaign.zi";
#import, file "../src/official_updates.zi";
#import "std/file"

#program_export
Check :: () -> s32 {
    last := cast(s32)SHOVEY_APPROVED_LEVEL_COUNT
    if ShoveyLevelCount() != last || ShoveyLevelData(last + 1) != "" || ShoveyLevelSolution(last + 1) != "" || EditStoryCount() != last { return 1 }
    progress := ShoveyProgress.{.unlocked = last}
    game: ShoveyGame
    if !ShoveyLoad(*game, last) || ShoveyLoad(*game, last + 1) { return 2 }
    for letter: ShoveyLevelSolution(last) {
        if letter >= #char "0" && letter <= #char "3" { unused ShoveyMove(*game, cast(s32)(letter - #char "0")) }
        else if letter == #char "f" { unused ShoveyFire(*game) }
        else if letter == #char "t" { unused ShoveyTick(*game) }
    }
    if !game.won { return 3 }
    ShoveyRecordWin(*progress, *game)
    if !progress.completed[last - 1] || progress.unlocked != last + 1 || ShoveyContinue(*progress, *game) || ShoveySelectLevel(*progress, *game, last + 1) { return 4 }
    // A campaign from the previous full release retains its later unlocks
    // and completion marks, while this release opens the last approved board.
    later := last + 5
    game.level = later
    progress.unlocked = later
    progress.completed[22] = true
    saved := ShoveyCampaignSave(*progress, *game)
    restored: ShoveyProgress
    position: ShoveyGame
    if !ShoveyCampaignRestore(*restored, *position, saved) || position.level != last || restored.unlocked != later || !restored.completed[last - 1] || !restored.completed[22] { return 5 }
    if ShoveyOpenLatest(*restored, *position) || position.level != last { return 6 }
    if restored.unlocked != later || !restored.completed[last - 1] || !restored.completed[22] { return 24 }
    // An unfinished device position remains intact even with later earned progress.
    if !ShoveyLoad(*position, 23) { return 25 }
    position.moves = 3
    if ShoveyOpenLatest(*restored, *position) || position.level != 23 || position.moves != 3 { return 26 }
    // A live campaign past 175 levels saves the wide layout and restores it.
    for index: cast(s32)0..299 {
        board := ShoveyLevelData(1 + index % last)
        for at: cast(s64)0..board.count - 1 { shovey_live_boards[cast(s64)index * SHOVEY_LIVE_BOARD + at] = board[at] }
        shovey_live_lengths[index] = cast(s32)board.count
    }
    shovey_live_count = 300
    wide := ShoveyProgress.{.unlocked = 250}
    wide.completed[22] = true
    wide.completed[200] = true
    if !ShoveyLoad(*game, 240) { return 7 }
    saved = ShoveyCampaignSave(*wide, *game)
    if saved[:2] != "C5" { return 8 }
    if !ShoveyCampaignRestore(*restored, *position, saved) || restored.unlocked != 250 || !restored.completed[22] ||
    !restored.completed[200] || restored.completed[201] || position.level != 240 { return 9 }
    shovey_live_count = 0
    // An old cache with exactly as many levels must not replace corrected
    // level 29 when this build starts, including offline.
    live_check.count = last
    for index: cast(s32)0..last - 1 {
        board := ShoveyLevelData(ifx index == 28 then 1 else index + 1)
        for at: cast(s64)0..board.count - 1 {
            live_staged[cast(s64)index * SHOVEY_LIVE_BOARD + at] = board[at]
        }
    }
    cached := LiveCheckInstall()
    shovey_live_count = 0
    if ShoveyLiveLoadCached(cached, "previous-campaign") ||
    ShoveyLevelBoard(29) != ShoveyLevelData(29) { return 10 }
    if ShoveyLiveLoadCached(cached, "") { return 11 }
    // An unchanged node publication must be rechecked when its old cache
    // was rejected; the saved publication mark alone proves nothing.
    if ShoveyLiveAlreadyChecked("publication", "publication", "previous-campaign") ||
    ShoveyLiveAlreadyChecked("publication", "publication", SHOVEY_APPROVED_CAMPAIGN_MARK) { return 13 }
    // An update proven against this build is still available offline.
    if !ShoveyLiveLoadCached(cached, SHOVEY_APPROVED_CAMPAIGN_MARK) ||
    ShoveyLevelBoard(29) != ShoveyLevelData(1) { return 12 }
    if !ShoveyLiveAlreadyChecked("publication", "publication", SHOVEY_APPROVED_CAMPAIGN_MARK) ||
    ShoveyLiveAlreadyChecked("new-publication", "publication", SHOVEY_APPROVED_CAMPAIGN_MARK) { return 14 }
    // A stale official publication can have been revalidated and stamped
    // against THIS build. Its old 97 must still not roll back the redesign.
    for at: cast(s32)0..1439 { live_staged[96 * SHOVEY_LIVE_BOARD + at] = RETIRED_CLASSIC_97[at] }
    cached = LiveCheckInstall()
    shovey_live_count = 0
    if !ShoveyLiveLoadCached(cached, SHOVEY_APPROVED_CAMPAIGN_MARK) ||
    ShoveyLevelBoard(97) != ShoveyLevelData(97) { return 15 }
    if !ShoveyLoad(*game, 97) { return 16 }
    for letter: ShoveyLevelSolution(97) { unused ShoveyMove(*game, cast(s32)(letter - #char "0")) }
    if !game.won { return 17 }
    // A changed live board is preserved, rather than all of 97 being pinned.
    shovey_live_boards[96 * SHOVEY_LIVE_BOARD + 1439] = #char "1"
    if ShoveyLevelBoard(97) == ShoveyLevelData(97) { return 18 }
    shovey_live_count = 0
    // Replay the actual live document, including its old-install-compatible
    // base boards. Exact retired guards must keep new engine variants active.
    document, read_ok := ReadEntireFile("levels/approved.json")
    if !read_ok || !ShoveyLiveCheckStart(document) { return 19 }
    compact: string
    result: s32 = -1
    for frame: 0..100000 {
        result = ShoveyLiveCheckStep(32, *compact)
        if result != -1 { break }
    }
    if result != 1 || ShoveyLevelCount() != last { return 20 }
    for number: cast(s32)1..last {
        if ShoveyRetiredOfficialBoard(number, ShoveyLevelBoard(number)) { return 21 }
    }
    // A later ruleset may reject a route; its prefix must never truncate
    // an older install's already available campaign or its earned progress.
    live_check.index = last - 1
    if LiveCheckKeepPrefix(*compact) != 0 || ShoveyLevelCount() != last { return 22 }
    live_check.index = last
    if LiveCheckKeepPrefix(*compact) != 1 || ShoveyLevelCount() != last { return 23 }
    shovey_live_count = 0
    return 0
}
