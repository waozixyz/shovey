#import "kryon/geometry"
Map :: #import, file "../src/world_map_view.zi";
Layout :: #import, file "../src/world_map_layout.zi";
Route :: #import, file "../src/world_map_progression.zi";

#program_export
main :: () -> s32 {
    {
        drag := Map.WorldMapViewState.{.pointer_drag=true,.pointer_start=Vector2.{100.0,100.0},.pointer_last=Vector2.{100.0,100.0},.scroll_x=300,.scroll_offset=500,.last_click_place=1}
        Map.WorldMapViewDrag(*drag, .{.x=104.0,.y=104.0,.down=true})
        if drag.pointer_moving || drag.scroll_x != 300 || drag.scroll_offset != 500 { return 81 }
        Map.WorldMapViewDrag(*drag, .{.x=140.0,.y=160.0,.released=true})
        if !drag.pointer_moving || drag.scroll_x != 260 || drag.scroll_offset != 440 || drag.last_click_place != 0 { return 82 }
        cancelled := Map.WorldMapViewState.{.pointer_start=Vector2.{100.0,100.0},.pointer_last=Vector2.{100.0,100.0},.scroll_offset=500}
        Map.WorldMapViewDrag(*cancelled, .{.x=140.0,.y=160.0,.released=true})
        if cancelled.pointer_moving || cancelled.scroll_offset != 500 { return 83 }
    }
    for orientation: cast(s32)0..1 {
        props := Map.WorldMapViewProps.{.landscape = orientation == 1}
        for size: cast(s32)0..2 {
            viewport := Rectangle.{0.0,0.0,320.0 + cast(float32)size * 320.0,600.0 + cast(float32)size * 120.0}
            width := Map.WorldMapViewFramingWidth(props,1,viewport)
            full := Map.WorldMapViewArtBounds(width,props.landscape)
            // Portrait fills the window width unless that would shrink below
            // the minimum scale; then the painting is wider and pans sideways.
            fitted := ifx props.landscape then viewport.height else viewport.width
            if !props.landscape && fitted < 1086.0 * Map.WorldMapViewPortraitMinimumScale { fitted = 1086.0 * Map.WorldMapViewPortraitMinimumScale }
            cross := ifx props.landscape then full.height - fitted else full.width - fitted
            if cross < -0.01 || cross > 0.01 { print("cross-axis framing orientation=% size=% cross=%\n",orientation,size,cross); return 59 }
            if Map.WorldMapViewFramingWidth(props,175,viewport) != width { return 60 }
        }
    }
    {
        flags: [2]bool = .[true,false]
        shown: [2]bool = .[true,true]
        props := Map.WorldMapViewProps.{.visible=shown[:],.available=flags[:],.now=1.0}
        state: Map.WorldMapViewState
        if Map.WorldMapViewClick(*state,props,1).activated != 0 || state.focused != 1 { return 53 }
        state.scroll_x = 120; state.scroll_offset = 340
        if state.reveal { return 77 }
        props.now = 1.2
        if Map.WorldMapViewClick(*state,props,1).activated != 1 { return 54 }
        if state.scroll_x != 120 || state.scroll_offset != 340 || state.reveal { return 78 }
        props.now = 2.0
        unused Map.WorldMapViewClick(*state,props,1)
        props.now = 2.6
        if Map.WorldMapViewClick(*state,props,1).activated != 0 { return 55 }
        unused Map.WorldMapViewClick(*state,props,2)
        props.now = 2.7
        if Map.WorldMapViewClick(*state,props,2).activated != 0 || state.focused != 1 { return 56 }
    }
    {
        shown: [175]bool
        for i: cast(s32)0..174 { shown[i] = true }
        props := Map.WorldMapViewProps.{.visible=shown[:]}
        width: float32 = 390.0 * (320.0 / 1086.0) / Layout.WorldMapWorldZoom
        for place: cast(s32)1..175 {
            point := Map.WorldMapViewPositionFor(place,width,props)
            if Map.WorldMapViewPointerPlace(props,width,Vector2.{},point) != place { return 57 }
        }
        if Map.WorldMapViewPointerPlace(props,width,Vector2.{},Vector2.{-1000.0,-1000.0}) != 0 { return 58 }
    }
    {
        // Real screen scale: every pair of boards and secret rooms stays one
        // full 56px hit circle apart on portrait phones, tablets and desktops.
        props := Map.WorldMapViewProps.{}
        widths: [8]float32 = .[320.0, 360.0, 375.0, 390.0, 412.0, 430.0, 600.0, 1080.0]
        for window: widths {
            width := Map.WorldMapViewFramingWidth(props,1,Rectangle.{0.0,0.0,window,844.0})
            for place: cast(s32)1..178 {
                a := Map.WorldMapViewPositionFor(ifx place > 175 then place + 825 else place, width, props)
                for other: place + 1..178 {
                    b := Map.WorldMapViewPositionFor(ifx other > 175 then other + 825 else other, width, props)
                    if Map.WorldMapViewRouteDistance(a, b) < Map.WorldMapViewTargetDiameter {
                        print("portrait overlap window=% places=%,% distance=%\n",window,place,other,Map.WorldMapViewRouteDistance(a, b))
                        return 61
                    }
                }
            }
        }
    }
    // Shovey is centred on the circle, lifted 2px, and inside its hit area.
    avatar := Map.WorldMapViewAvatarBounds(Vector2.{100.0, 100.0})
    hit := Map.WorldMapViewTargetBounds(Vector2.{100.0, 100.0})
    if avatar.x + avatar.width * 0.5 != 100.0 || avatar.y + avatar.height * 0.5 != 98.0 { return 32 }
    if avatar.x < hit.x || avatar.y < hit.y || avatar.x + avatar.width > hit.x + hit.width ||
        avatar.y + avatar.height > hit.y + hit.height { return 71 }
    if Map.WorldMapViewHighlightRadius > 31.0 { return 72 }
    if Map.WorldMapViewTargetDiameter < 56.0 || Map.WorldMapViewCircleRadius < 24.0 { return 25 }
    for orientation: cast(s32)0..1 {
        props := Map.WorldMapViewProps.{.landscape = orientation == 1}
        for place: cast(s32)1..175 {
            a := Map.WorldMapViewPositionFor(place, 390.0, props)
            target := Map.WorldMapViewTargetBounds(a)
            if target.width < 56.0 || target.height < 56.0 { return 26 }
            for other: place + 1..175 {
                b := Map.WorldMapViewPositionFor(other, 390.0, props)
                // Circular hit areas need a real gap, even at the tightest bend.
                if Map.WorldMapViewRouteDistance(a, b) < 80.0 { return 27 }
            }
        }
        for secret: cast(s32)1001..1003 {
            point := Map.WorldMapViewPositionFor(secret, 390.0, props)
            for place: cast(s32)1..175 {
                if Map.WorldMapViewRouteDistance(point, Map.WorldMapViewPositionFor(place,390.0,props)) < 90.0 { return 28 }
            }
            for edge: cast(s32)0..Route.WORLD_MAP_EDGE_COUNT - 1 {
                for sample: cast(s32)0..100 {
                    road := Map.WorldMapViewRailSample(edge,cast(float32)sample / 100.0,390.0,props.landscape)
                    if Map.WorldMapViewRouteDistance(point,road) < 80.0 { return 29 }
                }
            }
        }
    }
    for orientation: cast(s32)0..1 {
        visible: [1003]bool; available: [1003]bool
        for place: cast(s32)1..175 { visible[place - 1] = true; available[place - 1] = true }
        props := Map.WorldMapViewProps.{.visible = visible[:],.available = available[:],.landscape = orientation == 1}
        viewport := ifx orientation == 0 then Rectangle.{0.0,0.0,390.0,844.0} else Rectangle.{0.0,0.0,960.0,600.0}
        for scenario: cast(s32)0..1 {
            focus: s32 = ifx scenario == 0 then 63 else 97
            edge_index: s32
            for index: cast(s32)0..Route.WORLD_MAP_EDGE_COUNT - 1 {
                edge := Route.WorldMapEdgeAt(index)
                if edge.from_level == focus { edge_index = index + 1; break }
            }
            settling := Map.WorldMapViewState.{.focused = focus,.wheel_edge = edge_index,
                .world_width = 300.0,.framing_place = 20,.viewport_width = viewport.width,.viewport_height = viewport.height}
            // The real production zoom-update path runs without keyboard,
            // wheel, drag or reveal. At the same road endpoint it must settle
            // to the same paired/usable-viewport framing as an explicit reveal.
            Map.WorldMapViewUpdateFraming(*settling,props,viewport)
            if settling.world_width == 300.0 || settling.focused != focus || settling.wheel_edge != edge_index { return 49 }
            revealed := Map.WorldMapViewState.{.focused = focus}
            Map.WorldMapViewReveal(*revealed,props,settling.world_width,viewport)
            if settling.scroll_x != revealed.scroll_x || settling.scroll_offset != revealed.scroll_offset { return 50 }
            point := Map.WorldMapViewPositionFor(focus,settling.world_width,props)
            camera := Map.WorldMapViewCameraViewport(props,viewport)
            y := point.y - cast(float32)settling.scroll_offset
            if y < 48.0 || y + 28.0 > camera.height { print("settled focus outside camera: orientation=% scenario=% y=% camera=%\n",orientation,scenario,y,camera.height); return 51 }
            for idle: cast(s32)0..4 { Map.WorldMapViewUpdateFraming(*settling,props,viewport) }
            if settling.scroll_x != revealed.scroll_x || settling.scroll_offset != revealed.scroll_offset || settling.focused != focus { return 52 }
        }
        // Garden fork 18 (arms 19-23 / 24-27, merge 28) and cave fork 63
        // (arms 64-70 / 71-72, merge 73), both through the right arm.
        state := Map.WorldMapViewState.{.focused = 18}
        state.wheel_branch[0] = 2
        state.wheel_branch[1] = 2
        distance: float32
        for index: cast(s32)0..Route.WORLD_MAP_EDGE_COUNT - 1 {
            edge := Route.WorldMapEdgeAt(index)
            if (edge.from_level == 18 && edge.to_level == 24) ||
                (edge.from_level >= 24 && edge.from_level <= 62) ||
                (edge.from_level == 63 && edge.to_level == 71) ||
                (edge.from_level >= 71 && edge.from_level <= 96) {
                distance += Map.WorldMapViewRailLength(index,240.0,props.landscape)
            }
            if edge.from_level == 97 { distance += Map.WorldMapViewRailLength(index,240.0,props.landscape) * 0.25 }
        }
        unused Map.WorldMapViewWheelMove(*state,props,240.0,Vector2.{},distance)
        // This is a single genuine distance traversal through two fork/merge
        // boundaries. Its selected board remains far behind the camera.
        if state.focused != 18 || Map.WorldMapViewCameraPlace(state) != 97 { return 46 }
        width := Map.WorldMapViewFramingWidth(props,Map.WorldMapViewCameraPlace(state),viewport)
        if width != Map.WorldMapViewFramingWidth(props,1,viewport) { return 47 }
    }
    {
        ratings: [4]s32 = .[-1, 0, 2, 99]
        props := Map.WorldMapViewProps.{.stars = ratings[:]}
        if Map.WorldMapViewStars(props,0) != 0 || Map.WorldMapViewStars(props,1) != 0 ||
            Map.WorldMapViewStars(props,3) != 2 || Map.WorldMapViewStars(props,4) != 3 || Map.WorldMapViewStars(props,5) != 0 { return 30 }
        buffer_a: [32]u8; buffer_b: [32]u8; buffer_c: [32]u8
        a := Map.WorldMapViewDisplayName(19,props,buffer_a[:])
        b := Map.WorldMapViewDisplayName(24,props,buffer_b[:])
        c := Map.WorldMapViewDisplayName(1003,props,buffer_c[:])
        if a != "19-A1" || b != "19-B1" || c != "21-S" { return 31 }
    }
    for size: cast(s32)0..1 {
        viewport := ifx size == 0 then Rectangle.{0.0, 0.0, 390.0, 844.0} else Rectangle.{0.0, 0.0, 960.0, 600.0}
        width := Map.WorldMapViewWidth(viewport.width)
        for frontier: cast(s32)1..175 {
            visible: [1003]bool; available: [1003]bool
            for place: cast(s32)1..175 { visible[place - 1] = true }
            for place: cast(s32)1..frontier { available[place - 1] = true }
            props := Map.WorldMapViewProps.{.visible = visible[:], .available = available[:], .landscape = size == 1}
            expected := frontier + 3
            if expected > 175 { expected = 175 }
            if Map.WorldMapViewPublicLast(props) != expected { return 1 }
            extent := Map.WorldMapViewCameraBounds(props, width, viewport.height, viewport.width)
            if extent.width < viewport.width - 1.0 || extent.height < viewport.height - 1.0 { return 2 }
            // Portrait reaches both ends of the painting; landscape reaches
            // exactly the camera range that centers the outermost targets.
            art := Map.WorldMapViewArtBounds(width, size == 1)
            if size == 0 && (extent.x > art.x + 0.5 || extent.x + extent.width < art.x + art.width - 0.5 ||
                extent.y > art.y + 0.5 || extent.y + extent.height < art.y + art.height - 0.5) { return 14 }
            if size == 1 {
                left := Map.WorldMapViewPositionFor(1,width,props).x
                right := left
                for place: cast(s32)2..175 {
                    point := Map.WorldMapViewPositionFor(place,width,props)
                    if point.x < left { left = point.x }
                    if point.x > right { right = point.x }
                }
                final := Map.WorldMapViewPositionFor(175,width,props)
                if final.x < left { left = final.x }
                if final.x > right { right = final.x }
                expected_margin := viewport.width * 0.5
                left_gap := left - extent.x
                right_gap := extent.x + extent.width - right
                if left_gap < expected_margin - 1.0 || left_gap > expected_margin + 1.0 ||
                    right_gap < expected_margin - 1.0 || right_gap > expected_margin + 1.0 {
                    print("landscape extent targets=%,% bounds=%,%,%,% gaps=%,% expected=%\n",left,right,extent.x,extent.y,extent.width,extent.height,left_gap,right_gap,expected_margin)
                    return 15
                }
            }
            for place: cast(s32)1..175 {
                if !Map.WorldMapViewBrowsable(props, place) { continue }
                point := Map.WorldMapViewPositionFor(place,width,props)
                if point.x - 28.0 < extent.x || point.x + 28.0 > extent.x + extent.width || point.y - 64.0 < extent.y || point.y + 28.0 > extent.y + extent.height { print("extent failure place=% orientation=% point=%,% bounds=%,%,%,%\n",place,size,point.x,point.y,extent.x,extent.y,extent.width,extent.height); return 12 }
            }
            state := Map.WorldMapViewState.{.focused = frontier}
            state.scroll_x = -999999; state.scroll_offset = 999999
            Map.WorldMapViewClampCamera(*state, extent, viewport, width, props)
            if state.focused != frontier || state.scroll_x < cast(s32)extent.x || state.scroll_offset > cast(s32)(extent.y + extent.height - Map.WorldMapViewCameraViewport(props,viewport).height) + 1 { return 13 }
            Map.WorldMapViewReveal(*state, props, width, viewport)
            point := Map.WorldMapViewPositionFor(frontier,width,props)
            x := point.x - cast(float32)state.scroll_x; y := point.y - cast(float32)state.scroll_offset
            camera := Map.WorldMapViewCameraViewport(props,viewport)
            if x < 28.0 || x > viewport.width - 28.0 || y < 64.0 || y > camera.height - 28.0 { return 3 }
        }
    }
    {
        visible: [1003]bool; available: [1003]bool
        for place: cast(s32)1..175 { visible[place - 1] = true; available[place - 1] = true }
        props := Map.WorldMapViewProps.{.visible = visible[:],.available = available[:],.landscape = true}
        viewport_widths: [2]float32 = .[640.0, 1280.0]
        for viewport_width: viewport_widths {
            viewport := Rectangle.{0.0,0.0,viewport_width,600.0}
            width := Map.WorldMapViewWidth(viewport.width)
            extent := Map.WorldMapViewCameraBounds(props,width,viewport.height,viewport.width)
            first := Map.WorldMapViewPositionFor(1,width,props)
            last := Map.WorldMapViewPositionFor(175,width,props)
            state := Map.WorldMapViewState.{.focused = 1}
            state.scroll_x = -999999
            Map.WorldMapViewClampCamera(*state,extent,viewport,width,props)
            if first.x - cast(float32)state.scroll_x < viewport.width * 0.5 - 1.0 ||
                first.x - cast(float32)state.scroll_x > viewport.width * 0.5 + 1.0 { return 84 }
            state.scroll_x = 999999
            Map.WorldMapViewClampCamera(*state,extent,viewport,width,props)
            if last.x - cast(float32)state.scroll_x < viewport.width * 0.5 - 1.0 ||
                last.x - cast(float32)state.scroll_x > viewport.width * 0.5 + 1.0 { return 85 }

            // The last edge must keep moving on the first reverse notch,
            // including after the endpoint absorbed a large overscroll.
            far := Map.WorldMapViewState.{.focused = 175}
            Map.WorldMapViewReveal(*far,props,width,viewport)
            unused Map.WorldMapViewWheelMove(*far,props,width,last,100000.0)
            Map.WorldMapViewApplyPast(*far,extent,viewport,width,props)
            unused Map.WorldMapViewWheelMove(*far,props,width,last,-50.0)
            rail := Map.WorldMapViewRailPoint(*far,props,width)
            framed := Map.WorldMapViewFramePoint(props,rail,width,viewport,175)
            if framed.x != rail.x || framed.y != rail.y || Map.WorldMapViewRouteDistance(rail,last) < 1.0 { return 90 }
            props.key_pressed = 269
            state = Map.WorldMapViewState.{.focused = 1}
            if Map.WorldMapViewKeyboard(*state,props,width,viewport.height).focused != 175 || !state.reveal { return 86 }
            Map.WorldMapViewReveal(*state,props,width,viewport)
            if state.focused != 175 || state.reveal { return 87 }
            props.key_pressed = 268
            unused Map.WorldMapViewKeyboard(*state,props,width,viewport.height)
            if state.focused != 1 || !state.reveal { return 88 }
            Map.WorldMapViewReveal(*state,props,width,viewport)
            if state.focused != 1 || state.reveal { return 89 }
        }
    }
    {
        visible: [1003]bool; available: [1003]bool
        for place: cast(s32)1..175 { visible[place - 1] = true; available[place - 1] = true }
        props := Map.WorldMapViewProps.{.visible = visible[:], .available = available[:]}
        state := Map.WorldMapViewState.{.focused = 1}
        if Map.WorldMapViewSelect(*state,props,2).activated != 0 || state.focused != 2 { return 4 }
        props.key_pressed = 32
        if Map.WorldMapViewKeyboard(*state,props,390.0,844.0).activated != 2 { return 5 }
        for orientation: cast(s32)0..1 {
            props.landscape = orientation == 1
            a := Map.WorldMapViewPositionFor(2,390.0,props)
            b := Map.WorldMapViewPositionFor(3,390.0,props)
            center := Vector2.{(a.x + b.x) * 0.5, (a.y + b.y) * 0.5}
            route_state := Map.WorldMapViewState.{.focused = 2}
            moved := Map.WorldMapViewWheelMove(*route_state,props,390.0,center,20.0)
            back := Map.WorldMapViewWheelMove(*route_state,props,390.0,center,-20.0)
            if moved.x * moved.x + moved.y * moved.y < 100.0 || moved.x + back.x > 0.01 || moved.x + back.x < -0.01 ||
                moved.y + back.y > 0.01 || moved.y + back.y < -0.01 || route_state.focused != 2 { return 18 }
            // Perpendicular drag cannot leave the current rail. Along-road
            // drag advances it, and reversing retraces the same segment.
            route_state = Map.WorldMapViewState.{.focused = 2, .wheel_edge = 2, .wheel_t = 0.5}
            tangent_a := Map.WorldMapViewRailSample(1, 0.495, 390.0, props.landscape)
            tangent_b := Map.WorldMapViewRailSample(1, 0.505, 390.0, props.landscape)
            dx := tangent_b.x - tangent_a.x; dy := tangent_b.y - tangent_a.y
            length := Map.WorldMapViewRouteDistance(tangent_a, tangent_b)
            sideways := Map.WorldMapViewRailDrag(*route_state,props,390.0,center,Vector2.{-dy * 20.0 / length, dx * 20.0 / length})
            if sideways.x * sideways.x + sideways.y * sideways.y > 0.01 { return 22 }
            along := Map.WorldMapViewRailDrag(*route_state,props,390.0,center,Vector2.{-dx * 20.0 / length, -dy * 20.0 / length})
            // Reverse along the tangent at the new point.
            tangent_a = Map.WorldMapViewRailSample(1, route_state.wheel_t - 0.005, 390.0, props.landscape)
            tangent_b = Map.WorldMapViewRailSample(1, route_state.wheel_t + 0.005, 390.0, props.landscape)
            dx = tangent_b.x - tangent_a.x; dy = tangent_b.y - tangent_a.y
            length = Map.WorldMapViewRouteDistance(tangent_a, tangent_b)
            back = Map.WorldMapViewRailDrag(*route_state,props,390.0,center,Vector2.{dx * 20.0 / length, dy * 20.0 / length})
            if along.x * along.x + along.y * along.y < 1.0 || along.x + back.x > 0.01 || along.x + back.x < -0.01 ||
                along.y + back.y > 0.01 || along.y + back.y < -0.01 || route_state.focused != 2 { return 23 }
            // Start on the incoming edge and select the right arm. Traversing
            // forward and back must remember that arm without changing focus.
            incoming: s32
            for edge_index: cast(s32)0..Route.WORLD_MAP_EDGE_COUNT - 1 {
                edge := Route.WorldMapEdgeAt(edge_index)
                if edge.from_level == 17 && edge.to_level == 18 { incoming = edge_index + 1 }
            }
            route_state = Map.WorldMapViewState.{.focused = 24, .wheel_edge = incoming, .wheel_t = 0.5}
            // Cross the fork entry: the rest of the incoming rail and a short way along an arm.
            across := Map.WorldMapViewRailLength(incoming - 1,390.0,props.landscape) * 0.5 + 40.0
            moved = Map.WorldMapViewWheelMove(*route_state,props,390.0,center,across)
            if route_state.wheel_branch[0] != 2 || route_state.focused != 24 { return 20 }
            back = Map.WorldMapViewWheelMove(*route_state,props,390.0,center,-across)
            if moved.x + back.x > 0.01 || moved.x + back.x < -0.01 || moved.y + back.y > 0.01 || moved.y + back.y < -0.01 { return 21 }
            for index: cast(s32)0..Route.WORLD_MAP_EDGE_COUNT - 1 {
                edge := Route.WorldMapEdgeAt(index)
                from := Map.WorldMapViewPositionFor(edge.from_level, 390.0, props)
                to := Map.WorldMapViewPositionFor(edge.to_level, 390.0, props)
                rail_from := Map.WorldMapViewRailSample(index, 0.0, 390.0, props.landscape)
                rail_to := Map.WorldMapViewRailSample(index, 1.0, 390.0, props.landscape)
                if Map.WorldMapViewRouteDistance(from, rail_from) > 0.1 || Map.WorldMapViewRouteDistance(to, rail_to) > 0.1 { return 24 }
            }
            for index: cast(s32)0..Route.WORLD_MAP_FORK_COUNT - 1 {
                fork := Route.WorldMapForkAt(index)
                viewport_for_fork := ifx orientation == 0 then Rectangle.{0.0,0.0,390.0,844.0} else Rectangle.{0.0,0.0,960.0,600.0}
                framing_width := Map.WorldMapViewFramingWidth(props,fork.entry,viewport_for_fork)
                if framing_width < 390.0 * Map.WorldMapViewNativeScale(props,viewport_for_fork) / Layout.WorldMapWorldZoom - 0.01 || framing_width >= 390.0 || Map.WorldMapViewFramingWidth(props,1,viewport_for_fork) != framing_width { return 39 }
                framed := Map.WorldMapViewState.{.focused = fork.entry}
                Map.WorldMapViewReveal(*framed,props,framing_width,viewport_for_fork)
                // The merged painting has wider forks. When a fork group
                // exceeds the viewport, selecting either arm must reveal it.
                for place: cast(s32)0..1 {
                    node := ifx place == 0 then fork.left else fork.right
                    framed.focused = node
                    Map.WorldMapViewReveal(*framed,props,framing_width,viewport_for_fork)
                    point := Map.WorldMapViewPositionFor(node,framing_width,props)
                    x := point.x - cast(float32)framed.scroll_x
                    y := point.y - cast(float32)framed.scroll_offset
                    camera := Map.WorldMapViewCameraViewport(props,viewport_for_fork)
                    if x < 0.0 || x > viewport_for_fork.width || y < 0.0 || y > camera.height { print("fork center outside viewport: orientation=% node=% x=% y=% camera=%\n",orientation,node,x,y,camera.height); return 40 }
                }
                // A reverse notch retraces authored distance even when the
                // forward notch entered an area with a different zoom cap.
                for side: cast(s32)-1..1 {
                    if side == 0 { continue }
                    moving := Map.WorldMapViewState.{.focused = fork.entry}
                    original := Map.WorldMapViewPositionFor(fork.entry,390.0,props)
                    unused Map.WorldMapViewWheelMove(*moving,props,framing_width,original,
                        Map.WorldMapViewWheelDistance(framing_width,1.0),side)
                    next_width := Map.WorldMapViewFramingWidth(props,Map.WorldMapViewCameraPlace(moving),viewport_for_fork)
                    unused Map.WorldMapViewWheelMove(*moving,props,next_width,original,
                        Map.WorldMapViewWheelDistance(next_width,-1.0),-side)
                    if moving.focused != fork.entry || Map.WorldMapViewRouteDistance(original,
                        Map.WorldMapViewRailPoint(*moving,props,390.0)) > 0.02 { return 48 }
                }
                // Real pointer halves choose physical arms in either composition.
                viewport := Rectangle.{17.0, 0.0, 390.0, 844.0}
                if Map.WorldMapViewPointerSide(viewport, 18.0) != -1 ||
                    Map.WorldMapViewPointerSide(viewport, 406.0) != 1 { return 33 }
