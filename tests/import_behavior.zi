// The import tool: level files written back byte for byte, proven levels
// merged in place or after the story, and anything unproven refused.
#import "std/file"
#import "std/json_scan"
#import "std/text_buffer"
#import, file "../src/editor/edit.zi";
#import, file "../src/editor/sharing.zi";
#import, file "../tools/levels/edits.zi";

export_bytes: [200000]u8;
classic_bytes: [IMPORT_FILE]u8;
merged_bytes: [IMPORT_FILE]u8;
level: EditLevel;

Count :: (text: string) -> s32 { return ArrayCount(text, FieldAt(text, 0, "levels")) }

Level :: (text: string, number: s32) -> s32 { return ElementAt(text, FieldAt(text, 0, "levels"), number - 1) }

Row :: (text: string, number: s32, field: string, row: s32) -> string {
    span := ReadString(text, ElementAt(text, FieldAt(text, Level(text, number), field), row))
    return ifx span.valid then text[span.start:span.end] else ""
}

RoundTrip :: (classic: string) -> s32 {
    if !StoredRead(*stored, classic) { return 10 }
    writer := EditWriter.{.bytes = classic_bytes[:]}
    StoredWrite(*writer, *stored, classic)
    if writer.full || TextView(classic_bytes[0:writer.length]) != classic { return 11 }
    return 0
}

// An export as the editor writes it, with a route for its board.
Export :: (route: string) -> string {
    writer := EditWriter.{.bytes = export_bytes[:]}
    EditExportBegin(*writer)
    summary := EditSummary.{.id = 1, .from = 2}
    EditSetName(*summary, "Copy")
    level.board = EditNewBoard()
    unused EditSetRoute(*level, route)
    EditExportLevel(*writer, *summary, *level, true, "")
    summary.from = 0
    EditSetName(*summary, "Made fresh")
    unused EditPaint(*level.board, 9, 30)
    EditExportLevel(*writer, *summary, *level, false, "")
    EditExportEnd(*writer)
    return TextView(export_bytes[0:writer.length])
}

#program_export
Check :: () -> s32 {
    classic, classic_found := ReadEntireFile("levels/classic.json")
    if !classic_found { return 1 }
    result := RoundTrip(classic)
    if result != 0 { return result }
    classics := Count(classic)
    // Two levels: one replaces story level 2, one is new.
    out := EditWriter.{.bytes = merged_bytes[:]}
    if !ImportEdits(Export("33333333333"), classic, false, *out) { return 20 }
    merged := TextView(merged_bytes[0:out.length])
    fresh := EditNewBoard()
    if Count(merged) != classics + 1 || Row(merged, 2, "cells", 5) != EditBoardRow(*fresh, 0, 5) { return 21 }
    // The new level comes after the last, which keeps its board.
    if Row(merged, classics + 1, "cells", 1) != EditBoardRow(*fresh, 0, 1) ||
    Row(merged, classics, "cells", 3) != Row(classic, classics, "cells", 3) { return 22 }
    // Written to a copy, the file reads back as it was merged.
    if !CreateDirectory("build/import-test") && !DirectoryExists("build/import-test") { return 26 }
    if !WriteEntireFile("build/import-test/classic.json", merged) { return 27 }
    again, found := ReadEntireFile("build/import-test/classic.json")
    if !found || again != merged || !StoredRead(*stored, again) || stored.count != classics + 1 { return 28 }
    // --append adds the copy after the story too.
    out = EditWriter.{.bytes = merged_bytes[:]}
    if !ImportEdits(Export("33333333333"), classic, true, *out) ||
    Count(TextView(merged_bytes[0:out.length])) != classics + 2 { return 29 }
    // A route that does not win, or a text that is no export, imports nothing.
    if ImportEdits(Export("3333333333"), classic, false, *out) ||
    ImportError() != "level 1: its route does not win" { return 30 }
    if ImportEdits("{\"format\":\"other\",\"levels\":[]}", classic, false, *out) { return 31 }
    // A shared collection is added after the story.
    writer := EditWriter.{.bytes = export_bytes[:]}
    SharingDocumentBegin(*writer, "Shared")
    level.board = EditNewBoard()
    unused EditSetRoute(*level, "33333333333")
    SharingDocumentLevel(*writer, "Shared courtyard", *level, true)
    SharingDocumentEnd(*writer)
    out = EditWriter.{.bytes = merged_bytes[:]}
    if !ImportEdits(TextView(export_bytes[0:writer.length]), classic, false, *out) { return 32 }
    if Count(TextView(merged_bytes[0:out.length])) != classics + 1 { return 33 }
    return 0
}
