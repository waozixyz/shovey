// Render the production composition with real retained widgets and fake services.
ShopUI :: #import, file "../src/shop_view.zi";
Engine :: #import, file "../src/engine.zi";
Board :: #import, file "../src/shovey_board.zi";
Wardrobe :: #import, file "../src/shop_state.zi";
Daily :: #import, file "../src/daily_chest.zi";
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_draw"
#import "kryon/tree_input"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "std/c_string"
#import "std/text_buffer"
#import "std/vec"
using FrameStatus;

names: [8][256]u8;
values: [8][1024]u8;
count: s32;
missing: bool;
route: string;
purchases: s32;
navigation_backs: s32;
profile_request: [32]u8;
dew_reply: string = "{\"units\":12000000}";
account :: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
#program_export
FakeService :: (name: string, request: string) -> string {
    if name == "arcade.progress-storage" {
        if request == "ready" { return "ready" }
        if request == "flush" { return "flushed" }
        if request == "missing" { return ifx missing then "missing" else "present" }
    }
    if name == "entity.records" { return "{\"status\":\"done\",\"game_progress\":\"account-v1\",\"account\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}" }
    if name == "entity.game-shop" {
        if request != "status" { purchases += 1 }
        return "{\"status\":\"done\",\"owner\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"connected\":true,\"shovey_owned\":0,\"shovey_coins\":500}"
    }
    if name == "entity.dew" { return dew_reply }
    if name == "entity.profile" { unused CopyCString(request, profile_request[:]); return "opened" }
    if name == "arcade.navigation" && request == "back" { navigation_backs += 1; return "queued" }
    return ""
}
#program_export
FakeRecord :: (name: string) -> string {
    missing = true
    if name == "shop.request" { return route }
    for slot: cast(s32)0..count - 1 {
        if TextUntilNul(names[slot][:]) == name { missing = false; return TextUntilNul(values[slot][:]) }
    }
    return ""
}
#program_export
FakeSave :: (name: string, text: string) -> bool {
    if name == "shop.request" { route = text; return true }
    slot := count
    for index: cast(s32)0..count - 1 { if TextUntilNul(names[index][:]) == name { slot = index } }
    if slot >= 8 { return false }
    if slot == count { count += 1 }
    unused CopyCString(name, names[slot][:]); unused CopyCString(text, values[slot][:])
    return true
}
#program_export
FakeLocale :: (key: string) -> string { return TestLocale(key) }
#program_export
FakeSupports :: (name: string) -> bool { return false }

Draw :: (session: Session, width: float32, height: float32, today: s64 = 20000) -> bool {
    area := Rectangle.{0.0, 0.0, width, height}
    BeginFrame(session, cast(u64)1, area)
    if !ShopUI.Frame(session, area, 10.0, today) { return false }
    return EndFrame(session) == cast(FrameStatus)FrameOk
}
Find :: (session: Session, key: u64) -> s32 {
    for at: cast(s32)0..TreeCount(session) - 1 { if TreeNodeAt(session, at).key == key { return at } }
    return -1
}
Click :: (session: Session, key: u64) -> bool {
    at := Find(session, key)
    return at >= 0 && TreeActivateAt(session, at)
}
Bounds :: (session: Session, width: float32) -> bool {
    for at: cast(s32)0..TreeCount(session) - 1 {
        node := TreeNodeAt(session, at)
        if node.bounds.width < 0.0 || node.bounds.height < 0.0 || node.bounds.x < -0.1 || node.bounds.x + node.bounds.width > width + 0.1 { return false }
    }
    return true
}
// Consume the event, then render the state it selected. Back may close
// the page on the first frame, in which case there is no second shop frame.
Activate :: (session: Session, key: u64, width: float32, height: float32, today: s64 = 20000) -> bool {
    if !Click(session, key) || !Draw(session, width, height, today) { return false }
    return !ShopUI.IsOpen() || Draw(session, width, height, today)
}
#program_export
Check :: () -> s32 {
    session := SessionOpen()
    if ShopUI.IsOpen() || ShopUI.Back() { return 1 }
    route = "shop"; ShopUI.Request()
    if !ShopUI.IsOpen() || route != "" || purchases != 0 { return 2 }
    if !Draw(session, 320.0, 568.0) || !Bounds(session, 320.0) { return 3 }
    if !Activate(session, 61301, 320.0, 568.0) { return 4 }
    // Opening, cancelling and backing out never invoke checkout.
    if !Activate(session, 62426, 320.0, 568.0) || purchases != 0 || Find(session, 61610) < 0 { return 5 }
    if !Activate(session, 61611, 320.0, 568.0) || purchases != 0 || ShopUI.confirm != 0 { return 6 }
    if !Activate(session, 62426, 320.0, 568.0) || !ShopUI.Back() || !ShopUI.IsOpen() || ShopUI.confirm != 0 { return 7 }
    if !Draw(session, 320.0, 568.0) || !Activate(session, 62426, 320.0, 568.0) { return 8 }
    if !Activate(session, 61610, 320.0, 568.0) || purchases != 1 { return 9 }
    if !Activate(session, 61300, 900.0, 500.0) || !Bounds(session, 900.0) { return 10 }
    // Coin skins debit only after confirmation, then can be selected.
    if !Activate(session, 62026, 900.0, 500.0) || Wardrobe.ShopAvailable(1) { return 11 }
    if !Activate(session, 61610, 900.0, 500.0) || !Wardrobe.ShopAvailable(1) || Wardrobe.ShopSkin() != 1 || Wardrobe.ShopCoins() != 400 { return 12 }
    // Both facings and charged variants follow the selected skin, while
    // the tools keep their default until the game explicitly supplies one.
    Board.BoardSetSkin(Wardrobe.ShopSkin())
    Board.BoardSkinPrepare()
    if Board.SpriteFile(Board.SPRITE_PLAYER) != "assets/shovey/sprites/skin-1-player-left.png" ||
        Board.landscape_sprite_files[Board.SPRITE_CHARGED + 3] != "assets/shovey-landscape/sprites/skin-1-charged-down.png" { return 23 }
    board: Engine.ShoveyGame
    Board.BoardCacheKeep(*board, false)
    if !Board.BoardCacheCurrent(*board, false) { return 24 }
    Board.BoardSetSkin(2); Board.BoardSkinPrepare()
    if Board.BoardCacheCurrent(*board, false) { return 25 }
    if !Activate(session, 61302, 320.0, 568.0) || !Activate(session, 62502, 320.0, 568.0) || TextUntilNul(profile_request[:]) != "dew" { return 13 }
    if !Activate(session, 61104, 320.0, 568.0) || TextUntilNul(profile_request[:]) != "open" { return 14 }
    if !Activate(session, 61106, 320.0, 568.0) || TextUntilNul(profile_request[:]) != "leaderboard" { return 15 }
    if !ShopUI.Back() || ShopUI.IsOpen() { return 16 }
    if navigation_backs != 1 { return 27 }
    route = "chest"; ShopUI.Request()
    if !Draw(session, 320.0, 568.0, -1) || Daily.DailyChestReady(-1) { return 26 }
    if !Draw(session, 320.0, 568.0) || !Bounds(session, 320.0) || !Daily.DailyChestReady(20000) { return 17 }
    for day: cast(s32)1..7 { if Find(session, cast(u64)(63100 + day * 10)) < 0 { return 18 } }
    if !Activate(session, 63002, 320.0, 568.0) || Daily.DailyChestReady(20000) || Wardrobe.ShopCoins() != 420 { return 19 }
    if !Draw(session, 900.0, 500.0) || !Bounds(session, 900.0) || Daily.DailyChestClaim(20000) { return 20 }
    if !Draw(session, 320.0, 568.0, 20002) || Daily.DailyChestDay(20002) != 1 { return 21 }
    if !Activate(session, 61101, 320.0, 568.0, 20002) || ShopUI.IsOpen() { return 22 }
    if navigation_backs != 2 { return 28 }
    // A direct in-game page closes without leaving the game, while each
    // host-requested route pops its opener after nested Dew, Profile and
    // Leaderboard pages.
    ShopUI.Open(1)
    ShopUI.tab = 0
    if !Draw(session, 320.0, 568.0, 20002) { return 29 }
    if !ShopUI.Back() || ShopUI.IsOpen() || navigation_backs != 2 { return 32 }
    route = "shop"; ShopUI.Request()
    if !Draw(session, 320.0, 568.0, 20002) { return 33 }
    if !Activate(session, 61302, 320.0, 568.0, 20002) || !Activate(session, 62502, 320.0, 568.0, 20002) ||
        TextUntilNul(profile_request[:]) != "dew" { return 34 }
    if !Activate(session, 61101, 320.0, 568.0, 20002) || ShopUI.IsOpen() || navigation_backs != 3 { return 35 }
    route = "chest"; ShopUI.Request()
    if !Draw(session, 320.0, 568.0, 20002) { return 36 }
    if !Activate(session, 61104, 320.0, 568.0, 20002) || TextUntilNul(profile_request[:]) != "open" { return 37 }
    if !Activate(session, 61101, 320.0, 568.0, 20002) || ShopUI.IsOpen() || navigation_backs != 4 { return 38 }
    route = "chest"; ShopUI.Request()
    if !Draw(session, 320.0, 568.0, 20002) { return 39 }
    if !Activate(session, 61106, 320.0, 568.0, 20002) || TextUntilNul(profile_request[:]) != "leaderboard" { return 40 }
    if !Activate(session, 61101, 320.0, 568.0, 20002) || ShopUI.IsOpen() || navigation_backs != 5 { return 41 }
    // The shared browser cover uses a vertical Market/Chest pair and live
    // balances, and never retains a previously returned Dew amount.
    for width: cast(s32)0..1 {
        screen: float32 = ifx width == 0 then 320.0 else 900.0
        BeginFrame(session, cast(u64)1, Rectangle.{0.0, 0.0, screen, 640.0})
        ShopUI.CoverActions(session, Rectangle.{12.0, 12.0, screen - 128.0, 104.0})
        if EndFrame(session) != cast(FrameStatus)FrameOk || !Bounds(session, screen) { return 43 }
        market := TreeNodeAt(session, Find(session, 61000)).bounds
        chest := TreeNodeAt(session, Find(session, 61002)).bounds
        if chest.x != market.x || chest.y < market.y + market.height { return 44 }
        if Find(session, 61005) < 0 || Find(session, 61007) < 0 { return 45 }
    }
    if ShopUI.DewText() != "12" { return 46 }
    dew_reply = "{\"units\":-1}"
    if ShopUI.DewText() != "…" { return 47 }
    dew_reply = "{\"units\":0}"
    if ShopUI.DewText() != "0" { return 48 }
    unused SessionClose(session)
    return 42
}

// One explicit host binds package and local effects consistently.
#program_export
AppServiceHost :: (name: string, request: string) -> string { return FakeService(name, request) }
#program_export
AppSupportsHost :: (name: string) -> bool { return false }
#program_export
AppLocaleHost :: (key: string) -> string { return FakeLocale(key) }
#program_export
AppRecordHost :: (name: string) -> string { return FakeRecord(name) }
#program_export
SaveAppRecordHost :: (name: string, text: string) -> bool { return FakeSave(name, text) }

#if #defined(SHOVEY_SHOP_FIXTURE) {
    Pixmap :: #import "kryon/pixmap";
    #program_export "ShopTestMeasureGlyphWidth"
    MeasureGlyphWidth :: (value: string, font: s32, typeface: string) -> s32 { return Pixmap.MeasureGlyphWidth(value, font, typeface) }
    #program_export "ShopTestMeasureGlyphLineHeight"
    MeasureGlyphLineHeight :: (font: s32, typeface: string) -> s32 { return Pixmap.MeasureGlyphLineHeight(font, typeface) }
    #program_export "ShopTestImageWidth"
    ImageWidth :: (asset_path: string) -> s32 { return Pixmap.ImageWidth(asset_path) }
    #program_export "ShopTestImageHeight"
    ImageHeight :: (asset_path: string) -> s32 { return Pixmap.ImageHeight(asset_path) }
    #program_export "ShopTestRasterText"
    RasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) { Pixmap.RasterText(value, x, y, font, color) }
    #program_export "ShopTestRasterTextClipped"
    RasterTextClipped :: (value: string, x: s32, y: s32, font: s32, color: Color, clip: Rectangle) { Pixmap.RasterTextClipped(value, x, y, font, color, clip) }
    #program_export "ShopTestRasterTextRotated"
    RasterTextRotated :: (value: string, x: s32, y: s32, font: s32, color: Color,
        clip: Rectangle, origin: Vector2, rotation: float32, outer_clip: Rectangle,
