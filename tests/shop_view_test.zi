        Pixmap.RasterTextRotated(value, x, y, font, color, clip, origin, rotation,
            outer_clip, outer_clipped, emphasis, italic)
    }
    #program_export "ShopTestRasterRoundedRectangle"
    RasterRoundedRectangle :: (bounds: Rectangle, radius: float32, segments: s32, color: Color) { Pixmap.RasterRoundedRectangle(bounds, radius, segments, color) }
    #program_export "ShopTestRasterRoundedRectangleOutline"
    RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32, segments: s32, width: float32, color: Color) { Pixmap.RasterRoundedRectangleOutline(bounds, radius, segments, width, color) }
    #program_export "ShopTestRasterLine"
    RasterLine :: (line: Rectangle, color: Color) { Pixmap.RasterLine(line, color) }
    #program_export "ShopTestRasterImage"
    RasterImage :: (asset_path: string, texture_id: u32, source: Rectangle, destination: Rectangle, clip: Rectangle, origin: Vector2, rotation: float32, radius: float32, tint: Color) { Pixmap.RasterImage(asset_path, texture_id, source, destination, clip, origin, rotation, radius, tint) }
    #program_export "ShopTestRasterImageMesh"
    RasterImageMesh :: (asset_path: string, texture_id: u32, source: Rectangle, points: []Vector2, columns: s32, rows: s32, clip: Rectangle, tint: Color) { Pixmap.RasterImageMesh(asset_path, texture_id, source, points, columns, rows, clip, tint) }
    #program_export "ShopTestRasterTriangles"
    RasterTriangles :: (points: []Vector2, color: Color) { Pixmap.RasterTriangles(points, color) }
} else {

