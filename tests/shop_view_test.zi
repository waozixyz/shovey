#program_export
ImageWidth :: (asset_path: string) -> s32 { return 32 }

#program_export
ImageHeight :: (asset_path: string) -> s32 { return 32 }

#program_export
RasterText :: (value: string, x: s32, y: s32, font: s32, color: Color) {  }

#program_export
RasterTextClipped :: (value: string, x: s32, y: s32, font: s32, color: Color, clip: Rectangle) {  }

#program_export
RasterTextRotated :: (value: string, x: s32, y: s32, font: s32, color: Color,
    clip: Rectangle, origin: Vector2, rotation: float32, outer_clip: Rectangle,
    outer_clipped: bool, emphasis: bool, italic: bool) {}

#program_export
RasterRoundedRectangle :: (bounds: Rectangle, radius: float32, segments: s32, color: Color) {  }

#program_export
RasterRoundedRectangleOutline :: (bounds: Rectangle, radius: float32, segments: s32, width: float32, color: Color) {  }

#program_export
RasterLine :: (line: Rectangle, color: Color) {  }

#program_export
RasterImage :: (asset_path: string, texture_id: u32, source: Rectangle, destination: Rectangle, clip: Rectangle, origin: Vector2, rotation: float32, radius: float32, tint: Color) {  }

#program_export
RasterImageMesh :: (asset_path: string, texture_id: u32, source: Rectangle, points: []Vector2, columns: s32, rows: s32, clip: Rectangle, tint: Color) {  }

#program_export
RasterTriangles :: (points: []Vector2, color: Color) {  }
}

#if #defined(SHOVEY_SHOP_FIXTURE) {
    PNG :: #import "std/png_linux";
    Img :: #import "std/image";
    #import "std/file"
    english: string;
    fixture_art: [1048576]u32;
    fixture_art_count: s64;
    fixture_surface: [230400]u32;
    TestLocale :: (key: string) -> string {
        for at: cast(s64)0..english.count - key.count - 4 {
            if english[at] != #char "[" { continue }
            same := true
            for index: cast(s64)0..key.count - 1 { if english[at + index + 1] != key[index] { same = false; break } }
            start := at + key.count + 3
            if !same || english[at + key.count + 1] != #char "]" { continue }
            end := start
            while end < english.count && english[end] != #char "\n" { end += 1 }
            return english[start:end]
        }
        return key
    }
    FixtureSave :: (path: string) -> bool {
        image := Img.NewImage(320, 720)
        for at: cast(s64)0..230399 {
            pixel := fixture_surface[at]
            image.pixels[at * 4] = cast(u8)(pixel >> 16)
            image.pixels[at * 4 + 1] = cast(u8)(pixel >> 8)
            image.pixels[at * 4 + 2] = cast(u8)pixel
            image.pixels[at * 4 + 3] = 255
        }
        saved := PNG.WritePNGFile(path, *image)
        VecFree(image.pixels)
        return saved
    }
    #program_export
    Fixture :: () -> s32 {
        document, ok := ReadEntireFile("src/locales/en.txt")
        if !ok { return 1 }
        english = document
        paths: [15]string = .["assets/shovey/shop/stall.png", "assets/shovey/shop/chest-open.png",
            "assets/shovey/shop/chest-closed.png", "assets/shovey/shop/coins.png", "assets/shovey/shop/dew.png",
            "assets/shovey/shop/profile.png", "assets/shovey/shop/trophy.png", "", "", "", "", "", "", "", ""]
        starts: [15]s64
        widths: [15]s32
        heights: [15]s32
        for id: cast(s32)0..7 { paths[id + 7] = Wardrobe.ShopSkinPath(id) }
        // Load all owned bytes before the rasterizer borrows any image spans.
        for slot: cast(s32)0..14 {
            image := PNG.ReadPNGFile(paths[slot])
            if !Img.ImageValid(*image) { return 2 }
            starts[slot] = fixture_art_count; widths[slot] = image.width; heights[slot] = image.height
            for at: cast(s64)0..cast(s64)image.width * image.height - 1 {
                red := cast(u32)image.pixels[at * 4]
                green := cast(u32)image.pixels[at * 4 + 1]
                blue := cast(u32)image.pixels[at * 4 + 2]
                alpha := cast(u32)image.pixels[at * 4 + 3]
                if fixture_art_count >= fixture_art.count { return 2 }
                fixture_art[fixture_art_count] = (alpha << 24) | (red << 16) | (green << 8) | blue
                fixture_art_count += 1
            }
            VecFree(image.pixels)
        }
        for slot: cast(s32)0..14 {
            if !Pixmap.PixmapSetImage(slot, paths[slot], widths[slot], heights[slot],
                fixture_art[starts[slot]:starts[slot] + cast(s64)widths[slot] * heights[slot]]) { return 3 }
        }
        session := SessionOpen()
        ShopUI.Open(1)
        unused Pixmap.PixmapBeginInto(cast(u32)0xff2a2e2d, 320, 720, fixture_surface[:])
        if !Draw(session, 320.0, 720.0) || !FixtureSave("work/shop-view-test/shop.png") { return 4 }
        // A fresh retained tree ensures a full picture after clearing pixels.
        unused SessionClose(session)
        session = SessionOpen()
        ShopUI.Open(2)
        unused Pixmap.PixmapBeginInto(cast(u32)0xff2a2e2d, 320, 720, fixture_surface[:])
        if !Draw(session, 320.0, 720.0) || !FixtureSave("work/shop-view-test/chest.png") { return 5 }
        Pixmap.PixmapEndInto()
        Pixmap.PixmapCloseWorkers()
        unused SessionClose(session)
        return 42
    }
} else {
    TestLocale :: (key: string) -> string { return key }
}
