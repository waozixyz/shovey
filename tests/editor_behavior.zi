// The editor's rules apart from drawing: painting, one Shovey, undo, the
// records custom levels live in, proof by play and by the Ziran solver, the
// export, and shared collections.
#import "std/json_scan"
#import "std/text_buffer"
#import, file "../src/engine.zi";
#import, file "../src/progress.zi";
#import, file "../src/levels.zi";
#import, file "../src/editor/edit.zi";
#import, file "../src/editor/sharing.zi";
#import, file "../src/solver/solver.zi";
#import, file "../src/solver/classic_rules.zi";
#import, file "fixtures/classic_solver.zi";

play: EditPlay;
level: EditLevel;
other: EditLevel;
catalog: EditCatalog;
restored: EditCatalog;
history: EditHistory;
text_bytes: [300000]u8;
request_bytes: [300000]u8;
document: SharingDocument;
metas: [4]SharingMeta;

Count :: (board: *EditBoard, kind: u8) -> s32 {
    count: s32 = 0
    for at: cast(s32)0..EDIT_CELLS - 1 {
        if board.ground[at] == kind { count += 1 }
    }
    return count
}

// Shovey is always exactly one; painting him moves him, nothing paints over
// him, and Classic's wall ring stays.
LayerChecks :: () -> s32 {
    board := EditNewBoard()
    for index: cast(s32)0..EditPieceCount() - 1 {
        if EditPieceKind(index) == SHOVEY_BOAT { return 177 }
    }
    if EditPaint(*board, SHOVEY_BOAT, 50) { return 178 }
    unused EditPaint(*board, 9, 50)
    if !EditPaint(*board, EDIT_TILE_BRUSH + 77, 50) || board.ground[50] != 9 || board.tiles[50] != 77 { return 150 }
    history: EditHistory
    EditRemember(*history, *board)
    if !EditPaint(*board, EDIT_TILE_BRUSH + 78, 50) || board.ground[50] != 9 { return 151 }
    if !EditUndo(*history, *board) || board.tiles[50] != 77 || board.ground[50] != 9 { return 152 }
    if !EditPaint(*board, 0, 50) || board.tiles[50] != 77 { return 153 }
    home: s32 = 186
    if !EditPaint(*board, EDIT_TILE_BRUSH + 78, home) || board.ground[home] != 7 { return 154 }
    if !EditPaint(*board, EDIT_DECO_BRUSH + 57, home) || board.ground[home] != 7 || board.tiles[home] != 78 { return 159 }
    copy: EditBoard
    if !EditBoardRead(*copy, EditBoardHex(*board)) || !EditSame(*copy, *board) { return 155 }
    game: ShoveyGame
    if !ShoveyLoadData(*game, 1, EditBoardHex(*board)) || game.tiles[home] != 78 || game.ground[home] != 7 { return 156 }
    restored: ShoveyGame
    if !ShoveyRestore(*restored, ShoveySave(*game)) || (restored.tiles[home] != 78 || restored.decorations[home] != 57) { return 157 }
    progress := ShoveyProgressNew()
    campaign: ShoveyProgress
    if !ShoveyCampaignRestore(*campaign, *restored, ShoveyCampaignSave(*progress, *game)) || (restored.tiles[home] != 78 || restored.decorations[home] != 57) { return 158 }
    wall := EditNewBoard()
    unused EditPaint(*wall, EDIT_TILE_BRUSH + 12, 50)
    unused EditPaint(*wall, 71, 50)
    if !ShoveyLoadData(*game, 1, EditBoardHex(*wall)) || game.ground[50] != SHOVEY_CRACKED_WALL || game.tiles[50] != 12 { return 160 }
    unused EditPaint(*wall, EDIT_TILE_BRUSH + 77, 50)
    if !ShoveyLoadData(*game, 1, EditBoardHex(*wall)) || game.ground[50] != SHOVEY_CRACKED_FLOOR || game.tiles[50] != 77 { return 161 }
    unused EditPaint(*wall, EDIT_TILE_BRUSH + 12, 50)
    if !EditPaint(*wall, 9, 50) || wall.tiles[50] != 0 || wall.ground[50] != 9 { return 162 }
    if !EditPaint(*wall, SHOVEY_FISH, 50) || wall.tiles[50] != 64 { return 163 }
    if EditPaint(*wall, EDIT_TILE_BRUSH + 77, 50) { return 164 }
    if !ShoveyLoadData(*game, 1, EditBoardHex(*wall)) || game.ground[50] != SHOVEY_FISH { return 165 }
    if !EditPaint(*wall, SHOVEY_CRAB, 50) || wall.tiles[50] != 0 || wall.ground[50] != SHOVEY_CRAB { return 166 }
    unused EditPaint(*wall, EDIT_DECO_BRUSH + 57, 50)
    if !EditPaint(*wall, EDIT_TILE_BRUSH + SHOVEY_PIT, 50) || wall.ground[50] != 0 || wall.decorations[50] != 0 || wall.tiles[50] != SHOVEY_PIT { return 167 }
    for material: cast(s32)99..103 {
        paving := EditNewBoard()
        unused EditPaint(*paving, EDIT_TILE_BRUSH + material, 55)
        unused EditPaint(*paving, EDIT_TILE_BRUSH + material, 56)
        unused EditPaint(*paving, 9, 56)
        if paving.tiles[56] != cast(u8)material || paving.ground[56] != 9 { return 168 }
        if !EditBoardRead(*copy, EditBoardHex(*paving)) || !EditSame(*copy, *paving) { return 169 }
        if !ShoveyLoadData(*game, 1, EditBoardHex(*paving)) || !ShoveyMove(*game, 2) || game.player != 55 { return 170 }
        if !ShoveyMove(*game, 2) || game.objects[57] != 9 || game.player != 56 { return 171 }
        if !ShoveyRestore(*restored, ShoveySave(*game)) || restored.tiles[56] != material || restored.objects[57] != 9 { return 172 }
        unused EditPaint(*paving, EDIT_TILE_BRUSH, 56)
        if paving.tiles[56] != 0 || paving.ground[56] != 9 { return 173 }
    }
    blocking: [2]s32 = .[SHOVEY_LANTERN, SHOVEY_BOULDER]
    walls: [10]s32 = .[12,14,95,96,97,98,127,128,129,130]
    for material: walls {
        fitted := EditNewBoard()
        unused EditPaint(*fitted, EDIT_TILE_BRUSH + material, 55)
        if !EditPaint(*fitted, SHOVEY_DOOR, 55) || fitted.tiles[55] != cast(u8)material { return 182 }
        if !ShoveyLoadData(*game, 1, EditBoardHex(*fitted)) || !ShoveyMove(*game, 2) || game.ground[55] != SHOVEY_DOOR_OPEN { return 183 }
        if game.tiles[55] != material || !ShoveyCanEnter(*game, 55, 9) { return 184 }
        if !ShoveyRestore(*restored, ShoveySave(*game)) || restored.tiles[55] != material || restored.ground[55] != SHOVEY_DOOR_OPEN { return 185 }
        if !EditBoardRead(*copy, EditBoardHex(*fitted)) || !EditSame(*copy, *fitted) { return 186 }
        unused EditPaint(*fitted, 9, 55)
        if fitted.tiles[55] != 0 { return 187 }
    }
    for color: cast(s32)0..3 {
        initial := EditNewBoard()
        kind := SHOVEY_OPEN_GATE + color
        if !EditPaint(*initial, kind, 55) || initial.ground[55] != cast(u8)kind { return 179 }
        if !EditBoardRead(*copy, EditBoardHex(*initial)) || !EditSame(*copy, *initial) { return 180 }
        if !ShoveyLoadData(*game, 1, EditBoardHex(*initial)) || !ShoveyGateOpen(*game, 55) { return 181 }
    }
    for obstacle: blocking {
        lit := EditNewBoard()
        unused EditPaint(*lit, EDIT_TILE_BRUSH + 77, 55)
        if !EditPaint(*lit, EDIT_DECO_BRUSH + obstacle, 55) || lit.tiles[55] != 77 { return 174 }
        if EditPaint(*lit, 9, 55) { return 175 }
        if !ShoveyLoadData(*game, 1, EditBoardHex(*lit)) || ShoveyMove(*game, 2) { return 176 }
        if !ShoveyRestore(*restored, ShoveySave(*game)) || restored.decorations[55] != obstacle { return 177 }
        unused EditPaint(*lit, EDIT_DECO_BRUSH, 55)
        unused EditPaint(*lit, 9, 55)
        unused EditPaint(*lit, EDIT_DECO_BRUSH + obstacle, 56)
        if !ShoveyLoadData(*game, 1, EditBoardHex(*lit)) || ShoveyMove(*game, 2) || game.objects[55] != 9 { return 178 }
    }
    return 0
}

PaintChecks :: () -> s32 {
    board := EditNewBoard()
    if EditShovey(*board) != 54 || Count(*board, 10) != 1 || Count(*board, 7) != 1 { return 10 }
    if !EditPaint(*board, 10, 30) || EditShovey(*board) != 30 || Count(*board, 10) != 1 || board.ground[54] != 0 { return 11 }
    if EditPaint(*board, 0, 30) || EditPaint(*board, 9, 30) || EditShovey(*board) != 30 { return 12 }
    if EditPaint(*board, 9, 0) || EditPaint(*board, 0, 239) || board.ground[0] != 12 { return 13 }
    if !EditPaint(*board, 9, 50) || board.ground[50] != 9 || EditPaint(*board, 9, 50) { return 14 }
    if EditPaint(*board, 22, 51) || EditPaint(*board, 42, 51) || EditPick(*board, 50) != 9 { return 15 }
    return 0
}

UndoChecks :: () -> s32 {
    board := EditNewBoard()
    first := board
    EditRemember(*history, *board)
    unused EditPaint(*board, 9, 50)
    unused EditPaint(*board, 9, 51)
    EditRemember(*history, *board)
    unused EditPaint(*board, 12, 52)
    if !EditUndo(*history, *board) || board.ground[52] != 0 || board.ground[51] != 9 { return 40 }
    if !EditUndo(*history, *board) || !EditSame(*board, *first) || EditUndo(*history, *board) { return 41 }
    return 0
}

RecordChecks :: () -> s32 {
    catalog = EditCatalog.{.next = 1}
    a := EditAdd(*catalog, 12, "Crates in a row")
    b := EditAdd(*catalog, 0, "Ünïcødé — 島")
    if a != 0 || b != 1 || catalog.levels[1].id != 2 || catalog.next != 3 { return 50 }
    catalog.levels[0].proof = EDIT_PROOF_SOLVER
    catalog.levels[1].proof = EDIT_PROOF_DOWNLOAD
    catalog.levels[1].completed = true
    EditSetAuthor(*catalog.levels[1], "ada_1")
    text := EditIndexText(*catalog)
    if text == "" || !EditIndexRead(*restored, text) || restored.count != 2 || restored.next != 3 { return 51 }
    if EditField(restored.levels[0].name[:], restored.levels[0].name_length) != "Crates in a row" || restored.levels[0].from != 12 ||
    restored.levels[0].proof != EDIT_PROOF_SOLVER || restored.levels[0].completed { return 52 }
    if EditField(restored.levels[1].name[:], restored.levels[1].name_length) != "Ünïcødé — 島" || EditField(restored.levels[1].author[:], restored.levels[1].author_length) != "ada_1" ||
    restored.levels[1].proof != EDIT_PROOF_DOWNLOAD || !restored.levels[1].completed { return 53 }
    // A malformed index leaves the catalog as it was.
    if EditIndexRead(*restored, "I1\nlevel x") || restored.count != 2 { return 54 }
    if !EditIndexRead(*restored, "") || restored.count != 0 { return 55 }
    EditRemove(*catalog, 0)
    if catalog.count != 1 || catalog.levels[0].id != 2 { return 56 }
    // Names stay one line and never end inside a character.
    EditSetName(*catalog.levels[0], "two\nlines")
    if EditField(catalog.levels[0].name[:], catalog.levels[0].name_length) != "two" { return 57 }
    long := "ééééééééééééééééééééééééééééééééééé"
    EditSetName(*catalog.levels[0], long)
    if catalog.levels[0].name_length != 64 { return 58 }
    if EditLevelRecord(12) != "classic-12" || EditIndexRecord() != "classic-levels" { return 59 }
    level.board = EditNewBoard()
    unused EditSetRoute(*level, "0123")
    if !EditLevelRead(*other, EditLevelText(*level)) || !EditSame(*other.board, *level.board) ||
    EditField(other.route[:], other.route_length) != "0123" { return 60 }
    if EditLevelRead(*other, "E1\nroute 0") { return 61 }
    return 0
}

// A win in play records the route that proves the board; undo takes moves
// back out of it, and the route replays to the same win.
PlayChecks :: () -> s32 {
    board := EditNewBoard()
    if !EditPlayStart(*play, *board) { return 70 }
    if !EditPlayAct(*play, 3) || !EditPlayAct(*play, 3) || play.route_length != 2 { return 71 }
    if !EditPlayUndo(*play) || play.route_length != 1 || play.classic.player != 66 { return 72 }
    for step: cast(s32)0..9 { unused EditPlayAct(*play, 3) }
    if !EditPlayProven(*play) || EditField(play.route[:], play.route_length) != "33333333333" { return 73 }
    at: s32 = 0
    if EditReplay(*play, *board, "33333333333", *at, 100) != 1 { return 74 }
    at = 0
    if EditReplay(*play, *board, "3333333333", *at, 100) != 0 { return 75 }
    at = 0
    if EditReplay(*play, *board, "333333333x", *at, 100) != 0 { return 76 }
    // A long replay waits for the next call.
    at = 0
    if EditReplay(*play, *board, "33333333333", *at, 3) != -1 || at != 3 { return 77 }
    if EditReplay(*play, *board, "33333333333", *at, 100) != 1 { return 78 }
    return 0
}

Solve :: (board: string, budget: s64) -> s32 {
    if !SolverStart(board) { return SOLVER_INVALID }
    spent: s64 = 0
    while SolverStatus() == SOLVER_RUNNING && spent < budget { SolverRun(5000); spent += 5000 }
    return SolverStatus()
}

// The solver's routes are the engine's own moves, replayed to a win before
// they count; a board without a way home can never be won.
SolverChecks :: () -> s32 {
    // A crate can become a bridge. The second water cell still blocks the
    // ball after the first push; neither static nor trail pruning may call it lost.
    water: [480]u8
    digits := "0123456789abcdef"
    for cell: cast(s32)0..SHOVEY_CELLS - 1 {
        water[cell * 2] = cast(u8)48
        water[cell * 2 + 1] = cast(u8)99
    }
    row: [8]s32 = .[10, 9, 64, 9, 64, 1, 4, 7]
    for x: cast(s32)0..7 {
        water[(61 + x) * 2] = digits[row[x] >> 4]
        water[(61 + x) * 2 + 1] = digits[row[x] & 15]
    }
    for trail: cast(s32)0..1 {
        if !SolveClassicLoad(TextView(water[:])) { return 173 }
        if trail != 0 { solve_classic_game.powers = SHOVEY_TRAIL }
        for step: cast(s32)0..6 {
            if SolveClassicDead() || !SolveClassicAct(2) { return 174 }
        }
        if !solve_classic_game.won || solve_classic_game.ground[63] != SHOVEY_FLOATING_CRATE ||
        solve_classic_game.ground[65] != SHOVEY_FLOATING_CRATE { return 175 }
    }
    if Solve(TextView(water[:]), 2000000) != SOLVER_WON { return 176 }
    board := EditNewBoard()
    if Solve(EditBoardHex(*board), 2000000) != SOLVER_WON { return 90 }
    at: s32 = 0
    if EditReplay(*play, *board, SolverRoute(), *at, 100000) != 1 { return 91 }
    // Walled in: every reachable state is seen and none wins.
    unused EditPaint(*board, 12, 53)
    unused EditPaint(*board, 12, 55)
    unused EditPaint(*board, 12, 42)
    unused EditPaint(*board, 12, 66)
    if Solve(EditBoardHex(*board), 2000000) != SOLVER_NEVER || SolverRoute() != "" { return 92 }
    for index: cast(s32)0..1 {
        story: EditBoard
        if !EditBoardRead(*story, ClassicSolverFixture(index)) { return 93 }
        if Solve(EditBoardHex(*story), 4000000) != SOLVER_WON { return 94 + index }
        at = 0
        if EditReplay(*play, *story, SolverRoute(), *at, 100000) != 1 { return 98 }
    }
    if SolverStart("0c0c") || SolverStatus() != SOLVER_INVALID { return 100 }
    return 0
}

ExportChecks :: () -> s32 {
    writer := EditWriter.{.bytes = text_bytes[:]}
    summary := EditSummary.{.id = 3, .from = 12}
    EditSetName(*summary, "My \"best\" level")
    level.board = EditNewBoard()
    unused EditSetRoute(*level, "33333333333")
    EditExportBegin(*writer)
    EditExportLevel(*writer, *summary, *level, true, "")
    summary.from = 0
    EditExportLevel(*writer, *summary, *level, false, "")
    EditExportEnd(*writer)
    text := TextView(text_bytes[0:writer.length])
    list := FieldAt(text, 0, "levels")
    if writer.full || ArrayCount(text, list) != 2 { return 110 }
    first := ElementAt(text, list, 0)
    second := ElementAt(text, list, 1)
    number := ReadNumber(text, FieldAt(text, first, "number"))
    if !number.valid || number.value != 12.0 || FieldAt(text, second, "number") >= 0 { return 111 }
    if ArrayCount(text, FieldAt(text, first, "cells")) != 20 || ArrayCount(text, FieldAt(text, second, "cells")) != 20 { return 112 }
    name: [64]u8
    if SharingText(text, first, "name", name[:]) != 15 || TextView(name[0:15]) != "My \"best\" level" { return 113 }
    return 0
}

ShareChecks :: () -> s32 {
    {
        writer := EditWriter.{.bytes = text_bytes[:]}
        SharingDocumentBegin(*writer, "Weekend «puzzles»")
        level.board = EditNewBoard()
        unused EditSetRoute(*level, "33333333333")
        SharingDocumentLevel(*writer, "First", *level, true)
        unused EditSetRoute(*level, "2")
        SharingDocumentLevel(*writer, "Unproven", *level, false)
        SharingDocumentEnd(*writer)
        text := TextView(text_bytes[0:writer.length])
        if writer.full || !SharingDocumentRead(text, 0, *document) || document.count != 2 { return 120 }
        if TextView(document.title[0:document.title_length]) != "Weekend «puzzles»" { return 121 }
        name: [EDIT_NAME]u8
        name_length: s32
        if !SharingDocumentLevelRead(text, *document, 0, name[:], *name_length, *other) ||
        TextView(name[0:name_length]) != "First" || !EditSame(*other.board, *level.board) { return 122 }
        // The first route wins; the second does not, and is refused.
        at: s32 = 0
        if EditReplay(*play, *other.board, EditField(other.route[:], other.route_length), *at, 100000) != 1 { return 123 }
        if !SharingDocumentLevelRead(text, *document, 1, name[:], *name_length, *other) { return 124 }
        at = 0
        if EditReplay(*play, *other.board, EditField(other.route[:], other.route_length), *at, 100000) != 0 { return 125 }
        if SharingDocumentLevelRead(text, *document, 2, name[:], *name_length, *other) { return 126 }
        // Publishing embeds the collection as an object.
        request := EditWriter.{.bytes = request_bytes[:]}
        SharingPublishRequest(*request, "Weekend", SHARING_FRIENDS, text, "")
        sent := TextView(request_bytes[0:request.length])
        embedded := FieldAt(sent, 0, "document")
        if embedded < 0 || !SharingDocumentRead(sent, embedded, *document) || FieldAt(sent, 0, "id") >= 0 { return 127 }
        visibility: [16]u8
        if SharingText(sent, 0, "visibility", visibility[:]) != 7 || TextView(visibility[0:7]) != "friends" { return 128 }
    }
    // A collection of another format, edition or shape is refused.
    if SharingDocumentRead("{\"format\":\"other\",\"edition\":\"classic\",\"title\":\"x\",\"levels\":[]}", 0, *document) { return 129 }
    if SharingDocumentRead("{\"format\":\"shovey-levels-1\",\"edition\":\"space\",\"title\":\"x\",\"levels\":[]}", 0, *document) { return 130 }
    if !SharingDocumentRead("{\"format\":\"shovey-levels-1\",\"edition\":\"classic\",\"title\":\"x\",\"levels\":[{\"name\":\"a\",\"cells\":[\"00\"],\"route\":\"2\"}]}", 0, *document) { return 131 }
    name: [EDIT_NAME]u8
    name_length: s32
    if SharingDocumentLevelRead("{\"format\":\"shovey-levels-1\",\"edition\":\"classic\",\"title\":\"x\",\"levels\":[{\"name\":\"a\",\"cells\":[\"00\"],\"route\":\"2\"}]}", *document, 0, name[:], *name_length, *other) { return 132 }
    // Requests and replies.
    writer := EditWriter.{.bytes = request_bytes[:]}
    SharingFindRequest(*writer, "  @ada  ")
    if TextView(request_bytes[0:writer.length]) != "{\"operation\":\"find\",\"format\":\"shovey-levels-1\",\"query\":\"@ada\"}" { return 133 }
    writer = EditWriter.{.bytes = request_bytes[:]}
    SharingStatusRequest(*writer, 42)
    if TextView(request_bytes[0:writer.length]) != "{\"operation\":\"status\",\"request\":42}" { return 134 }
    writer = EditWriter.{.bytes = request_bytes[:]}
    SharingFetchRequest(*writer, "p-1")
    if TextView(request_bytes[0:writer.length]) != "{\"operation\":\"fetch\",\"id\":\"p-1\"}" { return 135 }
    writer = EditWriter.{.bytes = request_bytes[:]}
    SharingUnpublishRequest(*writer, "p-1")
    if TextView(request_bytes[0:writer.length]) != "{\"operation\":\"unpublish\",\"id\":\"p-1\"}" { return 136 }
    reply := SharingReplyRead("{\"status\":\"pending\",\"request\":7}")
    if reply.status != SHARING_PENDING || reply.request != 7 { return 137 }
    reply = SharingReplyRead("{\"status\":\"failed\",\"error\":\"signed-out\"}")
    if reply.status != SHARING_FAILED || EditField(reply.error[:], reply.error_length) != "signed-out" { return 138 }
    if SharingReplyRead("{\"status\":\"unavailable\"}").status != SHARING_UNAVAILABLE { return 139 }
    if SharingReplyRead("{\"status\":\"rejected\",\"error\":\"too big\"}").status != SHARING_REJECTED { return 140 }
    if SharingReplyRead("not json").status != SHARING_MALFORMED || SharingReplyRead("{\"status\":\"maybe\"}").status != SHARING_MALFORMED { return 141 }
    found := "{\"status\":\"done\",\"publications\":[{\"id\":\"p-1\",\"author\":{\"alias\":\"ada\",\"public_id\":\"ab12\"},\"format\":\"shovey-levels-1\",\"title\":\"Crates\",\"levels\":3,\"visibility\":\"friends\",\"updated_at\":1760000000,\"mine\":true},{\"id\":\"p-2\",\"author\":{\"alias\":\"bo\",\"public_id\":\"cd\"},\"format\":\"chess-1\",\"title\":\"x\",\"levels\":1,\"visibility\":\"public\",\"updated_at\":1,\"mine\":false}]}"
    if SharingReplyRead(found).status != SHARING_DONE || SharingFindRead(found, metas[:]) != 1 { return 142 }
    if EditField(metas[0].id[:], metas[0].id_length) != "p-1" || EditField(metas[0].alias[:], metas[0].alias_length) != "ada" || EditField(metas[0].title[:], metas[0].title_length) != "Crates" ||
    metas[0].levels != 3 || metas[0].visibility != SHARING_FRIENDS || !metas[0].mine || metas[0].updated_at != 1760000000 { return 143 }
    if SharingFindRead("{\"status\":\"done\"}", metas[:]) != -1 { return 144 }
    if !SharingPublicationRead("{\"status\":\"done\",\"publication\":{\"id\":\"p-9\",\"author\":{\"alias\":\"ada\",\"public_id\":\"ab\"},\"format\":\"shovey-levels-1\",\"title\":\"T\",\"levels\":1,\"visibility\":\"private\",\"updated_at\":5,\"mine\":true}}", *metas[1]) ||
    EditField(metas[1].id[:], metas[1].id_length) != "p-9" || metas[1].visibility != SHARING_PRIVATE { return 145 }
    return 0
}

#program_export
Check :: () -> s32 {
    checks: [8]s32 = .[LayerChecks(), PaintChecks(), UndoChecks(), RecordChecks(), PlayChecks(), ExportChecks(),
    ShareChecks(), SolverChecks()]
    for result: checks {
        if result != 0 { return result }
    }
    return 0
}
