#import, file "../src/rewards.zi";
#import "std/c_string"
#import "std/text_buffer"

// A host whose entity.dew service has no account at first, then one: the
// claim waits for the account, the node credits the chest once, and the
// record keeps what was answered across a relaunch.
signed_in: bool;
claimed: bool;
service_failed: bool;
malformed_answer: bool;
already_claimed: bool;
ineligible: bool;
claim_requests: s32;
record_rewards: [16]u8;
record_flags: [REWARD_COUNT * 2]bool;

#program_export
FakeService :: (name: string, request: string) -> string {
    if name != "entity.dew" { return "" }
    if request == "claim:shovey.secret-chest" {
        if !signed_in { return "{\"status\":\"signin\"}" }
        if service_failed { return "{\"status\":\"failed\"}" }
        claim_requests += 1
        claimed = true
        return "{\"status\":\"pending\"}"
    }
    if request == "claim-status" && claimed {
        if ineligible { return "{\"status\":\"ineligible\",\"reward\":\"shovey.secret-chest\"}" }
        if malformed_answer { return "{\"status\":\"done\",\"reward\":\"shovey.secret-chest\"}" }
        if already_claimed { return "{\"status\":\"done\",\"reward\":\"shovey.secret-chest\",\"credited\":false,\"units\":0,\"balance\":2000000}" }
        return "{\"status\":\"done\",\"reward\":\"shovey.secret-chest\",\"credited\":true,\"units\":2000000,\"balance\":2000000}"
    }
    return "{\"status\":\"failed\"}"
}

#program_export
FakeRecord :: (name: string) -> string {
    if name == "rewards" { return TextUntilNul(record_rewards[:]) }
    for reward: cast(s32)0..REWARD_COUNT - 1 {
        for flag: cast(s32)0..1 {
            if name == RewardFlagRecord(reward, flag == 1) {
                return ifx record_flags[reward * 2 + flag] then "1" else ""
            }
        }
    }
    return ""
}

#program_export
FakeSave :: (name: string, text: string) -> bool {
    if name == "rewards" { return CopyCString(text, record_rewards[:]) }
    for reward: cast(s32)0..REWARD_COUNT - 1 {
        for flag: cast(s32)0..1 {
            if name == RewardFlagRecord(reward, flag == 1) && text == "1" {
                record_flags[reward * 2 + flag] = true
                return true
            }
        }
    }
    return false
}

#program_export
Check :: () -> s32 {
    RewardEarn(REWARD_CHEST, 1.0)
    if TextUntilNul(record_rewards[:]) != "r1:10" { return 1 }
    RewardsPump(1.0)
    if reward_card != REWARD_CHEST || !reward_card_signin || claimed { return 2 }
    // Closing or revisiting an opened chest must not hide an unclaimed reward.
    reward_card = -1
    RewardOpen(REWARD_CHEST, 2.0)
    if reward_card != REWARD_CHEST || reward_card_empty || RewardClaimed(REWARD_CHEST) { return 10 }
    RewardsPump(2.0)
    if !reward_card_signin { return 11 }
    // The player connects an account; failure still leaves the reward pending.
    signed_in = true
    RewardsPump(3.0)
    if claimed { return 3 }
    service_failed = true
    RewardsPump(7.0)
    if RewardClaimed(REWARD_CHEST) || reward_state[REWARD_CHEST] != 1 { return 12 }
    service_failed = false
    reward_card = -1
    RewardOpen(REWARD_CHEST, 8.0)
    RewardsPump(8.0)
    if !claimed || reward_claiming != REWARD_CHEST { return 4 }
    malformed_answer = true
    RewardsPump(9.0)
    if RewardClaimed(REWARD_CHEST) || TextUntilNul(record_rewards[:]) != "r1:10" { return 13 }
    malformed_answer = false
    RewardRetry(REWARD_CHEST, 10.0)
    RewardsPump(10.0)
    RewardsPump(11.0)
    if reward_claiming != -1 || reward_state[REWARD_CHEST] != 2 { return 5 }
    if reward_card != REWARD_CHEST || reward_card_signin || TextUntilNul(reward_card_amount[:]) != "2" { return 6 }
    if TextUntilNul(record_rewards[:]) != "r1:20" { return 7 }
    requests := claim_requests
    RewardOpen(REWARD_CHEST, 20.0)
    RewardsPump(21.0)
    if !reward_card_empty || reward_card != REWARD_CHEST || claim_requests != requests { return 14 }
    // A relaunch reads the record and claims nothing again.
    reward_loaded = false
    reward_state[REWARD_CHEST] = 0
    claimed = false
    RewardOpen(REWARD_CHEST, 100.0)
    RewardsPump(100.0)
    if !RewardEarned(REWARD_CHEST) || reward_state[REWARD_CHEST] != 2 || claimed { return 8 }
    if !reward_card_empty || reward_card != REWARD_CHEST { return 15 }
    // The node may confirm that another device already claimed it: show empty.
    unused CopyCString("r1:10", record_rewards[:])
    record_flags = .{}
    reward_loaded = false
    reward_state = .{}
    already_claimed = true
    RewardOpen(REWARD_CHEST, 150.0)
    RewardsPump(150.0)
    RewardsPump(151.0)
    if !RewardClaimed(REWARD_CHEST) || !reward_card_empty || reward_card != REWARD_CHEST { return 16 }
    // Eligibility is a real rejection, not an unclaimed or credited result.
    unused CopyCString("r1:10", record_rewards[:])
    record_flags = .{}
    reward_loaded = false
    reward_state = .{}
    ineligible = true
    already_claimed = false
    RewardOpen(REWARD_CHEST, 160.0)
    RewardsPump(160.0)
    RewardsPump(161.0)
    if !reward_card_failed || !reward_card_ineligible || RewardClaimed(REWARD_CHEST) { return 17 }
    ineligible = false
    RewardRetry(REWARD_CHEST, 162.0)
    if reward_card_failed || reward_card_ineligible { return 18 }
    RewardsPump(162.0)
    RewardsPump(163.0)
    if !RewardClaimed(REWARD_CHEST) || reward_card_failed || reward_card_ineligible { return 19 }
    // Finishing the campaign without an account asks once, then waits.
    signed_in = false
    RewardEarn(REWARD_CAMPAIGN, 200.0)
    reward_card = -1
    RewardsPump(200.0)
    if reward_card != -1 || reward_state[REWARD_CAMPAIGN] != 1 { return 9 }
    // Another device's opening arrives after launch, without a local visit.
    record_rewards = .{}
    record_flags = .{}
    reward_state = .{}
    reward_loaded = false
    reward_card = -1
    RewardsPump(300.0)
    record_flags[REWARD_CHEST * 2] = true
    RewardsPump(302.0)
    if !RewardEarned(REWARD_CHEST) || RewardClaimed(REWARD_CHEST) { return 20 }
    // A stale r1 snapshot cannot close the opened chest, even on restart.
    unused CopyCString("r1:00", record_rewards[:])
    reward_state = .{}
    reward_loaded = false
    RewardsLoad()
    if !RewardEarned(REWARD_CHEST) || RewardClaimed(REWARD_CHEST) { return 21 }
    // A synced claim removes the reward without closing the chest.
    RewardOpen(REWARD_CHEST, 303.0)
    record_flags[REWARD_CHEST * 2 + 1] = true
    RewardsPump(304.0)
    if !RewardEarned(REWARD_CHEST) || !RewardClaimed(REWARD_CHEST) || !reward_card_empty { return 22 }
    // An older device's unclaimed save cannot undo that confirmed claim.
    unused CopyCString("r1:10", record_rewards[:])
    reward_state = .{}
    reward_loaded = false
    RewardsLoad()
    if !RewardEarned(REWARD_CHEST) || !RewardClaimed(REWARD_CHEST) { return 23 }
    return 42
}
