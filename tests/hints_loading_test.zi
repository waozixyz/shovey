#import, file "../src/engine.zi";
#import "std/text_buffer"
#import, file "../src/hints.zi";
#import, file "../src/player_loading.zi";
#import, file "../src/progress.zi";
#import, file "../src/levels.zi";
#import "std/c_string"

#program_export
main :: () -> s32 {
    if CollectionPicturePending(false, false) || !CollectionPicturePending(false, true) || CollectionPicturePending(true, true) { return 1 }
    state: CollectionLoading
    if !CollectionNeedsCover(*state, 1, 1, false, 100) { return 2 }
    if !CollectionNeedsCover(*state, 1, 1, false, 8099) { return 3 }
    if CollectionNeedsCover(*state, 1, 1, false, 8100) { return 4 }
    if !state.timed_out { return 14 }
    for generation: cast(s64)2..30 {
        if !CollectionNeedsCover(*state, 1, generation, true, 10000) || state.timed_out { return 5 }
        if !CollectionNeedsCover(*state, 1, generation, true, 10001) { return 6 }
        if CollectionNeedsCover(*state, 1, generation, true, 10002) { return 7 }
    }
    if CollectionNeedsCover(*state, 1, 30, false, 20000) || state.timed_out { return 15 }
    if CollectionNeedsCover(*state, 1, 30, false, 27999) || state.timed_out { return 16 }
    if CollectionNeedsCover(*state, 1, 30, false, 28000) || !state.timed_out { return 17 }
    if CollectionNeedsCover(*state, 1, 30, true, 28001) || state.timed_out { return 18 }
    for level: cast(s32)1..SHOVEY_APPROVED_LEVEL_COUNT {
        game: ShoveyGame
        if !ShoveyLoad(*game, level) { print("load failed %\n", level); return 8 }
        saved: [2433]u8
        unused CopyCString(ShoveySave(*game), saved[:])
        hint: LevelHint
        HintStart(*hint, *game)
        for at: 0..1000 { if hint.status != 1 { break }; HintStep(*hint) }
        if hint.status != 3 || hint.restart { print("hint failed % status %\n", level, hint.status); return 10 }
        restored: ShoveyGame
        if !ShoveyRestore(*restored, TextUntilNul(saved[:])) || !HintSame(*game, *restored) { print("restore failed %\n", level); return 9 }
        for action: hint.actions { if action != 0 { Step(*game, action) } }
        for at: cast(s64)hint.match + 3..hint.route.count - 1 { Step(*game, hint.route[at]) }
        if !game.won { print("advice failed %\n", level); return 13 }
    }
    // Reproduce idle fish movement before opening the in-app hint panel.
    for ticks: cast(s32)1..5 {
        idle: ShoveyGame
        unused ShoveyLoad(*idle, 1)
        for tick: 1..ticks { unused ShoveyAnimalsTick(*idle) }
        tip: LevelHint
        HintStart(*tip, *idle)
        for at: 0..1000 { if tip.status != 1 { break }; HintStep(*tip) }
        if tip.status != 3 || tip.restart || !tip.verifying { return 24 }
        for action: tip.actions { if action != 0 { Step(*idle, action) } }
        for at: cast(s64)tip.match + 3..tip.route.count - 1 { Step(*idle, tip.route[at]) }
        if !idle.won { return 25 }
    }
    for side: cast(s32)1..3 {
        secret: ShoveyGame
        if !ShoveyLoad(*secret, 1000 + side) { return 19 }
        tip: LevelHint
        HintStart(*tip, *secret)
        for at: 0..1000 { if tip.status != 1 { break }; HintStep(*tip) }
        if tip.status != 3 { print("secret hint unavailable %\n", side); return 20 }
    }
    drops: s32
    for level: cast(s32)1..SHOVEY_APPROVED_LEVEL_COUNT {
        cell := HintFloorCell(level)
        if cell < 0 { continue }
        drops += 1
        walk: ShoveyGame
        unused ShoveyLoad(*walk, level)
        reached := false
        route := ShoveyLevelSolution(level)
        for at: cast(s64)0..route.count - 1 {
            if at > 20 { break }
            Step(*walk, route[at])
            if walk.player == cell { reached = true; break }
        }
        if !reached || walk.lost || walk.won { return 21 }
    }
    if drops < 10 { return 22 }
    game: ShoveyGame
    unused ShoveyLoad(*game, 1)
    unused ShoveyMove(*game, 0)
    hint: LevelHint
    HintStart(*hint, *game)
    for at: 0..1000 { if hint.status != 1 { break }; HintStep(*hint) }
    if hint.status != 3 || hint.restart { return 11 }
    fallback := game
    fallback.level = 500
    free_tip: LevelHint
    HintStart(*free_tip, *fallback)
    if free_tip.status != 3 || free_tip.topic_count < 1 || free_tip.actions[0] != 0 { return 23 }
    game.lost = true
    HintStart(*hint, *game)
    for at: 0..1000 { if hint.status != 1 { break }; HintStep(*hint) }
    if hint.status != 3 || !hint.restart { return 12 }
    print("Local tests: all campaign levels load/restore and yield verified hints; missing and stalled pictures cannot trap the loading cover; 30 generations reopen.\n")
    return 0
}

Step :: (game: *ShoveyGame, action: u8) {
    if action == #char "t" { unused ShoveyTick(game) }
    else if action == #char "f" { unused ShoveyFire(game) }
    else { unused ShoveyMove(game, cast(s32)action - 48) }
}
