#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"
#import "std/c_string"
Progress :: #import "entity/game_progress";
#import, file "../src/shared_progress.zi";
Classic :: #import, file "../src/shared_campaign.zi";
ClassicGame :: #import, file "../src/engine.zi";
ClassicProgress :: #import, file "../src/progress.zi";

remote: Progress.GameProgressRecord;
remote_exists: bool;
synced: bool;
available: bool = true;
old_host: bool;
other_owner: bool;
retired: s32;
account_writes: s32;
account_calls: s32;
reply: string;

#program_export
FakeService :: (name: string, request: string) -> string {
    if name == "entity.records" { account_calls += 1 }
    if name != "entity.records" || !available { return "{\"status\":\"unavailable\"}" }
    if SharedProgressStatusField(request, "operation", "status") {
        if old_host { return "{\"status\":\"done\",\"account\":\"first\",\"sync\":\"synced\"}" }
        if other_owner { return "{\"status\":\"done\",\"game_progress\":\"account-v1\",\"account\":\"second\",\"sync\":\"synced\"}" }
        if synced { return "{\"status\":\"done\",\"game_progress\":\"account-v1\",\"account\":\"first\",\"sync\":\"synced\"}" }
        return "{\"status\":\"done\",\"game_progress\":\"account-v1\",\"account\":\"first\",\"sync\":\"pending\"}"
    }
    if SharedProgressStatusField(request, "operation", "put") {
        at := FieldAt(request, 0, "document")
        incoming: Progress.GameProgressRecord
        if !Progress.GameProgressRead(request[at:ValueEnd(request, at, 0)], *incoming) { return "{\"status\":\"rejected\"}" }
        if remote_exists { unused Progress.GameProgressMerge(*incoming, *remote) }
        remote = incoming
        remote_exists = true
        synced = false
        account_writes += 1
        return "{\"status\":\"done\"}"
    }
    if !remote_exists { return "{\"status\":\"missing\"}" }
    out: Vec(u8)
    BuilderPrint(*out, "{\"status\":\"done\",\"document\":")
    Progress.GameProgressWrite(*remote, *out)
    BuilderPrint(*out, "}")
    reply = BuilderFinish(out)
    return reply
}

#program_export
FakeRecord :: (name: string) -> string { unused name; return "" }
#program_export
FakeSave :: (name: string, text: string) -> bool {
    if (name == "campaign" || name == "position") && text == "" { retired += 1 }
    return true
}

#program_export
Check :: () -> s32 {
    game: ClassicGame.ShoveyGame
    unused ClassicGame.ShoveyLoad(*game, 1)
    local := ClassicProgress.ShoveyProgressNew()
    record := Classic.ShoveySharedRecord(*local)
    session: SharedProgressSession
    SharedProgressStart(*session, record, 0.0)
    // Opening a new game and moving do not create a network record.
    if account_writes != 0 { return 1 }
    for direction: cast(s32)0..3 {
        if ClassicGame.ShoveyMove(*game, direction) { break }
    }
    board: [8193]u8
    unused CopyCString(ClassicGame.ShoveySave(*game), board[:])
    startup_calls := account_calls
    for move: cast(s32)0..99 {
        record = Classic.ShoveySharedRecord(*local)
        if !SharedProgressSave(*session, *record, false) || account_writes != 0 ||
        account_calls != startup_calls { return 2 }
    }
    record.unlocked = 2
    if !SharedProgressSave(*session, *record, false) || session.record.unlocked != 1 || account_writes != 0 { return 10 }
    record.unlocked = 1
    // Playing crosses many polling intervals without calling the account
    // service at all. Even a pending completion waits until a safe boundary.
    calls := account_calls
    session.dirty = true
    for second: cast(s32)16..180 {
        if SharedProgressPump(*session, cast(float64)second, true) != 0 ||
        account_calls != calls || !session.dirty { return 11 }
    }
    session.dirty = false
    // Even a newer campaign from another device cannot move this player,
    // replace the board or advance the current level.
    remote = record
    remote.unlocked = 40
    remote.completed[0] = #char "1"
    remote.completed[1] = 0
    remote_exists = true
    if SharedProgressPump(*session, 16.0) != 1 { return 3 }
    Classic.ShoveySharedRestore(*local, *session.record)
    unused ClassicProgress.ShoveyOpenLatest(*local, *game)
    if local.unlocked != 40 || !local.completed[0] ||
    TextUntilNul(board[:]) != ClassicGame.ShoveySave(*game) || account_writes != 0 { return 4 }
    // A newly completed puzzle is the only normal save to the account.
    record.completed[1] = #char "1"
    record.completed[2] = 0
    if !SharedProgressSave(*session, *record, true) || account_writes != 1 || remote.unlocked != 40 { return 5 }
    synced = true
    unused SharedProgressPump(*session, 32.0)
    if retired != 2 { return 6 }
    // Reopening a saved puzzle with already-synced unlocks is read-only.
    reopened: SharedProgressSession
    SharedProgressStart(*reopened, session.record, 33.0)
    if account_writes != 1 || reopened.dirty { return 13 }
    other_owner = true
    record.completed[2] = #char "1"
    record.completed[3] = 0
    if SharedProgressSave(*session, *record, true) || account_writes != 1 { return 12 }
    if SharedProgressPump(*session, 48.0) != 2 || session.available || session.record.unlocked != 0 { return 7 }
    other_owner = false
    available = false
    SharedProgressStart(*session, record, 49.0)
    record.unlocked = 41
    if SharedProgressSave(*session, *record, true) { return 8 }
    available = true
    old_host = true
    SharedProgressStart(*session, record, 50.0)
    record.unlocked = 42
    if session.available || SharedProgressSave(*session, *record, true) { return 9 }
    return 42
}
