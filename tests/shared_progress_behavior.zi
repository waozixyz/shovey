#import "std/json_scan"
#import "std/text_buffer"
#import "std/vec"
#import "std/c_string"
Progress :: #import "entity/game_progress";
#import, file "../src/shared_progress.zi";
Classic :: #import, file "../src/shared_campaign.zi";
Game :: #import, file "../src/engine.zi";
Campaign :: #import, file "../src/progress.zi";
Controls :: #import, file "../src/controls.zi";

owner: string = "first";
remote: [3]Progress.GameProgressRecord;
exists: [3]bool;
slot: s32;
available: bool = true;
old_host: bool;
ready: bool = true;
flush: bool = true;
synced: bool = true;
local_save_allowed: bool = true;
account_calls: s32;
account_reads: s32;
account_writes: s32;
retired: s32;
missing: bool;
pending_put: bool;
pending_status: bool;
pending_read: bool;
read_fails: bool;
account_syncing: bool;
account_settled: bool;
revision: s64;
put_snapshot: Progress.GameProgressRecord;
reply: [32768]u8;
keys: [16][256]u8;
staged: [16][16384]u8;
durable: [16][16384]u8;
key_count: s32;

#program_export
FakeService :: (name: string, request: string) -> string {
    if name == "arcade.progress-storage" {
        if !ready { return "unavailable" }
        if request == "ready" { return "ready" }
        if request == "missing" { return ifx missing then "missing" else "present" }
        if request == "flush" {
            if !flush { return "failed" }
            durable = staged
            return "flushed"
        }
    }
    if name != "entity.records" { return "" }
    account_calls += 1
    if !available { return "{\"status\":\"unavailable\"}" }
    out: Vec(u8)
    if SharedProgressStatusField(request, "operation", "status") && FieldAt(request, 0, "request") < 0 {
        sync := "pending"
        if account_syncing { sync = "syncing" }
        else if account_settled || synced { sync = "synced" }
        BuilderPrint(*out, "{\"status\":\"done\",\"account\":\"%\",\"sync\":\"%\",\"revision\":%", owner, sync, revision)
        if !old_host { BuilderPrint(*out, ",\"game_progress\":\"account-v1\"") }
        BuilderPrint(*out, "}")
    } else if SharedProgressStatusField(request, "operation", "put") {
        account_writes += 1
        if !Progress.GameProgressReply(request, *put_snapshot) { return "{\"status\":\"rejected\"}" }
        if pending_put { pending_status = true; return "{\"status\":\"pending\",\"request\":7}" }
        remote[slot] = put_snapshot; exists[slot] = true
        synced = false
        return "{\"status\":\"done\"}"
    } else if pending_status && FieldAt(request, 0, "request") >= 0 {
        if pending_put { return "{\"status\":\"pending\",\"request\":7}" }
        pending_status = false
        remote[slot] = put_snapshot; exists[slot] = true
        return "{\"status\":\"done\",\"request\":7}"
    } else {
        account_reads += 1
        if pending_read { return "{\"status\":\"pending\",\"request\":9}" }
        if read_fails { return "{\"status\":\"unavailable\"}" }
        if !exists[slot] { return "{\"status\":\"missing\"}" }
        BuilderPrint(*out, "{\"status\":\"done\",\"document\":")
        Progress.GameProgressWrite(*remote[slot], *out)
        BuilderPrint(*out, "}")
    }
    unused CopyCString(TextView(VecSlice(out, 0, out.count)), reply[:])
    VecFree(out)
    return TextUntilNul(reply[:])
}
#program_export
FakeRecord :: (name: string) -> string {
    missing = true
    for index: cast(s32)0..key_count - 1 {
        if TextUntilNul(keys[index][:]) == name { missing = false; return TextUntilNul(staged[index][:]) }
    }
    return ""
}
#program_export
FakeSave :: (name: string, text: string) -> bool {
    if name == "local.campaign" { return local_save_allowed }
    if (name == "campaign" || name == "position") && text == "" { retired += 1; return true }
    for index: cast(s32)0..key_count - 1 {
        if TextUntilNul(keys[index][:]) == name { return CopyCString(text, staged[index][:]) }
    }
    if key_count >= 16 { return false }
    unused CopyCString(name, keys[key_count][:])
    unused CopyCString(text, staged[key_count][:])
    key_count += 1
    return true
}
Step :: (session: *SharedProgressSession, now: float64) {
    for frame: cast(s32)0..5 { unused SharedProgressPump(session, now + cast(float64)frame * 0.01) }
}
Pending :: (session: *SharedProgressSession) -> bool {
    value := session.record
    marker: bool
    return SharedProgressLoad(TextUntilNul(session.owner[:]), *value, *marker) && marker
}
#program_export
Check :: () -> s32 {
    local := Campaign.ShoveyProgressNew()
    local.unlocked = 40 // A local resume must never seed this account.
    record := Classic.ShoveySharedRecord(*local)
    game: Game.ShoveyGame
    unused Game.ShoveyLoad(*game, 1)
    for direction: cast(s32)0..3 { if Game.ShoveyMove(*game, direction) { break } }
    board: [8193]u8
    unused CopyCString(Game.ShoveySave(*game), board[:])
    session: SharedProgressSession
    ready = false
    SharedProgressStart(*session, record, 0.0)
    if session.bound || account_reads != 0 { return 1 }
    ready = true
    flush = false
    unused SharedProgressPump(*session, 1.0)
    if session.bound || account_reads != 0 { return 2 }
    flush = true
    Step(*session, 2.0)
    if !session.bound || session.record.unlocked != 1 || account_writes != 0 { return 3 }
    calls := account_calls
    for move: cast(s32)0..99 {
        if !SharedProgressSave(*session, 1, false) || SharedProgressPump(*session, 20.0 + cast(float64)move, true) != 0 { return 4 }
    }
    if account_calls != calls || account_writes != 0 || TextUntilNul(board[:]) != Game.ShoveySave(*game) { return 5 }
    remote[0] = session.record
    remote[0].unlocked = 40; remote[0].completed[0] = #char "1"; exists[0] = true
    if SharedProgressPump(*session, 30.0) != 1 { return 6 }
    Step(*session, 30.1)
    if session.record.unlocked != 40 || account_writes != 0 { return 7 }
    // Failed persistence suppresses upload and never reports a durable save.
    flush = false
    if SharedProgressSave(*session, 2, true) || session.client.result.durable || account_writes != 0 { return 8 }
    if SharedProgressSave(*session, 2, true) { return 27 }
    calls = account_calls
    unused SharedProgressPump(*session, 31.0, true)
    if account_calls != calls || session.client.result.durable { return 28 }
    // Start flushes staged data BEFORE a new client can call it durable.
    reopened: SharedProgressSession
    SharedProgressStart(*reopened, record, 31.0)
    if reopened.bound || account_writes != 0 { return 9 }
    flush = true
    Step(*reopened, 32.0)
    if !reopened.bound || reopened.record.completed[1] != #char "1" || account_writes != 1 || reopened.dirty { return 10 }
    // Hydration must precede that recovered put; the old remote level remains.
    if remote[0].unlocked != 40 || !reopened.client.result.durable || Pending(*reopened) { return 11 }
    if !SharedProgressSave(*reopened, 2, true) || account_writes != 1 { return 12 }
    // A provider's done reply is not a durable clear of the pending marker.
    unused SharedProgressSave(*reopened, 8, true)
    flush = false
    unused SharedProgressPump(*reopened, 33.0)
    if reopened.client.result.durable || SharedProgressSave(*reopened, 8, true) { return 29 }
    flush = true
    Step(*reopened, 34.0)
    if !reopened.client.result.durable || Pending(*reopened) { return 30 }
    // Dirtied during a pending put: acknowledgement must preserve the new win.
    pending_put = true
    unused SharedProgressSave(*reopened, 3, true)
    unused SharedProgressSave(*reopened, 4, true)
    if !Pending(*reopened) || !reopened.dirty { return 13 }
    pending_put = false
    Step(*reopened, 40.0)
    Step(*reopened, 42.0)
    if reopened.dirty || Pending(*reopened) || remote[0].completed[3] != #char "1" { return 14 }
    // Legacy cleanup needs both node sync and an independently saved local run.
    synced = true
    local_save_allowed = false
    unused Controls.SaveLocalCampaign("device-board")
    reopened.poll_at = 0.0
    unused SharedProgressPump(*reopened, 43.0)
    if retired != 0 || !reopened.retiring { return 15 }
    local_save_allowed = true
    unused Controls.SaveLocalCampaign("device-board")
    reopened.poll_at = 0.0
    unused SharedProgressPump(*reopened, 44.0)
    if retired != 2 { return 16 }
    // Same-owner Profile reset preserves the local board and earned save.
    SharedProgressStart(*reopened, record, 45.0)
    if reopened.record.completed[3] != #char "1" || TextUntilNul(board[:]) != Game.ShoveySave(*game) { return 17 }
    // A bound owner can retain an offline win without any upload, and the
    // pending marker survives a same-owner restart when the service returns.
    available = false
    writes := account_writes
    if SharedProgressSave(*reopened, 9, true) || account_writes != writes || !reopened.dirty { return 31 }
    available = true
    SharedProgressStart(*reopened, record, 45.5)
    Step(*reopened, 45.6)
    if reopened.dirty || reopened.record.completed[8] != #char "1" { return 32 }
    // A/B switch keeps an active A completion under A, never under B.
    owner = "second"; slot = 1
    writes = account_writes
    if SharedProgressSave(*reopened, 5, true) || account_writes != writes { return 18 }
    if SharedProgressPump(*reopened, 46.0) != 2 || reopened.available || reopened.record.unlocked != 0 { return 19 }
    SharedProgressStart(*reopened, record, 47.0)
    Step(*reopened, 47.1)
    if reopened.record.unlocked != 1 || account_writes != writes { return 20 }
    unused SharedProgressSave(*reopened, 1, true)
    Step(*reopened, 48.0)
    if remote[1].unlocked != 1 || TextUntilNul(remote[1].completed[:]) != "1" { return 21 }
    owner = ""; slot = 2
    SharedProgressStart(*reopened, record, 49.0)
    writes = account_writes; calls = account_reads
    unused SharedProgressSave(*reopened, 6, true)
    if account_writes != writes || account_reads != calls || !Pending(*reopened) { return 22 }
    SharedProgressStart(*reopened, record, 50.0)
    if reopened.record.unlocked != 1 { return 23 }
    owner = "first"; slot = 0
    SharedProgressStart(*reopened, record, 51.0)
    Step(*reopened, 51.1)
    if reopened.record.completed[4] != #char "1" || reopened.record.completed[5] == #char "1" { return 24 }
    // Unsupported/temporarily unavailable providers cannot acknowledge a win.
    available = false
    SharedProgressStart(*session, record, 52.0)
    if SharedProgressSave(*session, 40, true) { return 25 }
    available = true; old_host = true
    SharedProgressStart(*session, record, 53.0)
    if session.available || SharedProgressSave(*session, 41, true) { return 26 }
    // A signed-in read that has not finished, including the background
    // record sync after Entity's local cache answers "missing", shows
    // nothing; only Pip's tips wait for it, and never for long.
    available = true; old_host = false; account_syncing = false; account_settled = false; pending_status = false
    loading: SharedProgressSession
    pending_read = true
    SharedProgressStart(*loading, record, 35.0)
    if !SharedProgressAccountMerging(*loading) { return 33 }
    pending_read = false; account_settled = true
    loading.poll_at = 0.0
    Step(*loading, 36.5)
    if SharedProgressAccountMerging(*loading) || loading.record.unlocked != 40 { return 34 }
    exists[0] = false; account_settled = false
    SharedProgressStart(*loading, record, 37.0)
    if !SharedProgressAccountMerging(*loading) { return 35 }
    account_syncing = true
    loading.poll_at = 0.0
    unused SharedProgressPump(*loading, 37.5)
    if !SharedProgressAccountMerging(*loading) { return 36 }
    account_syncing = false; account_settled = true
    exists[0] = true
    loading.poll_at = 0.0
    unused SharedProgressPump(*loading, 38.0)
    if !SharedProgressAccountMerging(*loading) { return 37 }
    unused SharedProgressPump(*loading, 38.1)
    if loading.record.unlocked != 40 { return 41 }
    unused SharedProgressPump(*loading, 38.2)
    if SharedProgressAccountMerging(*loading) { return 43 }
    loading.now = 68.0
    account_syncing = true; account_settled = false
    loading.sync_pending = true
    if SharedProgressAccountMerging(*loading) { return 38 }
    failed: SharedProgressSession
    read_fails = true
    SharedProgressStart(*failed, record, 39.0)
    if SharedProgressAccountMerging(*failed) { return 39 }
    read_fails = false
    available = false
    offline: SharedProgressSession
    SharedProgressStart(*offline, record, 54.0)
    if SharedProgressAccountMerging(*offline) { return 40 }
    // Signed in, the device's copy of account progress plays at once while
    // the sync runs. A sync round that brings another device's progress
    // raises Entity's revision, and that progress merges within a few idle
    // frames, while the rest of the sync still runs, not after it settles.
    available = true; account_syncing = true; account_settled = false; exists[0] = true
    remote[0].unlocked = 40
    background: SharedProgressSession
    SharedProgressStart(*background, record, 70.0)
    if !background.client.result.hydrated || background.record.unlocked != 40 { return 44 }
    remote[0].unlocked = 45; revision += 1
    merged_at := -1.0
    for frame: cast(s32)1..30 {
        now := 71.0 + cast(float64)frame / 15.0
        if SharedProgressPump(*background, now) == 1 && background.record.unlocked == 45 { merged_at = now; break }
    }
    if merged_at < 0.0 || merged_at - 71.0 > 0.2 || !account_syncing { return 45 }
    // Another device's later progress also shows within a second of idle.
    account_syncing = false
    for frame: cast(s32)1..30 { unused SharedProgressPump(*background, 72.0 + cast(float64)frame / 15.0) }
    writes = account_writes
    remote[0].unlocked = 46; revision += 1
    merged_at = -1.0
    for frame: cast(s32)1..30 {
        now := 80.0 + cast(float64)frame / 15.0
        if SharedProgressPump(*background, now) == 1 && background.record.unlocked == 46 { merged_at = now; break }
    }
    if merged_at < 0.0 || merged_at - 80.0 > 1.1 || account_writes != writes { return 46 }
    // Results use synthetic private storage only; no profile/account reads.
    key_count = 0
    staged = .{}; durable = .{}
    flush = true; ready = true
    result_calls := account_calls
    if RecordLevelResult("shovey.classic", "first", 83, 123, 0, 10, true) ||
    RecordLevelResult("shovey.classic", "../bad", 83, 123, 10, 10, true) ||
    RecordLevelResult("shovey.classic", "first", 83, 123, 10, 10, false) { return 200 }
    if !RecordLevelResult("shovey.classic", "first", 83, 123, 15, 10, true) { return 201 }
    best := GetLevelResult("shovey.classic", "first", 83, 123, 10)
    if best.best_moves != 15 || best.stars != 2 || best.score != 666 { return 202 }
    if !RecordLevelResult("shovey.classic", "first", 83, 123, 20, 10, true) { return 203 }
    staged = durable
    if GetLevelResult("shovey.classic", "first", 83, 123, 10).best_moves != 15 { return 204 }
    if !RecordLevelResult("shovey.classic", "first", 83, 123, 9, 10, true) { return 205 }
    staged = durable
    if GetLevelResult("shovey.classic", "first", 83, 123, 10).score != 1000 { return 206 }
    if GetLevelResult("shovey.classic", "second", 83, 123, 10).stars != 0 ||
    GetLevelResult("shovey.classic", "", 83, 123, 10).stars != 0 ||
    GetLevelResult("shovey.editor", "first", 83, 123, 10).stars != 0 ||
    GetLevelResult("shovey.classic", "first", 84, 123, 10).stars != 0 ||
    GetLevelResult("shovey.classic", "first", 83, 124, 10).stars != 0 { return 207 }
    if !RecordLevelResult("shovey.classic", "second", 83, 123, 5, 0, true) { return 208 }
    if GetLevelResult("shovey.classic", "second", 83, 123, 0).stars != 1 ||
    GetLevelResult("shovey.classic", "second", 83, 123, 0).score != 0 { return 209 }
    flush = false
    if RecordLevelResult("shovey.classic", "first", 83, 123, 1, 10, true) { return 210 }
    flush = true; staged = durable
    if GetLevelResult("shovey.classic", "first", 83, 123, 10).best_moves != 9 || account_calls != result_calls { return 211 }
    result_key: [96]u8
    unused LevelResultKey("shovey.classic", "first", 83, result_key[:])
    unused FakeSave(TextUntilNul(result_key[:]), "{\"owner\":\"collision\",\"pack\":\"shovey.classic\",\"level\":83,\"board\":123,\"moves\":1}")
    if RecordLevelResult("shovey.classic", "first", 83, 123, 2, 10, true) ||
    GetLevelResult("shovey.classic", "first", 83, 123, 10).stars != 0 { return 212 }
    // Secrets have stable, separate IDs and tolerate missing pars.
    if !RecordLevelResult("shovey.classic", "first", 1003, 456, 4, 0, true) ||
    GetLevelResult("shovey.classic", "first", 1003, 456, 0).stars != 1 { return 213 }
    return 42
}
