// The quote, the one press that buys at the shown price, refusals and restore
// with fake shop answers only: no account, network or Dew is involved.
#import "island_unlock"
#import "std/text_buffer"
#import "std/vec"

ALICE :: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
BOB :: "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";

#program_export
FakeLocale :: (key: string) -> string {
    if key == "shovey_island_off" { return "40% off" }
    if key == "shovey_island_unlock" { return "Unlock" }
    return key
}

Answer :: (owner: string, connected: bool, owned: bool, price: s64, status: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "{\"owner\":\"%\",\"connected\":%,\"island_owned\":%,\"island_price_units\":%,\"island_regular_price_units\":85000000,\"island_discount_percent\":%,\"status\":\"%\"}",
        owner, connected, owned, price, ifx price == 51000000 then 40 else 0, status)
    return BuilderFinish(text)
}

// A signed-in owner taken as far as the node's sale quote.
Quoted :: (unlock: *IslandUnlock, price: s64) -> bool {
    unused IslandUnlockAnswer(unlock, Answer(ALICE, true, false, 0, "idle"), 0.0)
    if IslandUnlockNext(unlock, 0.0) != "refresh" { return false }
    if IslandUnlockAnswer(unlock, Answer(ALICE, true, false, 0, "pending"), 0.0) { return false }
    unused IslandUnlockAnswer(unlock, Answer(ALICE, true, false, 0, "done"), 0.0)
    if IslandUnlockNext(unlock, 0.0) != "shovey.island.quote" { return false }
    unused IslandUnlockAnswer(unlock, Answer(ALICE, true, false, 0, "pending"), 0.0)
    unused IslandUnlockAnswer(unlock, Answer(ALICE, true, false, price, "done"), 0.0)
    return unlock.stage == ISLAND_READY && unlock.price == price
}

Purchase :: () -> s32 {
    unlock: IslandUnlock
    // Nothing can be bought before a quote.
    if IslandUnlockBuy(*unlock) { return 1 }
    if !Quoted(*unlock, 51000000) { return 2 }
    if unlock.percent != 40 || unlock.regular != 85000000 { return 3 }
    if !IslandUnlockBuy(*unlock) { return 4 }
    // The confirmation names the exact quoted units, and only once.
    if IslandUnlockNext(*unlock, 1.0) != "shovey.island:51000000" { return 5 }
    if IslandUnlockBuy(*unlock) || IslandUnlockNext(*unlock, 1.0) != "" { return 6 }
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, false, 51000000, "pending"), 1.0)
    if unlock.owned { return 7 }
    // Only the ledger's verified answer unlocks.
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, true, 51000000, "done"), 1.0)
    if !unlock.owned || unlock.stage != ISLAND_IDLE { return 8 }
    if IslandUnlockNext(*unlock, 100.0) != "" { return 9 }
    return 0
}

Refusals :: () -> s32 {
    unlock: IslandUnlock
    if !Quoted(*unlock, 51000000) { return 1 }
    // A stale quote charges nothing and shows the new price first.
    unused IslandUnlockBuy(*unlock)
    unused IslandUnlockNext(*unlock, 1.0)
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, false, 0, "price_changed"), 1.0)
    if unlock.owned || unlock.notice != "shovey_island_changed" || unlock.price != 0 { return 2 }
    if IslandUnlockBuy(*unlock) { return 3 }
    if IslandUnlockNext(*unlock, 1.0) != "shovey.island.quote" { return 4 }
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, false, 85000000, "done"), 1.0)
    if unlock.price != 85000000 || unlock.percent != 0 { return 5 }
    // Not enough Dew leaves the quote ready for after a top-up, and asks
    // for the Dew page once.
    unused IslandUnlockBuy(*unlock)
    if IslandUnlockNext(*unlock, 2.0) != "shovey.island:85000000" { return 6 }
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, false, 85000000, "insufficient"), 2.0)
    if unlock.owned || unlock.notice != "shovey_island_insufficient" || unlock.stage != ISLAND_READY { return 7 }
    if IslandUnlockTakeAction(*unlock) != ISLAND_ACTION_BUY_DEW || IslandUnlockTakeAction(*unlock) != ISLAND_ACTION_NONE { return 9 }
    // A failed transfer stays locked and can be tried again.
    unused IslandUnlockBuy(*unlock)
    unused IslandUnlockNext(*unlock, 3.0)
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, false, 85000000, "failed"), 3.0)
    if unlock.owned || unlock.notice != "shovey_island_failed" { return 8 }
    return 0
}

Offline :: () -> s32 {
    unlock: IslandUnlock
    // Signed out: no quote, and the launch price is what the page shows.
    unused IslandUnlockAnswer(*unlock, Answer("", false, false, 0, "signin"), 0.0)
    if IslandUnlockNext(*unlock, 0.0) != "refresh" { return 1 }
    unused IslandUnlockAnswer(*unlock, Answer("", false, false, 0, "signin"), 0.0)
    if unlock.stage != ISLAND_IDLE || IslandUnlockNext(*unlock, 1.0) != "" { return 2 }
    if IslandUnlockNext(*unlock, 6.0) != "refresh" { return 3 }
    unused IslandUnlockAnswer(*unlock, Answer("", false, false, 0, "signin"), 6.0)
    price, regular, percent := IslandUnlockShown(*unlock)
    if price != 51000000 || regular != 85000000 || percent != 40 { return 4 }
    caption: [64]u8
    if IslandUnlockCaption(*unlock, caption[:]) != "51 Dew · 40% off" { return 5 }
    // Signed in with no connection: it retries slowly and blocks nothing.
    online: IslandUnlock
    unused IslandUnlockAnswer(*online, Answer(ALICE, true, false, 0, "idle"), 0.0)
    unused IslandUnlockNext(*online, 0.0)
    unused IslandUnlockAnswer(*online, Answer(ALICE, true, false, 0, "failed"), 0.0)
    if online.stage != ISLAND_IDLE || IslandUnlockNext(*online, 29.0) != "" { return 6 }
    if IslandUnlockNext(*online, 31.0) != "refresh" { return 7 }
    // The regular price shows without an offer once the node quotes it.
    regular_only: IslandUnlock
    if !Quoted(*regular_only, 85000000) { return 8 }
    if IslandUnlockCaption(*regular_only, caption[:]) != "85 Dew" { return 9 }
    return 0
}

Restore :: () -> s32 {
    bought: IslandUnlock
    if !IslandUnlockAnswer(*bought, Answer(ALICE, true, true, 0, "done"), 0.0) { return 1 }
    if !bought.owned || bought.saved { return 2 }
    name: [96]u8
    text: [192]u8
    if IslandUnlockRecordName(*bought, name[:]) != "island.v1.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" { return 3 }
    record := IslandUnlockRecord(*bought, text[:])
    // A restart offline: the same owner has it back with no answer from the node.
    restart: IslandUnlock
    if !IslandUnlockAnswer(*restart, Answer(ALICE, false, false, 0, "failed"), 0.0) { return 4 }
    IslandUnlockRestore(*restart, record)
    if !restart.owned || !restart.saved || !restart.remembered { return 5 }
    unused IslandUnlockAnswer(*restart, Answer(ALICE, false, false, 0, "failed"), 1.0)
    if !restart.owned { return 6 }
    // Another owner, or a guest, never reads it as theirs.
    other: IslandUnlock
    unused IslandUnlockAnswer(*other, Answer(BOB, true, false, 0, "idle"), 0.0)
    IslandUnlockRestore(*other, record)
    if other.owned { return 7 }
    guest: IslandUnlock
    IslandUnlockRestore(*guest, record)
    if guest.owned || IslandUnlockRecordName(*guest, name[:]) != "" { return 8 }
    // Malformed records stay locked.
    IslandUnlockRestore(*other, "{\"version\":2,\"owner\":\"bbbb\",\"owned\":true}")
    if other.owned { return 9 }
    // Leaving the account locks again and forgets the quote.
    if !IslandUnlockAnswer(*restart, Answer(BOB, true, false, 0, "idle"), 2.0) { return 10 }
    if restart.owned || restart.price != 0 { return 11 }
    // A guest answer cannot claim ownership.
    forged: IslandUnlock
    unused IslandUnlockAnswer(*forged, Answer("", false, true, 0, "done"), 0.0)
    if forged.owned { return 12 }
    return 0
}

Label :: (unlock: *IslandUnlock) -> string {
    return IslandUnlockLabel(unlock, label_text[:])
}
label_text: [128]u8;

// One press on the Unlock control buys at the price it showed, and nothing
// else does.
Press :: () -> s32 {
    // Signed out: the press asks for the sign-in page and buys nothing.
    guest: IslandUnlock
    unused IslandUnlockAnswer(*guest, Answer("", false, false, 0, "signin"), 0.0)
    if Label(*guest) != "Unlock · 51 Dew" || !IslandOffer(*guest) { return 1 }
    IslandUnlockPress(*guest, 0.0)
    if guest.wanted != 0 || IslandUnlockBusy(*guest) { return 2 }
    if IslandUnlockTakeAction(*guest) != ISLAND_ACTION_SIGN_IN || IslandUnlockTakeAction(*guest) != ISLAND_ACTION_NONE { return 3 }
    // With the node's quote the one press sends the exact confirmation.
    unlock: IslandUnlock
    if !Quoted(*unlock, 51000000) { return 4 }
    if Label(*unlock) != "Unlock · 51 Dew" { return 5 }
    IslandUnlockPress(*unlock, 1.0)
    if unlock.stage != ISLAND_CONFIRM_NEEDED || unlock.wanted != 51000000 { return 6 }
    // While it is under way the control says so, shows no offer and takes
    // no second press.
    if Label(*unlock) != "shovey_island_unlocking" || IslandOffer(*unlock) { return 7 }
    IslandUnlockPress(*unlock, 1.0)
    if IslandUnlockNext(*unlock, 1.0) != "shovey.island:51000000" { return 8 }
    IslandUnlockPress(*unlock, 1.0)
    if IslandUnlockNext(*unlock, 1.0) != "" || unlock.stage != ISLAND_CONFIRMING { return 9 }
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, true, 51000000, "done"), 2.0)
    if !unlock.owned || unlock.wanted != 0 || IslandUnlockTakeAction(*unlock) != ISLAND_ACTION_NONE { return 10 }
    // A press before the quote arrives waits for it, then buys at the
    // shown launch price once the node quotes exactly that.
    early: IslandUnlock
    unused IslandUnlockAnswer(*early, Answer(ALICE, true, false, 0, "idle"), 0.0)
    if IslandUnlockNext(*early, 0.0) != "refresh" { return 11 }
    IslandUnlockPress(*early, 0.0)
    if early.wanted != 51000000 || early.stage != ISLAND_SYNCING { return 12 }
    if Label(*early) != "shovey_island_unlocking" { return 13 }
    unused IslandUnlockAnswer(*early, Answer(ALICE, true, false, 0, "done"), 0.0)
    if IslandUnlockNext(*early, 0.0) != "shovey.island.quote" { return 14 }
    unused IslandUnlockAnswer(*early, Answer(ALICE, true, false, 51000000, "done"), 0.0)
    if early.stage != ISLAND_CONFIRM_NEEDED || IslandUnlockNext(*early, 0.0) != "shovey.island:51000000" { return 15 }
    // A quote other than the shown price is never charged by that press:
    // the new price shows and waits for a press of its own.
    dearer: IslandUnlock
    unused IslandUnlockAnswer(*dearer, Answer(ALICE, true, false, 0, "idle"), 0.0)
    unused IslandUnlockNext(*dearer, 0.0)
    IslandUnlockPress(*dearer, 0.0)
    unused IslandUnlockAnswer(*dearer, Answer(ALICE, true, false, 0, "done"), 0.0)
    unused IslandUnlockNext(*dearer, 0.0)
    unused IslandUnlockAnswer(*dearer, Answer(ALICE, true, false, 85000000, "done"), 0.0)
    if dearer.stage != ISLAND_READY || dearer.wanted != 0 || IslandUnlockNext(*dearer, 0.0) != "" { return 16 }
    if dearer.notice != "shovey_island_changed" || IslandUnlockNotice(*dearer, 1.0) != "shovey_island_changed" { return 17 }
    if IslandUnlockNotice(*dearer, 100.0) != "" || Label(*dearer) != "Unlock · 85 Dew" { return 18 }
    IslandUnlockPress(*dearer, 2.0)
    if IslandUnlockNext(*dearer, 2.0) != "shovey.island:85000000" { return 19 }
    // Not enough Dew: the Dew page is asked for once, the quote stays, and
    // the next press tries again.
    unused IslandUnlockAnswer(*dearer, Answer(ALICE, true, false, 85000000, "insufficient"), 3.0)
    if dearer.wanted != 0 || dearer.stage != ISLAND_READY || IslandUnlockTakeAction(*dearer) != ISLAND_ACTION_BUY_DEW { return 20 }
    IslandUnlockPress(*dearer, 4.0)
    if IslandUnlockNext(*dearer, 4.0) != "shovey.island:85000000" { return 21 }
    // The connection lost before the quote: the press is given up, not kept
    // for a later surprise.
    lost: IslandUnlock
    unused IslandUnlockAnswer(*lost, Answer(ALICE, true, false, 0, "idle"), 0.0)
    unused IslandUnlockNext(*lost, 0.0)
    IslandUnlockPress(*lost, 0.0)
    unused IslandUnlockAnswer(*lost, Answer(ALICE, true, false, 0, "failed"), 0.0)
    if lost.wanted != 0 || lost.notice != "shovey_island_offline" { return 22 }
    if IslandUnlockNext(*lost, 31.0) != "refresh" { return 23 }
    unused IslandUnlockAnswer(*lost, Answer(ALICE, true, false, 0, "done"), 31.0)
    unused IslandUnlockNext(*lost, 31.0)
    unused IslandUnlockAnswer(*lost, Answer(ALICE, true, false, 51000000, "done"), 31.0)
    if lost.stage != ISLAND_READY || IslandUnlockNext(*lost, 32.0) != "" { return 24 }
    // Asking the node again leaves a press under way alone.
    IslandUnlockPress(*lost, 33.0)
    IslandUnlockRefresh(*lost)
    if lost.stage != ISLAND_CONFIRM_NEEDED { return 25 }
    return 0
}

// A saved unlock reads Play while the node checks it, and a press on that
// Play never buys.
Remembered :: () -> s32 {
    bought: IslandUnlock
    unused IslandUnlockAnswer(*bought, Answer(ALICE, true, true, 0, "done"), 0.0)
    text: [192]u8
    record := IslandUnlockRecord(*bought, text[:])
    // A host with included content keeps its own entitlement check: the
    // record only marks Island as remembered.
    unlock: IslandUnlock
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, false, 0, "pending"), 0.0)
    IslandUnlockRestore(*unlock, record)
    unlock.owned = false
    if !unlock.remembered || IslandOffer(*unlock) { return 1 }
    if IslandUnlockNext(*unlock, 0.0) != "refresh" { return 2 }
    IslandUnlockPress(*unlock, 0.0)
    if unlock.wanted != ISLAND_WANTED_OPEN || Label(*unlock) != "shovey_island_opening" { return 3 }
    // The node agrees: it is the owner's, and nothing was bought.
    unused IslandUnlockAnswer(*unlock, Answer(ALICE, true, true, 0, "done"), 1.0)
    if !unlock.owned || unlock.wanted != 0 || unlock.stage != ISLAND_IDLE { return 4 }
    // The node disagrees: Island locks, the press is dropped, and the quote
    // that follows is not charged.
    stale: IslandUnlock
    unused IslandUnlockAnswer(*stale, Answer(ALICE, true, false, 0, "pending"), 0.0)
    IslandUnlockRestore(*stale, record)
    stale.owned = false
    unused IslandUnlockNext(*stale, 0.0)
    IslandUnlockPress(*stale, 0.0)
    unused IslandUnlockAnswer(*stale, Answer(ALICE, true, false, 0, "done"), 1.0)
    if stale.remembered || stale.wanted != 0 { return 5 }
    if IslandUnlockNext(*stale, 1.0) != "shovey.island.quote" { return 6 }
    unused IslandUnlockAnswer(*stale, Answer(ALICE, true, false, 51000000, "done"), 1.0)
    if stale.stage != ISLAND_READY || IslandUnlockNext(*stale, 2.0) != "" || IslandUnlockBusy(*stale) { return 7 }
    if Label(*stale) != "Unlock · 51 Dew" { return 8 }
    return 0
}

#program_export
Check :: () -> s32 {
    result := Purchase()
    if result != 0 { return 100 + result }
    result = Refusals()
    if result != 0 { return 200 + result }
    result = Offline()
    if result != 0 { return 300 + result }
    result = Restore()
    if result != 0 { return 400 + result }
    result = Press()
    if result != 0 { return 500 + result }
    result = Remembered()
    if result != 0 { return 600 + result }
    return 42
}
