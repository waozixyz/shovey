// Optional private-source proof for island_delivery_test.py --campaign.
// Keys run the reviewed compiled game; native rules independently replay the
// same route. Compare every saved position, including the explicit next island.
#import "player_host"
#import "island_unlock"
#import "player_platform"
#import "apps/host"
#import "island_engine"
#import "island_progress"
#import "campaign_asset_paths"
#import "island_levels"
#import "kryon/Frame"
#import "kryon/Desktop"
#import "kryon/session"
#import "kryon/tree"
#import "kryon/tree_input"
#import "kryon/pointer_input"
#import "kryon/input_protocol"
#import "kryon/ScrollDevice"
#import "kryon/geometry"
#import "kryon/app_files"
#import "kryon/app_context_host"
#import "kryon/hosted_app"
