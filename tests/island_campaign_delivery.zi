campaign_api :: #system_library "c";
CampaignCapture :: (number: s32) -> s32 #foreign campaign_api "CampaignCapture";
CampaignPointerSend :: (x: s32,y: s32,phase: s32) -> s32 #foreign campaign_api "CampaignPointerSend";

// Assert the real five shared controls at both narrow desktop widths.
CampaignToolbar :: (session: Session, bounds: Rectangle, island: bool, capture: s32) -> bool {
    ids: [5]s32 = ifx island then .[80018,80022,80015,80006,80019] else .[20022,20820,20016,20017,20023]
    for size: cast(s32)0..1 {
        width: s32 = ifx size==0 then 320 else 480
        if !ResizeDesktop(width,820) { return false }
        area := Rectangle.{0.0,0.0,cast(float32)width,820.0}
        for frame: 1..4 { if !CampaignFrame(session,area,0) { return false } }
        xs: [5]float32 = .[8.0,56.0,cast(float32)(width-156),cast(float32)(width-104),cast(float32)(width-52)]
        for id,slot: ids {
            found: bool
            for index: cast(s32)0..TreeCount(session)-1 {
                node := TreeNodeAt(session,index)
                if node.key==cast(u64)id {
                    if node.bounds.x!=xs[slot] || node.bounds.width!=44.0 || node.bounds.height!=44.0 { return false }
                    found=true
                }
                if island && (node.key==80004 || node.key==80005) { return false }
            }
            if !found { Report("Missing shared toolbar control\n"); return false }
        }
        if CampaignCapture(capture+size)!=0 { return false }
    }
    if !ResizeDesktop(cast(s32)bounds.width,cast(s32)bounds.height) { return false }
    return CampaignFrame(session,bounds,0)
}

CampaignScreenshot :: (number: s32) -> s32 { return CampaignCapture(number) }

CampaignCheckAssets :: () -> bool {
    runtime := AppHostActiveRuntime(*collection_host)
    if runtime == null { return false }
    paths: [7]string = .["assets/shovey-island/shop/book.png", "assets/shovey-island/controls/back.png",
        "assets/shovey-island/controls/levels.png", "assets/shovey-island/controls/restart.png",
        "assets/shovey-island/controls/hint.png", "assets/shovey-island/controls/sound-on.png",
        "assets/shovey-island/controls/sound-off.png"]
    for path: paths {
        if !HostedAppAsset(AppContextRuntime(*runtime.app),path).found { Report(path); return false }
    }
    return true
}


CampaignMap :: (session: Session, bounds: Rectangle, completed: bool) -> bool {
    levels: s32 = -1
    for index: cast(s32)0..TreeCount(session)-1 {
        if TreeNodeAt(session,index).key == 80018 || TreeNodeAt(session,index).key == 20907 { levels=index }
    }
    if levels < 0 || !CampaignClick(session,bounds,levels) { return false }
    for size: cast(s32)0..1 {
        width: s32 = ifx size == 0 then 320 else 960
        height: s32 = ifx size == 0 then 720 else 600
        if !ResizeDesktop(width,height) { return false }
        area := Rectangle.{0.0,0.0,cast(float32)width,cast(float32)height}
        for frame: 1..4 { if !CampaignFrame(session,area,0) { return false } }
        if completed && size == 0 {
            for step: 1..15 { if !CampaignFrame(session,area,263) { return false } }
        }
        // Exercise the production Scroll device with a drag beginning on a
        // level target. The map moves, selection stays, and release is no tap.
        if !CampaignMapDrag(session,area,size == 1) { Report("Island map drag failed\n"); return false }
        if !CampaignFrame(session,area,263) { return false }
        if completed && !CampaignFrame(session,area,262) { return false }
        if !CampaignMapDrag(session,area,size == 1,true) { Report("Island map cross-axis drag failed\n"); return false }
        if !CampaignFrame(session,area,263) { return false }
        if completed && !CampaignFrame(session,area,262) { return false }
        if completed {
            // Nearby turns 15 and 17 are the narrow layout's closest targets.
            // Each must select independently without starting a level.
            for target: cast(s32)0..1 {
                wanted := ifx target == 0 then 82017 else 82015
                button: s32 = -1
                for index: cast(s32)0..TreeCount(session)-1 {
                    if TreeNodeAt(session,index).key == cast(u64)wanted { button=index }
                }
                if button < 0 || !CampaignClick(session,area,button) { return false }
                selected_wanted: bool
                for index: cast(s32)0..TreeCount(session)-1 {
                    node := TreeNodeAt(session,index)
                    if node.key == cast(u64)wanted && node.selected { selected_wanted=true }
                }
                if !selected_wanted { return false }
            }
        }
        selected: bool
        art: bool
        play: s32 = -1
        for index: cast(s32)0..TreeCount(session)-1 {
            node := TreeNodeAt(session,index)
            if node.key == 81004 { art=true }
            if node.key == 81002 { play=index }
            if node.key >= 82001 && node.key <= 82030 && node.selected {
                selected=true
                if node.bounds.width != 56.0 || node.bounds.height != 56.0 { return false }
            }
            if node.key >= 82001 && node.key <= 82030 {
                for other: index+1..TreeCount(session)-1 {
                    next := TreeNodeAt(session,other)
                    if next.key >= 82001 && next.key <= 82030 {
                        dx := node.bounds.x-next.bounds.x; dy := node.bounds.y-next.bounds.y
                        if dx*dx+dy*dy < 3364.0 { Report("Island targets overlap\n"); return false }
                    }
                }
            }
        }
        if !art || !selected || play < 0 || CampaignCapture(size + ifx completed then 2 else 0) != 0 { return false }
    }
    // Enter uses the same gate and selected level as the visible Play action.
    area := Rectangle.{0.0,0.0,960.0,600.0}
    if !CampaignFrame(session,area,257) || !CampaignFrame(session,area,0) { return false }
    if !ResizeDesktop(cast(s32)bounds.width,cast(s32)bounds.height) { return false }
    return CampaignFrame(session,bounds,0) && CampaignFrame(session,bounds,0)
}

CampaignFrame :: (session: Session, bounds: Rectangle, key: s32) -> bool {
    if !PollDesktop() { return false }
    return CampaignPointerFrame(session,bounds,key,PollPointer())
}

CampaignPointerFrame :: (session: Session, bounds: Rectangle, key: s32, pointer: PointerFrame) -> bool {
    BeginDesktopFrame()
    TreePointerUpdate(session, pointer)
    BeginScrollFrame(session,Vector2.{pointer.x,pointer.y},pointer.pressed,pointer.down,pointer.released,0.0,
        cast(float64)MonotonicMilliseconds()/1000.0)
    // This is the retained root key, not a frame counter. Keep the same
    // identities between press and activation, as the desktop player does.
    if BeginFrame(session, cast(u64)1, bounds) != FrameStatus.FrameOk { return false }
    if !CollectionFrame(session, bounds, key, 0) { return false }
    if EndFrame(session) != FrameStatus.FrameOk || !EndDesktopFrame() { return false }
    CollectionCollect()
    return true
}

CampaignMapDrag :: (session: Session, bounds: Rectangle, horizontal: bool, cross: bool=false) -> bool {
    target: u64
    before: Rectangle
    painting: Rectangle
    for index: cast(s32)0..TreeCount(session)-1 {
        node := TreeNodeAt(session,index)
        if node.key >= 82001 && node.key <= 82030 && node.selected { target=node.key; before=node.bounds }
        if node.key == 81004 { painting=node.bounds }
    }
    if target == 0 { return false }
    x := before.x+28.0; y := before.y+28.0
    dx: float32 = ifx horizontal then -48.0 else 0.0
    dy: float32 = ifx horizontal then 0.0 else 48.0
    if cross {
        if horizontal { dx=0.0; dy=ifx painting.y < (bounds.height-88.0-painting.height)*0.5 then 80.0 else -80.0 }
        else { dy=0.0; dx=ifx painting.x < (bounds.width-painting.width)*0.5 then 80.0 else -80.0 }
    }
    if CampaignPointerSend(cast(s32)x,cast(s32)y,0) != 0 || !CampaignFrame(session,bounds,0) { return false }
    for step: cast(s32)1..4 {
        if CampaignPointerSend(cast(s32)(x+dx*cast(float32)step/4.0),cast(s32)(y+dy*cast(float32)step/4.0),1) != 0 ||
            !CampaignFrame(session,bounds,0) { return false }
    }
    if CampaignPointerSend(cast(s32)(x+dx),cast(s32)(y+dy),2) != 0 || !CampaignFrame(session,bounds,0) { return false }
    for index: cast(s32)0..TreeCount(session)-1 {
        node := TreeNodeAt(session,index)
        if node.key == target && node.selected {
            delta := ifx horizontal != cross then before.x-node.bounds.x else node.bounds.y-before.y
            if delta < 0.0 { delta=0.0-delta }
            return delta > 32.0
        }
    }
    return false
}

CampaignClick :: (session: Session, bounds: Rectangle, index: s32) -> bool {
    if !TreeActivateAt(session, index) { Report("Island book activation rejected\n"); return false }
    return CampaignFrame(session, bounds, 0) && CampaignFrame(session, bounds, 0)
}

CampaignMatches :: (expected: string) -> bool {
    records := CollectionRecordsFor("arcade.shovey-island")
    if records == null { return false }
    actual := AppFileRead(*records.files, "local.campaign")
    defer { AppFileFree(actual) }
    return actual == expected
}

CampaignOpen :: () -> bool {
    runtime := AppHostActiveRuntime(*collection_host)
    module: [32]u8
    function: [32]u8
    unused CopyCString("title_view", module[:])
    unused CopyCString("AppServiceHost", function[:])
    arguments: [2]HostValue = .[AppHostText("arcade.navigation"), AppHostText("island")]
    answer: HostValue
    return CollectionCall(null, runtime.node, *module[0], *function[0], *arguments[0], 2, *answer) == 1 &&
        collection_island_opening && !collection_island_page
}

CampaignEmptyBook :: (session: Session, bounds: Rectangle) -> bool {
    // The game paints under its loading cover before that cover releases
    // input. Wait for the normal reveal before using a game control.
    for frame: 1..400 {
        if !CampaignFrame(session, bounds, 0) { return false }
        covered: bool
        for index: cast(s32)0..TreeCount(session) - 1 {
            if TreeNodeAt(session, index).key == 49401 { covered = true }
        }
        if !covered { break }
        unused SleepMilliseconds(5)
    }
    // Proof keys keep playing under Pip's tutorial. Dismiss his input
    // capture before exercising the book's normal button.
    if !CampaignFrame(session, bounds, 256) || !CampaignFrame(session, bounds, 0) { return false }
    book_button: s32 = -1
    for index: cast(s32)0..TreeCount(session) - 1 {
        if TreeNodeAt(session, index).key == 80022 { book_button = index }
    }
    if book_button < 0 || !CampaignClick(session, bounds, book_button) { return false }
    empty_book: bool
    close_button: s32 = -1
    for index: cast(s32)0..TreeCount(session) - 1 {
        node := TreeNodeAt(session, index)
        label := node.semantic_label
        if node.key == 910003 && label.count >= 5 && label[label.count - 5:] == "0 / 0" { empty_book = true }
        if node.key == 910001 { close_button = index }
        if node.key >= 910100 && node.key < 911000 { return false }
    }
    if !empty_book {
        for index: cast(s32)0..TreeCount(session) - 1 {
            node := TreeNodeAt(session, index)
            if node.key >= 910000 && node.key < 911000 {
                message: Vec(u8)
                BuilderPrint(*message, "Island book node %: %\n", node.key, node.semantic_label)
                text := BuilderFinish(message)
                Report(text)
                AppFileFree(text)
            }
        }
    }
    if !empty_book || close_button < 0 || !CampaignClick(session, bounds, close_button) { Report("Empty Island sticker book failed\n"); return false }
    return true
}

CampaignDelivered :: (session: Session, bounds: Rectangle) -> bool {
    if IslandLevelCount() != 30 || IslandLevelData(31) != "" { return false }
    legacy := IslandProgressNew()
    legacy.unlocked = 150
    legacy.completed[89] = true
    old: IslandGame
    if !IslandLoad(*old, 1) { return false }
    old.level = 100
    restored: IslandProgress
    position: IslandGame
    if !IslandCampaignRestore(*restored, *position, IslandCampaignSave(*legacy, *old)) ||
        restored.unlocked != 150 || !restored.completed[89] || position.level != 30 { return false }
    if !IslandCampaignRestore(*legacy, *old, IslandCampaignSave(*restored, *position)) ||
        legacy.unlocked != 150 || !legacy.completed[89] { return false }
    old.won = true
    if !IslandOpenLatest(*legacy, *old) || old.level != 30 { return false }
    progress := IslandProgressNew()
    for number: cast(s32)1..30 {
        game: IslandGame
        if !IslandLoad(*game, number) || IslandLevelName(number) == "" { return false }
        if number == 1 {
            if !CollectionBack() { return false }
            CollectionCollect()
            records := CollectionRecordsFor("arcade.shovey-island")
            if !AppFileWrite(*records.files, "local.campaign", IslandCampaignSave(*progress, *game)) { return false }
            // Use the same deferred route as the title's owned Island Play.
            if !CampaignOpen() { return false }
            if !CampaignFrame(session, bounds, 0) || !CampaignFrame(session, bounds, 0) { return false }
        }
        // Each win opens the next island. No later level is injected or unlocked.
        runtime := AppHostActiveRuntime(*collection_host)
        if number == 1 {
            count_shown: bool
            for index: cast(s32)0..TreeCount(session) - 1 {
                node := TreeNodeAt(session, index)
                label := node.semantic_label
                if node.key == 80018 && node.bounds.y == 4.0 { count_shown = true }
            }
            if !count_shown { Report("Compiled Island did not show the shared toolbar\n"); return false }
            for index: cast(s32)0..CAMPAIGN_ASSET_COUNT - 1 {
                path := CampaignAssetPath(index)
                if !HostedAppAsset(AppContextRuntime(*runtime.app), path).found { Report(path); return false }
            }
            if HostedAppAsset(AppContextRuntime(*runtime.app), "assets/shovey-island/levels/31.png").found ||
                HostedAppAsset(AppContextRuntime(*runtime.app), "assets/shovey-island/levels-landscape/31.png").found { return false }
            if !CampaignEmptyBook(session, bounds) || !CampaignToolbar(session,bounds,true,5) || !CampaignMap(session,bounds,false) { return false }
        }
        languages: [12]string = .["en", "cs", "de", "es", "fr", "id", "it", "ja", "ko", "pt", "ru", "zh"]
        for language: languages {
            path: Vec(u8)
            BuilderPrint(*path, "assets/shovey-island/locales/%.txt", language)
            name := BuilderFinish(path)
            resource := HostedAppAsset(AppContextRuntime(*runtime.app), name)
            AppFileFree(name)
            if !resource.found || resource.data.count == 0 { return false }
        }
        if number==13 && (game.terrain[game.player]==0 || CampaignCapture(10)!=0) { return false }
        // No steps or remote account state are injected into the guest.
        // Its real key handler must produce each expected saved position.
        route := IslandLevelSolution(number)
        if route.count == 0 { return false }
        won: bool
        for letter, step: route {
            direction := cast(s32)(letter - #char "0")
            key: s32
            if letter == #char "f" { direction = 4; key = 70 }
            else if letter == #char "t" { direction = 5; key = 84 }
            else {
                if direction < 0 || direction > 3 { return false }
                keys: [4]s32 = .[263, 265, 262, 264]
                key = keys[direction]
            }
            unused IslandMove(*game, direction)
            if game.won { won = true }
            IslandRecordWin(*progress, *game)
            expected := IslandCampaignSave(*progress, *game)
            // A raft may still be gliding. Retry this key only until its
            // independently replayed position is saved, then release it.
            matched: bool
            for attempt: 1..400 {
                if !CampaignFrame(session, bounds, key) { return false }
                if CampaignMatches(expected) { matched = true; break }
                unused SleepMilliseconds(5)
            }
            if !matched {
                records := CollectionRecordsFor("arcade.shovey-island")
                actual := AppFileRead(*records.files, "local.campaign")
                observed_progress: IslandProgress
                observed: IslandGame
                unused IslandCampaignRestore(*observed_progress, *observed, actual)
                AppFileFree(actual)
                message: Vec(u8)
                BuilderPrint(*message, "Island %: packaged position differs at proof action % (%); guest level %, moves %, unlocked %; expected level %, moves %, unlocked %\n",
                    number, step + 1, direction, observed.level, observed.moves, observed_progress.unlocked, game.level, game.moves, progress.unlocked)
                text := BuilderFinish(message)
                Report(text)
                AppFileFree(text)
                return false
            }
        }
        // A win remains visible until the player presses Continue.
        if !CampaignFrame(session,bounds,0) { return false }
        continue_button: s32 = -1
        scored: bool
        for index: cast(s32)0..TreeCount(session)-1 {
            node := TreeNodeAt(session,index)
            if node.key==20905 { continue_button=index }
            if node.key==20903 && node.semantic_label=="Score: 1000 / 1000" { scored=true }
        }
        key: [96]u8
        name := LevelResultKey("shovey.island","",number,key[:])
        records := CollectionRecordsFor("arcade.shovey-island")
        saved := AppFileRead(*records.files,name)
        best_moves := ReadNumber(saved,FieldAt(saved,0,"moves"))
        AppFileFree(saved)
        if !best_moves.valid || best_moves.value!=cast(float64)game.moves { Report("Missing persisted Island score\n"); return false }
        if continue_button<0 || !scored { Report("Missing Island result\n"); return false }
        if number==13 && CampaignCapture(11)!=0 { return false }
        if number < IslandLevelCount() {
            if !CampaignClick(session,bounds,continue_button) { return false }
            unused IslandContinue(*progress,*game)
        }
        if number==13 {
            if !CollectionBack() { return false }
            CollectionCollect()
            if !CollectionOpenGame(ISLAND_UNLOCK_APP) { return false }
            for frame: 1..6 { if !CampaignFrame(session,bounds,0) { return false } }
            records=CollectionRecordsFor("arcade.shovey-island")
            reloaded := AppFileRead(*records.files,name)
            retained := ReadNumber(reloaded,FieldAt(reloaded,0,"moves"))
            AppFileFree(reloaded)
            if !retained.valid || retained.value!=best_moves.value { Report("Island score lost on reopen\n"); return false }
        }
        expected_unlocked := ifx number < IslandLevelCount() then number + 1 else number
        if !won || !progress.completed[number - 1] || progress.unlocked != expected_unlocked { return false }
        message: Vec(u8)
        BuilderPrint(*message, "Island %: packaged route and every saved position verified\n", number)
        text := BuilderFinish(message)
        Report(text)
        AppFileFree(text)
    }
    if !CampaignMap(session,bounds,true) || !CollectionBack() { return false }
    CollectionCollect()
    if !CollectionOpenGame("arcade.shovey") { return false }
    for frame: 1..10 { if !CampaignFrame(session,bounds,0) { return false } }
    if !CampaignFrame(session,bounds,257) || !CampaignFrame(session,bounds,0) { return false }
    if !CampaignFrame(session,bounds,257) || !CampaignFrame(session,bounds,0) { return false }
    if !CampaignFrame(session,bounds,256) { return false }
    return CampaignToolbar(session,bounds,false,7)
}
