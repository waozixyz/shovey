#import, file "../src/secret_travel.zi";
#import, file "../src/engine.zi";
#import, file "../src/levels.zi";
#import, file "../src/progress.zi";
#import, file "../src/reward_locations.zi";
#import "std/text_buffer"
#import "std/c_string"

ReachBeach :: () -> bool {
    game: ShoveyGame
    unused ShoveyLoad(*game, CHEST_PARENT_LEVEL)
    // Push the existing bomb down into the cracked wall, then walk through
    // the opening onto the beach. This starts from the actual shipped map.
    for input: "00000000033330" {
        if input == #char "f" { unused ShoveyFire(*game) }
        else if input == #char "t" { unused ShoveyTick(*game) }
        else { unused ShoveyMove(*game, cast(s32)input - 48) }
        probe := game
        if probe.player % SHOVEY_WIDTH == 1 { unused ShoveyMove(*probe, 0) }
        visit: ShoveySecretVisit
        if ShoveySecretEdge(*probe, *visit, 0) && probe.level == CHEST_LEVEL { return true }
    }
    return false
}

#program_export
Check :: () -> s32 {
    if CHEST_LEVEL != 1003 || CHEST_PARENT_LEVEL != 29 || CHEST_CELL != 124 ||
    ShoveyLevelCount() != SHOVEY_LEVEL_COUNT || !ReachBeach() { return 1 }
    for row: cast(s32)5..13 {
        game: ShoveyGame
        if !ShoveyLoad(*game, CHEST_PARENT_LEVEL) { return 2 }
        game.player = row * SHOVEY_WIDTH
        game.moves = 17
        game.keys = 2
        game.direction = 0
        game.objects[58] = 0
        parent: [2433]u8
        unused CopyCString(ShoveySave(*game), parent[:])
        visit: ShoveySecretVisit
        if !ShoveySecretEdge(*game, *visit, 0) || game.level != CHEST_LEVEL ||
        game.player != row * SHOVEY_WIDTH + 11 || !visit.valid ||
        game.ground[CHEST_CELL] != 0 || game.tiles[CHEST_CELL] != 78 { return 3 }
        // Every legitimate beach entrance can reach the authored route.
        while game.player < 119 { if !ShoveyMove(*game, 3) { return 4 } }
        while game.player > 119 { if !ShoveyMove(*game, 1) { return 5 } }
        touched := false
        for input: ShoveySecretSolution(3) {
            if !ShoveyMove(*game, cast(s32)input - 48) { return 6 }
            if game.player == CHEST_CELL { touched = true }
        }
        if !game.won || !touched { return 7 }
        progress := ShoveyProgressNew()
        before := progress.unlocked
        ShoveyRecordWin(*progress, *game)
        if progress.unlocked != before || progress.completed[28] { return 8 }
        if !ShoveyReturnFromSecret(*game, *visit) || visit.valid ||
        TextUntilNul(parent[:]) != ShoveySave(*game) { return 9 }
        // Returning through the room's edge also restores exact parent state,
        // including when exploration reaches a different part of that edge.
        if !ShoveySecretEdge(*game, *visit, 0) { return 10 }
        game.player = 11 + 7 * SHOVEY_WIDTH
        if !ShoveySecretEdge(*game, *visit, 2) || TextUntilNul(parent[:]) != ShoveySave(*game) { return 11 }
    }
    game: ShoveyGame
    visit: ShoveySecretVisit
    seen: [SHOVEY_LEVEL_COUNT + 1]bool
    for slot: cast(s32)1..ShoveyLevelCount() + 1 {
        number := ShoveyListedLevel(slot, true)
        if slot == 30 { if number != CHEST_LEVEL { return 19 }; continue }
        if number < 1 || number > ShoveyLevelCount() || seen[number] { return 20 }
        seen[number] = true
        if slot <= ShoveyLevelCount() && ShoveyListedLevel(slot, false) != slot { return 21 }
    }
    if ShoveyReopenChest(*game, *visit, false) || !ShoveyReopenChest(*game, *visit, true) ||
    game.level != CHEST_LEVEL || game.player != 119 || visit.parent.level != CHEST_PARENT_LEVEL { return 22 }
    unused ShoveyLoad(*game, 29)
    if ShoveySecretEdge(*game, *visit, 0) { return 12 }
    game.player = 0
    if ShoveySecretEdge(*game, *visit, 0) { return 13 }
    game.player = 14 * 12
    if ShoveySecretEdge(*game, *visit, 0) { return 14 }
    game.level = 28; game.tiles[game.player] = 78; game.ground[game.player] = 0
    if ShoveySecretEdge(*game, *visit, 0) { return 15 }
    unused ShoveyLoad(*game, 29)
    game.player = 9 * 12; game.won = true
    if ShoveySecretEdge(*game, *visit, 0) { return 16 }
    game.won = false; game.lost = true
    if ShoveySecretEdge(*game, *visit, 0) { return 17 }
    // Existing end-of-campaign beaches retain their own IDs and return path.
    for side: cast(s32)1..2 {
        if ShoveySecretData(side) == "" { continue }
        unused ShoveyLoad(*game, ShoveyLevelCount())
        direction: s32 = ifx side == 1 then 2 else 0
        game.player = ifx side == 1 then 119 else 108
        parent: [2433]u8
        unused CopyCString(ShoveySave(*game), parent[:])
        if !ShoveySecretEdge(*game, *visit, direction) || game.level != 1000 + side ||
        !ShoveyReturnFromSecret(*game, *visit) || TextUntilNul(parent[:]) != ShoveySave(*game) { return 18 }
    }
    return 0
}
