#import, file "../src/controls.zi";
#import "std/c_string"
#import "std/text_buffer"

// A host that keeps the edition's records, like Inner Breeze, and may also
// offer Arcade's services, like the Arcade app. Relaunching forgets what the
// game itself remembered; the host keeps its records and services.
service_open: bool;
editor_requests: s32;
navigation_supported: bool;
navigation_reply: string = "{\"v\":1,\"status\":\"queued\",\"request\":1,\"receipt\":\"\",\"reason\":\"\"}";
service_controls: [16]u8;
service_sound: [16]u8;
record_controls: [16]u8;
record_sound: [16]u8;

#program_export
FakeService :: (name: string, request: string) -> string {
    if !service_open { return "{\"status\":\"unavailable\"}" }
    if name == "apps.navigation" {
        editor_requests += 1
        if request != "arcade.shovey-editor" { return "{\"v\":1,\"status\":\"rejected\"}" }
        return navigation_reply
    }
    if name == "arcade.controls" {
        if request == "get" { return TextUntilNul(service_controls[:]) }
        if request == "set-on" || request == "set-off" { unused CopyCString(request[4:], service_controls[:]) }
        return TextUntilNul(service_controls[:])
    }
    if name == "arcade.sound" {
        if request == "get" { return TextUntilNul(service_sound[:]) }
        unused CopyCString(ifx request == "mute" then "muted" else "on", service_sound[:])
        return TextUntilNul(service_sound[:])
    }
    return ""
}

#program_export
FakeRecord :: (name: string) -> string {
    if name == "controls" { return TextUntilNul(record_controls[:]) }
    if name == "sound" { return TextUntilNul(record_sound[:]) }
    return ""
}

#program_export
FakeSave :: (name: string, text: string) -> bool {
    if name == "controls" { return CopyCString(text, record_controls[:]) }
    if name == "sound" { return CopyCString(text, record_sound[:]) }
    return false
}

// Whether the host reports a keyboard-and-mouse desktop.
desktop: bool;

#program_export
FakeSupports :: (capability: string) -> bool {
    if capability == "app-navigation" { return navigation_supported }
    return desktop && capability == "kryon.input.desktop"
}

Relaunch :: () {
    controls_pad = -1
    controls_chosen = false
    sound_muted = -1
}

#program_export
Check :: () -> s32 {
    // Inner Breeze: no Arcade services, so the edition's records keep both.
    Relaunch()
    if ControlsChosen() || SoundMuted() { return 1 }
    ControlsSetPad(true)
    Relaunch()
    if !ControlsChosen() || !ControlsPad() { return 2 }
    ControlsSetPad(false)
    Relaunch()
    if !ControlsChosen() || ControlsPad() { return 3 }
    SoundSetMuted(true)
    Relaunch()
    if !SoundMuted() { return 4 }
    // Arcade: its services answer first, so every edition shares a choice.
    service_open = true
    record_controls[0] = 0
    record_sound[0] = 0
    unused CopyCString("on", service_controls[:])
    unused CopyCString("on", service_sound[:])
    Relaunch()
    if !ControlsChosen() || !ControlsPad() || SoundMuted() { return 5 }
    ControlsSetPad(false)
    Relaunch()
    if ControlsPad() || TextUntilNul(service_controls[:]) != "off" || TextUntilNul(record_controls[:]) != "off" { return 6 }
    // A desktop host: nothing chosen yet, yet nothing to ask; swipe and tap.
    service_open = false
    record_controls[0] = 0
    desktop = true
    Relaunch()
    if !ControlsChosen() || ControlsPad() { return 7 }
    // A touch host with nothing chosen still asks.
    desktop = false
    Relaunch()
    if ControlsChosen() { return 8 }
    // A portable game returns to its own title; direct views use host Back.
    game_title_enabled = false
    game_title_requested = false
    LeaveForGameSelection()
    if game_title_requested { return 9 }
    game_title_enabled = true
    LeaveForGameSelection()
    if !game_title_requested { return 10 }
    // No request at all without the shared host's explicit capability.
    service_open = true
    if ClassicEditorAvailable() || OpenClassicEditor() || editor_requests != 0 { return 11 }
    navigation_supported = true
    if !ClassicEditorAvailable() || !OpenClassicEditor() || editor_requests != 1 { return 12 }
    navigation_reply = "{\"v\":1,\"status\":\"rejected\",\"reason\":\"consent unavailable\"}"
    if OpenClassicEditor() || editor_requests != 2 { return 13 }
    navigation_reply = "{\"status\":\"unavailable\"}"
    if OpenClassicEditor() || editor_requests != 3 { return 14 }
    navigation_reply = "queued"
    if OpenClassicEditor() || editor_requests != 4 { return 15 }
    navigation_reply = "{\"v\":1,\"status\":\"queued\"} trailing"
    if OpenClassicEditor() || editor_requests != 5 { return 16 }
    navigation_reply = "{\"v\":2,\"status\":\"queued\"}"
    if OpenClassicEditor() || editor_requests != 6 { return 17 }
    service_open = false
    if OpenClassicEditor() || editor_requests != 6 { return 18 }
    return 42
}
