// Invoke the real view functions without a storage or drawing host: secret
// branches must return before either capability, even with legacy cache data.
View :: #import, file "../src/shovey_view.zi";
#import, file "../src/engine.zi";
#import, file "../src/levels.zi";
#import "std/c_string"
#import "std/text_buffer"
#import "apps/node_types"
#import, file "../src/secret_travel.zi";
#import, file "../src/progress.zi";

#program_export
Check :: () -> s32 {
    for side: cast(s32)1..3 {
        level := 1000 + side
        unused ShoveyLoad(*View.game, 29)
        View.game.moves = 17
        View.game.keys = 2
        View.secret_visit.parent = View.game
        View.secret_visit.room = level
        View.secret_visit.valid = true
        parent: [2433]u8
        unused CopyCString(ShoveySave(*View.game), parent[:])
        if !ShoveyLoad(*View.game, level) { return 1 }
        for letter: ShoveySecretSolution(side) {
            unused ShoveyMove(*View.game, cast(s32)(letter - #char "0"))
        }
        if !View.game.won || View.game.lost { return 2 }
        View.level_results_loaded[level - 1] = true
        View.level_results[level - 1] = ShoveyLevelResult.{.best_moves = 1, .stars = 3, .score = 1000}
        legacy := View.ShoveyBestLevelResult("", level)
        if legacy.best_moves != 0 || legacy.stars != 0 || legacy.score != 0 { return 3 }
        View.result_save_failed = true
        View.RememberLevelResult()
        if View.result_save_failed { return 4 }
        // Existing records/cache are ignored, not erased or rewritten.
        if View.level_results[level - 1].score != 1000 || !View.level_results_loaded[level - 1] { return 5 }
        View.won_at = 0.0
        View.result_dismissed = 0
        View.frame.now = 10.0
        if View.LevelResultScreen(400.0, 0.0, 800.0) || View.game.level != level || View.won_at != 10.0 { return 6 }
        View.frame.now = 10.5
        if View.LevelResultScreen(400.0, 0.0, 800.0) || View.game.level != level { return 7 }
        View.frame.now = 11.0
        if View.LevelResultScreen(400.0, 0.0, 800.0) || View.secret_visit.valid || View.won_at != 0.0 ||
        ShoveySave(*View.game) != TextUntilNul(parent[:]) { return 8 }
    }
    // Story cache and explicit result dismissal continue to work.
    View.level_results_loaded[0] = true
    View.level_results[0] = ShoveyLevelResult.{.best_moves = 51, .stars = 3, .score = 1000}
    story := View.ShoveyBestLevelResult("", 1)
    if story.best_moves != 51 || story.stars != 3 || story.score != 1000 { return 9 }
    unused ShoveyLoad(*View.game, 1)
    View.game.won = true
    View.result_dismissed = 1
    if View.LevelResultScreen(400.0, 0.0, 800.0) || View.result_dismissed != 1 { return 10 }
    View.game.won = false
    if View.LevelResultScreen(400.0, 0.0, 800.0) || View.result_dismissed != 0 { return 11 }
    return 0
}
