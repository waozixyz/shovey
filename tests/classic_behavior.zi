#import, file "../src/engine.zi";
#import, file "../src/orientation.zi";
#import, file "../src/progress.zi";

// Opening the game lands on the newest unlocked puzzle; an unfinished
// position there is kept, and a replay of an older puzzle is left behind.
OpenChecks :: () -> s32 {
    progress := ShoveyProgressNew()
    game: ShoveyGame
    if !ShoveyLoad(*game, 1) { return 10 }
    if ShoveyOpenLatest(*progress, *game) || game.level != 1 { return 11 }
    game.won = true
    if !ShoveyOpenLatest(*progress, *game) || game.level != 2 || game.won || progress.unlocked != 2 || !progress.completed[0] { return 12 }
    if !ShoveySelectLevel(*progress, *game, 1) || game.level != 1 { return 13 }
    if !ShoveyOpenLatest(*progress, *game) || game.level != 2 || game.moves != 0 { return 14 }
    game.moves = 7
    if ShoveyOpenLatest(*progress, *game) || game.moves != 7 { return 15 }
    game.lost = true
    if !ShoveyOpenLatest(*progress, *game) || game.lost || game.moves != 0 { return 16 }
    return 0
}

ProgressChecks :: () -> s32 {
    progress := ShoveyProgressNew()
    if !ShoveyLevelUnlocked(*progress, 1) || ShoveyLevelUnlocked(*progress, 2) || ShoveyLevelUnlocked(*progress, 0) { return 20 }
    game: ShoveyGame
    unused ShoveyLoad(*game, 1)
    ShoveyRecordWin(*progress, *game)
    if progress.completed[0] || progress.unlocked != 1 { return 21 }
    game.won = true
    ShoveyRecordWin(*progress, *game)
    if !progress.completed[0] || progress.unlocked != 2 || ShoveyLevelUnlocked(*progress, 3) { return 22 }
    if !ShoveyContinue(*progress, *game) || game.level != 2 || game.won { return 23 }
    game.moves = 5
    saved := ShoveyCampaignSave(*progress, *game)
    restored: ShoveyProgress
    position: ShoveyGame
    if !ShoveyCampaignRestore(*restored, *position, saved) || restored.unlocked != 2 || !restored.completed[0] ||
    position.level != 2 || position.moves != 5 { return 24 }
    // A game saved before the boards changed keeps its progress and
    // restarts its level: first an old C1 save, then a changed board.
    campaign_bytes[1] = #char "1"
    if !ShoveyCampaignRestore(*restored, *position, TextView(campaign_bytes[:SHOVEY_CAMPAIGN_C1])) ||
    restored.unlocked != 2 || !restored.completed[0] || position.level != 2 || position.moves != 0 { return 26 }
    campaign_bytes[1] = #char "2"
    campaign_bytes[SHOVEY_CAMPAIGN_C1] = ifx campaign_bytes[SHOVEY_CAMPAIGN_C1] == #char "0" then #char "1" else #char "0"
    position.moves = 9
    if !ShoveyCampaignRestore(*restored, *position, TextView(campaign_bytes[:SHOVEY_CAMPAIGN_C1 + 8])) || position.level != 2 || position.moves != 0 { return 27 }
    if ShoveySelectLevel(*progress, *game, 3) || game.level != 2 { return 25 }
    return 0
}

BoardChecks :: () -> s32 {
    game: ShoveyGame
    for level: cast(s32)1..ShoveyLevelCount() {
        if !ShoveyLoad(*game, level) || game.player < 0 { return 30 }
        saved := ShoveySave(*game)
        copy: ShoveyGame
        if !ShoveyRestore(*copy, saved) || ShoveySave(*copy) != saved { return 31 }
    }
    // The finale is a picture: Shovey cannot move there.
    if !ShoveyLoad(*game, ShoveyLevelCount()) || ShoveyMove(*game, 0) || ShoveyMove(*game, 2) { return 32 }
    return 0
}

// Landscape is only a presentation: every logical cell has exactly one
// drawn place, and every drawn place maps back to the same logical cell.
OrientationChecks :: () -> s32 {
    seen: [BOARD_CELLS]bool
    for at: cast(s32)0..BOARD_CELLS - 1 {
        display := BoardDisplayIndex(at, true)
        if display < 0 || seen[display] || BoardLogicalIndex(display, true) != at { return 70 }
        seen[display] = true
        if BoardDisplayIndex(at, false) != at || BoardLogicalIndex(at, false) != at { return 71 }
    }
    if BoardDisplayIndex(11, true) != 0 || BoardLogicalIndex(0, true) != 11 { return 72 }
    if BoardDisplayIndex(228, true) != 239 || BoardLogicalIndex(239, true) != 228 { return 73 }
    // Input uses visible directions, so logical right and up must land in the
    // display places selected by visible up and left.
    center: s32 = 117
    if BoardDisplayIndex(cast(s32)(center + 1), true) != BoardDisplayIndex(center, true) - 20 { return 76 }
    if BoardDisplayIndex(cast(s32)(center - 12), true) != BoardDisplayIndex(center, true) - 1 { return 77 }
    for direction: cast(s32)0..3 {
        if BoardEngineDirection(direction, true) != (direction + 1) % 4 { return 74 }
        if BoardEngineDirection(direction, false) != direction { return 75 }
    }
    return 0
}

// Every autonomous block gets one step per tick. Blocks that begin beside
// one another are still occupied for that tick and cannot collide.
TickChecks :: () -> s32 {
    game := Floor()
    for at: cast(s32)26..30 { game.ground[at] = 30 }
    game.ground[27] = 29; game.ground[29] = 29; game.light_from[27] = 2; game.light_from[29] = 2
    if !ShoveyTick(*game) || game.ground[27] != 31 || game.ground[28] != 29 ||
    game.ground[29] != 31 || game.ground[30] != 29 { return 60 }

    game = Floor()
    for at: cast(s32)26..28 { game.ground[at] = 30 }
    game.ground[27] = 29; game.ground[28] = 29; game.light_from[27] = 2; game.light_from[28] = 2
    if !ShoveyTick(*game) || game.ground[27] != 29 || game.ground[28] != 31 { return 61 }
    if !ShoveyTick(*game) || game.ground[26] != 29 || game.ground[27] != 31 || game.ground[28] != 31 { return 62 }
    return 0
}

// One move (or a throw, for -1) and what it is heard as; -1 when nothing moved.
Heard :: (game: *ShoveyGame, direction: s32) -> s32 {
    before := game.*
    moved := false
    if direction < 0 { moved = ShoveyFire(game) } else { moved = ShoveyMove(game, direction) }
    if !moved { return -1 }
    return ShoveyEvent(*before, game)
}

// A plain floor with Shovey in the second row, second column, facing right.
Floor :: () -> ShoveyGame {
    return ShoveyGame.{.level = 1, .player = 13, .direction = 2}
}

// A plain step is quiet; pushes, pits, goals, pickups, doors, portals,
// throws, a win and a loss are each heard as themselves.
EventChecks :: () -> s32 {
    game := Floor()
    if Heard(*game, 2) != SHOVEY_EVENT_NONE { return 40 }
    game = Floor(); game.objects[14] = 9
    if Heard(*game, 2) != SHOVEY_EVENT_PUSH { return 41 }
    game = Floor(); game.objects[14] = 1; game.ground[15] = 4
    if Heard(*game, 2) != SHOVEY_EVENT_PIT { return 42 }
    game = Floor(); game.objects[14] = 9; game.ground[15] = 18
    if Heard(*game, 2) != SHOVEY_EVENT_GOAL { return 43 }
    game = Floor(); game.ground[14] = 33
    if Heard(*game, 2) != SHOVEY_EVENT_PICKUP { return 44 }
    game = Floor(); game.ground[14] = 21; game.ground[50] = 21
    if Heard(*game, 2) != SHOVEY_EVENT_PICKUP { return 45 }
    game = Floor(); game.keys = 1; game.ground[14] = 34
    if Heard(*game, 2) != SHOVEY_EVENT_DOOR { return 46 }
    game = Floor(); game.objects[14] = 9; game.ground[15] = 13; game.ground[50] = 14
    if Heard(*game, 2) != SHOVEY_EVENT_DOOR { return 47 }
    game = Floor(); game.ground[14] = 8; game.ground[74] = 8
    if Heard(*game, 2) != SHOVEY_EVENT_TELEPORT { return 48 }
    game = Floor(); game.powers = SHOVEY_AMMO
    if Heard(*game, -1) != SHOVEY_EVENT_SHOT { return 49 }
    game = Floor(); game.ground[14] = 7
    if Heard(*game, 2) != SHOVEY_EVENT_WON { return 50 }
    game = Floor(); game.powers = SHOVEY_CHARGED; game.ground[14] = 27
    if Heard(*game, 2) != SHOVEY_EVENT_LOST { return 51 }
    // A wall is no move at all.
    game = Floor(); game.ground[14] = 12
    if Heard(*game, 2) != -1 { return 52 }
    return 0
}

// The second palette keeps six logical colors across balls, pits and paint.
ColorChecks :: () -> s32 {
    for kind: cast(s32)44..46 {
        if ShoveyBallColor(kind) != kind - 40 { return 80 }
    }
    for kind: cast(s32)47..49 {
        if ShoveyPitColor(kind) != kind - 43 { return 81 }
    }
    for kind: cast(s32)50..52 {
        if ShoveyPaintColor(kind) != kind - 46 { return 82 }
    }
    if ShoveyBallForColor(4) != 44 || ShoveyBallForColor(5) != 45 || ShoveyBallForColor(6) != 46 { return 83 }

    game := Floor()
    game.objects[14] = 44
    game.ground[15] = 47
    if ShoveyRemaining(*game) != 1 || !ShoveyMove(*game, 2) || ShoveyRemaining(*game) != 0 || game.objects[15] != 0 { return 84 }

    game = Floor()
    game.objects[14] = 45
    game.ground[15] = 51
    if !ShoveyMove(*game, 2) || game.ground[15] != 0 || game.objects[15] != 45 { return 85 }
    game.ground[16] = 48
    if !ShoveyMove(*game, 2) || ShoveyRemaining(*game) != 0 || game.objects[16] != 0 { return 86 }

    game = Floor()
    game.objects[14] = 46
    game.ground[15] = 47
    if ShoveyMove(*game, 2) || game.objects[14] != 46 { return 87 }
    return 0
}

// A cherry is a second fruit: stepping on it eats it, and it counts to finish.
CherryChecks :: () -> s32 {
    game := Floor()
    game.ground[14] = 56
    game.ground[50] = 21
    if ShoveyRemaining(*game) != 2 { return 90 }
    if !ShoveyMove(*game, 2) || game.ground[14] != 0 || ShoveyRemaining(*game) != 1 { return 91 }
    return 0
}

// The abyss ends the game for Shovey, rejects every object and stays open;
// arrows only admit one way, cracked floor falls once left, ice carries Shovey,
// a bomb crate breaks a cracked wall, and portals pair by colour.
TileChecks :: () -> s32 {
    game := Floor()
    game.ground[15] = SHOVEY_PIT
    if !ShoveyMove(*game, 2) || !ShoveyMove(*game, 2) || !game.lost { return 100 }

    for object: cast(s32)1..SHOVEY_LAST_KIND {
        if !ShoveyMovable(object) || object == 40 { continue }
        for direction: cast(s32)0..3 {
            game = Floor()
            start := ShoveyNeighbor(78, (direction + 2) % 4)
            abyss := ShoveyNeighbor(78, direction)
            game.player = start
            game.direction = direction
            game.ground[abyss] = SHOVEY_PIT
            game.tiles[abyss] = SHOVEY_PIT
            game.objects[78] = object
            // Both ordinary play and the editor's animated movement must
            // leave the piece, player, abyss and underlying tile intact.
            frames: [8]ShoveyGame
            if ShoveyCanEnter(*game, abyss, object) || ShoveyPush(*game, 78, direction) ||
                ShoveyMove(*game, direction) || ShoveyMoveFrames(*game, direction, frames[:]) != 0 { return 101 }
            if game.player != start || game.moves != 0 || game.lost || game.objects[78] != object ||
                game.objects[abyss] != 0 || game.ground[abyss] != SHOVEY_PIT || game.tiles[abyss] != SHOVEY_PIT { return 180 }
        }
    }

    game = Floor()
    game.ground[14] = 68
    if !ShoveyMove(*game, 2) { return 102 }
    game = Floor()
    game.ground[15] = 68
    if !ShoveyMove(*game, 2) || !ShoveyMove(*game, 2) || game.player != 15 { return 103 }
    game = Floor()
    game.ground[15] = 66
    unused ShoveyMove(*game, 2)
    unused ShoveyMove(*game, 2)
    if game.player != 14 { return 104 }

    game = Floor()
    game.ground[15] = SHOVEY_CRACKED_FLOOR
    if !ShoveyMove(*game, 2) || !ShoveyMove(*game, 2) || game.ground[15] != SHOVEY_CRACKED_FLOOR { return 105 }
    if !ShoveyMove(*game, 2) || game.ground[15] != SHOVEY_PIT || game.lost { return 110 }

    game = Floor()
    game.ground[14] = SHOVEY_ICE
    game.ground[15] = SHOVEY_ICE
    game.ground[16] = SHOVEY_ICE
    if !ShoveyMove(*game, 2) || game.player != 17 { return 106 }

    game = Floor()
    game.objects[14] = SHOVEY_BOMB
    game.ground[15] = SHOVEY_CRACKED_WALL
    if !ShoveyMove(*game, 2) || game.ground[15] != 0 || game.objects[14] != 0 || game.objects[15] != 0 { return 107 }
    game = Floor()
    game.objects[14] = 9
    game.ground[15] = SHOVEY_CRACKED_WALL
    if ShoveyMove(*game, 2) { return 108 }

    game = Floor()
    game.ground[14] = 73
    game.ground[30] = 74
    game.ground[48] = 73
    if !ShoveyMove(*game, 2) || game.player != 48 { return 109 }
    return 0
}

NatureChecks :: () -> s32 {
    for color: cast(s32)0..4 {
        moss := Floor()
        wall := ifx color == 0 then 14 else SHOVEY_MOSS_WALL + color - 1
        button := ifx color == 0 then 13 else SHOVEY_MOSS_BUTTON + color - 1
        moss.ground[14] = wall
        moss.ground[26] = button
        moss.ground[27] = ifx color == 4 then 13 else SHOVEY_MOSS_BUTTON + color
        moss.objects[27] = 9
        if ShoveyGateColor(wall) >= 0 || ShoveyGateColor(button) >= 0 { return 177 }
        if ShoveyMove(*moss, 2) || ShoveyDoorOpen(*moss, 14) { return 178 }
        moss.objects[26] = 9
        if !ShoveyDoorOpen(*moss, 14) || !ShoveyMove(*moss, 2) || moss.player != 14 { return 179 }
        restored_moss: ShoveyGame
        if !ShoveyRestore(*restored_moss, ShoveySave(*moss)) || !ShoveyDoorOpen(*restored_moss, 14) { return 180 }
        moss.objects[26] = 0
        if ShoveyDoorOpen(*moss, 14) { return 181 }
        moss.objects[14] = 9
        if !ShoveyDoorOpen(*moss, 14) { return 182 }
    }
    // Matching normal and initially-open gates always move in opposite
    // directions. Other colours stay untouched, including after save/restore.
    for color: cast(s32)0..3 {
        paired := Floor()
        normal := ifx color == 0 then SHOVEY_GATE else 107 + (color - 1) * 3
        lever := ifx color == 0 then SHOVEY_LEVER else 108 + (color - 1) * 3
        paired.ground[14] = lever
        paired.ground[26] = normal
        paired.ground[27] = SHOVEY_OPEN_GATE + color
        paired.ground[28] = SHOVEY_OPEN_GATE + (color + 1) % 4
        if ShoveyCanEnter(*paired, 26, 10) || !ShoveyCanEnter(*paired, 27, 9) { return 160 }
        if !ShoveyMove(*paired, 2) || !ShoveyCanEnter(*paired, 26, 9) || ShoveyCanEnter(*paired, 27, 10) { return 161 }
        if !ShoveyGateOpen(*paired, 28) { return 162 }
        restored_pair: ShoveyGame
        if !ShoveyRestore(*restored_pair, ShoveySave(*paired)) || ShoveyGateOpen(*restored_pair, 27) { return 163 }
        if !ShoveyMove(*paired, 2) || ShoveyGateOpen(*paired, 26) || !ShoveyGateOpen(*paired, 27) { return 164 }
        // A closing gate waits for its occupant to leave.
        paired.ground[14] = lever + 1
        paired.objects[27] = 9
        if !ShoveyGateOpen(*paired, 27) { return 165 }
        paired.objects[27] = 0
        if ShoveyGateOpen(*paired, 27) { return 166 }
        // Any matching lever toggles the circuit, including the second and
        // third lever. A different colour must remain independent.
        shared := Floor()
        shared.ground[14] = lever
        shared.ground[25] = lever
        shared.ground[37] = lever
        other_lever := ifx color == 3 then SHOVEY_LEVER else 108 + color * 3
        shared.ground[38] = other_lever
        shared.ground[26] = normal
        shared.ground[27] = SHOVEY_OPEN_GATE + color
        if !ShoveyMove(*shared, 2) { return 167 }
        if shared.ground[14] != lever + 1 || shared.ground[25] != lever + 1 || shared.ground[37] != lever + 1 { return 168 }
        if !ShoveyGateOpen(*shared, 26) || ShoveyGateOpen(*shared, 27) || shared.ground[38] != other_lever { return 169 }
        if !ShoveyMove(*shared, 3) { return 170 } // Push the second lever below Shovey.
        if shared.ground[14] != lever || shared.ground[25] != lever || shared.ground[37] != lever { return 171 }
        if ShoveyGateOpen(*shared, 26) || !ShoveyGateOpen(*shared, 27) { return 172 }
        shared.player = 49
        if !ShoveyMove(*shared, 1) || !ShoveyGateOpen(*shared, 26) { return 173 }
        if !ShoveyRestore(*restored_pair, ShoveySave(*shared)) || !ShoveyGateOpen(*restored_pair, 26) { return 174 }
        restored_pair.player = 13
        if !ShoveyMove(*restored_pair, 3) || ShoveyGateOpen(*restored_pair, 26) || !ShoveyGateOpen(*restored_pair, 27) { return 175 }
        // Older saves can have unsynchronised handles. Either handle still
        // closes that active circuit instead of leaving the other one on.
        shared.ground[14] = lever + 1
        shared.ground[25] = lever
        shared.ground[37] = lever
        shared.player = 13
        if !ShoveyMove(*shared, 3) || ShoveyLeversActive(*shared, color) { return 176 }
    }
    door := Floor()
    door.ground[14] = SHOVEY_DOOR
    if ShoveyCanEnter(*door, 14, 9) { return 142 }
    before_door := door
    if !ShoveyMove(*door, 2) || door.player != 14 || door.ground[14] != SHOVEY_DOOR_OPEN || door.moves != 1 || door.keys != 0 { return 143 }
    if !ShoveyCanEnter(*door, 14, 9) || ShoveyEvent(*before_door, *door) != SHOVEY_EVENT_DOOR { return 144 }
    saved_door: ShoveyGame
    if !ShoveyRestore(*saved_door, ShoveySave(*door)) || saved_door.ground[14] != SHOVEY_DOOR_OPEN { return 145 }
    for color: cast(s32)0..2 {
        colored := Floor()
        colored.ground[14] = 108 + color * 3
        for group: cast(s32)0..2 { colored.ground[26 + group] = 107 + group * 3 }
        colored.ground[29] = SHOVEY_GATE
        if !ShoveyMove(*colored, 2) || colored.player != 13 { return 148 }
        for group: cast(s32)0..2 {
            if ShoveyGateOpen(*colored, 26 + group) != (group == color) { return 149 }
        }
        if ShoveyGateOpen(*colored, 29) { return 150 }
        if !ShoveyRestore(*saved_door, ShoveySave(*colored)) || !ShoveyGateOpen(*saved_door, 26 + color) { return 151 }
        if !ShoveyMove(*colored, 2) || ShoveyGateOpen(*colored, 26 + color) { return 152 }
        colored = Floor()
        colored.ground[14] = 116 + color * 2
        if !ShoveyMove(*colored, 2) || colored.player != 14 || colored.ground[14] != 117 + color * 2 { return 153 }
    }
    gate := Floor()
    gate.ground[14] = SHOVEY_LEVER
    gate.ground[26] = SHOVEY_GATE
    if ShoveyCanEnter(*gate, 26, 10) { return 135 }
    if !ShoveyMove(*gate, 2) || gate.player != 13 || gate.ground[14] != SHOVEY_LEVER_ON || !ShoveyCanEnter(*gate, 26, 10) { return 136 }
    restored_gate: ShoveyGame
    if !ShoveyRestore(*restored_gate, ShoveySave(*gate)) || !ShoveyGateOpen(*restored_gate, 26) { return 137 }
    if !ShoveyMove(*gate, 2) || gate.player != 13 || ShoveyCanEnter(*gate, 26, 10) { return 138 }
    gate.powers = SHOVEY_SLIDE
    if !ShoveyMove(*gate, 2) || gate.ground[14] != SHOVEY_LEVER_ON || gate.player != 13 { return 139 }
    animals: [3]s32 = .[SHOVEY_CHICKEN, SHOVEY_TURTLE, SHOVEY_CRAB]
    pieces: [10]s32 = .[1, 2, 3, 9, 19, 28, 36, 53, SHOVEY_BOMB, 44]
    for animal: animals {
        for direction: cast(s32)0..3 {
            walking := Floor()
            walking.ground[78] = animal
            walking.light_from[78] = direction
            for side: cast(s32)0..3 { if side != direction { walking.ground[ShoveyNeighbor(78, side)] = 12 } }
            destination := ShoveyNeighbor(78, direction)
            if !ShoveyAnimalsTick(*walking) || walking.ground[destination] != animal || walking.light_from[destination] != direction { return 140 }
            // Turning at an obstacle records the direction actually walked.
            walking = Floor()
            walking.ground[78] = animal
            walking.light_from[78] = direction
            walking.ground[destination] = 12
            turn := (direction + 1) % 4
            for side: cast(s32)0..3 { if side != turn { walking.ground[ShoveyNeighbor(78, side)] = 12 } }
            destination = ShoveyNeighbor(78, turn)
            if !ShoveyAnimalsTick(*walking) || walking.ground[destination] != animal || walking.light_from[destination] != turn { return 141 }
        }
        blocked := Floor()
        blocked.ground[14] = animal
        if ShoveyMove(*blocked, 2) || blocked.player != 13 || blocked.moves != 0 { return 126 }
        for piece: pieces {
            blocked = Floor()
            blocked.objects[14] = piece
            blocked.ground[15] = animal
            if ShoveyMove(*blocked, 2) || blocked.player != 13 || blocked.objects[14] != piece || blocked.objects[15] != 0 || blocked.ground[15] != animal { return 127 }
            // Once the animal walks away, the same push succeeds.
            if !ShoveyTick(*blocked) || blocked.ground[15] != 0 || !ShoveyMove(*blocked, 2) || blocked.objects[15] == 0 { return 128 }
        }
        blocked = Floor()
        blocked.ground[14] = animal
        blocked.player = 13
        blocked.objects[2] = 9
        blocked.ground[15] = SHOVEY_TURTLE
        blocked.ground[26] = SHOVEY_TREE
        if ShoveyAnimalsTick(*blocked) && blocked.ground[14] != animal { return 129 }
        if blocked.player != 13 || blocked.objects[2] != 9 || blocked.ground[26] != SHOVEY_TREE { return 130 }
    }
    // The first move is not shared by every animal, and is not always up.
    wanderers: [6]s32 = .[SHOVEY_CHICKEN, SHOVEY_TURTLE, SHOVEY_CRAB, 89, 90, 91]
    for animal: wanderers {
        directions: s32 = 0
        for position: cast(s32)50..110 {
            if position % SHOVEY_WIDTH < 2 || position % SHOVEY_WIDTH > 9 { continue }
            wandering := Floor()
            if ShoveyFish(animal) {
                for at: cast(s32)0..SHOVEY_CELLS - 1 { wandering.ground[at] = 64; wandering.tiles[at] = 64 }
            }
            wandering.ground[position] = animal
            wandering.light_from[position] = 4
            if !ShoveyAnimalsTick(*wandering) { return 161 }
            steps: s32 = 0
            for direction: cast(s32)0..3 {
                to := ShoveyNeighbor(position, direction)
                if wandering.ground[to] == animal {
                    if wandering.light_from[to] != direction { return 162 }
                    directions |= 1 << direction
                    steps += 1
                }
            }
            if steps != 1 { return 163 }
        }
        if directions != 15 { return 164 }
    }
    for fish: cast(s32)89..91 {
        pool := Floor()
        pool.ground[26] = fish
        pool.tiles[26] = 64
        pool.ground[27] = 64
        pool.tiles[27] = 64
        pool.light_from[26] = 2
        if !ShoveyTick(*pool) || pool.ground[26] != 64 || pool.ground[27] != fish || pool.light_from[27] != 2 { return 131 }
        if ShoveyCanEnter(*pool, 27, 9) { return 132 }
        if !ShoveyTick(*pool) || pool.ground[26] != fish || pool.ground[27] != 64 || pool.light_from[26] != 0 { return 146 }
        pool.objects[27] = 9
        if ShoveyTick(*pool) || pool.ground[26] != fish || pool.objects[27] != 9 { return 147 }
    }
    portals: [6]s32 = .[73, 74, 75, 85, 86, 87]
    for portal: portals {
        paired := Floor()
        paired.ground[14] = portal
        paired.ground[30] = portal
        paired.ground[48] = ifx portal == 73 then 74 else 73
        if !ShoveyMove(*paired, 2) || paired.player != 30 || paired.teleports != 1 { return 133 }
        paired = Floor()
        paired.objects[14] = 9
        paired.ground[15] = portal
        if ShoveyMove(*paired, 2) || paired.objects[14] != 9 { return 134 }
    }
    game := Floor()
    game.ground[14] = SHOVEY_TREE
    game.decorations[14] = SHOVEY_TREE
    if ShoveyMove(*game, 2) || game.player != 13 { return 120 }
    game = Floor()
    game.objects[14] = 9
    game.ground[15] = SHOVEY_TREE
    if ShoveyMove(*game, 2) || game.objects[14] != 9 { return 121 }
    game = Floor()
    game.ground[26] = SHOVEY_DOG
    game.light_from[26] = 2
    game.ground[27] = SHOVEY_TREE
    game.objects[38] = 9
    game.player = 25
    if !ShoveyAnimalsTick(*game) || game.ground[14] != SHOVEY_DOG || game.ground[26] != 0 { return 122 }
    if game.ground[27] != SHOVEY_TREE || game.objects[38] != 9 || game.player != 25 { return 123 }
    // The animal's exact position and facing survive an ordinary game save.
    saved := ShoveySave(*game)
    restored: ShoveyGame
    if !ShoveyRestore(*restored, saved) || restored.ground[14] != SHOVEY_DOG || restored.light_from[14] != 1 { return 124 }
    if restored.decorations[27] != game.decorations[27] { return 125 }
    // Saving and resuming preserves future wandering, too.
    for step: cast(s32)0..19 {
        if ShoveyAnimalsTick(*restored) != ShoveyAnimalsTick(*game) { return 165 }
        for at: cast(s32)0..SHOVEY_CELLS - 1 {
            if restored.ground[at] != game.ground[at] || restored.light_from[at] != game.light_from[at] { return 166 }
        }
    }
    return 0
}

#program_export
Check :: () -> s32 {
    result := OpenChecks()
    if result != 0 { return result }
    result = ProgressChecks()
    if result != 0 { return result }
    result = EventChecks()
    if result != 0 { return result }
    result = ColorChecks()
    if result != 0 { return result }
    result = CherryChecks()
    if result != 0 { return result }
    result = TileChecks()
    if result != 0 { return result }
    result = TickChecks()
    if result != 0 { return result }
    result = NatureChecks()
    if result != 0 { return result }
    result = BoardChecks()
    if result != 0 { return result }
    return OrientationChecks()
}
