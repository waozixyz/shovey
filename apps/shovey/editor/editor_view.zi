// The Shovey Editor's screens: choose Classic or Island, browse the story
// levels and your own, paint boards, play them with the real engines and
// let the Ziran solver check them, export them for the developer, and
// share level collections where the host offers it.
//
// Custom levels live in the editor's own records (see edit.zi). A story
// level is never changed: the first stroke on one makes a custom copy.
#import "kryon/session"
#import "kryon/geometry"
#import "kryon/drawing_props"
#import "kryon/text_props"
#import "kryon/text_align"
