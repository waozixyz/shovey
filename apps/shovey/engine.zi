// Shovey Classic: a bounded 20 by 12 board, independent of graphics and storage.
#import "text_buffer"
#import, file "levels.zi";

SHOVEY_WIDTH :: 20
SHOVEY_HEIGHT :: 12
SHOVEY_CELLS :: 240
SHOVEY_TRAIL :: 1
SHOVEY_REVERSE :: 2
SHOVEY_CHARGED :: 4
SHOVEY_AMMO :: 8
SHOVEY_SLIDE :: 16

ShoveyGame :: struct {
    ground: [SHOVEY_CELLS]s32
    objects: [SHOVEY_CELLS]s32
    light_from: [SHOVEY_CELLS]s32
    level: s32
    player: s32
    direction: s32
    powers: s32
    keys: s32
    moves: s32
    teleports: s32
    won: bool
    lost: bool
}

ShoveyLevelCount :: () -> s32 { return SHOVEY_LEVEL_COUNT }

// Directions are left, up, right, down. Never wrap an edge into another row.
ShoveyNeighbor :: (position: s32, direction: s32) -> s32 {
    if position < 0 || position >= SHOVEY_CELLS { return -1 }
    if direction == 0 && position % SHOVEY_WIDTH > 0 { return position - 1 }
    if direction == 1 && position >= SHOVEY_WIDTH { return position - SHOVEY_WIDTH }
    if direction == 2 && position % SHOVEY_WIDTH < SHOVEY_WIDTH - 1 { return position + 1 }
    if direction == 3 && position < SHOVEY_CELLS - SHOVEY_WIDTH { return position + SHOVEY_WIDTH }
    return -1
}

ShoveyMovable :: (kind: s32) -> bool {
    return (kind >= 1 && kind <= 3) || kind == 9 || kind == 19 || kind == 28 ||
    (kind >= 36 && kind <= 38) || kind == 40
}

ShoveyDigit :: (byte: u8) -> s32 {
    if byte >= #char "0" && byte <= #char "9" { return cast(s32)(byte - #char "0") }
    if byte >= #char "a" && byte <= #char "f" { return cast(s32)(byte - #char "a") + 10 }
    return -1
}

ShoveyByte :: (text: string, at: s32) -> s32 {
    if at < 0 || at + 1 >= text.count { return -1 }
    high := ShoveyDigit(text[at]); low := ShoveyDigit(text[at + 1])
    if high < 0 || low < 0 { return -1 }
    return high * 16 + low
}

ShoveyLoad :: (game: *ShoveyGame, level: s32) -> bool {
    return ShoveyLoadData(game, level, ShoveyLevelData(level))
}

// Loads a board given as 480 hex digits, one byte per cell in row order.
ShoveyLoadData :: (game: *ShoveyGame, level: s32, data: string) -> bool {
    if data.count != SHOVEY_CELLS * 2 { return false }
    game.* = ShoveyGame.{.level = level, .player = -1, .direction = 1}
    for position: cast(s32)0..SHOVEY_CELLS - 1 {
        kind := ShoveyByte(data, position * 2)
        game.light_from[position] = 4
        if kind == 10 { game.player = position }
        else if ShoveyMovable(kind) { game.objects[position] = kind }
        else { game.ground[position] = kind }
    }
    return game.player >= 0
}

ShoveyDoorOpen :: (game: *ShoveyGame, position: s32) -> bool {
    if game.objects[position] != 0 { return true }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.ground[at] == 13 && game.objects[at] != 0 { return true }
    }
    return false
}

ShoveyRemaining :: (game: *ShoveyGame) -> s32 {
    remaining: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        object := game.objects[at]; ground := game.ground[at]
        if (object >= 1 && object <= 3) || object == 19 || object == 28 || object == 40 || ground == 21 ||
        (ground == 18 && object != 9) || (ground == 39 && object != 36) || ground == 29 || ground == 30 {
            remaining += 1
        }
    }
    return remaining
}

ShoveyFloorAllows :: (game: *ShoveyGame, position: s32, object: s32) -> bool {
    if position < 0 || position >= SHOVEY_CELLS { return false }
    kind := game.ground[position]
    player := object == 10
    if kind == 0 || kind == 13 || kind == 18 || kind == 20 ||
    kind == 29 || kind == 30 || kind == 31 || kind == 41 || kind == 42 || kind == 43 { return true }
    if kind == 14 { return ShoveyDoorOpen(game, position) }
    if kind >= 4 && kind <= 6 { return player || object == kind - 3 }
    if kind >= 15 && kind <= 17 { return player || (object >= 1 && object <= 3) }
    if kind == 39 { return player || (object >= 36 && object <= 38) }
    if kind == 26 { return player && (game.powers & SHOVEY_AMMO) == 0 }
    if kind == 7 || kind == 8 || kind == 11 || kind == 21 || kind == 25 ||
    kind == 27 || kind == 33 || kind == 35 { return player }
    return false
}

ShoveyCanEnter :: (game: *ShoveyGame, position: s32, object: s32) -> bool {
    return position >= 0 && position < SHOVEY_CELLS && game.objects[position] == 0 &&
    ShoveyFloorAllows(game, position, object)
}

ShoveyPush :: (game: *ShoveyGame, from: s32, direction: s32) -> bool {
    object := game.objects[from]
    to := ShoveyNeighbor(from, direction)
    if !ShoveyMovable(object) || object == 40 || to == game.player || !ShoveyCanEnter(game, to, object) { return false }
    ground := game.ground[to]
    game.objects[from] = 0
    if ground == 42 { game.ground[to] = 23 }
    if ground >= 4 && ground <= 6 && object == ground - 3 { return true }
    if ground >= 15 && ground <= 17 && object >= 1 && object <= 3 {
        object = ground - 14
        game.ground[to] = 0
    }
    if object >= 36 && object <= 38 {
        object = ifx object == 38 then 36 else object + 1
    }
    game.objects[to] = object
    if object == 19 {
        touching := false
        for side: cast(s32)0..3 {
            neighbor := ShoveyNeighbor(to, side)
            if neighbor >= 0 && game.objects[neighbor] == 19 {
                touching = true
                game.objects[neighbor] = 0
            }
        }
        if touching { game.objects[to] = 0 }
    }
    return true
}

// The shadow mirrors every accepted move, then the game tests whether both
// actors meet. Walls and failed pushes do not move the shadow, and neither
// does home: the shadow only crosses plain floor.
ShoveyShadowAdvance :: (game: *ShoveyGame, direction: s32) {
    shadow: s32 = -1
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.objects[at] == 40 { shadow = at; break }
    }
    if shadow < 0 { return }
    to := ShoveyNeighbor(shadow, (direction + 2) % 4)
    if to >= 0 && game.objects[to] == 0 && game.ground[to] == 0 {
        game.objects[shadow] = 0
        shadow = to
        game.objects[shadow] = 40
    }
    if shadow == game.player { game.objects[shadow] = 0 }
}

ShoveySensor :: (game: *ShoveyGame, position: s32) {
    another := false
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if at != position && game.ground[at] == 41 { another = true }
    }
    if !another { game.ground[position] = 41; return }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if at == position || game.ground[at] == 41 {
            game.ground[at] = ifx game.objects[at] == 0 then 23 else 42
        }
    }
}

ShoveyStep :: (game: *ShoveyGame, direction: s32) -> bool {
    to := ShoveyNeighbor(game.player, direction)
    if to < 0 { return false }
    if game.ground[to] == 34 && game.keys > 0 {
        game.keys -= 1
        game.ground[to] = 0
        return true
    }
    // Decide floor entry before moving an object: pushing the crate off a
    // door must allow Shovey to follow it through that previously open door.
    // Conversely, a solid floor must never move an object as a side effect.
    if !ShoveyFloorAllows(game, to, 10) { return false }
    if game.objects[to] != 0 && game.objects[to] != 40 && !ShoveyPush(game, to, direction) { return false }
    kind := game.ground[to]
    game.player = to
    ShoveyShadowAdvance(game, direction)
    if kind == 8 {
        // Teleporting scans columns first and takes the first other free portal.
        destination: s32 = -1
        for x: cast(s32)0..SHOVEY_WIDTH - 1 {
            for y: cast(s32)0..SHOVEY_HEIGHT - 1 {
                at := y * SHOVEY_WIDTH + x
                if at != to && game.ground[at] == 8 && game.objects[at] == 0 {
                    destination = at
                    break
                }
            }
            if destination >= 0 { break }
        }
        if destination >= 0 {
            to = destination
            game.player = to
            ShoveyShadowAdvance(game, direction)
            game.teleports += 1
        }
    }
    game.player = to
    game.moves += 1
    if kind == 11 { game.powers = game.powers | SHOVEY_TRAIL }
    if kind == 25 { game.powers = game.powers | SHOVEY_REVERSE; game.ground[to] = 0 }
    if kind == 26 { game.powers = game.powers | SHOVEY_AMMO; game.ground[to] = 0 }
    if kind == 35 { game.powers = game.powers | SHOVEY_SLIDE; game.ground[to] = 0 }
    if kind == 21 { game.ground[to] = 0 }
    if kind == 33 { game.keys += 1; game.ground[to] = 0 }
    if kind == 27 {
        if (game.powers & SHOVEY_CHARGED) != 0 { game.lost = true }
        else { game.powers = game.powers | SHOVEY_CHARGED }
    }
    if kind == 20 || kind == 41 { ShoveySensor(game, to) }
    if kind == 42 { game.ground[to] = 23 }
    if game.ground[to] == 0 && (game.powers & SHOVEY_TRAIL) != 0 { game.ground[to] = 11 }
    if kind == 7 && ShoveyRemaining(game) == 0 { game.won = true }
    return true
}

ShoveyMove :: (game: *ShoveyGame, direction: s32) -> bool {
    if direction < 0 || direction > 3 || game.won || game.lost || game.level == SHOVEY_LEVEL_COUNT { return false }
    if (game.powers & SHOVEY_REVERSE) != 0 { direction = (direction + 2) % 4 }
    game.direction = direction
    slide := (game.powers & SHOVEY_SLIDE) != 0
    changed := ShoveyStep(game, direction)
    if slide && changed {
        visited: [SHOVEY_CELLS]bool
        while !game.won && !game.lost && !visited[game.player] {
            visited[game.player] = true
            if !ShoveyStep(game, direction) { break }
        }
    }
    return changed
}

ShoveyFire :: (game: *ShoveyGame) -> bool {
    if game.won || game.lost || game.level == SHOVEY_LEVEL_COUNT || (game.powers & SHOVEY_AMMO) == 0 { return false }
    game.powers = game.powers & ~SHOVEY_AMMO
    at := ShoveyNeighbor(game.player, game.direction)
    while at >= 0 {
        ground := game.ground[at]
        object := game.objects[at]
        // A shot pierces targets but stops at solid objects,
        // walls, doors and pickups. In particular a star survives the shot.
        if object == 28 { game.objects[at] = 0 }
        else if (object >= 1 && object <= 3) || object == 9 || object == 19 ||
        (object >= 36 && object <= 38) || ground == 12 || ground == 14 ||
        ground == 26 || ground == 33 || ground == 34 { break }
        at = ShoveyNeighbor(at, game.direction)
    }
    game.moves += 1
    return true
}

// What one move or shot did that is worth hearing. The engine reports no
// events, so the view keeps the board from before and compares.
SHOVEY_EVENT_NONE :: 0
SHOVEY_EVENT_PUSH :: 1
SHOVEY_EVENT_PIT :: 2
SHOVEY_EVENT_GOAL :: 3
SHOVEY_EVENT_PICKUP :: 4
SHOVEY_EVENT_DOOR :: 5
SHOVEY_EVENT_TELEPORT :: 6
SHOVEY_EVENT_SHOT :: 7
SHOVEY_EVENT_WON :: 8
SHOVEY_EVENT_LOST :: 9

ShoveyTally :: struct {
    balls: s32
    apples: s32
    closed: s32
}

ShoveyCount :: (game: *ShoveyGame) -> ShoveyTally {
    tally: ShoveyTally
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        object := game.objects[at]; ground := game.ground[at]
        if object >= 1 && object <= 3 { tally.balls += 1 }
        if ground == 21 { tally.apples += 1 }
        if ground == 34 || (ground == 14 && !ShoveyDoorOpen(game, at)) { tally.closed += 1 }
    }
    return tally
}

// The most meaningful event first; a plain step is quiet.
ShoveyEvent :: (before: *ShoveyGame, after: *ShoveyGame) -> s32 {
    if after.won && !before.won { return SHOVEY_EVENT_WON }
    if after.lost && !before.lost { return SHOVEY_EVENT_LOST }
    was := ShoveyCount(before); now := ShoveyCount(after)
    if now.balls < was.balls { return SHOVEY_EVENT_PIT }
    // A crate or colour block on its goal, stars that meet, a target or
    // the shadow cleared. An eaten apple is a pickup, not a goal.
    if ShoveyRemaining(after) + was.apples - now.apples < ShoveyRemaining(before) { return SHOVEY_EVENT_GOAL }
    if now.closed < was.closed { return SHOVEY_EVENT_DOOR }
    if after.teleports > before.teleports { return SHOVEY_EVENT_TELEPORT }
    if now.apples < was.apples || after.keys > before.keys || (after.powers & ~before.powers) != 0 { return SHOVEY_EVENT_PICKUP }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        // The shadow moves by itself with every step.
        if before.objects[at] != after.objects[at] && before.objects[at] != 40 && after.objects[at] != 40 { return SHOVEY_EVENT_PUSH }
    }
    if (before.powers & SHOVEY_AMMO) != 0 && (after.powers & SHOVEY_AMMO) == 0 { return SHOVEY_EVENT_SHOT }
    return SHOVEY_EVENT_NONE
}

// Each tick advances every autonomous block once, as one simultaneous step.
// A blocked tick chooses its next direction; movement starts on the following
// tick. Blocks that start beside each other cannot exchange or follow into a
// cell together. Fresh path takes priority over visited path, with
// axis-dependent turn ordering.
ShoveyTick :: (game: *ShoveyGame) -> bool {
    if game.won || game.lost || game.level == SHOVEY_LEVEL_COUNT { return false }
    occupied: [SHOVEY_CELLS]bool
    reserved: [SHOVEY_CELLS]bool
    for at: cast(s32)0..SHOVEY_CELLS - 1 { occupied[at] = false; reserved[at] = false }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.ground[at] == 29 { occupied[at] = true }
    }
    moved := false
    for block: cast(s32)0..SHOVEY_CELLS - 1 {
        if !occupied[block] { continue }
        direction := game.light_from[block]
        if direction == 4 { direction = 1 }
        to := ShoveyNeighbor(block, direction)
        if to < 0 || occupied[to] || reserved[to] || game.objects[to] != 0 ||
        (game.ground[to] != 30 && game.ground[to] != 31) { to = -1 }
        if to < 0 {
            order: [4]s32 = .[2, 0, 1, 3]
            if direction == 0 || direction == 2 {
                order[0] = 1; order[1] = 3; order[2] = 2; order[3] = 0
            }
            for terrain: cast(s32)30..31 {
                for next: order {
                    neighbor := ShoveyNeighbor(block, next)
                    if neighbor >= 0 && !occupied[neighbor] && !reserved[neighbor] &&
                    game.objects[neighbor] == 0 && game.ground[neighbor] == terrain {
                        game.light_from[block] = next
                        break
                    }
                }
                if game.light_from[block] != 4 && game.light_from[block] != direction { break }
            }
            if game.light_from[block] == direction { game.ground[block] = 31 }
            moved = true
            continue
        }
        game.ground[block] = 31
        game.ground[to] = 29
        game.light_from[block] = 4
        game.light_from[to] = direction
        reserved[to] = true
        moved = true
    }
    return moved
}

save_bytes: [1472]u8;

ShoveyHexWrite :: (value: s32, at: s32, digits: s32) {
    alphabet := "0123456789abcdef"
    for index: cast(s32)0..digits - 1 {
        shift := (digits - index - 1) * 4
        save_bytes[at + index] = alphabet[(value >> shift) & 15]
    }
}

// A borrowed, fixed-size save buffer. The host copies the record during
// SaveAppRecordHost; no frame or move accumulates allocated save strings.
ShoveySave :: (game: *ShoveyGame) -> string {
    save_bytes[0] = #char "P"; save_bytes[1] = #char "1"
    ShoveyHexWrite(game.level, 2, 2)
    ShoveyHexWrite(game.player, 4, 2)
    ShoveyHexWrite(game.direction, 6, 2)
    ShoveyHexWrite(game.powers, 8, 2)
    ShoveyHexWrite(game.keys, 10, 2)
    ShoveyHexWrite(game.moves, 12, 8)
    ShoveyHexWrite(game.teleports, 20, 8)
    ShoveyHexWrite(ifx game.won then 1 else 0, 28, 2)
    ShoveyHexWrite(ifx game.lost then 1 else 0, 30, 2)
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ShoveyHexWrite(game.ground[at], 32 + at * 6, 2)
        ShoveyHexWrite(game.objects[at], 34 + at * 6, 2)
        ShoveyHexWrite(game.light_from[at], 36 + at * 6, 2)
    }
    return TextView(save_bytes[:])
}

ShoveyRestore :: (game: *ShoveyGame, text: string) -> bool {
    if text.count != 32 + SHOVEY_CELLS * 6 || text[:2] != "P1" { return false }
    restored: ShoveyGame
    restored.level = ShoveyByte(text, 2)
    restored.player = ShoveyByte(text, 4)
    restored.direction = ShoveyByte(text, 6)
    restored.powers = ShoveyByte(text, 8)
    restored.keys = ShoveyByte(text, 10)
    if restored.level < 1 || restored.level > SHOVEY_LEVEL_COUNT || restored.player < 0 || restored.player >= SHOVEY_CELLS ||
    restored.direction < 0 || restored.direction > 3 || restored.powers < 0 || restored.powers > 31 || restored.keys < 0 { return false }
    for index: cast(s32)0..7 {
        digit := ShoveyDigit(text[12 + index])
        if digit < 0 || (index == 0 && digit >= 8) { return false }
        restored.moves = restored.moves * 16 + digit
        digit = ShoveyDigit(text[20 + index])
        if digit < 0 || (index == 0 && digit >= 8) { return false }
        restored.teleports = restored.teleports * 16 + digit
    }
    won := ShoveyByte(text, 28); lost := ShoveyByte(text, 30)
    if won < 0 || won > 1 || lost < 0 || lost > 1 { return false }
    restored.won = won == 1; restored.lost = lost == 1
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ground := ShoveyByte(text, 32 + at * 6)
        object := ShoveyByte(text, 34 + at * 6)
        source := ShoveyByte(text, 36 + at * 6)
        if ground < 0 || ground > 43 || object < 0 || (object != 0 && !ShoveyMovable(object)) || source < 0 || source > 4 { return false }
        if ShoveyMovable(ground) || ground == 10 || ground == 22 || ground == 24 || ground == 32 { return false }
        restored.ground[at] = ground; restored.objects[at] = object; restored.light_from[at] = source
    }
    if restored.objects[restored.player] != 0 || restored.ground[restored.player] == 12 ||
    restored.ground[restored.player] == 34 { return false }
    game.* = restored
    return true
}
