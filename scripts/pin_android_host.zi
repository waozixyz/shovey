// Pins the Arcade commit, and its locked Ziran, that build the Android APK:
//
//     ziran run --target=c scripts/pin_android_host.zi -- COMMIT [--arcade DIR]
//
// The pinned commit must record this release in apps/versions.json, so the
// publisher pins the Arcade commit it has just recorded and pushed. Builders
// fetch the pin from GitHub, so it must already be on Arcade's origin/master.
#import "std/file"
#import "std/json_document"
#import "std/stdio_linux"
#import "std/text_tools"
#import "shovey_tools"

ANDROID_PROJECT :: "packaging/android";
ANDROID_HOST :: "https://github.com/waozixyz/arcade.git";

// The lock's identity of a package at a commit, as Ziran derives it.
PackageId :: (url: string, commit: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "%\n%", url, commit)
    digest := Sha256Text(BuilderFinish(text))
    id: Vec(u8)
    BuilderPrint(*id, "p%", digest[0:16])
    return BuilderFinish(id)
}

// TEXT with the 40-digit ref after a "[SECTION]\ngit = \"...\"\nref = \""
// heading replaced by COMMIT; "" when the section is not there.
PinRef :: (text: string, section: string, commit: string) -> string {
    heading: Vec(u8)
    BuilderPrint(*heading, "[%]\ngit = \"", section)
    start := TextFind(text, BuilderFinish(heading))
    if start < 0 { return "" }
    line_end := TextFind(text, "\"\nref = \"", start)
    if line_end < 0 || TextFind(text[start:line_end], "\n") >= 0 { return "" }
    at := line_end + 9
    if at + 41 > text.count || !TextIsLowerHex(text[at:at + 40]) || text[at + 40] != #char "\"" { return "" }
    result: Vec(u8)
    BuilderAppend(result, text[0:at])
    BuilderAppend(result, commit)
    BuilderAppend(result, text[at + 40:text.count])
    return BuilderFinish(result)
}

Quoted :: (value: string) -> string {
    text: Vec(u8)
    BuilderPrint(*text, "\"%\"", value)
    return BuilderFinish(text)
}

main :: (argc: s32, argv: **u8) -> s32 {
    arguments := ToolArguments(argc, argv)
    requested := ""
    arcade := "../arcade"
    index: s64 = 0
    while index < arguments.count {
        if arguments[index] == "--arcade" && index + 1 < arguments.count { arcade = arguments[index + 1]; index += 2; continue }
        if requested.count == 0 && !TextHasPrefix(arguments[index], "-") { requested = arguments[index]; index += 1; continue }
        return Fail("usage: pin_android_host COMMIT [--arcade DIR]")
    }
    if requested.count == 0 { return Fail("usage: pin_android_host COMMIT [--arcade DIR]") }
    if !InShovey() { return Fail("Run pin_android_host from Shovey's folder") }
    verify: [4]string = .["git", "rev-parse", "--verify", ""]
    object: Vec(u8)
    BuilderPrint(*object, "%^{commit}", requested)
    verify[3] = BuilderFinish(object)
    commit, found := CommandOutput(verify[:], arcade)
    if !found || commit.count != 40 { return Fail("The Arcade commit is not in the Arcade checkout") }
    ancestor: [5]string = .["git", "merge-base", "--is-ancestor", commit, "origin/master"]
    if !RunCommand(ancestor[:], arcade) { return Fail("Push the Arcade commit to origin/master before pinning it") }
    show: [3]string = .["git", "show", ""]
    lock_object: Vec(u8)
    BuilderPrint(*lock_object, "%:ziran.lock", commit)
    show[2] = BuilderFinish(lock_object)
    arcade_lock, shown := CommandOutput(show[:], arcade)
    host_lock: JsonDocument
    if !shown || !JsonRead(*host_lock, arcade_lock) { return Fail("Cannot read that Arcade commit's ziran.lock") }
    toolchain := JsonMember(*host_lock, host_lock.root, "toolchain")
    toolchain_commit := JsonString(*host_lock, JsonMember(*host_lock, toolchain, "commit"))
    toolchain_url := JsonString(*host_lock, JsonMember(*host_lock, toolchain, "url"))
    manifest_path := JoinPath(ANDROID_PROJECT, "ziran.toml")
    lock_path := JoinPath(ANDROID_PROJECT, "ziran.lock")
    manifest, read_manifest := ReadEntireFile(manifest_path)
    lock_text, read_lock := ReadEntireFile(lock_path)
    if !read_manifest || !read_lock { return Fail("Cannot read packaging/android") }
    manifest = PinRef(manifest, "toolchain", toolchain_commit)
    if manifest.count > 0 { manifest = PinRef(manifest, "dependencies.host", commit) }
    if manifest.count == 0 { return Fail("packaging/android/ziran.toml has no pinned toolchain and host") }
    // Replace the pinned values in place, keeping the lock in Ziran's format.
    lock: JsonDocument
    if !JsonRead(*lock, lock_text) { return Fail("packaging/android/ziran.lock is not JSON") }
    host := JsonFirst(*lock, JsonMember(*lock, lock.root, "packages"))
    pinned_toolchain := JsonMember(*lock, lock.root, "toolchain")
    if !JsonIs(*lock, JsonMember(*lock, host, "name"), "host") || !JsonIs(*lock, JsonMember(*lock, host, "url"), ANDROID_HOST) ||
        !JsonIs(*lock, JsonMember(*lock, pinned_toolchain, "url"), toolchain_url) {
        return Fail("packaging/android/ziran.lock does not pin the Arcade host and its Ziran")
    }
    olds: [3]string
    news: [3]string
    olds[0] = JsonString(*lock, JsonMember(*lock, host, "id"))
    news[0] = PackageId(ANDROID_HOST, commit)
    olds[1] = JsonString(*lock, JsonMember(*lock, host, "commit"))
    news[1] = commit
    olds[2] = JsonString(*lock, JsonMember(*lock, pinned_toolchain, "commit"))
    news[2] = toolchain_commit
    for index: 0..2 { lock_text = TextReplace(lock_text, Quoted(olds[index]), Quoted(news[index])) }
    if !WriteEntireFile(manifest_path, manifest) || !WriteEntireFile(lock_path, lock_text) { return Fail("Cannot write packaging/android") }
    report: Vec(u8)
    BuilderPrint(*report, "Android host: Arcade %, Ziran %\n", commit, toolchain_commit)
    WriteOutput(BuilderFinish(report))
    return 0
}
