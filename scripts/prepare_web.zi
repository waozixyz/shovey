// Stages the built game and editor resources for their shared browser host,
// after build_bundles:
//
//     ziran run --target=c scripts/prepare_web.zi
//
// The editor offers only Classic until Island is for sale, so the browser
// build leaves Island's pictures out; that keeps runtime.data under the
// Cloudflare Pages file limit. The developer's private Island editor keeps
// them (SHOVEY_ISLAND_EDITOR=1). The editor reads Classic's pictures and
// sounds from Shovey's own folder on the page, so its packed copies stay out.
#import "std/environment_linux"
#import "std/file"
#import "std/file_tree_linux"
#import "std/json_document"
#import "std/text_tools"
#import "shovey_tools"
#import "locale_code"

main :: (argc: s32, argv: **u8) -> s32 {
    if argc > 1 { return Fail("usage: prepare_web") }
    if !InShovey() { return Fail("Run prepare_web from Shovey's folder") }
    assets := "build/web-assets/assets"
    if !RemoveTree(assets) || !CreateDirectories(assets) { return Fail("Cannot prepare build/web-assets") }
    names: [2]string = .["shovey", "shovey-editor"]
    for names {
        staged := JoinPath(JoinPath(JoinPath("build/game-assets", it), "assets"), it)
        if !CopyTree(staged, JoinPath(assets, it)) { return Fail("Build the bundles before preparing the web build") }
    }
    if EnvironmentText("SHOVEY_ISLAND_EDITOR") != "1" { RemoveTree(JoinPath(assets, "shovey-editor/island")) }
    RemoveTree(JoinPath(assets, "shovey-editor/classic"))
    code: Vec(u8)
    manifests: [2]string = .["src/catalog.json", "src/editor/catalog.json"]
    functions: [2]string = .["GameLocaleText", "EditorLocaleText"]
    for index: 0..1 {
        descriptor: JsonDocument
        if !ReadJsonFile(manifests[index], *descriptor) { return Fail("Cannot read an edition's catalog") }
        locales := JsonString(*descriptor, JsonMember(*descriptor, descriptor.root, "locales"))
        prefix := JsonString(*descriptor, JsonMember(*descriptor, descriptor.root, "locale_prefix"))
        translations := LocaleCode(locales, prefix)
        if translations.error.count > 0 { return Fail(translations.error) }
        if index > 0 { VecPush(code, cast(u8)10) }
        BuilderAppend(code, TextReplace(translations.code, "GameLocaleText", functions[index]))
    }
    if !CreateDirectories("build/web-generated") ||
        !WriteEntireFile("build/web-generated/translations.zi", BuilderFinish(code)) {
        return Fail("Cannot write build/web-generated/translations.zi")
    }
    return 0
}
