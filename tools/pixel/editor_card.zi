// Draws the Shovey Editor's game card from Classic's own pictures: a board
// being built beside its pieces. Run from Shovey's root on a display (make
// editor-card runs it on a private one):
//
//     KRYON_CAPTURE_PATH=assets/shovey-editor/preview.png build/card/editor-card
#import "c_string"
#import "cairo_raster"
#import "desktop_runtime"
#import "session"
#import "geometry"
#import "drawing_props"
#import "image_props"
#import "image_widget"
#import "box_props"
#import "box_widget"
#import "tree"
#import "tree_draw"
#import "tile_map"
#import, file "../../src/engine.zi";
#import, file "../../src/shovey_board.zi";
#import, file "../../src/editor/edit.zi";

CARD_WIDTH :: 480
CARD_HEIGHT :: 288

session: Session;
classic: ShoveyGame;
names: [SPRITE_COUNT]string;

// A courtyard half built: crates for their corners, balls for their pits,
// a key for its lock, and Shovey on the way.
ClassicCard :: () {
    board := EditNewBoard()
    pieces: [16]s32 = .[9, 23, 18, 36, 9, 63, 18, 96, 1, 66, 4, 112, 2, 129, 5, 133]
    for at: cast(s32)0..7 { unused EditPaint(*board, pieces[at * 2], pieces[at * 2 + 1]) }
    walls: [10]s32 = .[47, 67, 87, 107, 127, 52, 72, 92, 172, 173]
    for wall: walls { unused EditPaint(*board, 12, wall) }
    unused EditPaint(*board, 33, 145)
    unused EditPaint(*board, 34, 157)
    unused EditPaint(*board, 21, 186)
    classic = ShoveyGame.{.player = -1, .direction = 2}
    for at: cast(s32)0..EDIT_CELLS - 1 {
        kind := cast(s32)board.ground[at]
        classic.light_from[at] = 4
        if kind == CLASSIC_SHOVEY { classic.player = at }
        else if ShoveyMovable(kind) { classic.objects[at] = kind }
        else { classic.ground[at] = kind }
    }
}

Picture :: (key: u64, path: string, bounds: Rectangle) {
    Image(session, ImageProps.{.key = key, .asset_path = path, .bounds = bounds, .fit = ImageFit.ImageFitContain, .smooth = true})
}

// A palette of pieces in a column of rows, the chosen one marked.
Palette :: (key: u64, x: float32, y: float32, columns: s32, pictures: []string, floor: string, chosen: s32) {
    size: float32 = 34.0
    for index: cast(s32)0..cast(s32)pictures.count - 1 {
        cell := Rectangle.{x + cast(float32)(index % columns) * (size + 6.0), y + cast(float32)(index / columns) * (size + 6.0), size, size}
        unused Box(session, BoxProps.{.key = key + cast(u64)(index * 4), .bounds = Rectangle.{cell.x - 3.0, cell.y - 3.0, size + 6.0, size + 6.0},
                .fill = ifx index == chosen then Color.{86, 160, 140, 255} else Color.{214, 222, 218, 255}, .radius = 6.0})
        Picture(key + cast(u64)(index * 4 + 1), floor, cell)
        Picture(key + cast(u64)(index * 4 + 2), pictures[index], cell)
    }
}

Draw :: () -> bool {
    BeginDesktopFrame()
    viewport := DesktopViewport()
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk { return false }
    unused Box(session, BoxProps.{.key = 1, .bounds = Rectangle.{0.0, 0.0, cast(float32)CARD_WIDTH, cast(float32)CARD_HEIGHT},
            .fill = Color.{236, 241, 238, 255}})
    grid := ShoveyBoard(session, *classic, Rectangle.{10.0, 10.0, 320.0, 192.0}, cast(u64)1000, 0.0, names[:], true)
    // The cell being painted, under the pointer.
    cell := TileMapCell(grid, 109)
    unused Box(session, BoxProps.{.key = 3000, .bounds = Rectangle.{cell.x - 1.0, cell.y - 1.0, cell.width + 2.0, cell.height + 2.0},
            .fill = Color.{255, 196, 110, 140}, .radius = 2.0})
    classic_pieces: [7]string = .[SpriteFile(9), SpriteFile(18), SpriteFile(1), SpriteFile(4), SpriteFile(12), SpriteFile(33), SpriteFile(21)]
    Palette(4000, 13.0, 222.0, 7, classic_pieces[:], SpriteFile(0), 0)
    // More of the palette beside the board: walls, doors, keys and scenery.
    more_pieces: [12]string = .[SpriteFile(2), SpriteFile(5), SpriteFile(3), SpriteFile(6), SpriteFile(7), SpriteFile(19),
    SpriteFile(34), SpriteFile(36), SpriteFile(38), SpriteFile(15), SpriteFile(16), SpriteFile(17)]
    Palette(8000, 351.0, 22.0, 3, more_pieces[:], SpriteFile(0), 4)
    if EndFrame(session) != FrameStatus.FrameOk { return false }
    return EndDesktopFrame()
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    board_guides = false
    ClassicCard()
    if !OpenDesktopSized(CARD_WIDTH, CARD_HEIGHT) {
        CloseDesktop()
        return 1
    }
    session = SessionOpen()
    if !SessionValid(session) {
        CloseDesktop()
        return 1
    }
    ok := Draw() && Draw() && CaptureConfigured()
    SessionClose(session)
    CloseDesktop()
    return ifx ok then 0 else 1
}
