// Shortens winning Classic routes. Walks between pushes take the shortest
// way the engine allows, and loops that bring the board back to an earlier
// state are cut. A route is only replaced by one the engine replays to a
// win; moves after the win are dropped.
#import "std/text_buffer"
#import, file "../../src/engine.zi";

ROUTES_MAX :: 32768

routes_out: [2][ROUTES_MAX]u8;
routes_best: [ROUTES_MAX]u8;
routes_check: [ROUTES_MAX]u8;
routes_hash: [ROUTES_MAX + 1]u32;
routes_from: [SHOVEY_CELLS]s32;
routes_step: [SHOVEY_CELLS]s32;
routes_queue: [SHOVEY_CELLS]s32;
routes_walk: [SHOVEY_CELLS]u8;

RoutesLetter :: (action: s32) -> u8 {
    letters := "0123ft"
    return letters[action]
}

RoutesAction :: (letter: u8) -> s32 {
    if letter >= #char "0" && letter <= #char "3" { return cast(s32)(letter - #char "0") }
    if letter == #char "f" { return 4 }
    if letter == #char "t" { return 5 }
    return -1
}

RoutesAct :: (game: *ShoveyGame, action: s32) {
    if action >= 0 && action <= 3 { unused ShoveyMove(game, action) }
    else if action == 4 { unused ShoveyFire(game) }
    else if action == 5 { unused ShoveyTick(game) }
}

// Everything but Shovey's cell and facing is the same.
RoutesSameBoard :: (a: *ShoveyGame, b: *ShoveyGame) -> bool {
    if a.powers != b.powers || a.keys != b.keys || a.won != b.won || a.lost != b.lost { return false }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if a.objects[at] != b.objects[at] || a.ground[at] != b.ground[at] || a.tiles[at] != b.tiles[at] ||
        a.light_from[at] != b.light_from[at] { return false }
    }
    return true
}

RoutesSame :: (a: *ShoveyGame, b: *ShoveyGame) -> bool {
    return a.player == b.player && a.direction == b.direction && RoutesSameBoard(a, b)
}

RoutesHash :: (game: *ShoveyGame) -> u32 {
    hash: u32 = 2166136261
    hash = (hash ^ cast(u32)game.player) * cast(u32)16777619
    hash = (hash ^ cast(u32)game.direction) * cast(u32)16777619
    hash = (hash ^ cast(u32)(game.powers * 64 + game.keys)) * cast(u32)16777619
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        hash = (hash ^ cast(u32)(game.objects[at] * 4096 + game.ground[at] * 8 + game.light_from[at])) * cast(u32)16777619
    }
    return hash
}

// The shortest walk from Shovey's cell in start to `target` that changes
// nothing but Shovey's cell, written to routes_walk; its length, or -1.
RoutesWalk :: (start: *ShoveyGame, target: s32) -> s32 {
    for at: cast(s32)0..SHOVEY_CELLS - 1 { routes_from[at] = -2 }
    routes_from[start.player] = -1
    routes_queue[0] = start.player
    head: s32 = 0
    tail: s32 = 1
    while head < tail && routes_from[target] == -2 {
        cell := routes_queue[head]
        head += 1
        for direction: cast(s32)0..3 {
            game := start.*
            game.player = cell
            if !ShoveyMove(*game, direction) || game.player == cell || !RoutesSameBoard(start, *game) { continue }
            if routes_from[game.player] != -2 { continue }
            routes_from[game.player] = cell
            routes_step[game.player] = direction
            routes_queue[tail] = game.player
            tail += 1
        }
    }
    if routes_from[target] == -2 { return -1 }
    length: s32 = 0
    cell := target
    while cell != start.player {
        routes_walk[length] = RoutesLetter(routes_step[cell])
        length += 1
        cell = routes_from[cell]
    }
    // The walk was gathered backwards.
    for at: cast(s32)0..length / 2 - 1 {
        swap := routes_walk[at]
        routes_walk[at] = routes_walk[length - 1 - at]
        routes_walk[length - 1 - at] = swap
    }
    return length
}

// Replaces every run of plain walking with the shortest walk to the same
// cell. A walk before a shot keeps its own steps, as its facing aims.
RoutesShortenWalks :: (data: string, route: []u8, out: []u8) -> s32 {
    game: ShoveyGame
    if !ShoveyLoadData(*game, 0, data) { return -1 }
    length: s32 = 0
    at: s64 = 0
    while at < route.count && !game.won && !game.lost {
        action := RoutesAction(route[at])
        if action < 0 { return -1 }
        if action <= 3 {
            walked := game
            end := at
            while end < route.count {
                step := RoutesAction(route[end])
                if step < 0 || step > 3 { break }
                next := walked
                unused ShoveyMove(*next, step)
                if !RoutesSameBoard(*walked, *next) { break }
                walked = next
                end += 1
            }
            if end > at {
                aimed := end < route.count && route[end] == #char "f"
                steps := ifx aimed then -1 else RoutesWalk(*game, walked.player)
                if steps < 0 {
                    for letter: route[at:end] {
                        if length >= cast(s32)out.count { return -1 }
                        out[length] = letter
                        length += 1
                    }
                } else {
                    if length + steps > cast(s32)out.count { return -1 }
                    for index: cast(s32)0..steps - 1 { out[length + index] = routes_walk[index] }
                    length += steps
                }
                game = walked
                at = end
                continue
            }
        }
        if length >= cast(s32)out.count { return -1 }
        RoutesAct(*game, action)
        out[length] = route[at]
        length += 1
        at += 1
    }
    return ifx game.won && !game.lost then length else -1
}

// Cuts every stretch of the route that returns to an earlier state.
RoutesCutLoops :: (data: string, route: []u8, out: []u8) -> s32 {
    game: ShoveyGame
    if !ShoveyLoadData(*game, 0, data) { return -1 }
    length: s32 = 0
    routes_hash[0] = RoutesHash(*game)
    for letter: route {
        if game.won { break }
        action := RoutesAction(letter)
        if action < 0 || length >= cast(s32)out.count { return -1 }
        RoutesAct(*game, action)
        out[length] = letter
        length += 1
        hash := RoutesHash(*game)
        // Look back for the same state; replaying the prefix confirms it.
        cut: s32 = -1
        for earlier: cast(s32)0..length - 1 {
            if routes_hash[earlier] != hash { continue }
            before: ShoveyGame
            unused ShoveyLoadData(*before, 0, data)
            for index: cast(s32)0..earlier - 1 { RoutesAct(*before, RoutesAction(out[index])) }
            if RoutesSame(*before, *game) { cut = earlier; break }
        }
        if cut >= 0 { length = cut }
        routes_hash[length] = hash
    }
    return ifx game.won && !game.lost then length else -1
}

RoutesWins :: (data: string, route: string) -> bool {
    for at: cast(s64)0..route.count - 1 { routes_check[at] = route[at] }
    return RoutesWinBytes(data, routes_check[0:route.count])
}

RoutesWinBytes :: (data: string, route: []u8) -> bool {
    game: ShoveyGame
    if !ShoveyLoadData(*game, 0, data) { return false }
    for letter: route {
        if game.won { break }
        action := RoutesAction(letter)
        if action < 0 { return false }
        RoutesAct(*game, action)
        if game.lost { return false }
    }
    return game.won
}

RoutesKeep :: (from: []u8, length: s32) {
    for at: cast(s32)0..length - 1 { routes_best[at] = from[at] }
}

// The shortest winning route this finds for a board of 480 to 1440 hex
// digits, borrowed until the next call; route itself when nothing shorter
// wins.
RoutesShorten :: (data: string, route: string) -> string {
    if route.count > ROUTES_MAX || !RoutesWins(data, route) { return route }
    for at: cast(s64)0..route.count - 1 { routes_out[1][at] = route[at] }
    RoutesKeep(routes_out[1][:], cast(s32)route.count)
    best := cast(s32)route.count
    for pass: cast(s32)0..3 {
        walks := RoutesShortenWalks(data, routes_best[0:best], routes_out[0][:])
        if walks < 0 {
            for at: cast(s32)0..best - 1 { routes_out[0][at] = routes_best[at] }
            walks = best
        }
        loops := RoutesCutLoops(data, routes_out[0][0:walks], routes_out[1][:])
        if loops < 0 || loops >= best || !RoutesWinBytes(data, routes_out[1][0:loops]) { break }
        RoutesKeep(routes_out[1][:], loops)
        best = loops
    }
    return TextView(routes_best[0:best])
}
