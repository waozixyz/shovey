// Puzzle similarity ignores surface art and measures small relocations under
// all four mirrorings. Goals and pieces count four times as much as walls.
#import, file "../../src/engine.zi";

PuzzleKind :: (board: []u8, at: s32, flip: s32) -> s32 {
    text := TextView(board)
    kind := ShoveyByte(text, at * 2)
    tile := ifx board.count >= SHOVEY_CELLS * 4 then ShoveyByte(text, SHOVEY_CELLS * 2 + at * 2) else ShoveyDefaultTile(kind)
    if kind == 0 { kind = tile }
    if kind == 71 && tile == 12 { kind = 12 }
    if board.count >= SHOVEY_CELLS * 6 && ShoveyBlockingDecoration(ShoveyByte(text, SHOVEY_CELLS * 4 + at * 2)) { kind = 12 }
    if kind == 57 || kind == 58 || kind == 59 || kind == 60 || kind == 61 || kind == 77 || kind == 78 { return 0 }
    if kind >= 99 && kind <= 103 { return 0 }
    if ShoveyMossColor(kind) >= 0 { return 14 }
    if ShoveyButtonColor(kind) >= 0 { return 13 }
    if kind == 62 || kind == 63 || kind == 64 || kind == 76 || (kind >= 95 && kind <= 98) { return 12 }
    if ShoveyBallColor(kind) > 0 { return 1 }
    if ShoveyPitColor(kind) > 0 { return 4 }
    if ShoveyPaintColor(kind) > 0 { return 15 }
    if ShoveyColorBlock(kind) { return 36 }
    if (flip & 1) != 0 { if kind == 66 { return 68 }; if kind == 68 { return 66 } }
    if (flip & 2) != 0 { if kind == 67 { return 69 }; if kind == 69 { return 67 } }
    return kind
}

PuzzleSimilarity :: (a: []u8, b: []u8) -> s32 {
    best: s32 = 0
    for flip: cast(s32)0..3 {
        left: [SHOVEY_CELLS]s32
        right: [SHOVEY_CELLS]s32
        left_count: [256]s32
        right_count: [256]s32
        for at: cast(s32)0..SHOVEY_CELLS - 1 {
            x := at % SHOVEY_WIDTH; y := at / SHOVEY_WIDTH
            if x == 0 || y == 0 || x == SHOVEY_WIDTH - 1 || y == SHOVEY_HEIGHT - 1 { continue }
            mirrored := (ifx (flip & 2) != 0 then SHOVEY_HEIGHT - 1 - y else y) * SHOVEY_WIDTH +
                        (ifx (flip & 1) != 0 then SHOVEY_WIDTH - 1 - x else x)
            left[at] = PuzzleKind(a, at, 0)
            right[at] = PuzzleKind(b, mirrored, flip)
            if left[at] > 0 && left[at] < 256 { left_count[left[at]] += 1 }
            if right[at] > 0 && right[at] < 256 { right_count[right[at]] += 1 }
        }
        total: s32 = 0; score: s32 = 0
        for kind: cast(s32)1..255 {
            count := ifx left_count[kind] > right_count[kind] then left_count[kind] else right_count[kind]
            total += count * 2 * (ifx kind == 12 then 1 else 4)
        }
        for side: cast(s32)0..1 {
            for at: cast(s32)0..SHOVEY_CELLS - 1 {
                kind := ifx side == 0 then left[at] else right[at]
                if kind <= 0 { continue }
                nearest: s32 = 9
                for other: cast(s32)0..SHOVEY_CELLS - 1 {
                    candidate := ifx side == 0 then right[other] else left[other]
                    if candidate != kind { continue }
                    dx := at % SHOVEY_WIDTH - other % SHOVEY_WIDTH
                    dy := at / SHOVEY_WIDTH - other / SHOVEY_WIDTH
                    distance := (ifx dx < 0 then -dx else dx) + (ifx dy < 0 then -dy else dy)
                    if distance < nearest { nearest = distance }
                    if nearest == 0 { break }
                }
                value := 100 - nearest * 12
                if value > 0 { score += value * (ifx kind == 12 then 1 else 4) }
            }
        }
        percent := ifx total == 0 then 100 else score / total
        if percent > best { best = percent }
    }
    return best
}
