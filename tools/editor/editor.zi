AppendText :: (bytes: []u8, length: *s32, text: string) {
    if length.* + cast(s32)text.count > cast(s32)bytes.count { return }
    for index: cast(s64)0..text.count - 1 {
        bytes[length.*] = text[index]
        length.* += 1
    }
}

AppendNumber :: (bytes: []u8, length: *s32, number: s32) {
    digits: [24]u8
    AppendText(bytes, length, FormatInteger(cast(s64)number, digits[:]))
}

Board :: (number: s32) -> []u8 { return boards[(number - 1) * HEX:number * HEX] }
SavedBoard :: (number: s32) -> []u8 { return saved_boards[(number - 1) * HEX:number * HEX] }
Original :: (number: s32) -> []u8 { return originals[number * HEX:(number + 1) * HEX] }

Same :: (a: []u8, b: []u8) -> bool {
    for at: cast(s32)0..HEX - 1 { if a[at] != b[at] { return false } }
    return true
}

Copy :: (to: []u8, from: []u8) {
    for at: cast(s32)0..HEX - 1 { to[at] = from[at] }
}

Digit :: (byte: u8) -> s32 {
    if byte >= cast(u8)48 && byte <= cast(u8)57 { return cast(s32)(byte - cast(u8)48) }
    if byte >= cast(u8)97 && byte <= cast(u8)102 { return cast(s32)(byte - cast(u8)87) }
    return 0
}

KindAt :: (board: []u8, at: s32) -> s32 { return Digit(board[at * 2]) * 16 + Digit(board[at * 2 + 1]) }

SetKind :: (board: []u8, at: s32, kind: s32) {
    alphabet := "0123456789abcdef"
    board[at * 2] = alphabet[(kind >> 4) & 15]
    board[at * 2 + 1] = alphabet[kind & 15]
}

DefaultTiles :: (board: []u8) {
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        SetKind(board, SHOVEY_CELLS + at, ShoveyDefaultTile(KindAt(board, at)))
        SetKind(board, SHOVEY_CELLS * 2 + at, 0)
    }
}

NormalizeTiles :: (board: []u8) {
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        decoration := KindAt(board, SHOVEY_CELLS * 2 + at)
        if decoration >= 79 && decoration <= 81 { SetKind(board, SHOVEY_CELLS * 2 + at, 0) }
        kind := KindAt(board, at)
        if kind == 62 { SetKind(board, at, 71); SetKind(board, SHOVEY_CELLS + at, 12) }
        if kind != 0 && ShoveyTerrain(kind) {
            SetKind(board, SHOVEY_CELLS + at, kind)
            SetKind(board, at, 0)
        }
        tile := KindAt(board, SHOVEY_CELLS + at)
        if tile == 62 || tile == 71 {
            SetKind(board, SHOVEY_CELLS + at, ifx tile == 62 then 12 else 0)
            if KindAt(board, at) == 0 { SetKind(board, at, 71) }
        }
        if tile >= 66 && tile <= 69 && KindAt(board, at) == 0 {
            SetKind(board, at, tile)
            SetKind(board, SHOVEY_CELLS + at, 0)
        }
        if tile >= 57 && tile <= 59 {
            SetKind(board, SHOVEY_CELLS * 2 + at, tile)
            SetKind(board, SHOVEY_CELLS + at, 0)
        }
    }
}

VisibleKind :: (board: []u8, at: s32) -> s32 {
    kind := KindAt(board, at)
    return ifx kind != 0 then kind else KindAt(board, SHOVEY_CELLS + at)
}

ReadBoard :: (text: string, board: []u8) -> bool {
    if text.count != PIECES_HEX && text.count != PIECES_HEX * 2 && text.count != HEX { return false }
    for at: cast(s32)0..cast(s32)text.count - 1 {
        byte := text[at]
        if !((byte >= cast(u8)48 && byte <= cast(u8)57) || (byte >= cast(u8)97 && byte <= cast(u8)102)) { return false }
        board[at] = byte
    }
    if text.count == PIECES_HEX { DefaultTiles(board) }
    if text.count < HEX { for at: cast(s32)PIECES_HEX * 2..HEX - 1 { board[at] = cast(u8)48 } }
    NormalizeTiles(board)
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if !ShoveyTile(KindAt(board, SHOVEY_CELLS + at)) || !ShoveyDecoration(KindAt(board, SHOVEY_CELLS * 2 + at)) { return false }
    }
    return true
}

Players :: (board: []u8) -> s32 {
    count: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 { if KindAt(board, at) == 10 { count += 1 } }
    return count
}

PrivateColorPiece :: (kind: s32) -> bool { return kind >= 44 && kind <= 55 }

HasPrivateColorPieces :: () -> bool {
    for at: cast(s32)0..SHOVEY_CELLS - 1 { if PrivateColorPiece(KindAt(Board(current), at)) { return true } }
    return false
}

// The board text between `number == N { return "` and the next quote.
FindBoard :: (text: string, number: s32, into: []u8) -> bool {
    marker: [48]u8
    length: s32 = 0
    AppendText(marker[:], *length, "number == ")
    AppendNumber(marker[:], *length, number)
    AppendText(marker[:], *length, " { return \"")
    wanted := TextView(marker[:length])
    at: s64 = 0
    while at + wanted.count + cast(s64)PIECES_HEX <= text.count {
        if text[at:at + wanted.count] == wanted {
            start := at + wanted.count
            if text[start + cast(s64)PIECES_HEX] != cast(u8)34 { return false }
            for index: cast(s32)0..PIECES_HEX - 1 { into[index] = text[start + cast(s64)index] }
            DefaultTiles(into)
            NormalizeTiles(into)
            return true
        }
        at += 1
    }
    return false
}

// A place is in the game unless it waits for a winnable layout; the last
// place is the finale picture.
InGame :: (place: s32) -> bool { return place == PLACES || !stuck[place] }

// The game's level number of a place, or the number it gets once it is in.
LevelNumber :: (place: s32) -> s32 {
    if place == PLACES { return level_count }
    number: s32 = 1
    for other: cast(s32)1..place {
        number += unlinked_before[other]
        if other < place && !stuck[other] { number += 1 }
    }
    return number
}

// The engine's level for a board: only the finale picture is special.
LevelFor :: (place: s32) -> s32 { return ifx place == PLACES then level_count else 1 }

// Hex digit `at` of a board with a wall around plain floor.
EmptyDigit :: (at: s32) -> u8 {
    if at >= PIECES_HEX { return cast(u8)48 }
    cell := at / 2
    x := cell % SHOVEY_WIDTH
    y := cell / SHOVEY_WIDTH
    border := x == 0 || y == 0 || x == SHOVEY_WIDTH - 1 || y == SHOVEY_HEIGHT - 1
    return ifx at % 2 == 1 && border then cast(u8)99 else cast(u8)48
}

// The game's boards fill their places in order; a waiting place starts from
// its original board, or an empty one on a machine without originals.
LoadLevels :: () {
    text, found := ReadEntireFile(LEVELS_FILE)
    live := found && ReadLevelFile(text)
    level_count = ifx live then file_count else ShoveyLevelCount()
    in_game: s32 = 0
    for place: cast(s32)1..PLACES - 1 { if !stuck[place] { in_game += 1 } }
    linked_count := level_count - unlinked_count - 1
    // Without the list of waiting places, the game's levels fill the first places.
    mapping_ok = in_game == linked_count
    if in_game != linked_count {
        for place: cast(s32)1..PLACES - 1 { stuck[place] = place >= linked_count }
    }
    number: s32 = 0
    for place: cast(s32)1..PLACES {
        number += unlinked_before[place]
        data := ""
        if place == PLACES {
            data = ifx live then TextView(file_boards[(level_count - 1) * HEX:level_count * HEX]) else ShoveyLevelData(level_count)
        }
        else if !stuck[place] {
            number += 1
            data = ifx live then TextView(file_boards[(number - 1) * HEX:number * HEX]) else ShoveyLevelData(number)
        }
        if data.count >= PIECES_HEX { unused ReadBoard(data, Board(place)) }
        else if original_found[place] { Copy(Board(place), Original(place)) }
        else {
            for at: cast(s32)0..HEX - 1 { Board(place)[at] = EmptyDigit(at) }
            DefaultTiles(Board(place))
        }
        Copy(SavedBoard(place), Board(place))
    }
}

// Cells that differ from the place's own original.
Differences :: (place: s32) -> s32 {
    if place < 1 || place > PLACES || !original_found[place] { return -1 }
    count: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if VisibleKind(Board(place), at) != VisibleKind(Original(place), at) { count += 1 }
    }
    return count
}

MirroredIndex :: (at: s32, flip_x: bool, flip_y: bool) -> s32 {
    if at < 0 || at >= SHOVEY_CELLS { return -1 }
    x := at % SHOVEY_WIDTH
    y := at / SHOVEY_WIDTH
    if flip_x { x = SHOVEY_WIDTH - 1 - x }
    if flip_y { y = SHOVEY_HEIGHT - 1 - y }
    return y * SHOVEY_WIDTH + x
}

OnBorder :: (at: s32) -> bool {
    x := at % SHOVEY_WIDTH
    y := at / SHOVEY_WIDTH
    return x == 0 || y == 0 || x == SHOVEY_WIDTH - 1 || y == SHOVEY_HEIGHT - 1
}

// Surface changes do not disguise a near copy. Small piece relocations and
// mirrored layouts remain similar. Cache each place's immutable comparison.
SimilarityTo :: (place: s32, number: s32) -> s32 {
    if number < 1 || number > PLACES || !original_found[number] { return -1 }
    cached := similarity_cache[place * HEX:(place + 1) * HEX]
    if place == number && similarity_cached[place] && Same(cached, Board(place)) {
        similarity_percent = similarity_scores[place]
        return similarity_percent
    }
    similarity_percent = PuzzleSimilarity(Board(place), Original(number))
    if place == number {
        Copy(cached, Board(place))
        similarity_cached[place] = true
        similarity_scores[place] = similarity_percent
    }
    return similarity_percent
}

BestMirrorMatch :: (place: s32) -> s32 { return SimilarityTo(place, original_shown) }

// Still too close to its own original: it is on the list of places to change
// and, measured over the whole map, most of its pieces match that original.
TOO_CLOSE_PERCENT :: 70
TooClose :: (place: s32) -> bool {
    return SimilarityTo(place, place) >= TOO_CLOSE_PERCENT
}

// The next place to work on: waiting for a winnable layout, or still too
// close to its original and not changed here yet.
NextWaiting :: () -> s32 {
    for step: cast(s32)1..PLACES {
        place := (current - 1 + step) % PLACES + 1
        if !InGame(place) || (TooClose(place) && Same(Board(place), SavedBoard(place)) && !PathExists(DraftPath(place))) { return place }
    }
    return current
}

LoadOriginals :: () {
    #if !#defined(SHOVEY_ADMIN) {
    text, found := ReadEntireFile("backup/original/classic-levels.zi")
    if found {
        for number: cast(s32)1..LEVELS_MAX { original_found[number] = FindBoard(text, number, Original(number)) }
    }
    }
    list, listed := ReadEntireFile("backup/redesign/stuck.txt")
    if listed {
        at: s64 = 0
        while at < list.count {
            if at + 8 <= list.count && list[at:at + 8] == "classic " {
                at += 8
                number: s32 = 0
                while at < list.count && list[at] >= cast(u8)48 && list[at] <= cast(u8)57 {
                    number = number * 10 + cast(s32)(list[at] - cast(u8)48)
                    at += 1
                }
                if number > 0 && number <= LEVELS_MAX { stuck[number] = true }
            }
            while at < list.count && list[at] != cast(u8)10 { at += 1 }
            at += 1
        }
    }
    focused, has_focus := ReadEntireFile("backup/editor-drafts/focus.txt")
    if has_focus {
        number: s32 = 0
        for at: cast(s64)0..focused.count - 1 {
            byte := focused[at]
            if byte >= cast(u8)48 && byte <= cast(u8)57 { number = number * 10 + cast(s32)(byte - cast(u8)48) }
            else { if number > 0 && number <= LEVELS_MAX { focus[number] = true }; number = 0 }
        }
    }
    #if !#defined(SHOVEY_ADMIN) {
        original_sprites = PathExists("backup/original/sprites/tile-0.png")
    }
    SpritesPrepare()
    for index: cast(s32)0..SPRITE_COUNT - 1 {
        our_portrait_tiles[index] = sprite_files[index]
        our_landscape_tiles[index] = landscape_sprite_files[index]
        original_tiles[index] = SpriteFile(index)
    }
    #if !#defined(SHOVEY_ADMIN) {
    if original_sprites {
        digits: [24]u8
        for kind: cast(s32)0..40 {
            bytes: Vec(u8)
            BuilderPrint(*bytes, "backup/original/sprites/tile-%.png", FormatInteger(cast(s64)kind, digits[:]))
            original_tiles[kind] = BuilderFinish(bytes)
        }
        original_tiles[SPRITE_PLAYER + 1] = "backup/original/sprites/player.png"
    }
    }
    for kind: cast(s32)44..55 {
        digits: [24]u8
        portrait: Vec(u8)
        BuilderPrint(*portrait, "assets/shovey/sprites/tile-%.png", FormatInteger(cast(s64)kind, digits[:]))
        our_portrait_tiles[SPRITE_NEW_COLOR + kind - 44] = BuilderFinish(portrait)
        landscape: Vec(u8)
        BuilderPrint(*landscape, "assets/shovey-landscape/sprites/tile-%.png", FormatInteger(cast(s64)kind, digits[:]))
        our_landscape_tiles[SPRITE_NEW_COLOR + kind - 44] = BuilderFinish(landscape)
    }
    our_portrait_tiles[SPRITE_CHERRY] = "assets/shovey/sprites/tile-56.png"
    our_landscape_tiles[SPRITE_CHERRY] = "assets/shovey-landscape/sprites/tile-56.png"
}

// Two layers: the floor under pieces and Shovey, then each cell's kind.
PrivateFloorSprite :: (kind: s32) -> s32 {
    if (kind >= 44 && kind <= 46) || (kind >= 53 && kind <= 55) { return 0 }
    return FloorSprite(kind)
}

OurTiles :: () -> []string {
    return ifx boards_landscape then our_landscape_tiles[:] else our_portrait_tiles[:]
}

LoadOrientation :: () {
    orientation, found := ReadEntireFile("backup/editor-drafts/orientation")
    boards_landscape = !found || orientation != "portrait"
}

RotateBoards :: () {
    boards_landscape = !boards_landscape
    unused WriteEntireFile("backup/editor-drafts/orientation", ifx boards_landscape then "landscape" else "portrait")
}

PrivateSprite :: (kind: s32) -> s32 {
    facing := BoardEngineDirection(1, boards_landscape)
    if kind >= SHOVEY_MOSS_WALL && kind < SHOVEY_MOSS_BUTTON { return SPRITE_MOSS_WALL + kind - SHOVEY_MOSS_WALL }
    if kind >= SHOVEY_MOSS_BUTTON && kind <= SHOVEY_LAST_KIND { return SPRITE_MOSS_BUTTON + kind - SHOVEY_MOSS_BUTTON }
    if kind == SHOVEY_BOULDER { return SPRITE_BOULDER }
    color := ShoveyGateColor(kind)
    if color >= 0 {
        open := ShoveyGateStartsOpen(kind)
        if color == 0 { return ifx open then SPRITE_GATE_OPEN else SPRITE_GATE }
        return SPRITE_COLORED_GATE + (color - 1) * 4 + (ifx open then 1 else 0)
    }
    lever_color := ShoveyLeverColor(kind)
    if lever_color > 0 { return SPRITE_COLORED_GATE + (lever_color - 1) * 4 + (ifx ShoveyLeverActive(kind) then 3 else 2) }
    if kind >= 116 && kind <= 121 { return SPRITE_COLORED_DOOR + kind - 116 }
    if kind == SHOVEY_LANTERN { return SPRITE_LANTERN }
    if kind == SHOVEY_DOOR || kind == SHOVEY_DOOR_OPEN { return SPRITE_DOOR + kind - SHOVEY_DOOR }
    if ShoveyMaterialFloor(kind) { return SPRITE_MATERIAL_FLOOR + kind - 99 }
    if kind >= 95 && kind <= 98 { return SPRITE_WALL + kind - 95 }
    if ShoveyLever(kind) { return SPRITE_LEVER + kind - SHOVEY_LEVER }
    if kind >= 85 && kind <= 87 { return SPRITE_PORTAL + kind - 85 }
    if kind == SHOVEY_CRAB { return SPRITE_CRAB + facing }
    if ShoveyFish(kind) { return SPRITE_FISH + (kind - SHOVEY_FISH) * 16 + facing }
    if kind == SHOVEY_DOG { return SPRITE_DOG + facing }
    if kind == SHOVEY_TURTLE { return SPRITE_TURTLE + facing }
    if kind == SHOVEY_TREE { return SPRITE_TREE }
    if kind >= 44 && kind <= 55 { return SPRITE_NEW_COLOR + kind - 44 }
    if kind == 56 { return SPRITE_CHERRY }
    if kind >= 57 && kind <= 78 { return SPRITE_NEW_TILE + kind - 57 }
    return kind
}

HexBoard :: (board: []u8, tiles: []string, layers: []s32, key: u64, bounds: Rectangle, landscape: bool, label: string) -> TileMapResult {
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        kind := KindAt(board, at)
        display := BoardDisplayIndex(at, landscape)
        tile := KindAt(board, SHOVEY_CELLS + at)
        if ShoveyOpenDoor(kind) && ShoveyWallFloor(tile) >= 0 { tile = ShoveyWallFloor(tile) }
        layers[display] = PrivateSprite(tile)
        if KindAt(board, SHOVEY_CELLS + at) == SHOVEY_PIT {
            mask: s32 = 0
            for direction: cast(s32)0..3 {
                neighbor := ShoveyNeighbor(at, direction)
                if neighbor < 0 || KindAt(board, SHOVEY_CELLS + neighbor) != SHOVEY_PIT { mask |= 1 << direction }
            }
            layers[display] = SPRITE_ABYSS + mask
        }
        if KindAt(board, SHOVEY_CELLS + at) == 77 {
            mask: s32 = 0
            for direction: cast(s32)0..3 {
                neighbor := ShoveyNeighbor(at, direction)
                if neighbor >= 0 && KindAt(board, SHOVEY_CELLS + neighbor) != 77 { mask |= 1 << direction }
            }
            layers[display] = SPRITE_GRASS_EDGE + mask
        }
        decoration := KindAt(board, SHOVEY_CELLS * 2 + at)
        layers[SHOVEY_CELLS + display] = ifx decoration == 0 then -1 else PrivateSprite(decoration)
        layers[SHOVEY_CELLS * 2 + display] = ifx kind == 10 then SPRITE_PLAYER + BoardEngineDirection(1, landscape) else ifx kind > 0 && kind <= SHOVEY_LAST_KIND then PrivateSprite(kind) else -1
    }
    columns := cast(s32)(ifx landscape then SHOVEY_HEIGHT else SHOVEY_WIDTH)
    rows := cast(s32)(ifx landscape then SHOVEY_WIDTH else SHOVEY_HEIGHT)
    fitted := TileMapFit(bounds, columns, rows)
    cell := cast(float32)cast(s32)fitted.cell
    fitted.board = Rectangle.{cast(float32)cast(s32)(bounds.x + (bounds.width - cell * cast(float32)columns) / 2.0),
            cast(float32)cast(s32)(bounds.y + (bounds.height - cell * cast(float32)rows) / 2.0),
            cell * cast(float32)columns, cell * cast(float32)rows}
    return TileMap(session, TileMapProps.{.key = key, .bounds = fitted.board, .columns = columns, .rows = rows,
            .tiles = tiles, .names = names[0:0], .layers = layers, .layer_count = 3, .label = label})
}

// ---------------------------------------------------------------- editing

Remember :: (clear_redo: bool = true) {
    if clear_redo { redo_count = 0 }
    if history_count == HISTORY {
        for index: cast(s32)0..(HISTORY - 1) * HEX - 1 { history[index] = history[index + HEX] }
        history_count -= 1
    }
    Copy(history[history_count * HEX:(history_count + 1) * HEX], Board(current))
    history_count += 1
}

UndoEdit :: () {
    if history_count == 0 { return }
    if redo_count < HISTORY {
        Copy(redo_history[redo_count * HEX:(redo_count + 1) * HEX], Board(current))
        redo_count += 1
    }
    history_count -= 1
    Copy(Board(current), history[history_count * HEX:(history_count + 1) * HEX])
    Edited()
}

RedoEdit :: () {
    if redo_count == 0 { return }
    Remember(false)
    redo_count -= 1
    Copy(Board(current), redo_history[redo_count * HEX:(redo_count + 1) * HEX])
    Edited()
}

ResetEdit :: () {
    original := ifx original_found[current] then Original(current) else reset_board[:]
    if Same(Board(current), original) { return }
    Remember()
    Copy(Board(current), original)
    Edited()
}

Approved :: (place: s32) -> bool {
    return approved_places[place - 1]
}

ApprovalMatches :: (place: s32) -> bool { return Approved(place) && Same(Board(place), approved_boards[(place - 1) * HEX:place * HEX]) }

PublishedApprovalMatches :: (place: s32) -> bool {
    return (!server_configured || server_verified) && Approved(place) && published_places[place - 1] &&
        Same(approved_boards[(place - 1) * HEX:place * HEX], published_boards[(place - 1) * HEX:place * HEX])
}

ServerBoardMatches :: (place: s32) -> bool {
    return server_verified && published_places[place - 1] &&
        Same(Board(place), published_boards[(place - 1) * HEX:place * HEX])
}

NeedsUpdate :: (place: s32) -> bool {
    return server_configured && server_verified && (Approved(place) || published_places[place - 1]) && !ServerBoardMatches(place)
}

PublicationBusy :: () -> bool {
    status := TextView(publish_message[:publish_message_length])
    return status == "Updating…" || status == "Checking…" || status == "Publishing…" || status == "Verifying…"
}

UpdateAvailable :: () -> bool {
    return NeedsUpdate(current) && !playing && !glm_busy && check_state != 1 && !PublicationBusy()
}

DifferenceAt :: (place: s32, at: s32) -> bool {
    if !server_verified || !published_places[place - 1] { return false }
    server := published_boards[(place - 1) * HEX:place * HEX]
    for layer: cast(s32)0..2 {
        cell := layer * SHOVEY_CELLS + at
        if KindAt(Board(place), cell) != KindAt(server, cell) { return true }
    }
    return false
}

DifferenceCount :: (place: s32) -> s32 {
    count: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 { if DifferenceAt(place, at) { count += 1 } }
    return count
}

HighlightDifferences :: (grid: TileMapResult, key: u64) {
    if grid.cell < 3.0 { return }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if !DifferenceAt(current, at) { continue }
        cell := TileMapCell(grid, BoardDisplayIndex(at, boards_landscape))
        bounds := Rectangle.{cell.x + 1.0, cell.y + 1.0, cell.width - 2.0, cell.height - 2.0}
        unused Box(session, BoxProps.{.key = key + cast(u64)at, .bounds = bounds,
            .fill = Color.{238, 102, 158, 35}, .border = Color.{248, 118, 174, 255}})
    }
}

LoadServerCampaign :: () {
    server_configured = PathExists("backup/editor-publish.json")
    server_verified = false
    if !server_configured { return }
    for place: cast(s32)1..PLACES { published_places[place - 1] = false }
    text, found := ReadEntireFile("backup/editor-drafts/server-campaign.json")
    if !found { return }
    state := ReadString(text, FieldAt(text, 0, "status"))
    if !state.valid || text[state.start:state.end] != "verified" { return }
    positions: [PLACES]s32
    count := ArrayPositions(text, FieldAt(text, 0, "boards"), positions[:])
    if count < 1 || count > PLACES { return }
    for index: cast(s32)0..count - 1 {
        board := ReadString(text, positions[index])
        if !board.valid || board.end - board.start != HEX { return }
        candidate: [HEX]u8
        if !ReadBoard(text[board.start:board.end], candidate[:]) { return }
    }
    for place: cast(s32)1..PLACES {
        number := LevelNumber(place)
        if !InGame(place) || number < 1 || number > count { continue }
        board := ReadString(text, positions[number - 1])
        published_places[place - 1] = ReadBoard(text[board.start:board.end], published_boards[(place - 1) * HEX:place * HEX])
    }
    server_verified = true
}

CheckServer :: (now: s64) {
    if !PathExists("backup/editor-publish.json") || !PathExists("scripts/editor_server.py") { return }
    if server_check_started != 0 && now - server_check_started < 30000 { return }
    server_check_started = now
    Shell("setsid python3 scripts/editor_server.py > backup/editor-server.log 2>&1 < /dev/null &")
}

ApprovalAvailable :: () -> bool {
    if playing { return false }
    if (Solved() || Proven()) && !ApprovalMatches(current) { return true }
    if !Approved(current) { return saved_approval_ready }
    if PublishedApprovalMatches(current) { return false }
    status := TextView(publish_message[:publish_message_length])
    return status != "Updating…" && status != "Checking…" && status != "Publishing…" && status != "Verifying…"
}

LoadApprovals :: () {
    for place: cast(s32)1..PLACES {
        text, found := ReadEntireFile(DraftPath(place, ".approved"))
        approved_places[place - 1] = found && ReadBoard(text, approved_boards[(place - 1) * HEX:place * HEX])
        published, ready := ReadEntireFile(DraftPath(place, ".published"))
        published_places[place - 1] = ready && ReadBoard(published, published_boards[(place - 1) * HEX:place * HEX])
    }
    LoadServerCampaign()
    // The campaign survives missing local markers and editor installations.
    // A newer local approval still takes precedence while it is publishing.
    text, found := ReadEntireFile("levels/approved.json")
    if !found { return }
    positions: [PLACES]s32
    count := ArrayPositions(text, FieldAt(text, 0, "levels"), positions[:])
    if count < 0 || count > PLACES { return }
    names: [3]string = .["cells", "tiles", "decorations"]
    for index: cast(s32)0..count - 1 {
        at := positions[index]
        number := ReadNumber(text, FieldAt(text, at, "number"))
        if !number.valid || number.value < 1.0 || number.value > cast(float64)PLACES { continue }
        place := cast(s32)number.value
        if cast(float64)place != number.value || Approved(place) { continue }
        candidate: [HEX]u8
        valid := true
        for layer: cast(s32)0..2 {
            rows: [SHOVEY_HEIGHT]s32
            if ArrayPositions(text, FieldAt(text, at, names[layer]), rows[:]) != SHOVEY_HEIGHT { valid = false; break }
            for row: cast(s32)0..SHOVEY_HEIGHT - 1 {
                span := ReadString(text, rows[row])
                if !span.valid || span.end - span.start != SHOVEY_WIDTH * 2 { valid = false; break }
                for digit: cast(s32)0..SHOVEY_WIDTH * 2 - 1 {
                    candidate[layer * PIECES_HEX + row * SHOVEY_WIDTH * 2 + digit] = text[span.start + digit]
                }
            }
            if !valid { break }
        }
        if valid { approved_places[place - 1] = ReadBoard(TextView(candidate[:]), approved_boards[(place - 1) * HEX:place * HEX]) }
    }
}

ToggleSelector :: () {
    selector_open = !selector_open
    if selector_open {
        LoadApprovals()
        CheckServer(MonotonicMilliseconds())
    }
}

ActionMessage :: (text: string) {
    action_message_length = 0
    AppendText(action_message[:], *action_message_length, text)
}

RunAction :: (action: string) {
    command: [512]u8
    length: s32 = 0
    AppendText(command[:], *length, "setsid python3 scripts/editor_actions.py ")
    AppendText(command[:], *length, action)
    AppendText(command[:], *length, " ")
    AppendNumber(command[:], *length, current)
    AppendText(command[:], *length, " > backup/editor-action.log 2>&1 < /dev/null &")
    Shell(TextView(command[:length]))
}

ApproveEdit :: () {
    if !ApprovalAvailable() { return }
    if ApprovalMatches(current) || (Approved(current) && !Solved() && !Proven()) {
        ActionMessage("Publishing…")
        RunAction("update")
        return
    }
    if !Solved() && !Proven() {
        // A later draft must not discard approval of the last saved win.
        text, found := ReadEntireFile(LEVELS_FILE)
        if !found || !ReadLevelFile(text) { return }
        index := LevelNumber(current) - 1
        if index < 0 || index >= file_count || !FileHolds(index, SavedBoard(current)) { return }
        start := file_route_start[index]
        length := file_route_length[index]
        if length <= 0 { return }
        QueueApproval(SavedBoard(current), file_routes[start:start + length])
        return
    }
    StartSave()
    if save_state != 2 { return }
    letters := ifx Solved() then route[:route_length] else proof_route[:proof_length]
    QueueApproval(Board(current), letters)
}

UpdateEdit :: () {
    if !UpdateAvailable() { return }
    if Solved() || Proven() || ApprovalMatches(current) {
        ApproveEdit()
        return
    }
    // A saved winning route is reused immediately. A changed, unproven draft
    // starts its check; the existing save/approval path publishes it on a win.
    ActionMessage("")
    StartCheck()
}

UpdateAll :: () {
    if !server_configured || playing || glm_busy || PublicationBusy() { return }
    ActionMessage("Updating published levels…")
    publish_message_length = 0
    AppendText(publish_message[:], *publish_message_length, "Updating…")
    RunAction("update-all")
}

QueueApproval :: (board: []u8, letters: []u8) {
    length: s32 = 0
    AppendText(proof_record[:], *length, TextView(board))
    AppendText(proof_record[:], *length, "\n")
    AppendText(proof_record[:], *length, TextView(letters))
    if !WriteEntireFile(DraftPath(current, ".approval-request"), TextView(proof_record[:length])) { ActionMessage("Approval could not be saved."); return }
    if !WriteEntireFile(DraftPath(current, ".approved"), TextView(board)) { ActionMessage("Approval could not be saved."); return }
    Copy(approved_boards[(current - 1) * HEX:current * HEX], board)
    approved_places[current - 1] = true
    ActionMessage("Publishing…")
    publish_message_length = 0
    AppendText(publish_message[:], *publish_message_length, "Updating…")
    RunAction("approve")
}

ModifyGLM :: (repair: bool = false) {
    if playing || glm_busy || current >= PLACES { return }
    glm_repair = repair
    Copy(glm_base[:], Board(current))
    glm_place = current
    unused RemoveFile(DraftPath(current, ".glm-result"))
    unused RemoveFile(DraftPath(current, ".glm-status"))
    unused RemoveFile(DraftPath(current, ".glm-proof"))
    if !WriteEntireFile(DraftPath(current, ".glm-base"), TextView(glm_base[:])) { return }
    unused WriteEntireFile(DraftPath(current, ".glm-state"), "working")
    glm_busy = true
    glm_started = MonotonicMilliseconds()
    ActionMessage(ifx repair then "Repairing…" else "Designing…")
    RunAction(ifx repair then "fix" else "glm")
}

// A result and its proof must describe the same board, and its route must
// win in this editor's engine before we replace the board on screen.
GLMProof :: (text: string, board: []u8) -> bool {
    if text.count <= cast(s64)HEX + 1 || text.count > cast(s64)(HEX + ROUTE_MAX + 1) { return false }
    if text[HEX] != cast(u8)10 || text[0:HEX] != TextView(board) { return false }
    length := cast(s32)text.count - HEX - 1
    letters: [ROUTE_MAX]u8
    for at: cast(s32)0..length - 1 {
        letter := text[HEX + 1 + at]
        if !((letter >= cast(u8)48 && letter <= cast(u8)51) || letter == cast(u8)102 || letter == cast(u8)116) { return false }
        letters[at] = letter
    }
    return Wins(board, LevelFor(current), letters[:], length)
}

PollActions :: (now: s64) {
    if now - actions_polled < 500 { return }
    actions_polled = now
    CheckServer(now)
    if now - server_polled >= 2000 {
        server_polled = now
        LoadApprovals()
    }
    if glm_busy {
        result, ready := ReadEntireFile(DraftPath(glm_place, ".glm-result"))
        if ready {
            candidate: [HEX]u8
            if ReadBoard(result, candidate[:]) && glm_place == current && !playing && Same(Board(current), glm_base[:]) {
                proof, proven := ReadEntireFile(DraftPath(glm_place, ".glm-proof"))
                if proven && GLMProof(proof, candidate[:]) {
                    Remember()
                    Copy(Board(current), candidate[:])
                    Edited()
                    Copy(proof_board[:], candidate[:])
                    proof_length = cast(s32)proof.count - HEX - 1
                    for at: cast(s32)0..proof_length - 1 { proof_route[at] = proof[HEX + 1 + at] }
                    proof_level = current
                    AcceptRoute(proof_route[:], proof_length)
                    ActionMessage(ifx glm_repair then "Repair applied" else "Variation applied")
                } else { ActionMessage(ifx glm_repair then "Repair failed its route check. Retry." else "Variation failed its route check. Retry.") }
            } else { ActionMessage("Level changed. Run GLM again.") }
            glm_busy = false
            unused RemoveFile(DraftPath(glm_place, ".glm-result"))
        } else {
            status, found := ReadEntireFile(DraftPath(glm_place, ".glm-status"))
            if found {
                ActionMessage(status)
            }
            phase, phased := ReadEntireFile(DraftPath(glm_place, ".glm-state"))
            if phased && phase == "error" { glm_busy = false }
            if now - glm_started > 480000 { glm_busy = false; ActionMessage("GLM timed out. Retry.") }
        }
    } else {
        status, found := ReadEntireFile("backup/editor-drafts/publish-status")
        if found && status != TextView(publish_message[:publish_message_length]) {
            if status == "Published" {
                server_check_started = 0
                CheckServer(now)
            }
            LoadApprovals()
            publish_message_length = 0
            AppendText(publish_message[:], *publish_message_length, status)
            ActionMessage(status)
        }
    }
}

Edited :: () {
    StopCheck()
    check_state = 0
    edited_at = MonotonicMilliseconds()
    check_wanted = true
    if save_state == 2 { save_state = 0 }
    unused WriteEntireFile(DraftPath(current), TextView(Board(current)))
}

// An unsaved board is kept in backup/editor-drafts/NNN.hex until it is saved.
DraftPath :: (number: s32, suffix: string = ".hex") -> string {
    length: s32 = 0
    AppendText(draft_bytes[:], *length, "backup/editor-drafts/")
    if number < 100 { AppendText(draft_bytes[:], *length, "0") }
    if number < 10 { AppendText(draft_bytes[:], *length, "0") }
    AppendNumber(draft_bytes[:], *length, number)
    AppendText(draft_bytes[:], *length, suffix)
    return TextView(draft_bytes[:length])
}

LoadDrafts :: () {
    unused CreateDirectory("backup")
    unused CreateDirectory("backup/editor-drafts")
    for number: cast(s32)1..PLACES {
        RestoreDraft(number)
    }
}

RestoreDraft :: (number: s32) {
    if number == current && playing { return }
    text, found := ReadEntireFile(DraftPath(number))
    restored: [HEX]u8
    if found && ReadBoard(text, restored[:]) { Copy(Board(number), restored[:]) }
}

LoadUnlinked :: () {
    unlinked_count = 0
    for place: cast(s32)1..PLACES { unlinked_before[place] = 0 }
    text, found := ReadEntireFile("backup/editor-drafts/unlinked.txt")
    if !found { return }
    at: s64 = 0
    while at < text.count {
        if at + 7 <= text.count && text[at:at + 7] == "before " {
            at += 7
            place: s32 = 0
            while at < text.count && text[at] >= cast(u8)48 && text[at] <= cast(u8)57 {
                place = place * 10 + cast(s32)(text[at] - cast(u8)48)
                at += 1
            }
            if place >= 1 && place <= PLACES {
                unlinked_before[place] += 1
                unlinked_count += 1
            }
        }
        while at < text.count && text[at] != cast(u8)10 { at += 1 }
        at += 1
    }
}

Paint :: (at: s32, kind: s32) {
    board := Board(current)
    if kind >= 512 {
        decoration := kind - 512
        if !ShoveyDecoration(decoration) || KindAt(board, SHOVEY_CELLS * 2 + at) == decoration { return }
        if ShoveyBlockingDecoration(decoration) && KindAt(board, at) != 0 { return }
        tile := KindAt(board, SHOVEY_CELLS + at)
        if ShoveyBlockingDecoration(decoration) && (tile == 12 || ShoveyMossColor(tile) >= 0 || tile == SHOVEY_PIT || ShoveySolidDecor(tile)) { SetKind(board, SHOVEY_CELLS + at, 0) }
        SetKind(board, SHOVEY_CELLS * 2 + at, decoration)
        Edited()
        return
    }
    if palette_tab == 0 {
        tile := ifx kind >= 256 then kind - 256 else 0
        if tile == SHOVEY_PIT {
            if KindAt(board, SHOVEY_CELLS + at) == tile && KindAt(board, at) == 0 && KindAt(board, SHOVEY_CELLS * 2 + at) == 0 { return }
            SetKind(board, SHOVEY_CELLS + at, tile)
            SetKind(board, at, 0)
            SetKind(board, SHOVEY_CELLS * 2 + at, 0)
            Edited()
            return
        }
        if ShoveyFish(KindAt(board, at)) && tile != 64 { return }
        if !ShoveyTile(tile) || KindAt(board, SHOVEY_CELLS + at) == tile { return }
        SetKind(board, SHOVEY_CELLS + at, tile)
        Edited()
        return
    }
    if kind == 0 {
        if KindAt(board, at) == 0 && KindAt(board, SHOVEY_CELLS * 2 + at) == 0 { return }
        SetKind(board, at, 0)
        SetKind(board, SHOVEY_CELLS * 2 + at, 0)
        Edited()
        return
    }
    replaced_wall := false
    if kind != 0 && ShoveyBlockingDecoration(KindAt(board, SHOVEY_CELLS * 2 + at)) { return }
    tile := KindAt(board, SHOVEY_CELLS + at)
    if ShoveyFish(kind) && tile != 64 { SetKind(board, SHOVEY_CELLS + at, 64); replaced_wall = true }
    else if !ShoveyFish(kind) && kind != 0 && kind != 71 &&
        !((ShoveyClosedDoor(kind) || ShoveyOpenDoor(kind)) && ShoveyWallFloor(tile) >= 0) &&
        (tile == 12 || ShoveyMossColor(tile) >= 0 || ShoveySolidDecor(tile)) {
        SetKind(board, SHOVEY_CELLS + at, 0)
        replaced_wall = true
    }
    if KindAt(board, at) == kind { if replaced_wall { Edited() }; return }
    // There is one Shovey: painting it moves it.
    if kind == 10 {
        for other: cast(s32)0..SHOVEY_CELLS - 1 { if KindAt(board, other) == 10 { SetKind(board, other, 0) } }
    }
    SetKind(board, at, kind)
    Edited()
}

Open :: (place: s32) {
    StopCheck()
    check_state = 0
    current = (place - 1 + PLACES) % PLACES + 1
    playing = false
    diff_open = false
    RestoreDraft(current)
    Copy(reset_board[:], Board(current))
    original_shown = current
    // Reopening the editor comes back to this place.
    digits: [24]u8
    unused WriteEntireFile("backup/editor-drafts/place", FormatInteger(cast(s64)current, digits[:]))
    history_count = 0
    redo_count = 0
    playing = false
    watching = false
    check_wanted = true
    edited_at = 0
    if save_state != 1 { save_state = 0 }
    if !RestoreProof() { unused RestoreSavedRoute() }
    saved_approval_ready = false
    if InGame(current) && mapping_ok {
        text, found := ReadEntireFile(LEVELS_FILE)
        if found && ReadLevelFile(text) {
            index := LevelNumber(current) - 1
            saved_approval_ready = index >= 0 && index < file_count && file_route_length[index] > 0 && FileHolds(index, SavedBoard(current))
        }
    }
}

// ---------------------------------------------------------------- checking

// Plays a route on a board in the game engine; true when it wins.
Wins :: (board: []u8, level: s32, letters: []u8, length: s32) -> bool {
    game: ShoveyGame
    if !ShoveyLoadData(*game, level, TextView(board)) { return false }
    for index: cast(s32)0..length - 1 {
        letter := letters[index]
        if letter >= cast(u8)48 && letter <= cast(u8)51 { unused ShoveyMove(*game, cast(s32)(letter - cast(u8)48)) }
        else if letter == cast(u8)102 { unused ShoveyFire(*game) }
        else if letter == cast(u8)116 { unused ShoveyTick(*game) }
        if game.won { return true }
    }
    return game.won
}

Shell :: (text: string) {
    bytes: [ROUTE_MAX + 2048]u8
    if CopyCString(text, bytes[:]) { unused RunShell(*bytes[0]) }
}

// The solver's four searches run side by side as separate processes; the
// first win counts and stops the others.
SEARCHES :: 4
search_names: [4]string = .["greedy", "macro-bfs", "chain", "bfs"];
search_done: [4]bool;

CheckFile :: (index: s32, suffix: string) -> string {
    length: s32 = 0
    AppendText(path_bytes[:], *length, "build/editor/check-")
    AppendText(path_bytes[:], *length, search_names[index])
    AppendText(path_bytes[:], *length, suffix)
    return TextView(path_bytes[:length])
}

StopCheck :: () {
    if check_state == 1 {
        Shell("for f in build/editor/check-*.pid; do kill -- -$(cat $f) 2>/dev/null; done; rm -f build/editor/check-*")
    }
}

StartCheck :: () {
    check_wanted = false
    StopCheck()
    if Solved() { return }
    if Proven() {
        AcceptRoute(proof_route[:], proof_length)
        return
    }
    if RestoreProof() { return }
    if RestoreSavedRoute() { return }
    board := Board(current)
    Copy(check_board[:], board)
    check_level = current
    route_length = 0
    if Players(board) != 1 { check_state = 4; return }
    for index: cast(s32)0..SEARCHES - 1 {
        search_done[index] = false
        length: s32 = 0
        AppendText(command[:], *length, "mkdir -p build/editor && (setsid sh -c 'nice -n 10 build/solver/shovey-solve-classic solve --level ")
        AppendNumber(command[:], *length, LevelFor(current))
        AppendText(command[:], *length, " --seconds ")
        AppendText(command[:], *length, SOLVE_SECONDS)
        AppendText(command[:], *length, " --max-mb 128 --only ")
        AppendText(command[:], *length, search_names[index])
        AppendText(command[:], *length, " ")
        AppendText(command[:], *length, TextView(board))
        AppendText(command[:], *length, " > ")
        AppendText(command[:], *length, CheckFile(index, ".tmp"))
        AppendText(command[:], *length, " 2>&1; mv ")
        AppendText(command[:], *length, CheckFile(index, ".tmp"))
        AppendText(command[:], *length, " ")
        AppendText(command[:], *length, CheckFile(index, ".out"))
        AppendText(command[:], *length, "' & echo $! > ")
        AppendText(command[:], *length, CheckFile(index, ".pid"))
        AppendText(command[:], *length, ")")
        Shell(TextView(command[:length]))
    }
    check_state = 1
    check_started = MonotonicMilliseconds()
}

Contains :: (text: string, part: string) -> bool {
    if part.count > text.count { return false }
    for at: cast(s64)0..text.count - part.count {
        if text[at:at + part.count] == part { return true }
    }
    return false
}

// The solver writes its stats line and the route on its own line, in either
// order: the route is the line made only of route letters.
ReadRoute :: (text: string) -> bool {
    route_length = 0
    if !Contains(text, "\"solved\":true") { return false }
    start: s64 = 0
    while start < text.count && route_length == 0 {
        end := start
        while end < text.count && text[end] != cast(u8)10 { end += 1 }
        whole := end > start
        for at: start..end - 1 {
            letter := text[at]
            if !((letter >= cast(u8)48 && letter <= cast(u8)51) || letter == cast(u8)102 || letter == cast(u8)116) { whole = false }
        }
        if whole && end - start <= cast(s64)ROUTE_MAX {
            for at: start..end - 1 {
                route[route_length] = text[at]
                route_length += 1
            }
        }
        start = end + 1
    }
    return route_length > 0
}

PollCheck :: () {
    if check_state != 1 { return }
    finished: s32 = 0
    for index: cast(s32)0..SEARCHES - 1 {
        if !search_done[index] && PathExists(CheckFile(index, ".out")) {
            text, found := ReadEntireFile(CheckFile(index, ".out"))
            search_done[index] = true
            // Only a route the engine replays to a win counts.
            if found && ReadRoute(text) && Wins(check_board[:], LevelFor(check_level), route[:], route_length) {
                AcceptRoute(route[:], route_length)
                return
            }
            route_length = 0
        }
        if search_done[index] { finished += 1 }
    }
    if finished == SEARCHES {
        StopCheck()
        check_state = 3
    }
}

// The check belongs to the board on screen.
Checked :: () -> bool { return check_level == current && Same(check_board[:], Board(current)) }

AcceptRoute :: (letters: []u8, length: s32) {
    StopCheck()
    Copy(check_board[:], Board(current))
    check_level = current
    for at: cast(s32)0..length - 1 { route[at] = letters[at] }
    route_length = length
    check_state = 2
    check_wanted = false
    record_length: s32 = 0
    AppendText(proof_record[:], *record_length, TextView(Board(current)))
    AppendText(proof_record[:], *record_length, "\n")
    AppendText(proof_record[:], *record_length, TextView(route[:route_length]))
    unused WriteEntireFile(DraftPath(current, ".proof"), TextView(proof_record[:record_length]))
}

// A played or checked win survives switching boards and reopening the editor.
RestoreProof :: () -> bool {
    text, found := ReadEntireFile(DraftPath(current, ".proof"))
    if !found || text.count <= cast(s64)HEX + 1 || text.count > cast(s64)(HEX + ROUTE_MAX + 1) { return false }
    if text[HEX] != cast(u8)10 { return false }
    length := cast(s32)text.count - HEX - 1
    for at: cast(s32)0..length - 1 {
        letter := text[HEX + 1 + at]
        if !((letter >= cast(u8)48 && letter <= cast(u8)51) || letter == cast(u8)102 || letter == cast(u8)116) { return false }
        proof_route[at] = letter
    }
    if text[0:HEX] != TextView(Board(current)) && !Wins(Board(current), LevelFor(current), proof_route[:], length) { return false }
    Copy(proof_board[:], Board(current))
    proof_length = length
    proof_level = current
    AcceptRoute(proof_route[:], length)
    if InGame(current) && Same(Board(current), SavedBoard(current)) {
        save_level = current
        save_state = 2
        Copy(save_board[:], Board(current))
    }
    return true
}

// Saved levels keep their winning route. A changed board can reuse that
// route when it still wins, including changes to flowers or floor artwork.
RestoreSavedRoute :: () -> bool {
    if !InGame(current) || !mapping_ok { return false }
    text, found := ReadEntireFile(LEVELS_FILE)
    if !found || !ReadLevelFile(text) { return false }
    index := LevelNumber(current) - 1
    if index < 0 || index >= file_count { return false }
    start := file_route_start[index]
    length := file_route_length[index]
    if length <= 0 || length > ROUTE_MAX { return false }
    saved := FileHolds(index, Board(current))
    letters := file_routes[start:start + length]
    if !saved && !Wins(Board(current), LevelFor(current), letters, length) { return false }
    AcceptRoute(letters, length)
    if saved {
        Copy(save_board[:], Board(current))
        save_level = current
        save_state = 2
    }
    return true
}

// ---------------------------------------------------------------- saving

// levels/classic.json, read and written in its current portrait layout: every
// level's board and winning route (the finale picture has none). Comparison
// mode turns that board for display, but never changes the stored orientation.
LEVELS_FILE :: "levels/classic.json"
ROUTES_SIZE :: 400000
file_count: s32;
file_boards: [LEVELS_MAX * HEX]u8;
file_tiles: [LEVELS_MAX]bool;
file_decorations: [LEVELS_MAX]bool;
file_route_start: [LEVELS_MAX]s32;
file_route_length: [LEVELS_MAX]s32;
file_routes: [ROUTES_SIZE]u8;
file_routes_used: s32;
file_text: [ROUTES_SIZE + LEVELS_MAX * 3072]u8;
path_bytes: [256]u8;

Find :: (text: string, part: string, from: s64) -> s64 {
    at := from
    while at + part.count <= text.count {
        if text[at:at + part.count] == part { return at }
        at += 1
    }
    return -1
}

ReadLevelFile :: (text: string) -> bool {
    file_count = 0
    file_routes_used = 0
    at: s64 = 0
    while file_count < LEVELS_MAX {
        cells := Find(text, "\"cells\": [", at)
        if cells < 0 { break }
        at = cells + 10
        for row: cast(s32)0..SHOVEY_HEIGHT - 1 {
            quote := Find(text, "\"", at)
            if quote < 0 || quote + 25 >= text.count { return false }
            for column: cast(s32)0..SHOVEY_WIDTH - 1 { file_boards[file_count * HEX + row * SHOVEY_WIDTH * 2 + column * 2] = text[quote + 1 + cast(s64)column * 2] }
            for column: cast(s32)0..SHOVEY_WIDTH - 1 { file_boards[file_count * HEX + row * SHOVEY_WIDTH * 2 + column * 2 + 1] = text[quote + 2 + cast(s64)column * 2] }
            at = quote + 26
        }
        for cell: cast(s32)0..SHOVEY_CELLS - 1 {
            SetKind(file_boards[file_count * HEX:(file_count + 1) * HEX], SHOVEY_CELLS + cell,
                    ShoveyDefaultTile(KindAt(file_boards[file_count * HEX:(file_count + 1) * HEX], cell)))
        }
        next_level := Find(text, "\"number\":", at)
        tiles := Find(text, "\"tiles\": [", at)
        file_tiles[file_count] = tiles >= 0 && (next_level < 0 || tiles < next_level)
        if file_tiles[file_count] {
            tile_at := tiles + 10
            for row: cast(s32)0..SHOVEY_HEIGHT - 1 {
                quote := Find(text, "\"", tile_at)
                if quote < 0 || quote + 25 >= text.count { return false }
                for digit: cast(s32)0..SHOVEY_WIDTH * 2 - 1 {
                    file_boards[file_count * HEX + PIECES_HEX + row * SHOVEY_WIDTH * 2 + digit] = text[quote + 1 + cast(s64)digit]
                }
                tile_at = quote + 26
            }
        }
        for cell: cast(s32)0..SHOVEY_CELLS - 1 { SetKind(file_boards[file_count * HEX:(file_count + 1) * HEX], SHOVEY_CELLS * 2 + cell, 0) }
        decorations := Find(text, "\"decorations\": [", at)
        file_decorations[file_count] = decorations >= 0 && (next_level < 0 || decorations < next_level)
        if file_decorations[file_count] {
            deco_at := decorations + 16
            for row: cast(s32)0..SHOVEY_HEIGHT - 1 {
                quote := Find(text, "\"", deco_at)
                if quote < 0 || quote + 25 >= text.count { return false }
                for digit: cast(s32)0..SHOVEY_WIDTH * 2 - 1 {
                    file_boards[file_count * HEX + PIECES_HEX * 2 + row * SHOVEY_WIDTH * 2 + digit] = text[quote + 1 + cast(s64)digit]
                }
                deco_at = quote + 26
            }
        }
        file_route_start[file_count] = file_routes_used
        file_route_length[file_count] = -1
        next := Find(text, "\"number\":", at)
        solution := Find(text, "\"solution\": \"", at)
        if solution >= 0 && (next < 0 || solution < next) {
            from := solution + 13
            length: s32 = 0
            while from + cast(s64)length < text.count && text[from + cast(s64)length] != cast(u8)34 { length += 1 }
            if file_routes_used + length > ROUTES_SIZE { return false }
            for index: cast(s32)0..length - 1 { file_routes[file_routes_used + index] = text[from + cast(s64)index] }
            file_route_length[file_count] = length
            file_routes_used += length
            at = from + cast(s64)length
        }
        file_count += 1
    }
    return file_count > 0
}

// The level file's text, as Python's json.dumps(indent=1) writes it.
LevelFileText :: () -> string {
    length: s32 = 0
    AppendText(file_text[:], *length, "{\n \"edition\": \"classic\",\n \"width\": 12,\n \"height\": 20,\n \"levels\": [\n")
    for index: cast(s32)0..file_count - 1 {
        AppendText(file_text[:], *length, "  {\n   \"number\": ")
        AppendNumber(file_text[:], *length, index + 1)
        AppendText(file_text[:], *length, ",\n   \"cells\": [\n")
        for row: cast(s32)0..SHOVEY_HEIGHT - 1 {
            AppendText(file_text[:], *length, "    \"")
            AppendText(file_text[:], *length, TextView(file_boards[index * HEX + row * SHOVEY_WIDTH * 2:index * HEX + row * SHOVEY_WIDTH * 2 + SHOVEY_WIDTH * 2]))
            AppendText(file_text[:], *length, ifx row < SHOVEY_HEIGHT - 1 then "\",\n" else "\"\n")
        }
        AppendText(file_text[:], *length, "   ]")
        if file_tiles[index] {
            AppendText(file_text[:], *length, ",\n   \"tiles\": [\n")
            for row: cast(s32)0..SHOVEY_HEIGHT - 1 {
                AppendText(file_text[:], *length, "    \"")
                from := index * HEX + PIECES_HEX + row * SHOVEY_WIDTH * 2
                AppendText(file_text[:], *length, TextView(file_boards[from:from + SHOVEY_WIDTH * 2]))
                AppendText(file_text[:], *length, ifx row < SHOVEY_HEIGHT - 1 then "\",\n" else "\"\n")
            }
            AppendText(file_text[:], *length, "   ]")
        }
        if file_decorations[index] {
            AppendText(file_text[:], *length, ",\n   \"decorations\": [\n")
            for row: cast(s32)0..SHOVEY_HEIGHT - 1 {
                AppendText(file_text[:], *length, "    \"")
                from := index * HEX + PIECES_HEX * 2 + row * SHOVEY_WIDTH * 2
                AppendText(file_text[:], *length, TextView(file_boards[from:from + SHOVEY_WIDTH * 2]))
                AppendText(file_text[:], *length, ifx row < SHOVEY_HEIGHT - 1 then "\",\n" else "\"\n")
            }
            AppendText(file_text[:], *length, "   ]")
        }
        if file_route_length[index] >= 0 {
            AppendText(file_text[:], *length, ",\n   \"solution\": \"")
            start := file_route_start[index]
            AppendText(file_text[:], *length, TextView(file_routes[start:start + file_route_length[index]]))
            AppendText(file_text[:], *length, "\"")
        }
        AppendText(file_text[:], *length, ifx index < file_count - 1 then "\n  },\n" else "\n  }\n")
    }
    AppendText(file_text[:], *length, " ]\n}\n")
    return TextView(file_text[:length])
}

SaveFailed :: (message: string) {
    save_state = 3
    save_message_length = 0
    AppendText(save_message[:], *save_message_length, message)
}

// Whether level `index` of the file on disk holds exactly `board`.
FileHolds :: (index: s32, board: []u8) -> bool {
    if index < 0 || index >= file_count { return false }
    normalized: [HEX]u8
    if !ReadBoard(TextView(file_boards[index * HEX:(index + 1) * HEX]), normalized[:]) { return false }
    return Same(normalized[:], board)
}

// Does the file still hold, at the spot this place saves to, the board the
// editor loaded for it? A place only ever replaces its own level, or goes in
// between the levels of the places on both sides of it, so a save can never
// land on another place's level.
SaveSpotMatches :: (place: s32, index: s32) -> bool {
    if !mapping_ok { return false }
    if InGame(place) { return FileHolds(index, SavedBoard(place)) }
    before: s32 = 0
    after: s32 = 0
    other: s32 = 1
    while other <= PLACES {
        if InGame(other) {
            if other < place { before = other }
            else if other > place && after == 0 { after = other }
        }
        other += 1
    }
    if before > 0 && !FileHolds(index - 1, SavedBoard(before)) { return false }
    if after > 0 && !FileHolds(index, SavedBoard(after)) { return false }
    return index == file_count || after > 0
}

// Writes the board on screen with its winning route into the level file: a
// place in the game gets the new board, a waiting place goes in at its place
// and leaves the waiting list. The level code and pictures follow.
StartSave :: () {
    if save_state == 1 || (!Solved() && !Proven()) { return }
    Copy(save_board[:], Board(current))
    save_level = current
    if InGame(current) && Same(Board(current), SavedBoard(current)) { save_state = 2; return }
    text, found := ReadEntireFile(LEVELS_FILE)
    if !found || !ReadLevelFile(text) { SaveFailed("levels/classic.json could not be read."); return }
    // Only a file this editor writes back unchanged is safe to rewrite.
    if LevelFileText() != text { SaveFailed("levels/classic.json is not in the layout the editor writes."); return }
    letters := ifx Solved() then route[:route_length] else proof_route[:proof_length]
    if file_routes_used + cast(s32)letters.count > ROUTES_SIZE { SaveFailed("the route is too long to keep."); return }
    index := LevelNumber(current) - 1
    if !SaveSpotMatches(current, index) {
        SaveFailed("this place and levels/classic.json no longer agree; nothing was saved. Reopen the editor.")
        return
    }
    if !InGame(current) {
        if file_count >= LEVELS_MAX { SaveFailed("there is no room for another level."); return }
        at := file_count
        while at > index {
            for cell: cast(s32)0..HEX - 1 { file_boards[at * HEX + cell] = file_boards[(at - 1) * HEX + cell] }
            file_tiles[at] = file_tiles[at - 1]
            file_decorations[at] = file_decorations[at - 1]
            file_route_start[at] = file_route_start[at - 1]
            file_route_length[at] = file_route_length[at - 1]
            at -= 1
        }
        file_count += 1
    }
    board := Board(current)
    for cell: cast(s32)0..HEX - 1 { file_boards[index * HEX + cell] = board[cell] }
    file_tiles[index] = true
    file_decorations[index] = true
    file_route_start[index] = file_routes_used
    file_route_length[index] = cast(s32)letters.count
    for at: cast(s32)0..cast(s32)letters.count - 1 { file_routes[file_routes_used + at] = letters[at] }
    file_routes_used += cast(s32)letters.count
    if !WriteEntireFile(LEVELS_FILE, LevelFileText()) { SaveFailed("levels/classic.json could not be written."); return }
    Copy(save_board[:], board)
    save_level = current
    Copy(SavedBoard(current), board)
    if !InGame(current) {
        stuck[current] = false
        level_count += 1
        WriteWaiting()
    }
    unused RemoveFile(DraftPath(current))
    save_state = 2
    saved_approval_ready = true
    // The game's level code and the level pictures follow the file.
    if PathExists("tools/levels/levels.py") { Shell("(python3 tools/levels/levels.py generate && python3 tools/levels/levels.py previews) > /dev/null 2>&1 &") }
}

// backup/redesign/stuck.txt: the places still waiting for a winnable layout.
WriteWaiting :: () {
    length: s32 = 0
    for place: cast(s32)1..PLACES - 1 {
        if stuck[place] {
            AppendText(file_text[:], *length, "classic ")
            AppendNumber(file_text[:], *length, place)
            AppendText(file_text[:], *length, "\n")
        }
    }
    unused WriteEntireFile("backup/redesign/stuck.txt", TextView(file_text[:length]))
}

// A board saves itself once it is proven winnable and changed; a save that
// failed is not repeated for the same board.
AutoSave :: () {
    if save_state == 1 || (!Solved() && !Proven()) { return }
    if !Same(Board(current), SavedBoard(current)) {
        if save_state == 3 && save_level == current && Same(save_board[:], Board(current)) { return }
        StartSave()
    }
    if save_state == 2 && !playing && Approved(current) && !ApprovalMatches(current) { ApproveEdit() }
}

// ---------------------------------------------------------------- playing

StartPlay :: () {
    playing = true
    watching = false
    play_length = 0
    unused ShoveyLoadData(*play, LevelFor(current), TextView(Board(current)))
    last_tick = MonotonicMilliseconds()
}

PlayAct :: (action: s32) {
    if play.won || play.lost || play_length >= ROUTE_MAX { return }
    accepted := ifx action <= 3 then ShoveyMove(*play, action) else ifx action == 4 then ShoveyFire(*play) else ShoveyTick(*play)
    if action == 5 && !accepted { return }
    play_route[play_length] = LETTERS[action]
    play_length += 1
    // A win you just played is already proof; stop the searches and save it.
    if play.won && !watching {
        Copy(proof_board[:], Board(current))
        for index: cast(s32)0..play_length - 1 { proof_route[index] = play_route[index] }
        proof_length = play_length
        proof_level = current
        AcceptRoute(proof_route[:], proof_length)
    }
}

// You won the board on screen yourself.
Proven :: () -> bool { return proof_length > 0 && proof_level == current && Same(proof_board[:], Board(current)) }

// The solver found a route for the board on screen.
Solved :: () -> bool { return check_state == 2 && Checked() }

PlayUndo :: () {
    while play_length > 0 && play_route[play_length - 1] == cast(u8)116 { play_length -= 1 }
    if play_length > 0 { play_length -= 1 }
    length := play_length
    play_length = 0
    unused ShoveyLoadData(*play, LevelFor(current), TextView(Board(current)))
    for index: cast(s32)0..length - 1 {
        action: s32 = 0
        for candidate: cast(s32)0..5 { if LETTERS[candidate] == play_route[index] { action = candidate } }
        PlayAct(action)
    }
}

StartWatch :: () {
    if check_state != 2 || !Checked() { return }
    StartPlay()
    watching = true
    watch_at = 0
    watch_last = 0
}

// ---------------------------------------------------------------- screen

Caption :: (key: u64, bounds: Rectangle, text: string, font: s32 = 16) {
    Text(session, TextProps.{.key = key, .bounds = bounds, .text = text, .font = font,
            .wrap = TextWrap.TextWrapAuto, .align = TextAlign.TextAlignStart,
            .vertical_align = TextAlign.TextAlignCenter})
}

Control :: (id: s32, bounds: Rectangle, label: string, selected: bool = false, icon: string = "", picture: string = "") -> bool {
    return Button(session, ButtonProps.{.key = cast(u64)id, .id = id, .bounds = bounds, .label = label, .selected = selected, .icon_shape = icon, .image = ImageProps.{.asset_path = picture, .fit = ImageFit.ImageFitContain}, .fit_content = true,
            .tone = ifx selected then ButtonTone.ButtonToneAccent else ButtonTone.ButtonToneNeutral, .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0
}

Inside :: (bounds: Rectangle, x: float32, y: float32) -> bool {
    return x >= bounds.x && y >= bounds.y && x < bounds.x + bounds.width && y < bounds.y + bounds.height
}

// Green below 50%, then a continuous shift through yellow and orange to red.
Lerp :: (a: s32, b: s32, part: s32, of: s32) -> u8 {
    return cast(u8)(a + (b - a) * part / of)
}

SimilarityColor :: (percent: s32) -> Color {
    if percent <= 50 { return Color.{96, 168, 120, 255} }
    if percent < 70 { return Color.{Lerp(96, 236, percent - 50, 20), Lerp(168, 208, percent - 50, 20), Lerp(120, 72, percent - 50, 20), 255} }
    if percent < 90 { return Color.{Lerp(236, 226, percent - 70, 20), Lerp(208, 80, percent - 70, 20), Lerp(72, 60, percent - 70, 20), 255} }
    value := ifx percent > 100 then 100 else percent
    return Color.{Lerp(226, 214, value - 90, 10), Lerp(80, 36, value - 90, 10), Lerp(60, 36, value - 90, 10), 255}
}

LevelCardColor :: (place: s32, similarity: s32) -> Color {
    if Approved(place) || published_places[place - 1] {
        if !server_configured { return Color.{159, 111, 209, 255} }
        if !server_verified { return Color.{144, 148, 148, 255} }
        if ServerBoardMatches(place) {
            return Color.{159, 111, 209, 255}
        }
        return Color.{218, 132, 167, 255}
    }
    return SimilarityColor(similarity)
}

// Every place at once: a button for each, coloured by what it needs, with
// its number and how alike its board is to its own original (mirroring
// and rotation ignored). A click opens that place.
SELECTOR_COLUMNS :: 15
SelectorScreen :: (area: Rectangle) {
    rows := (PLACES + SELECTOR_COLUMNS - 1) / SELECTOR_COLUMNS
    legend_height: float32 = 28.0
    gap: float32 = 4.0
    cell_width := (area.width - gap * cast(float32)(SELECTOR_COLUMNS - 1)) / cast(float32)SELECTOR_COLUMNS
    cell_height := (area.height - legend_height - gap * cast(float32)(rows - 1)) / cast(float32)rows
    Caption(15, Rectangle.{area.x, area.y, area.width, legend_height},
        ifx server_configured && !server_verified then "Server unverified. Similarity: green below 50% → red above 90%." else
        "Purple: synced. Pink: changed. Similarity: green below 50% → red above 90%.", 14)
    // Measuring a place sets the status line's numbers; keep them.
    keep_percent := similarity_percent
    keep_matches := similarity_matches
    keep_total := similarity_total
    for place: cast(s32)1..PLACES {
        index := place - 1
        column := index % SELECTOR_COLUMNS
        row := index / SELECTOR_COLUMNS
        bounds := Rectangle.{area.x + cast(float32)column * (cell_width + gap),
                area.y + legend_height + cast(float32)row * (cell_height + gap), cell_width, cell_height}
        length: s32 = 0
        AppendNumber(cell_bytes[index * 16:index * 16 + 16], *length, place)
        alike := SimilarityTo(place, place)
        if alike >= 0 {
            AppendText(cell_bytes[index * 16:index * 16 + 16], *length, " ")
            AppendNumber(cell_bytes[index * 16:index * 16 + 16], *length, alike)
            AppendText(cell_bytes[index * 16:index * 16 + 16], *length, "%")
        }
        fill := LevelCardColor(place, alike)
        border := ifx place == current then Color.{30, 30, 30, 255} else Color.{0, 0, 0, 40}
        unused Box(session, BoxProps.{.key = cast(u64)(74000 + place), .bounds = bounds,
                .fill = fill, .border = border, .radius = 5.0})
        if Button(session, ButtonProps.{.key = cast(u64)(3000 + place), .id = 3000 + place, .bounds = bounds,
                .label = TextView(cell_bytes[index * 16:index * 16 + length]), .tone = ButtonTone.ButtonToneNeutral,
                .emphasis = ButtonEmphasis.ButtonEmphasisGhost}) != 0 {
            Open(place)
            selector_open = false
        }
    }
    similarity_percent = keep_percent
    similarity_matches = keep_matches
    similarity_total = keep_total
}

// What the solver says about the board on screen, while you play too.
SolverText :: (bytes: []u8, length: *s32) {
    if check_state == 1 {
        AppendText(bytes, length, "Solver checking (")
        AppendNumber(bytes, length, cast(s32)((MonotonicMilliseconds() - check_started) / 1000))
        AppendText(bytes, length, " of ")
        AppendText(bytes, length, SOLVE_SECONDS)
        AppendText(bytes, length, " s).")
    } else if Solved() {
        AppendText(bytes, length, "Solver: winnable in ")
        AppendNumber(bytes, length, route_length)
        AppendText(bytes, length, " moves.")
    } else if check_state == 3 && Checked() {
        AppendText(bytes, length, "Solver: no route found in ")
        AppendText(bytes, length, SOLVE_SECONDS)
        AppendText(bytes, length, " s.")
    }
}

SolutionText :: () -> string {
    length: s32 = 0
    if Solved() || Proven() {
        AppendText(solution_bytes[:], *length, "Winnable · ")
        AppendNumber(solution_bytes[:], *length, ifx Solved() then route_length else proof_length)
        AppendText(solution_bytes[:], *length, " moves")
    } else if check_state == 1 {
        AppendText(solution_bytes[:], *length, "Checking solution…")
    } else if check_state == 3 && Checked() {
        AppendText(solution_bytes[:], *length, "No solution found")
    } else if check_state == 4 {
        AppendText(solution_bytes[:], *length, "Needs one player")
    } else {
        AppendText(solution_bytes[:], *length, "Not checked")
    }
    return TextView(solution_bytes[:length])
}

SolutionColor :: () -> Color {
    if Solved() || Proven() { return Color.{54, 106, 65, 255} }
    if check_state == 1 { return Color.{118, 94, 38, 255} }
    if (check_state == 3 && Checked()) || check_state == 4 { return Color.{126, 58, 64, 255} }
    return Color.{67, 74, 72, 255}
}

StatusText :: (show_solution: bool = true) -> string {
    length: s32 = 0
    if playing {
        if watching { AppendText(status_bytes[:], *length, "Watching the solver's route.    ") }
        if play.won { AppendText(status_bytes[:], *length, "Won!    ") }
        else if play.lost { AppendText(status_bytes[:], *length, "Lost. Z undoes, R restarts.    ") }
        AppendNumber(status_bytes[:], *length, ShoveyRemaining(*play))
        AppendText(status_bytes[:], *length, " still to do, ")
        AppendNumber(status_bytes[:], *length, play_length)
        AppendText(status_bytes[:], *length, " moves.    ")
        if show_solution { SolverText(status_bytes[:], *length) }
        return TextView(status_bytes[:length])
    }
    if show_solution {
    if check_state == 4 { AppendText(status_bytes[:], *length, "Put exactly one Shovey on the board.") }
    else if check_state == 1 || (check_wanted && !Checked()) {
        AppendText(status_bytes[:], *length, "Checking whether it can be won")
        if check_state == 1 {
            AppendText(status_bytes[:], *length, " (")
            AppendNumber(status_bytes[:], *length, cast(s32)((MonotonicMilliseconds() - check_started) / 1000))
            AppendText(status_bytes[:], *length, " of ")
            AppendText(status_bytes[:], *length, SOLVE_SECONDS)
            AppendText(status_bytes[:], *length, " s)")
        }
        AppendText(status_bytes[:], *length, "...")
    }
    else if check_state == 2 && Checked() {
        AppendText(status_bytes[:], *length, "Winnable: the engine replays a win in ")
        AppendNumber(status_bytes[:], *length, route_length)
        AppendText(status_bytes[:], *length, " moves.")
    }
    else if check_state == 3 && Checked() {
        AppendText(status_bytes[:], *length, "No winning route found in ")
        AppendText(status_bytes[:], *length, SOLVE_SECONDS)
        AppendText(status_bytes[:], *length, ifx Proven() then " s." else " s. Play it (Tab) to prove it, or change it.")
    }
    }
    if BestMirrorMatch(current) >= 0 {
        AppendText(status_bytes[:], *length, "    Puzzle similarity: ")
        AppendNumber(status_bytes[:], *length, similarity_percent)
        AppendText(status_bytes[:], *length, "% (layout and pieces, best mirror)")
    }
    if show_solution && Proven() {
        AppendText(status_bytes[:], *length, "    You won it in ")
        AppendNumber(status_bytes[:], *length, proof_length)
        AppendText(status_bytes[:], *length, " moves.")
    }
    AppendText(status_bytes[:], *length, "    ")
    if save_state == 1 { AppendText(status_bytes[:], *length, "Saving...") }
    else if save_state == 2 && save_level == current && Same(Board(current), SavedBoard(current)) {
        AppendText(status_bytes[:], *length, "Saved in the game's levels.")
    }
    else if !InGame(current) && Same(Board(current), SavedBoard(current)) {
        AppendText(status_bytes[:], *length, "Not in the game yet: once it is winnable it goes in by itself.")
    }
    else if TooClose(current) && Same(Board(current), SavedBoard(current)) {
        AppendText(status_bytes[:], *length, "Too close to its original: change it so it differs more.")
    }
    else if save_state == 3 {
        AppendText(status_bytes[:], *length, "Not saved: ")
        AppendText(status_bytes[:], *length, TextView(save_message[:save_message_length]))
    }
    else if !Same(Board(current), SavedBoard(current)) {
        AppendText(status_bytes[:], *length, "Kept as a draft; it saves itself once it is winnable.")
    }
    return TextView(status_bytes[:length])
}

Palette :: (area: Rectangle) {
    tabs: [2]string = .["Tiles", "Objects"]
    eraser := "S2rr:M5 19H19M7 15L15 7L19 11L13 17H9Z"
    for tab: cast(s32)0..1 {
        if Control(69000 + tab, Rectangle.{area.x + cast(float32)tab * 120.0, area.y, 116.0, 36.0}, tabs[tab], palette_tab == tab) {
            palette_tab = tab
            selected = ifx tab == 0 then 256 else 0
        }
    }
    tile_kinds: [29]s32 = .[0,103,99,100,101,102,77,78,60,61,70,64,65,4,5,6,47,48,49,12,14,95,127,96,128,97,129,98,130]
    tile_names: [29]string = .["Stone floor","Mossy floor","Slate floor","Brick floor","Sandstone floor","Timber floor","Grass","Sand","Checker","Stripes","Ice","Water","Abyss","Red pit","Blue pit","Green pit","Cyan pit","Purple pit","Yellow pit","Stone wall","Mossy stone","Slate wall","Mossy slate","Brick wall","Mossy brick","Sandstone wall","Mossy sand","Timber wall","Mossy timber"]
    count: s32 = ifx palette_tab == 0 then 29 else PALETTE
    visible_count: s32 = 0
    for index: cast(s32)0..count - 1 {
        kind := ifx palette_tab == 0 then tile_kinds[index] else palette_kinds[index]
        if palette_tab == 1 && kind != 0 && (ShoveyTerrain(kind) || kind == 62) { continue }
        if palette_tab == 0 && kind == 12 { visible_count = ((visible_count + 2) / 3) * 3 }
        visible_count += 1
    }
    scrolled := Scroll(session, ScrollProps.{.key = cast(u64)69500, .bounds = Rectangle.{area.x, area.y + 44.0, area.width, area.height - 44.0},
            .content_height = ((visible_count + 2) / 3) * 96, .keep_scrollbar = true, .scroll_offset = palette_scroll[palette_tab]})
    palette_scroll[palette_tab] = scrolled.scroll_offset
    if !scrolled.opened { return }
    row: s32 = 0
    cell_width := (area.width - 16.0) / 3.0
    for index: cast(s32)0..count - 1 {
        kind := ifx palette_tab == 0 then tile_kinds[index] else palette_kinds[index]
        if palette_tab == 1 && kind != 0 && (ShoveyTerrain(kind) || kind == 62) { continue }
        name := ifx palette_tab == 0 then tile_names[index] else ifx kind == 0 then "Erase object" else ifx kind == 71 then "Crack" else palette_names[index]
        brush := kind + (ifx palette_tab == 0 then 256 else ifx kind != 0 && ShoveyDecoration(kind) then 512 else 0)
        if palette_tab == 0 && kind == 12 { row = ((row + 2) / 3) * 3 }
        bounds := Rectangle.{scrolled.content.x + cast(float32)(row % 3) * cell_width,
                scrolled.content.y + cast(float32)(row / 3) * 96.0, cell_width - 4.0, 92.0}
        row += 1
        if bounds.y + bounds.height < scrolled.viewport.y || bounds.y > scrolled.viewport.y + scrolled.viewport.height { continue }
        sprite := ifx kind == 10 then SPRITE_PLAYER + BoardEngineDirection(1, boards_landscape) else PrivateSprite(kind)
        picture := ifx kind == 0 && palette_tab != 0 then "" else OurTiles()[sprite]
        if Button(session, ButtonProps.{.key = cast(u64)(70000 + index), .id = 70000 + index, .class_name = 9001,
                .bounds = bounds, .label = name, .selected = selected == brush, .fit_content = true,
                .icon_shape = ifx kind == 0 && palette_tab != 0 then eraser else "",
                .image = ImageProps.{.asset_path = picture, .fit = ImageFit.ImageFitContain},
                .icon_placement = IconPlacement.IconPlacementAbove,
                .tone = ifx selected == brush then ButtonTone.ButtonToneAccent else ButtonTone.ButtonToneNeutral,
                .emphasis = ButtonEmphasis.ButtonEmphasisFilled}) != 0 { selected = brush }
    }
    unused End(session)
}

Screen :: (viewport: Rectangle, key: s32, modifiers: s32) {
    unused Box(session, BoxProps.{.key = cast(u64)19990, .bounds = viewport, .fill = ColorFromPacked(cast(u32)SHOVEY_SLATE)})
    now := MonotonicMilliseconds()
    PollActions(now)
    PollCheck()
    ctrl := (modifiers & 2) != 0
    if key == 258 { if playing { playing = false; watching = false } else { StartPlay() } }
    if key == 76 && !playing { ToggleSelector() }
    if key == 256 { selector_open = false }
    if playing {
        if !watching {
            if key == 263 || key == 65 { PlayAct(BoardEngineDirection(0, boards_landscape)) }
            if key == 265 || key == 87 { PlayAct(BoardEngineDirection(1, boards_landscape)) }
            if key == 262 || key == 68 { PlayAct(BoardEngineDirection(2, boards_landscape)) }
            if key == 264 || key == 83 { PlayAct(BoardEngineDirection(3, boards_landscape)) }
            if key == 32 { PlayAct(4) }
            if key == 90 || key == 259 { PlayUndo() }
        }
        if key == 82 { StartPlay() }
        // Animals and moving blocks share the engine's recorded timer tick.
        if !watching && now - last_tick >= 1000 {
            last_tick = now
            PlayAct(5)
        }
        if watching && watch_at < route_length && now - watch_last >= 120 {
            watch_last = now
            letter := route[watch_at]
            action: s32 = 0
            for candidate: cast(s32)0..5 { if LETTERS[candidate] == letter { action = candidate } }
            PlayAct(action)
            watch_at += 1
        }
    } else {
        if key == 78 { Open(current + 1) }
        if key == 80 { Open(current - 1) }
        if key == 85 { Open(NextWaiting()) }
        if key == 91 && original_shown > 1 { original_shown -= 1 }
        if key == 93 && original_shown < PLACES { original_shown += 1 }
        if key == 90 { UndoEdit() }
        if key == 89 { RedoEdit() }
        if key == 67 { StartCheck() }
        if key == 83 && ctrl { StartSave() }
    }
    // Check again shortly after the last change.
    if check_wanted && !pointer.down && !secondary.down && now - edited_at >= 1200 { StartCheck() }
    AutoSave()

    width := viewport.width
    height := viewport.height
    length: s32 = 0
    if InGame(current) {
        AppendText(title_bytes[:], *length, "Level ")
        AppendNumber(title_bytes[:], *length, LevelNumber(current))
        AppendText(title_bytes[:], *length, " of ")
        AppendNumber(title_bytes[:], *length, level_count)
    } else {
        AppendText(title_bytes[:], *length, "Waiting: not in the game")
    }
    // The title is the button for the full list of levels.
    if Control(1, Rectangle.{8.0, 8.0, 334.0, 40.0}, TextView(title_bytes[:length])) { ToggleSelector() }
    // One row of controls: moving between places, play and check, then the
    // fix queue and the rotation both boards share.
    bx: float32 = 350.0
    if Control(2, Rectangle.{bx, 8.0, 88.0, 40.0}, "Previous") { Open(current - 1) }
    bx += 96.0
    if Control(3, Rectangle.{bx, 8.0, 64.0, 40.0}, "Next") { Open(current + 1) }
    bx += 72.0
    if Control(4, Rectangle.{bx, 8.0, 108.0, 40.0}, ifx playing then "Edit (Tab)" else "Play (Tab)") {
        if playing { playing = false; watching = false } else { StartPlay() }
    }
    bx += 116.0
    if Control(5, Rectangle.{bx, 8.0, 104.0, 40.0}, "Check (C)") { StartCheck() }
    bx += 112.0
    if Control(6, Rectangle.{bx, 8.0, 112.0, 40.0}, "Watch route") { StartWatch() }
    bx += 120.0
    if Control(7, Rectangle.{bx, 8.0, 92.0, 40.0}, "Undo (Z)") { if playing { PlayUndo() } else { UndoEdit() } }
    bx += 100.0
    if Control(8, Rectangle.{bx, 8.0, 120.0, 40.0}, "Save (Ctrl+S)") { StartSave() }
    bx += 128.0
    if Control(13, Rectangle.{bx, 8.0, 136.0, 40.0}, "Next to fix (U)") { Open(NextWaiting()) }
    bx += 144.0
    if Control(14, Rectangle.{bx, 8.0, 168.0, 40.0}, ifx boards_landscape then "Rotate: portrait" else "Rotate: landscape") { RotateBoards() }
    if Control(16, Rectangle.{8.0, 51.0, 80.0, 30.0}, "Redo (Y)") && !playing { RedoEdit() }
    if Control(17, Rectangle.{94.0, 51.0, 80.0, 30.0}, "Reset") && !playing { ResetEdit() }
    if Button(session, ButtonProps.{.key = 18, .id = 18, .bounds = Rectangle.{180.0, 51.0, 122.0, 30.0},
            .label = ifx glm_busy && !glm_repair then "GLM working…" else "GLM Modify", .disabled = playing || glm_busy || current >= PLACES}) != 0 { ModifyGLM() }
    update := NeedsUpdate(current)
    if Button(session, ButtonProps.{.key = 19, .id = 19, .bounds = Rectangle.{308.0, 51.0, 100.0, 30.0},
            .label = ifx update then ifx check_state == 1 then "Checking…" else ifx PublicationBusy() then "Updating…" else "Update" else "Approve",
            .selected = Approved(current), .disabled = ifx update then !UpdateAvailable() else !ApprovalAvailable()}) != 0 {
        if update { UpdateEdit() } else { ApproveEdit() }
    }
    differences: s32 = 0
    AppendText(diff_label[:], *differences, "Diff ")
    AppendNumber(diff_label[:], *differences, DifferenceCount(current))
    if Button(session, ButtonProps.{.key = 20, .id = 20, .bounds = Rectangle.{414.0, 51.0, 96.0, 30.0},
            .label = TextView(diff_label[:differences]), .selected = diff_open,
            .disabled = playing || !server_verified || !published_places[current - 1]}) != 0 { diff_open = !diff_open }
    if Button(session, ButtonProps.{.key = 21, .id = 21, .bounds = Rectangle.{516.0, 51.0, 92.0, 30.0},
            .label = ifx glm_busy && glm_repair then "Fixing…" else "Fix it",
            .disabled = playing || glm_busy || current >= PLACES}) != 0 { ModifyGLM(true) }
    if Button(session, ButtonProps.{.key = 22, .id = 22, .bounds = Rectangle.{614.0, 51.0, 116.0, 30.0},
            .label = "Update all", .disabled = !server_configured || playing || glm_busy || PublicationBusy()}) != 0 { UpdateAll() }
    unused Box(session, BoxProps.{.key = 23, .bounds = Rectangle.{742.0, 51.0, 220.0, 30.0},
        .fill = SolutionColor(), .radius = 4.0})
    Caption(24, Rectangle.{750.0, 52.0, 204.0, 28.0}, SolutionText(), 14)
    Caption(9, Rectangle.{974.0, 52.0, width - 986.0, 28.0},
        ifx action_message_length > 0 then TextView(action_message[:action_message_length]) else StatusText(false), 14)

    if selector_open {
        if now - drafts_refreshed >= 1000 {
            LoadDrafts()
            drafts_refreshed = now
        }
        SelectorScreen(Rectangle.{8.0, 88.0, width - 16.0, height - 96.0})
        return
    }

    palette_width: float32 = 360.0
    boards_area := Rectangle.{8.0, 84.0, width - palette_width - 24.0, height - 84.0 - 8.0}
    half := (boards_area.height - 28.0) / 2.0
    has_original := original_shown >= 1 && original_shown <= LEVELS_MAX && original_found[original_shown]
    edit_top := boards_area.y + half + 28.0
    edit_height := half - 26.0
    #if #defined(SHOVEY_ADMIN) {
        edit_top = boards_area.y
        edit_height = boards_area.height - 26.0
    } else {
    length = 0
    if diff_open && server_verified && published_places[current - 1] {
        AppendText(label_bytes[:], *length, "Server version")
    } else if has_original {
        AppendText(label_bytes[:], *length, "Original level ")
        AppendNumber(label_bytes[:], *length, original_shown)
        AppendText(label_bytes[:], *length, ifx original_sprites then "" else "  (drawn with the new pictures)")
    } else {
        AppendText(label_bytes[:], *length, "No original on this machine")
    }
    Caption(11, Rectangle.{boards_area.x, boards_area.y, boards_area.width, 24.0}, TextView(label_bytes[:length]), 15)
    if diff_open && server_verified && published_places[current - 1] {
        server_grid := HexBoard(published_boards[(current - 1) * HEX:current * HEX], OurTiles(), layers_original[:],
            cast(u64)100000, Rectangle.{boards_area.x, boards_area.y + 26.0, boards_area.width, half - 26.0},
            boards_landscape, "Server version")
        HighlightDifferences(server_grid, cast(u64)800000)
    } else if has_original {
        unused HexBoard(Original(original_shown), ifx original_sprites then original_tiles[:] else OurTiles(), layers_original[:],
            cast(u64)100000, Rectangle.{boards_area.x, boards_area.y + 26.0, boards_area.width, half - 26.0},
            boards_landscape, "Original")
    }
    }
    Caption(12, Rectangle.{boards_area.x, edit_top, boards_area.width, 24.0},
        ifx playing then "New level: playing" else ifx diff_open then "Your version" else "New level: editing", 15)
    edit_area := Rectangle.{boards_area.x, edit_top + 26.0, boards_area.width, edit_height}
    if playing {
        landscape_aspect := cast(float32)SHOVEY_HEIGHT / cast(float32)SHOVEY_WIDTH
        portrait_aspect := cast(float32)SHOVEY_WIDTH / cast(float32)SHOVEY_HEIGHT
        aspect := ifx boards_landscape then landscape_aspect else portrait_aspect
        play_width := edit_area.width
        play_height := play_width / aspect
        if play_height > edit_area.height {
            play_height = edit_area.height
            play_width = play_height * aspect
        }
        play_bounds := Rectangle.{edit_area.x + (edit_area.width - play_width) / 2.0,
                edit_area.y + (edit_area.height - play_height) / 2.0, play_width, play_height}
        unused ShoveyBoard(session, *play, play_bounds, cast(u64)200000, cast(float64)now / 1000.0, names[0:0])
    } else {
        grid := HexBoard(Board(current), OurTiles(), layers_edit[:], cast(u64)200000, edit_area, boards_landscape, "New level")
        if diff_open { HighlightDifferences(grid, cast(u64)801000) }
        // Alt+click (or Shift+click, if the desktop keeps Alt) picks up the
        // piece under the pointer to paint with.
        picking := (modifiers & 5) != 0
        if picking && pointer.pressed && grid.cell > 0.0 {
            at := BoardLogicalIndex(TileMapCellAt(grid, pointer.x, pointer.y), boards_landscape)
            if at >= 0 {
                piece := KindAt(Board(current), at)
                decoration := KindAt(Board(current), SHOVEY_CELLS * 2 + at)
                selected = ifx palette_tab == 0 then 256 + KindAt(Board(current), SHOVEY_CELLS + at) else ifx piece == 0 && decoration != 0 then 512 + decoration else piece
            }
        }
        // A stroke paints every cell the pointer crosses; it is undone at once.
        if !picking && (pointer.down || secondary.down || secondary.pressed) && grid.cell > 0.0 {
            at := BoardLogicalIndex(TileMapCellAt(grid, pointer.x, pointer.y), boards_landscape)
            if at >= 0 {
                if !stroke { Remember(); stroke = true }
                Paint(at, ifx secondary.down || secondary.pressed then 0 else selected)
            }
        }
        if !pointer.down && !secondary.down && !secondary.pressed { stroke = false }
    }
    Palette(Rectangle.{width - palette_width - 8.0, 88.0, palette_width, height - 88.0 - 8.0})
}

Draw :: () -> bool {
    BeginDesktopFrame()
    key := DesktopPressedKey()
    modifiers := DesktopModifiers()
    viewport := DesktopViewport()
    pointer = PollPointer()
    secondary = PollSecondaryPointer()
    TreePointerUpdate(session, pointer)
    BeginScrollFrame(session, Vector2.{pointer.x, pointer.y}, pointer.pressed, pointer.down, pointer.released,
            DesktopWheelMove(), cast(float64)MonotonicMilliseconds() / 1000.0)
    if BeginFrame(session, cast(u64)1, viewport) != FrameStatus.FrameOk { Say("Editor frame could not begin.\n"); return false }
    Screen(viewport, key, modifiers)
    finished := EndFrameRetained(session, DesktopFrameReusable())
    if finished.status != FrameStatus.FrameOk { Say("Editor frame could not finish.\n"); return false }
    DesktopFrameUnchanged(finished.paint_unchanged)
    drawn := EndDesktopFrame()
    if !drawn { Say("Editor raster frame could not finish.\n") }
    return drawn
}

WriteOut :: (fd: s32, bytes: *u8, count: usize) -> isize #foreign libc "write";

Say :: (text: string) {
    bytes: [256]u8
    if CopyCString(text, bytes[:]) { unused WriteOut(1, *bytes[0], cast(usize)text.count) }
}

#program_export
main :: (argc: s32, argv: **u8) -> s32 {
    // --check-file: can the level file be read and written back unchanged?
    if argc >= 2 && TextFromCString(argv[1]) == "--check-file" {
        text, found := ReadEntireFile(ifx argc >= 3 then TextFromCString(argv[2]) else LEVELS_FILE)
        if !found || !ReadLevelFile(text) { Say("levels/classic.json could not be read\n"); return 1 }
        if LevelFileText() != text { Say("levels/classic.json would not be written back unchanged\n"); return 1 }
        Say("levels/classic.json reads and writes back unchanged\n")
        return 0
    }
    LoadOriginals()
    LoadUnlinked()
    LoadLevels()
    LoadDrafts()
    LoadOrientation()
    LoadApprovals()
    if argc >= 2 && TextFromCString(argv[1]) == "--similarity" {
        digits: [24]u8
        for place: cast(s32)1..PLACES {
            Say(FormatInteger(cast(s64)place, digits[:]))
            Say(" ")
            Say(FormatInteger(cast(s64)SimilarityTo(place, place), digits[:]))
            Say("%\n")
        }
        return 0
    }
    selected = 256
    palette_tab = 0
    start: s32 = 1
    last, remembered := ReadEntireFile("backup/editor-drafts/place")
    if remembered {
        number: s32 = 0
        for at: cast(s64)0..last.count - 1 {
            if last[at] >= cast(u8)48 && last[at] <= cast(u8)57 { number = number * 10 + cast(s32)(last[at] - cast(u8)48) }
        }
        if number > 0 { start = number }
    }
    if argc >= 2 {
        text := TextFromCString(argv[1])
        number: s32 = 0
        for at: cast(s64)0..text.count - 1 {
            if text[at] >= cast(u8)48 && text[at] <= cast(u8)57 { number = number * 10 + cast(s32)(text[at] - cast(u8)48) }
        }
        if number > 0 { start = number }
    }
    Open(start)
    if !OpenDesktopSized(1500, 1000) {
        CloseDesktop()
        return 1
    }
    title: [32]u8
    unused CopyCString("Shovey level editor", title[:])
    SetTitle(window, *title[0])
    session = SessionOpen()
    if !SessionValid(session) {
        CloseDesktop()
        return 1
    }
    unused WidgetPaletteUse(session, ShoveyPalette())
    rules := ActiveStyleRules()
    icons: StyleRule
    icons.selector = StyleDefaultSelector()
    icons.selector.kind = StyleKindButton()
    icons.selector.class_name = 9001
    icons.style.fields = cast(u32)StyleField.StyleIconSize | cast(u32)StyleField.StyleFontSize |
            cast(u32)StyleField.StylePaddingX | cast(u32)StyleField.StylePaddingY | cast(u32)StyleField.StyleGap
    icons.style.icon_size = 64.0
    icons.style.font_size = 12.0
    icons.style.padding_x = 4.0
    icons.style.padding_y = 4.0
    icons.style.gap = 3.0
    icons.order = rules.count
    rules.items[rules.count] = icons
    rules.count += 1
    unused InstallStyleRules(rules)
    ok := true
    while ok && PollDesktop() {
        ok = Draw()
        // An idle window still draws a few frames a second, so a finished
        // check or save shows without input.
        if ok { PauseDesktop() }
    }
    StopCheck()
    SessionClose(session)
    CloseDesktop()
    return ifx ok then 0 else 1
}
