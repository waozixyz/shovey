// C boundary for the Classic solver (tools/solver/solver.c). Every rule runs
// in the shipped engine; this module only loads boards and converts the
// behavior-relevant part of a ShoveyGame to and from a fixed byte vector.
//
// Solver state vector, CLASSIC_STATE_SIZE bytes:
//   0..239    ground
//   240..479  objects
//   480..719  every moving block's light_from direction
//   720       player
//   721       direction while ammunition is held, else 0: ShoveyMove sets it
//             before anything reads it and only ShoveyFire reads it
//   722       powers
//   723       keys
//   724       1 when won, 2 when lost
// Level, move and teleport counters are constant or cosmetic and stay out.
#import, file "../../src/engine.zi";
#import, file "../../src/solver/classic_deadlocks.zi";

CLASSIC_STATE_SIZE :: 725

classic_hex: [SHOVEY_CELLS * 6]u8;
// The loaded board supplies the constant fields of every decoded state.
classic_initial: ShoveyGame;
classic_base: ShoveyGame;
classic_game: ShoveyGame;
// A mirror shadow moves with every step, so no step is plain while one exists.
classic_shadow: bool;

#program_export
ClassicApiStateSize :: () -> s32 { return CLASSIC_STATE_SIZE }

// Loads a NUL-terminated hex board. Returns 1 when the engine accepts it.
#program_export
ClassicApiLoad :: (hex: *u8, level: s32) -> s32 {
    count: s32 = 0
    while hex[count] != cast(u8)0 {
        if count >= SHOVEY_CELLS * 6 { return 0 }
        classic_hex[count] = hex[count]
        count += 1
    }
    if !ShoveyLoadData(*classic_initial, level, TextView(classic_hex[0:count])) { return 0 }
    classic_base = classic_initial
    classic_game = classic_initial
    ClassicApiCrateCells()
    ClassicApiDoorCells()
    ClassicApiPushTable(18, false, classic_goal_table[:])
    ClassicApiPushTable(13, true, classic_plate_table[:])
    return 1
}

// Cells from which a crate can still be pushed onto a crate goal, with the
// fewest pushes it takes. Checked only when every crate must end on a goal
// (no more crates than goals); otherwise any cell may hold a spare crate.
classic_crate_live: [SHOVEY_CELLS]bool;
classic_crate_pushes: [SHOVEY_CELLS]s32;
classic_crate_check: bool;

// Gates (14) stay shut while no plate (13) holds an object. With gates shut,
// areas number the parts of the board Shovey can walk between, and
// switch_pushes counts the pushes that bring a crate onto a plate from each
// cell. A goal or the house in another area than Shovey waits for a plate.
classic_doors: bool;
classic_switch_pushes: [SHOVEY_CELLS]s32;
classic_area: [SHOVEY_CELLS]s32;

// Ground a crate can never enter: walls, holes, home, portals and the
// colour-block goal. Apples, paint, pickups, locks and doors can go away.
ClassicApiPermanentWall :: (ground: s32) -> bool {
    return ground == 12 || ground == 63 || ground == 64 || ground == SHOVEY_PIT || ground == 76 ||
        ShoveyBlockingDecoration(ground) || (ground >= 95 && ground <= 98)
}

ClassicApiCrateWall :: (ground: s32) -> bool {
    return ClassicApiPermanentWall(ground) || (ground >= 4 && ground <= 8) || ground == 39
}

// A crate reaches a place by pushes exactly when pulling it back from that
// place can bring it here; a pull needs the cell behind the crate free of
// walls for Shovey.
ClassicApiCrateCells :: () {
    game := *classic_initial
    crates: s32 = 0
    places: s32 = 0
    queue: [SHOVEY_CELLS]s32
    count: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        classic_crate_live[at] = false
        classic_crate_pushes[at] = CLASSIC_FAR
        if game.objects[at] == 9 { crates += 1 }
        if game.ground[at] == 18 {
            places += 1
            classic_crate_live[at] = true
            classic_crate_pushes[at] = 0
            queue[count] = at
            count += 1
        }
    }
    classic_crate_check = crates > 0 && crates <= places
    head: s32 = 0
    while head < count {
        at := queue[head]
        head += 1
        for side: cast(s32)0..3 {
            from := ShoveyNeighbor(at, side)
            behind := ShoveyNeighbor(from, side)
            if from < 0 || behind < 0 || classic_crate_live[from] { continue }
            if ClassicApiCrateWall(game.ground[from]) || ClassicApiPermanentWall(game.ground[behind]) { continue }
            classic_crate_live[from] = true
            classic_crate_pushes[from] = classic_crate_pushes[at] + 1
            queue[count] = from
            count += 1
        }
    }
}

// Exact pushes a crate needs, with Shovey's side taken into account: a state
// is a crate cell and the part of the floor Shovey can walk in with that crate
// as a wall (named by its smallest cell). A crate may have to be pushed past
// its place and back so that Shovey can stand behind it, and the count
// includes that detour. The tables hold the fewest pushes to a goal (18) with
// gates open, and to a plate (13) with gates shut. Other pieces are ignored.
CLASSIC_TABLE :: SHOVEY_CELLS * SHOVEY_CELLS
classic_goal_table: [CLASSIC_TABLE]s32;
classic_plate_table: [CLASSIC_TABLE]s32;
classic_table_queue: [CLASSIC_TABLE]s32;
classic_fill_seen: [SHOVEY_CELLS]s32;
classic_fill_queue: [SHOVEY_CELLS]s32;
classic_fill_stamp: s32;
classic_fill_count: s32;

// The cells Shovey can walk to from start with one crate cell as an extra
// wall, left marked in classic_fill_seen. Returns the region's smallest cell,
// or -1 when Shovey cannot stand on start.
ClassicApiFill :: (crate: s32, start: s32, shut: bool) -> s32 {
    game := *classic_initial
    if start < 0 || start == crate || ClassicApiPermanentWall(game.ground[start]) || (shut && game.ground[start] == 14) { return -1 }
    classic_fill_stamp += 1
    stamp := classic_fill_stamp
    smallest := start
    classic_fill_queue[0] = start
    classic_fill_seen[start] = stamp
    count: s32 = 1
    head: s32 = 0
    while head < count {
        at := classic_fill_queue[head]
        head += 1
        if at < smallest { smallest = at }
        for side: cast(s32)0..3 {
            next := ShoveyNeighbor(at, side)
            if next < 0 || next == crate || classic_fill_seen[next] == stamp { continue }
            if ClassicApiPermanentWall(game.ground[next]) || (shut && game.ground[next] == 14) { continue }
            classic_fill_seen[next] = stamp
            classic_fill_queue[count] = next
            count += 1
        }
    }
    classic_fill_count = count
    return smallest
}

ClassicApiCrateCan :: (ground: s32, shut: bool) -> bool {
    return !ClassicApiCrateWall(ground) && !(shut && ground == 14)
}

ClassicApiPushTable :: (target: s32, shut: bool, table: []s32) {
    game := *classic_initial
    for index: cast(s32)0..CLASSIC_TABLE - 1 { table[index] = CLASSIC_FAR }
    count: s32 = 0
    done: [SHOVEY_CELLS]bool
    for t: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.ground[t] != target { continue }
        for at: cast(s32)0..SHOVEY_CELLS - 1 { done[at] = false }
        for p: cast(s32)0..SHOVEY_CELLS - 1 {
            if done[p] { continue }
            canon := ClassicApiFill(t, p, shut)
            if canon < 0 { done[p] = true; continue }
            for index: cast(s32)0..classic_fill_count - 1 { done[classic_fill_queue[index]] = true }
            if table[t * SHOVEY_CELLS + canon] > 0 {
                table[t * SHOVEY_CELLS + canon] = 0
                classic_table_queue[count] = t * SHOVEY_CELLS + canon
                count += 1
            }
        }
    }
    // Backwards: a push moved the crate from f to e with Shovey on f's far side.
    head: s32 = 0
    while head < count {
        state := classic_table_queue[head]
        head += 1
        e := state / SHOVEY_CELLS
        canon := state % SHOVEY_CELLS
        here := table[state]
        unused ClassicApiFill(e, canon, shut)
        inside: [4]bool
        for d: cast(s32)0..3 {
            f := ShoveyNeighbor(e, d)
            inside[d] = f >= 0 && classic_fill_seen[f] == classic_fill_stamp
        }
        for d: cast(s32)0..3 {
            if !inside[d] { continue }
            f := ShoveyNeighbor(e, d)
            g := ShoveyNeighbor(f, d)
            if g < 0 || !ClassicApiCrateCan(game.ground[f], shut) { continue }
            canon2 := ClassicApiFill(f, g, shut)
            if canon2 < 0 { continue }
            key := f * SHOVEY_CELLS + canon2
            if table[key] > here + 1 {
                table[key] = here + 1
                classic_table_queue[count] = key
                count += 1
            }
        }
    }
}

// The pushes this crate still needs from where Shovey stands now.
ClassicApiCrateDistance :: (crate: s32, table: []s32, shut: bool) -> s32 {
    canon := ClassicApiFill(crate, classic_game.player, shut)
    if canon < 0 { return CLASSIC_FAR }
    return table[crate * SHOVEY_CELLS + canon]
}

ClassicApiDoorCells :: () {
    game := *classic_initial
    queue: [SHOVEY_CELLS]s32
    count: s32 = 0
    doors := false
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        classic_switch_pushes[at] = CLASSIC_FAR
        classic_area[at] = -1
        if game.ground[at] == 14 { doors = true }
        if game.ground[at] == 13 {
            classic_switch_pushes[at] = 0
            queue[count] = at
            count += 1
        }
    }
    classic_doors = doors && count > 0
    head: s32 = 0
    while head < count {
        at := queue[head]
        head += 1
        for side: cast(s32)0..3 {
            from := ShoveyNeighbor(at, side)
            behind := ShoveyNeighbor(from, side)
            if from < 0 || behind < 0 || classic_switch_pushes[from] < CLASSIC_FAR { continue }
            if ClassicApiCrateWall(game.ground[from]) || game.ground[from] == 14 { continue }
            if game.ground[behind] == 12 || game.ground[behind] == 14 { continue }
            classic_switch_pushes[from] = classic_switch_pushes[at] + 1
            queue[count] = from
            count += 1
        }
    }
    areas: s32 = 0
    for start: cast(s32)0..SHOVEY_CELLS - 1 {
        if classic_area[start] >= 0 || game.ground[start] == 12 || game.ground[start] == 14 { continue }
        classic_area[start] = areas
        queue[0] = start
        count = 1
        head = 0
        while head < count {
            at := queue[head]
            head += 1
            for side: cast(s32)0..3 {
                next := ShoveyNeighbor(at, side)
                if next < 0 || classic_area[next] >= 0 || game.ground[next] == 12 || game.ground[next] == 14 { continue }
                classic_area[next] = areas
                queue[count] = next
                count += 1
            }
        }
        areas += 1
    }
}

// Writes the current game's state vector. Returns 0 when a value does not
// fit its byte, which the solver treats as a fatal encoding error.
#program_export
ClassicApiEncode :: (out: *u8) -> s32 {
    game := *classic_game
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ground := game.ground[at]
        object := game.objects[at]
        if ground < 0 || ground > 255 || object < 0 || object > 255 { return 0 }
        out[at] = cast(u8)ground
        out[SHOVEY_CELLS + at] = cast(u8)object
        source := game.light_from[at]
        if source < 0 || source > 4 { return 0 }
        out[SHOVEY_CELLS * 2 + at] = cast(u8)source
    }
    direction: s32 = ifx (game.powers & SHOVEY_AMMO) != 0 then game.direction else 0
    if game.player < 0 || game.player >= SHOVEY_CELLS || direction < 0 || direction > 3 ||
    game.powers < 0 || game.powers > 255 || game.keys < 0 || game.keys > 255 { return 0 }
    out[720] = cast(u8)game.player
    out[721] = cast(u8)direction
    out[722] = cast(u8)game.powers
    out[723] = cast(u8)game.keys
    out[724] = cast(u8)((ifx game.won then 1 else 0) + (ifx game.lost then 2 else 0))
    return 1
}

// Replaces the base and current game with a decoded state vector.
#program_export
ClassicApiDecode :: (data: *u8) {
    classic_base = classic_initial
    game := *classic_base
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ground := cast(s32)data[at]
        game.ground[at] = ground
        game.objects[at] = cast(s32)data[SHOVEY_CELLS + at]
        game.light_from[at] = cast(s32)data[SHOVEY_CELLS * 2 + at]
    }
    game.player = cast(s32)data[720]
    game.direction = cast(s32)data[721]
    game.powers = cast(s32)data[722]
    game.keys = cast(s32)data[723]
    game.won = (data[724] & cast(u8)1) != cast(u8)0
    game.lost = (data[724] & cast(u8)2) != cast(u8)0
    classic_shadow = false
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        if game.objects[at] == 40 { classic_shadow = true }
    }
    classic_game = classic_base
}

// Restores the current game to the last decoded (or loaded) base.
#program_export
ClassicApiReset :: () { classic_game = classic_base }

// Actions: 0..3 move left, up, right, down; 4 fires; 5 advances the moving
// block one timer tick. Returns 1 when the engine accepted the action. The
// solver relies on the engine's rejections changing nothing but facing:
// ShoveyMove sets the direction before its checks, and every other rejection
// returns before any write.
#program_export
ClassicApiAct :: (action: s32) -> s32 {
    accepted := false
    if action >= 0 && action <= 3 { accepted = ShoveyMove(*classic_game, action) }
    else if action == 4 { accepted = ShoveyFire(*classic_game) }
    else if action == 5 { accepted = ShoveyTick(*classic_game) }
    return ifx accepted then 1 else 0
}

// Describe an attempted push before replay; a rejected action never counts.
#program_export
ClassicApiPushKind :: (action: s32) -> s32 {
    if action < 0 || action > 3 { return 0 }
    at := ShoveyNeighbor(classic_game.player, action)
    if at < 0 { return 0 }
    kind := classic_game.objects[at]
    return ifx kind != 40 && ShoveyMovable(kind) then kind else 0
}

// Mechanics used by this action, rather than unused pieces on the board.
#program_export
ClassicApiActionFeatures :: (action: s32) -> s32 {
    if action < 0 || action > 3 { return 0 }
    at := ShoveyNeighbor(classic_game.player, action)
    if at < 0 { return 0 }
    ground := classic_game.ground[at]
    features: s32 = 0
    if ShoveyArrow(ground) >= 0 { features |= 1 }
    if ground == 8 || ShoveyColorPortal(ground) { features |= 2 }
    if ground == 11 && (classic_game.powers & SHOVEY_TRAIL) == 0 { features |= 4 }
    if ShoveyMossColor(ground) >= 0 || ShoveyGateColor(ground) >= 0 { features |= 8 }
    if ShoveyLever(ground) { features |= 16 }
    if ground == 35 || ground == SHOVEY_ICE { features |= 128 }
    if ClassicApiPushKind(action) != 0 {
        to := ShoveyNeighbor(at, action)
        if to >= 0 {
            if ShoveyPaintColor(classic_game.ground[to]) > 0 { features |= 32 }
            if ShoveyButtonColor(classic_game.ground[to]) >= 0 { features |= 64 }
        }
    }
    return features
}

#program_export
ClassicApiWon :: () -> s32 { return ifx classic_game.won then 1 else 0 }

#program_export
ClassicApiLost :: () -> s32 { return ifx classic_game.lost then 1 else 0 }

#program_export
ClassicApiRemaining :: () -> s32 { return ShoveyRemaining(*classic_game) }

// What the goal chain counts down: the goals still to finish, plus one while
// gates exist and no plate holds anything. Pressing a plate is a step of its
// own, as a person plays: clear the balls and stars, bring one crate to the
// plate so the gate opens, then place the other crates.
#program_export
ClassicApiProgress :: () -> s32 {
    progress := ShoveyRemaining(*classic_game)
    if classic_doors {
        held := false
        for at: cast(s32)0..SHOVEY_CELLS - 1 {
            if classic_game.ground[at] == 13 && classic_game.objects[at] != 0 { held = true }
        }
        if !held { progress += 1 }
    }
    return progress
}

// Byte offsets of Shovey's cell and facing in the state vector. A move that
// changes no other byte is a free walk, so the solver may treat every cell
// reached that way as one region.
#program_export
ClassicApiPlayerByte :: () -> s32 { return 720 }

#program_export
ClassicApiFacingByte :: () -> s32 { return 721 }

#program_export
ClassicApiFacings :: () -> s32 { return 4 }

// The current walker as the state vector encodes it: cell * 4 + facing.
#program_export
ClassicApiWalker :: () -> s32 {
    facing: s32 = ifx (classic_game.powers & SHOVEY_AMMO) != 0 then classic_game.direction else 0
    return classic_game.player * 4 + facing
}

// Moves the base game's walker, as decoding the vector with it would.
#program_export
ClassicApiSetWalker :: (walker: s32) {
    classic_base.player = walker / 4
    classic_base.direction = walker % 4
}

// The walker a move reaches when it only moves Shovey onto plain, empty floor:
// ShoveyStep then changes nothing but Shovey's cell and facing. Powers that
// react to steps and a mirror shadow rule this out. Returns -1 when the
// engine has to take the step.
#program_export
ClassicApiPlainStep :: (direction: s32) -> s32 {
    game := *classic_base
    if classic_shadow || (game.powers & (SHOVEY_TRAIL | SHOVEY_REVERSE | SHOVEY_SLIDE)) != 0 { return -1 }
    to := ShoveyNeighbor(game.player, direction)
    if to < 0 || game.ground[to] != 0 || game.objects[to] != 0 || game.ground[game.player] == SHOVEY_CRACKED_FLOOR { return -1 }
    return to * 4 + (ifx (game.powers & SHOVEY_AMMO) != 0 then direction else 0)
}

// Animals avoid Shovey, so their timer tick depends on his exact cell.
#program_export
ClassicApiWalkerFree :: (action: s32) -> s32 {
    if action != 5 { return 0 }
    for kind: classic_base.ground { if ShoveyAnimal(kind) && !ShoveyFish(kind) { return 0 } }
    return 1
}

// A ball against two crossing walls can never move again and never sinks, so
// ShoveyRemaining can never reach 0. Only permanent walls (12) and the board
// edge count. The macro searches drop such states.
#program_export
ClassicApiDead :: () -> s32 {
    if SolveTrailBallsBlocked(*classic_game) { return 1 }
    balls: [6]s32
    holes: [6]s32
    paint: [6]s32
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        color := ShoveyBallColor(classic_game.objects[at])
        if color > 0 { balls[color - 1] += 1 }
        pit := ShoveyPitColor(classic_game.ground[at])
        if pit > 0 { holes[pit - 1] += 1 }
        painter := ShoveyPaintColor(classic_game.ground[at])
        if painter > 0 { paint[painter - 1] += 1 }
    }
    // A ball without a matching pit needs a consumable paint of a color
    // that has one. Do not spend that last paint on an already-matching ball.
    needed: s32 = 0
    available: s32 = 0
    for color: cast(s32)0..5 {
        if holes[color] == 0 { needed += balls[color] }
        else { available += paint[color] }
    }
    if needed > available { return 1 }
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        object := classic_game.objects[at]
        if ShoveyBallColor(object) <= 0 { continue }
        blocked: [4]bool
        for side: cast(s32)0..3 {
            neighbor := ShoveyNeighbor(at, side)
            blocked[side] = neighbor < 0 || ClassicApiPermanentWall(classic_game.ground[neighbor])
        }
        if (blocked[0] || blocked[2]) && (blocked[1] || blocked[3]) { return 1 }
    }
    // A crate that can no longer reach any goal when every crate needs one,
    // or one frozen in place off its goal.
    if classic_crate_check {
        for at: cast(s32)0..SHOVEY_CELLS - 1 {
            if classic_game.objects[at] != 9 { continue }
            if !classic_crate_live[at] { return 1 }
            if classic_game.ground[at] != 18 {
                held: [SHOVEY_CELLS]bool
                if ClassicApiFrozen(at, 0, held[:], true) && ClassicApiFrozen(at, 1, held[:], true) { return 1 }
            }
        }
    }
    return 0
}

// Whether a piece at `at` can never move along an axis (0 across, 1 along):
// no push either way is possible. `held` marks pieces assumed fixed, so a
// ring of pieces ends the recursion; `goal` asks pushes to lead somewhere a
// crate can still reach a goal from.
ClassicApiFrozen :: (at: s32, axis: s32, held: []bool, goal: bool = false) -> bool {
    first := ShoveyNeighbor(at, ifx axis == 0 then 0 else 1)
    second := ShoveyNeighbor(at, ifx axis == 0 then 2 else 3)
    held[at] = true
    stuck := !ClassicApiCanPush(first, second, axis, held, goal) && !ClassicApiCanPush(second, first, axis, held, goal)
    held[at] = false
    return stuck
}

// A push with Shovey standing on `from` moving the piece onto `to`. Shovey
// cannot stand on walls or fixed pieces; crates never enter walls, holes,
// home, portals or the colour goal; a piece already there must be able to
// move out of the way across this axis.
ClassicApiCanPush :: (from: s32, to: s32, axis: s32, held: []bool, goal: bool) -> bool {
    game := *classic_game
    if from < 0 || to < 0 || held[from] || held[to] { return false }
    if ClassicApiPermanentWall(game.ground[from]) || ClassicApiCrateWall(game.ground[to]) { return false }
    if goal && !classic_crate_live[to] { return false }
    if ShoveyMovable(game.objects[to]) && ClassicApiFrozen(to, 1 - axis, held) { return false }
    return true
}

ClassicApiDistance :: (from: s32, to: s32) -> s32 {
    dx := from % SHOVEY_WIDTH - to % SHOVEY_WIDTH; dy := from / SHOVEY_WIDTH - to / SHOVEY_WIDTH
    return (ifx dx < 0 then -dx else dx) + (ifx dy < 0 then -dy else dy)
}

// Distance to the nearest listed cell other than from, or 0 for none.
ClassicApiNearest :: (from: s32, cells: []s32) -> s32 {
    best: s32 = -1
    for cell: cells {
        if cell == from { continue }
        distance := ClassicApiDistance(from, cell)
        if best < 0 || distance < best { best = distance }
    }
    return ifx best < 0 then 0 else best
}

CLASSIC_FAR :: 1000
// Finishing a goal must outweigh the longest walk home (at most 28 cells).
CLASSIC_GOAL :: 32
// Search order, as a person plays: loose balls and stars are cleared before a
// crate goes to a plate, and a plate before the remaining crates. Each earlier
// kind of goal weighs more, so finishing it beats any later goal.
CLASSIC_BALL_ORDER :: 8
CLASSIC_STAR_ORDER :: 4
CLASSIC_DOOR_ORDER :: 2

// Fills distance with the cost of pushing a piece (object kind) from each
// cell into the nearest source cell, each source starting at its own cost.
// A push needs the piece's floor where it stands and Shovey's floor behind
// it; any other object on either cell must move first and costs 3 more.
ClassicApiEventuallyAllows :: (game: *ShoveyGame, at: s32, piece: s32) -> bool {
    if at < 0 || at >= SHOVEY_CELLS { return false }
    kind := game.ground[at]
    // These are state changes, not permanent walls. Only the real engine
    // decides when a move through them is legal; the estimate stays optimistic.
    return ShoveyFloorAllows(game, at, piece) || ShoveyClosedDoor(kind) ||
        ShoveyGateColor(kind) >= 0 || ShoveyMossColor(kind) >= 0
}

ClassicApiPushField :: (game: *ShoveyGame, piece: s32, sources: []s32, starts: []s32,
    distance: []s32) {
    queue: [SHOVEY_CELLS]s32
    queued: [SHOVEY_CELLS]bool
    head: s32 = 0; count: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 { distance[at] = CLASSIC_FAR }
    for index: cast(s32)0..cast(s32)sources.count - 1 {
        at := sources[index]
        if starts[index] < distance[at] { distance[at] = starts[index] }
        if !queued[at] { queued[at] = true; queue[(head + count) % SHOVEY_CELLS] = at; count += 1 }
    }
    while count > 0 {
        cell := queue[head]
        head = (head + 1) % SHOVEY_CELLS; count -= 1
        queued[cell] = false
        for direction: cast(s32)0..3 {
            // The piece came from `from`, pushed toward cell by Shovey behind it.
            from := ShoveyNeighbor(cell, direction)
            behind := ShoveyNeighbor(from, direction)
            if behind < 0 || !ClassicApiEventuallyAllows(game, from, piece) || !ClassicApiEventuallyAllows(game, behind, 10) { continue }
            cost := distance[cell] + 1
            if game.objects[from] != 0 && game.objects[from] != piece { cost += 3 }
            if game.objects[behind] != 0 { cost += 3 }
            if cost < distance[from] {
                distance[from] = cost
                if !queued[from] { queued[from] = true; queue[(head + count) % SHOVEY_CELLS] = from; count += 1 }
            }
        }
    }
}

// Route guidance through the actual room geometry. Spare crates obstruct the
// route but are not extra goals; walking into an ordinary door opens it.
// This orders work only and never prunes a state or claims a solution.
ClassicApiWalkNearest :: (game: *ShoveyGame, targets: []s32) -> s32 {
    if targets.count == 0 { return 0 }
    distance: [SHOVEY_CELLS]s32
    queue: [SHOVEY_CELLS]s32
    queued: [SHOVEY_CELLS]bool
    for at: cast(s32)0..SHOVEY_CELLS - 1 { distance[at] = CLASSIC_FAR }
    distance[game.player] = 0
    queue[0] = game.player
    queued[game.player] = true
    head: s32 = 0
    count: s32 = 1
    while count > 0 {
        at := queue[head]
        head = (head + 1) % SHOVEY_CELLS
        count -= 1
        queued[at] = false
        for direction: cast(s32)0..3 {
            to := ShoveyNeighbor(at, direction)
            if !ClassicApiEventuallyAllows(game, to, 10) { continue }
            cost := distance[at] + 1
            if game.objects[to] != 0 && game.objects[to] != 40 { cost += 4 }
            if !ShoveyFloorAllows(game, to, 10) { cost += 4 }
            if cost >= distance[to] { continue }
            distance[to] = cost
            if !queued[to] {
                queued[to] = true
                queue[(head + count) % SHOVEY_CELLS] = to
                count += 1
            }
        }
    }
    best: s32 = CLASSIC_FAR
    for target: targets { if distance[target] < best { best = distance[target] } }
    return ifx best >= CLASSIC_FAR then 100 else best
}

// Focus the ordered searches on routes to objectives. Spare crates off
// these routes remain legal to move, but are more expensive search steps.
classic_focus: [SHOVEY_CELLS]bool;
classic_focus_walk: [SHOVEY_CELLS]s32;
classic_focus_from: [SHOVEY_CELLS]s32;

ClassicApiFocusWalk :: (at: s32) {
    if at < 0 || at >= SHOVEY_CELLS || classic_focus_walk[at] >= CLASSIC_FAR { return }
    for step: cast(s32)0..SHOVEY_CELLS - 1 {
        classic_focus[at] = true
        from := classic_focus_from[at]
        if from < 0 || from == at { return }
        at = from
    }
}

ClassicApiFocusPiece :: (game: *ShoveyGame, piece: s32, at: s32, sources: []s32, starts: []s32) {
    if sources.count == 0 { return }
    distance: [SHOVEY_CELLS]s32
    ClassicApiPushField(game, piece, sources, starts, distance[:])
    for step: cast(s32)0..SHOVEY_CELLS - 1 {
        classic_focus[at] = true
        for source: sources { if at == source { return } }
        best: s32 = -1
        support: s32 = -1
        cost: s32 = CLASSIC_FAR
        access: s32 = CLASSIC_FAR
        for direction: cast(s32)0..3 {
            next := ShoveyNeighbor(at, direction)
            behind := ShoveyNeighbor(at, (direction + 2) % 4)
            if behind < 0 || next < 0 || !ClassicApiEventuallyAllows(game, next, piece) ||
                !ClassicApiEventuallyAllows(game, behind, 10) || distance[next] >= distance[at] { continue }
            pushed := distance[next] + 1
            if game.objects[at] != 0 && game.objects[at] != piece { pushed += 3 }
            if game.objects[behind] != 0 { pushed += 3 }
            if pushed < cost || (pushed == cost && classic_focus_walk[behind] < access) {
                best = next; support = behind; cost = pushed; access = classic_focus_walk[behind]
            }
        }
        if best < 0 { ClassicApiFocusWalk(at); return }
        ClassicApiFocusWalk(support)
        classic_focus[support] = true
        at = best
    }
}

#program_export
ClassicApiFocus :: () {
    game := *classic_game
    queue: [SHOVEY_CELLS]s32
    queued: [SHOVEY_CELLS]bool
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        classic_focus[at] = false
        classic_focus_walk[at] = CLASSIC_FAR
        classic_focus_from[at] = -1
    }
    classic_focus_walk[game.player] = 0
    queue[0] = game.player; queued[game.player] = true
    head: s32 = 0; count: s32 = 1
    while count > 0 {
        at := queue[head]; head = (head + 1) % SHOVEY_CELLS; count -= 1
        queued[at] = false
        for direction: cast(s32)0..3 {
            to := ShoveyNeighbor(at, direction)
            if !ClassicApiEventuallyAllows(game, to, 10) { continue }
            cost := classic_focus_walk[at] + 1
            if game.objects[to] != 0 && game.objects[to] != 40 { cost += 8 }
            if !ShoveyFloorAllows(game, to, 10) { cost += 8 }
            if cost >= classic_focus_walk[to] { continue }
            classic_focus_walk[to] = cost; classic_focus_from[to] = at
            if !queued[to] {
                queued[to] = true; queue[(head + count) % SHOVEY_CELLS] = to; count += 1
            }
        }
    }
    crates: [SHOVEY_CELLS]s32; crate_count: s32 = 0
    plates: [SHOVEY_CELLS]s32; plate_count: s32 = 0
    switches: [SHOVEY_CELLS]s32; switch_count: s32 = 0
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ground := game.ground[at]; object := game.objects[at]
        if object == 9 { crates[crate_count] = at; crate_count += 1 }
        if ground == 18 && object != 9 { plates[plate_count] = at; plate_count += 1 }
        if ground == 13 && object == 0 { switches[switch_count] = at; switch_count += 1 }
        if ground == 21 || ground == 56 || object == 19 || object == 28 || object == 40 ||
            ShoveyLever(ground) || (ground == 7 && ShoveyRemaining(game) == 0) { ClassicApiFocusWalk(at) }
        color := ShoveyBallColor(object)
        if color > 0 {
            sources: [SHOVEY_CELLS]s32; starts: [SHOVEY_CELLS]s32; source_count: s32 = 0
            for to: cast(s32)0..SHOVEY_CELLS - 1 {
                pit := ShoveyPitColor(game.ground[to])
                paint := ShoveyPaintColor(game.ground[to])
                if pit != color && paint == 0 { continue }
                sources[source_count] = to
                if paint > 0 { starts[source_count] = CLASSIC_GOAL }
                source_count += 1
            }
            ClassicApiFocusPiece(game, object, at, sources[0:source_count], starts[0:source_count])
        }
        if ShoveyColorBlock(object) {
            rests: [SHOVEY_CELLS]s32; starts: [SHOVEY_CELLS]s32; rest_count: s32 = 0
            for to: cast(s32)0..SHOVEY_CELLS - 1 {
                if game.ground[to] == 39 { rests[rest_count] = to; rest_count += 1 }
            }
            ClassicApiFocusPiece(game, object, at, rests[0:rest_count], starts[0:rest_count])
        }
    }
    starts: [SHOVEY_CELLS]s32
    if plate_count > 0 {
        best: s32 = -1; cost: s32 = CLASSIC_FAR
        for index: cast(s32)0..crate_count - 1 {
            pushes := ClassicApiCrateDistance(crates[index], classic_goal_table[:], false)
            if pushes < cost { best = crates[index]; cost = pushes }
        }
        if best >= 0 { ClassicApiFocusPiece(game, 9, best, plates[0:plate_count], starts[0:plate_count]) }
    }
    if classic_doors && switch_count > 0 {
        best: s32 = -1; cost: s32 = CLASSIC_FAR
        for index: cast(s32)0..crate_count - 1 {
            pushes := ClassicApiCrateDistance(crates[index], classic_plate_table[:], true)
            if pushes < cost { best = crates[index]; cost = pushes }
        }
        if best >= 0 { ClassicApiFocusPiece(game, 9, best, switches[0:switch_count], starts[0:switch_count]) }
    }
}

#program_export
ClassicApiActionCost :: (action: s32) -> s32 {
    if action < 0 || action > 3 || classic_crate_check { return 1 }
    at := ShoveyNeighbor(classic_game.player, action)
    if at < 0 || classic_game.objects[at] != 9 || classic_focus[at] { return 1 }
    return 16
}

// Search guidance only, never a rule: each unfinished goal of ShoveyRemaining
// costs CLASSIC_GOAL plus how far its piece is from the place that finishes it,
// then Shovey's distance to the nearest open goal, or to a house when none is
// left. Balls use push distances to a hole of their color, or through a
// painter to a hole of the painter's color; other pieces use Manhattan
// distance.
#program_export
ClassicApiEstimate :: () -> s32 {
    game := *classic_game
    balls: [SHOVEY_CELLS]s32; ball_count: s32 = 0
    holes: [6][SHOVEY_CELLS]s32; hole_count: [6]s32
    painters: [SHOVEY_CELLS]s32; painter_count: s32 = 0
    crates: [SHOVEY_CELLS]s32; crate_count: s32 = 0
    plates: [SHOVEY_CELLS]s32; plate_count: s32 = 0
    rings: [SHOVEY_CELLS]s32; ring_count: s32 = 0
    rests: [SHOVEY_CELLS]s32; rest_count: s32 = 0
    stars: [SHOVEY_CELLS]s32; star_count: s32 = 0
    goals: [SHOVEY_CELLS]s32; goal_count: s32 = 0
    homes: [SHOVEY_CELLS]s32; home_count: s32 = 0
    colors: [6]bool
    estimate: s32 = 0
    plate_held := false
    for at: cast(s32)0..SHOVEY_CELLS - 1 {
        ground := game.ground[at]; object := game.objects[at]
        if ground == 13 && object != 0 { plate_held = true }
        ball_color := ShoveyBallColor(object)
        if ball_color > 0 {
            balls[ball_count] = at * 64 + object; ball_count += 1
            colors[ball_color - 1] = true
        }
        pit_color := ShoveyPitColor(ground)
        if pit_color > 0 { holes[pit_color - 1][hole_count[pit_color - 1]] = at; hole_count[pit_color - 1] += 1 }
        if ShoveyPaintColor(ground) > 0 { painters[painter_count] = at; painter_count += 1 }
        if object == 9 && ground != 18 { crates[crate_count] = at; crate_count += 1 }
        if ground == 18 && object != 9 { plates[plate_count] = at; plate_count += 1 }
        if ShoveyColorBlock(object) && ground != 39 { rings[ring_count] = at; ring_count += 1 }
        if ground == 39 && !ShoveyColorRest(object) { rests[rest_count] = at; rest_count += 1 }
        if object == 19 { stars[star_count] = at; star_count += 1 }
        if ground == 7 { homes[home_count] = at; home_count += 1 }
        if ground == 21 || ground == 56 || object == 28 || object == 40 { estimate += CLASSIC_GOAL; goals[goal_count] = at; goal_count += 1 }
        if object == 40 { estimate += ClassicApiDistance(at, game.player) }
        if ground == 29 || ground == 30 { estimate += 1 }
    }
    for color: cast(s32)0..5 {
        if !colors[color] { continue }
        sources: [SHOVEY_CELLS]s32; starts: [SHOVEY_CELLS]s32; source_count: s32 = 0
        for index: cast(s32)0..hole_count[color] - 1 {
            sources[source_count] = holes[color][index]; source_count += 1
        }
        for index: cast(s32)0..painter_count - 1 {
            at := painters[index]; painted := ShoveyPaintColor(game.ground[at]) - 1
            sources[source_count] = at
            starts[source_count] = 1 + ClassicApiNearest(at, holes[painted][0:hole_count[painted]])
            source_count += 1
        }
        distance: [SHOVEY_CELLS]s32
        ClassicApiPushField(game, ShoveyBallForColor(color + 1), sources[0:source_count], starts[0:source_count], distance[:])
        for index: cast(s32)0..ball_count - 1 {
            if balls[index] % 64 != ShoveyBallForColor(color + 1) { continue }
            at := balls[index] / 64
            estimate += CLASSIC_BALL_ORDER * (CLASSIC_GOAL + (ifx distance[at] >= CLASSIC_FAR then 100 else distance[at]))
            goals[goal_count] = at; goal_count += 1
        }
    }
    if classic_crate_check {
        // Every crate needs a goal: count the pushes each still needs.
        for index: cast(s32)0..crate_count - 1 {
            pushes := ClassicApiCrateDistance(crates[index], classic_goal_table[:], false)
            estimate += CLASSIC_GOAL + (ifx pushes >= CLASSIC_FAR then 100 else pushes)
            goals[goal_count] = crates[index]; goal_count += 1
        }
    } else {
        // Spare crates: the crates nearest to a goal fill the open goals.
        costs: [SHOVEY_CELLS]s32
        for index: cast(s32)0..crate_count - 1 { costs[index] = ClassicApiCrateDistance(crates[index], classic_goal_table[:], false) }
        for index: cast(s32)0..plate_count - 1 {
            best: s32 = -1
            for crate_index: cast(s32)0..crate_count - 1 {
                if costs[crate_index] >= 0 && (best < 0 || costs[crate_index] < costs[best]) { best = crate_index }
            }
            pushes: s32 = 100
            if best >= 0 {
                if costs[best] < CLASSIC_FAR { pushes = costs[best] }
                costs[best] = -1
            }
            estimate += CLASSIC_GOAL + pushes
            goals[goal_count] = plates[index]; goal_count += 1
        }
    }
    for index: cast(s32)0..rest_count - 1 {
        estimate += CLASSIC_GOAL + ClassicApiNearest(rests[index], rings[0:ring_count])
        goals[goal_count] = rests[index]; goal_count += 1
    }
    for index: cast(s32)0..star_count - 1 {
        nearest := ClassicApiNearest(stars[index], stars[0:star_count])
        estimate += CLASSIC_STAR_ORDER * (CLASSIC_GOAL + (ifx nearest > 1 then nearest - 1 else 0))
        goals[goal_count] = stars[index]; goal_count += 1
    }
    // A goal or the house beyond a shut gate: the nearest free crate has to
    // reach a plate first, which outweighs the goals it unlocks.
    if classic_doors && !plate_held {
        needed := false
        here := classic_area[game.player]
        for index: cast(s32)0..goal_count - 1 {
            if classic_area[goals[index]] != here { needed = true }
        }
        for index: cast(s32)0..home_count - 1 {
            if classic_area[homes[index]] != here { needed = true }
        }
        if needed {
            nearest: s32 = CLASSIC_FAR
            for index: cast(s32)0..crate_count - 1 {
                pushes := ClassicApiCrateDistance(crates[index], classic_plate_table[:], true)
                if pushes < nearest { nearest = pushes }
            }
            estimate += CLASSIC_GOAL * 8 * CLASSIC_DOOR_ORDER + (ifx nearest >= CLASSIC_FAR then 100 else nearest)
        }
    }
    if goal_count > 0 { estimate += ClassicApiWalkNearest(game, goals[0:goal_count]) }
    else { estimate += ClassicApiWalkNearest(game, homes[0:home_count]) }
    return estimate
}
