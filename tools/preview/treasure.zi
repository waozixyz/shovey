// A separate unsigned local preview of the real game and reward UI.
#import "kryon/app_context"
#import "kryon/app_protocol"
Host :: #import, file "../../src/web/host.zi";
View :: #import, file "../../src/shovey_view.zi";
Game :: #import, file "../../src/engine.zi";
Progress :: #import, file "../../src/progress.zi";
Rewards :: #import, file "../../src/rewards.zi";
Controls :: #import, file "../../src/controls.zi";
Profile :: #import "entity"
#import "kryon/modal_props"
#import "kryon/modal_frame_widget"
#import "kryon/tree"
#import "kryon/widget_palette"
#import "session"
#import "std/c_string"
#import "std/text_buffer"
#import "preview_map"

started: bool;
treasure_seen: bool;
profile_open: bool;
profile_seen: bool;
account_game: [2433]u8;

#program_export
LocaleHost :: (key: string) -> string { return Host.AppLocaleHost(key) }
#program_export
RecordHost :: (name: string) -> string { return DocumentRead(name) }
#program_export
SaveHost :: (name: string, text: string) -> bool { return DocumentWrite(name, text) }
#program_export
KeyHost :: () -> s32 { return ifx profile_open then 0 else AppKey() }
#program_export
SoundHost :: (path: string) -> bool { unused path; return false }

#program_export
CheckOffline :: () -> s32 {
    if Controls.DewService("claim:shovey.secret-chest") != "{\"status\":\"signin\"}" { return 1 }
    if Controls.CompletionAccountService("{}") != "{\"status\":\"unavailable\"}" { return 2 }
    if Game.ShoveyLevelBoard(1003) != PreviewMap { return 3 }
    game: Game.ShoveyGame
    if !Game.ShoveyLoadData(*game, 1003, PreviewMap) || game.player < 0 { return 4 }
    return 42
}

#program_export
OfflineService :: (name: string, request: string) -> string {
    if name == "entity.profile" && request == "open" {
        unused CopyCString(Game.ShoveySave(*View.game), account_game[:])
        profile_open = true
        return "queued"
    }
    if name == "entity.dew" { return "{\"status\":\"signin\"}" }
    if name == "arcade.controls" { return "off" }
    if name == "arcade.sound" { return "muted" }
    return "{\"status\":\"unavailable\"}"
}

// The preview uses Entity's real account composition, with no account
// provider or credentials. It must respond to the same open action as a host.
AccountModal :: () {
    if !profile_open { return }
    modal := ModalFrame(AppSession(), ModalFrameProps.{.key = cast(u64)880000,
        .id = 880000, .title = Profile.Label("entity.account", "Account"),
        .width = 560, .height = 300, .scale = AppScale(),
        .has_right_action = true, .right_label = Host.AppLocaleHost("shovey_close")})
    if modal.dismissed || modal.right_clicked {
        profile_open = false
        unused DocumentWrite("preview.account-closed", ifx Game.ShoveySave(*View.game) == TextUntilNul(account_game[:]) then
            "{\"preserved\":true}" else "{\"preserved\":false}")
    }
    if !modal.opened { return }
    Profile.session = AppSession()
    Profile.scale = AppScale()
    y := modal.layout.content.y + 16.0
    Profile.AccountPage(modal.layout.content.x, *y, modal.layout.content.width)
    Profile.Paragraph(cast(u64)880010,
        "Account connection is unavailable in this offline preview. Nothing has been credited.",
        modal.layout.content.x, y + 8.0, modal.layout.content.width, 80.0)
    unused End(AppSession())
    if !profile_seen {
        unused DocumentWrite("preview.account-modal", "{\"service\":\"entity.profile\",\"modal\":\"account\",\"offline\":true,\"credited\":false}")
        profile_seen = true
    }
}

#program_export
Main :: () -> s64 {
    mode := AppMode()
    if mode == APP_IDENTIFY {
        AppIdentity("shovey-treasure-preview")
        AppDescribe("Shovey 29a · Offline preview", "S1.7rr:M4 4H20V20H4ZM9 9H15V15H9Z")
        return APP_PROTOCOL
    }
    if mode == APP_FRAME {
        if !started {
            // Skip account/campaign hydration. No owner documents are read.
            View.loaded = true
            View.mini = true
            View.progress = Progress.ShoveyProgressNew()
            View.level_updates = 0
            unused DocumentWrite("local.secret29a", "1")
            View.last_tick = AppNow()
            Rewards.reward_loaded = true
            if !Game.ShoveyLoadData(*View.game, 1003, PreviewMap) { return -1 }
            unused DocumentWrite("preview.started", PreviewIdentity)
            started = true
        }
        View.ShoveyFrame()
        if profile_open {
            unused WidgetPaletteRestore(AppSession())
            AccountModal()
        }
        if !treasure_seen && Rewards.reward_card == Rewards.REWARD_CHEST && Rewards.reward_card_signin {
            unused DocumentWrite("preview.treasure", "{\"level\":1003,\"cell\":124,\"dialog\":\"signin\",\"credited\":false}")
            treasure_seen = true
        }
    }
    return 0
}
