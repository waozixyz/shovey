// Shared colours, materials, noise and shapes for every Shovey model,
// built with Kryon's Scene.
#import "std/math"
#import "std/vec"
#import "drawing_props"
#import "scene"

// Cool greens and blues grounded by earth brown, with a little light orange.
MIST :: 0xdde9e5
PALE_MIST :: 0xeef4f1
SKY :: 0xa8c8d2
LAKE :: 0x3f6f8f
JADE :: 0x2e7d68
PINE :: 0x1e4a40
EARTH :: 0x6e4c36
BARK :: 0x8a6446
WOOD :: 0xa9805a
LIGHT_WOOD :: 0xc7a27a
ORANGE :: 0xf2a65e
INK :: 0x1b322d
STONE :: 0x9aa8a4
DARK_STONE :: 0x6f7f7b
PALE_STONE :: 0xc9d4d0
RED :: 0xcf5643
BLUE :: 0x3f7cc4
GREEN :: 0x46a05e
YELLOW :: 0xe9c44c
PINK :: 0xd98aa6
LILAC :: 0xa99ad0
SAND :: 0xe6d9b2
WET_SAND :: 0xcdbf98
WATER :: 0x6aaec2
DEEP_WATER :: 0x4b8fa8
FOAM :: 0xeef7f5
GRASS :: 0x6fb27c
DARK_GRASS :: 0x4f9466
LEAF :: 0x4c9a5e
WHITE :: 0xf6f8f4
GOLD :: 0xe6b84f
SILVER :: 0xc3cdd0

PI :: 3.141592653589793
TAU :: 6.283185307179586

Hex :: (value: u32) -> Color {
    return .{cast(u8)((value >> 16) & 255), cast(u8)((value >> 8) & 255), cast(u8)(value & 255), 255}
}

// Matte surfaces: nothing glossy or plastic. GLOW below zero means none.
Mat :: (color: u32, rough: float64 = 0.78, metal: float64 = 0.0, glow: s64 = -1,
    glow_strength: float64 = -1.0, opacity: float64 = -1.0, double_sided: bool = false,
    flat: bool = false) -> SceneMaterial {
    material := LitMaterial(Hex(color), rough, metal)
    if glow >= 0 {
        material.glow = Hex(cast(u32)glow)
        material.glow_strength = ifx glow_strength >= 0.0 then glow_strength else 0.6
    }
    if opacity >= 0.0 {
        material.opacity = opacity
        material.transparent = true
    }
    material.double_sided = double_sided
    material.flat = flat
    return material
}

// three.js colour arithmetic happens in linear light and comes back as
// sRGB bytes: TONE times K.
Darker :: (tone: u32, k: float64) -> u32 {
    c := Hex(tone)
    return Pack(Linear(c.r) * k, Linear(c.g) * k, Linear(c.b) * k)
}

// TONE moved T of the way to white.
Lighter :: (tone: u32, t: float64) -> u32 {
    c := Hex(tone)
    return Pack(Linear(c.r) + (1.0 - Linear(c.r)) * t, Linear(c.g) + (1.0 - Linear(c.g)) * t,
        Linear(c.b) + (1.0 - Linear(c.b)) * t)
}

Linear :: (value: u8) -> float64 {
    c := cast(float64)value / 255.0
    if c < 0.04045 { return c * 0.0773993808 }
    return Pow(c * 0.9478672986 + 0.0521327014, 2.4)
}

Encoded :: (c: float64) -> u32 {
    value := ifx c < 0.0031308 then c * 12.92 else 1.055 * Pow(c, 0.41666) - 0.055
    if value < 0.0 { value = 0.0 }
    if value > 1.0 { value = 1.0 }
    return cast(u32)Round(value * 255.0)
}

Pack :: (r: float64, g: float64, b: float64) -> u32 {
    return (Encoded(r) << 16) | (Encoded(g) << 8) | Encoded(b)
}

// JavaScript's Math.round: halves go up.
Round :: (value: float64) -> float64 {
    return Floor(value + 0.5)
}

Floor :: (value: float64) -> float64 {
    whole := cast(float64)cast(s64)value
    return ifx whole > value then whole - 1.0 else whole
}

Clamp :: (value: float64, low: float64, high: float64) -> float64 {
    return ifx value < low then low else ifx value > high then high else value
}

// A linear colour, times 255, as kit.js's rgb works with them.
Rgb :: (tone: u32) -> Vector3 {
    c := Hex(tone)
    return .{Linear(c.r) * 255.0, Linear(c.g) * 255.0, Linear(c.b) * 255.0}
}

Blend :: (a: u32, b: u32, t: float64) -> Vector3 {
    return Mix(Rgb(a), Rgb(b), t)
}

Mix :: (a: Vector3, b: Vector3, t: float64) -> Vector3 {
    return .{a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t}
}

// Mulberry32, as kit.js's rng.
Random :: struct { state: u32; }

NextRandom :: (random: *Random) -> float64 {
    random.state = random.state + 0x6D2B79F5
    t := random.state
    t = (t ^ (t >> 15)) * (t | 1)
    t = t ^ (t + (t ^ (t >> 7)) * (t | 61))
    return cast(float64)(t ^ (t >> 14)) / 4294967296.0
}

// Value noise that repeats every PERIOD lattice cells, so a texture spread
// over one board cell joins its neighbours exactly.
Noise :: struct {
    period: s32
    lattice: [4096]float64
}

MakeNoise :: (noise: *Noise, period: s32, seed: u32) {
    random: Random = .{seed}
    noise.period = period
    for at: 0..period * period - 1 { noise.lattice[at] = NextRandom(*random) }
}

NoiseAt :: (noise: *Noise, u: float64, v: float64) -> float64 {
    period := cast(float64)noise.period
    x := u * period
    y := v * period
    x0 := Floor(x)
    y0 := Floor(y)
    fx := Smooth(x - x0)
    fy := Smooth(y - y0)
    top := Lattice(noise, x0, y0) * (1.0 - fx) + Lattice(noise, x0 + 1.0, y0) * fx
    bottom := Lattice(noise, x0, y0 + 1.0) * (1.0 - fx) + Lattice(noise, x0 + 1.0, y0 + 1.0) * fx
    return top * (1.0 - fy) + bottom * fy
}

Smooth :: (t: float64) -> float64 { return t * t * (3.0 - 2.0 * t) }

Lattice :: (noise: *Noise, x: float64, y: float64) -> float64 {
    p := noise.period
    cx := (cast(s32)x % p + p) % p
    cy := (cast(s32)y % p + p) % p
    return noise.lattice[cy * p + cx]
}

// ---------------------------------------------------------------- shapes

Box :: (s: *Scene, w: float64, h: float64, d: float64, r: float64, material: SceneMaterial) -> s32 {
    return RoundedBox(s, w, h, d, r, material, 4)
}

Ball :: (s: *Scene, radius: float64, material: SceneMaterial, segments: s32 = 48) -> s32 {
    return Sphere(s, radius, material, segments, cast(s32)Round(cast(float64)segments * 0.75))
}

Pipe :: (s: *Scene, top: float64, bottom: float64, height: float64, material: SceneMaterial, segments: s32 = 40) -> s32 {
    return Cylinder(s, top, bottom, height, material, segments)
}

Ring :: (s: *Scene, radius: float64, tube: float64, material: SceneMaterial, arc: float64 = TAU) -> s32 {
    return Torus(s, radius, tube, material, 24, 64, arc)
}

// Revolves a profile of (radius, height) points around the vertical axis.
Lathed :: (s: *Scene, points: []ShapePoint, material: SceneMaterial) -> s32 {
    return Lathe(s, points, material, 48)
}

// A flat shape lying on the ground, raised to DEPTH with soft edges. Shape
// points are in board units: x to the right, y towards the bottom.
Slab :: (s: *Scene, shape: *Shape, depth: float64, material: SceneMaterial, bevel: float64 = 0.02) -> s32 {
    node := Extrude(s, shape, depth, material, bevel, bevel, 4, 48)
    unused SetRotation(s, node, PI / 2.0, 0.0, 0.0)
    unused SetPosition(s, node, 0.0, depth + bevel, 0.0)
    return node
}

Polygon :: (shape: *Shape, points: []ShapePoint) {
    for at: 0..points.count - 1 {
        if at == 0 { ShapeMoveTo(shape, points[at].x, points[at].y) }
        else { ShapeLineTo(shape, points[at].x, points[at].y) }
    }
    ShapeClose(shape)
}

CircleShape :: (shape: *Shape, cx: float64, cy: float64, r: float64) {
    ShapeArc(shape, cx, cy, r, 0.0, TAU)
}

RoundedRectShape :: (shape: *Shape, x: float64, y: float64, w: float64, h: float64, r: float64) {
    ShapeMoveTo(shape, x + r, y)
    ShapeLineTo(shape, x + w - r, y)
    ShapeQuadraticTo(shape, x + w, y, x + w, y + r)
    ShapeLineTo(shape, x + w, y + h - r)
    ShapeQuadraticTo(shape, x + w, y + h, x + w - r, y + h)
    ShapeLineTo(shape, x + r, y + h)
    ShapeQuadraticTo(shape, x, y + h, x, y + h - r)
    ShapeLineTo(shape, x, y + r)
    ShapeQuadraticTo(shape, x, y, x + r, y)
}

StarShape :: (shape: *Shape, cx: float64, cy: float64, outer: float64, inner: float64,
    points: s32 = 5, turn: float64 = -PI / 2.0) {
    for i: 0..points * 2 - 1 {
        r := ifx i % 2 != 0 then inner else outer
        a := turn + cast(float64)i * PI / cast(float64)points
        if i == 0 { ShapeMoveTo(shape, cx + Cos(a) * r, cy + Sin(a) * r) }
        else { ShapeLineTo(shape, cx + Cos(a) * r, cy + Sin(a) * r) }
    }
    ShapeClose(shape)
}

At :: (s: *Scene, node: s32, x: float64 = 0.0, y: float64 = 0.0, z: float64 = 0.0) -> s32 {
    return SetPosition(s, node, x, y, z)
}

Turned :: (s: *Scene, node: s32, x: float64 = 0.0, y: float64 = 0.0, z: float64 = 0.0) -> s32 {
    return SetRotation(s, node, x, y, z)
}

Scaled :: (s: *Scene, node: s32, x: float64, y: float64, z: float64) -> s32 {
    return SetScale(s, node, x, y, z)
}

ScaledAll :: (s: *Scene, node: s32, k: float64) -> s32 {
    return SetScale(s, node, k, k, k)
}

NoShadow :: (s: *Scene, node: s32) -> s32 {
    return SetShadows(s, node, false, true)
}
